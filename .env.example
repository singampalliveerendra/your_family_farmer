# Go Grameen — environment manifest.
#
# Copy to .env.local and fill in. Every variable below is read somewhere in
# src/; nothing here is optional-by-accident, so each one says what breaks
# without it. Values are per-environment: production and staging are SEPARATE
# Supabase projects, and mixing a URL from one with a key from the other
# produces "Invalid API key", which is always a config mismatch and never an
# auth-code bug.

# --- Supabase ---------------------------------------------------------------
# The anon key is PUBLIC: it ships inside every JS bundle. It is not a secret
# and rotating it is not a security fix — what the browser may do is decided by
# RLS policies and column GRANTs, not by this value.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — every API route's authority comes from
# this. Never expose it to the client and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessions ---------------------------------------------------------------
# 32+ random chars: `openssl rand -hex 32`. Signs every role's session cookie,
# the guest checkout token, AND the at-rest OTP hashes. Rotating it logs
# everyone out and invalidates every outstanding OTP, so do it in a quiet
# window. Requests throw rather than fall back if this is missing or too short.
SESSION_SECRET=

# --- Razorpay ---------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay dashboard: Settings -> Webhooks. Distinct from the key
# secret above. Without it the webhook route returns 500 and payments are
# confirmed only by the browser callback, which a dead phone can lose.
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
# OTP delivery. Meta is transport only — we generate and verify the codes
# ourselves (src/lib/otp.ts).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Cron -------------------------------------------------------------------
# Vercel sends this as a Bearer token to /api/cron/reconcile-payments. The route
# FAILS CLOSED when it is unset — a missing secret is a misconfiguration, not
# permission to run the job unauthenticated.
CRON_SECRET=

# --- Environment ------------------------------------------------------------
# Set to `staging` on the staging deployment. This is what suppresses real
# WhatsApp sends and pins the OTP to 123456 for testing.
#
# Do NOT rely on VERCEL_ENV for this. If staging is deployed as its own Vercel
# *production* deployment, VERCEL_ENV is "production" there and the guards
# silently stop applying — real OTPs then go to whatever number a tester types.
YFF_ENV=

# Default region for complaint routing when a request carries no moderator
# session. Per-moderator zones come from the moderators table, not from here.
MODERATOR_ZONE=tadepalligudem

# --- Admin ------------------------------------------------------------------
# The /admin area's shared password. Moderators are per-person accounts in the
# `moderators` table and do NOT use this.
ADMIN_PASSWORD=
