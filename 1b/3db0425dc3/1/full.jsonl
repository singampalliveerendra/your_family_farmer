ry ? deliveryAltPhone.replace(/\\D/g, '').slice(-10) : null,\n        idempotencyKey: getIdempotencyKey(f.farmerId),\n      }),\n    }).catch(() => null)\n    if (!r) return { ok: false, error: 'Network error. Please try again.' }\n    const json = await r.json().catch(() => ({}))\n    if (!r.ok || !json?.ok) return { ok: false, error: json?.error ?? 'Could not place order.' }\n    // Order saved — drop the key so a genuinely new order later gets a fresh one.\n    delete idempotencyKeys.current[f.farmerId]\n    return {","numLines":40,"startLine":583,"totalLines":2248}},"sourceToolAssistantUUID":"44fa7258-7f39-4e25-a9be-6c5c38c43f8e","session_id":"b6577fe7-68cf-4607-bdd4-71d04060cfcc","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"b6577fe7-68cf-4607-bdd4-71d04060cfcc","version":"2.1.212","gitBranch":"staging"}
