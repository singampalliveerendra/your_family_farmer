{"parentUuid":"8a7eae31-1f70-4176-b8d8-30a297b2d30e","isSidechain":false,"promptId":"d3b6d7a8-bd7b-4f4a-8834-d867f1fc08f3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Az7wfTnQBe3DSeiSP6kekg","type":"tool_result","content":"80\t  }\n81\t\n82\t  const paidByRazorpay = order.payment_status === 'paid' && !!order.razorpay_payment_id\n83\t  const paidByOther =\n84\t    order.payment_status === 'completed' ||\n85\t    order.payment_status === 'payment_claimed' ||\n86\t    order.payment_status === 'pending_confirmation'\n87\t\n88\t  // Cancellation is the buyer's choice, so the platform fee (moderator\n89\t  // commission) is NOT refunded — it covers the gateway/software cost already\n90\t  // incurred. We refund the produce price only; the fee stamped on this row\n91\t  // (the cart's first row carries it) is withheld. Surfaced to the buyer so the\n92\t  // deduction is shown clearly.\n93\t  const platformFeeWithheld = Math.max(0, Number(order.platform_fee) || 0)\n94\t  const refundAmount = Math.max(0, Number(order.total_price) || 0)\n95\t\n96\t  // Part-paid COD: the deposit is forfeited when the BUYER cancels. That is the\n97\t  // entire reason it exists — on full COD a buyer could walk away from a\n98\t  // confirmed order having risked nothing, after the farmer had already\n99\t  // harvested for it. Refunding it here would make the deposit pointless.\n100\t  //\n101\t  // A farmer decline/cancel is the opposite case and DOES refund it in full —\n102\t  // see /api/farmer/orders/[id]/decline. Note deposit_paid is deliberately\n103\t  // absent from paidByRazorpay/paidByOther above, so no refund call is made.\n104\t  const depositForfeited = isDepositPaid(order.payment_status)\n105\t    ? Math.max(0, Number(order.cod_deposit) || 0)\n106\t    : 0\n107\t  if (depositForfeited > 0) {\n108\t    update.deposit_forfeited_at = new Date().toISOString()\n109\t    update.cod_balance_due = 0\n110\t  }\n111\t\n112\t  if (paidByRazorpay) {\n113\t    const amountPaise = Math.round(refundAmount * 100)\n114\t    if (amountPaise > 0) {\n115\t      try {\n116\t        const refund = await refundPayment({\n117\t          paymentId: order.razorpay_payment_id as string,\n118\t          amountPaise,\n119\t          notes: { order_code: order.order_code ?? '', order_id: order.id, reason: 'buyer_cancel' },\n120\t        })\n121\t        update.refund_id = refund.id\n122\t        update.refund_status = refund.status ?? 'processed'\n123\t        update.refund_amount = Math.round(refund.amountPaise / 100)\n124\t        update.refunded_at = new Date().toISOString()\n125\t      } catch (e) {\n126\t        // The gateway refused the refund (e.g. account/gateway state). Don't\n127\t        // trap the buyer with an order they can't cancel: cancel it anyway and\n128\t        // flag the refund as failed, recording the amount owed so the team can\n129\t        // settle it manually from the Razorpay dashboard. The buyer sees a\n130\t        // \"refund failed / will be processed manually\" note.\n131\t        console.error('[YFF] razorpay refund on cancel failed:', e)\n132\t        update.refund_status = 'failed'\n133\t        update.refund_amount = refundAmount\n134\t      }\n135\t    }\n136\t  } else if (paidByOther) {\n137\t    update.refund_status = 'initiated'\n138\t  }\n139\t\n140\t  const { error: updErr } = await supabase.from('orders').update(update).eq('id', id)\n141\t  if (updErr) {\n142\t    console.error('[YFF] cancel update failed:', updErr.message)\n143\t    return NextResponse.json({ error: 'Could not cancel the order. Please try again.' }, { status: 500 })\n144\t  }\n145\t\n146\t  return NextResponse.json({\n147\t    ok: true,\n148\t    refunded: !!update.refund_id,\n149\t    refundInitiated: update.refund_status === 'initiated',\n150\t    refundFailed: update.refund_status === 'failed',\n151\t    refundAmount,\n152\t    platformFeeWithheld,\n153\t    // The buyer must be told plainly what the cancellation cost them.\n154\t    depositForfeited,\n155\t  })\n156\t}\n157\t"}]},"uuid":"746edca7-e48d-49e9-b2da-ee039aa7df25","timestamp":"2026-07-20T04:33:55.121Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/app/api/consumer/orders/[id]/cancel/route.ts","content":"  }\n\n  const paidByRazorpay = order.payment_status === 'paid' && !!order.razorpay_payment_id\n  const paidByOther =\n    order.payment_status === 'completed' ||\n    order.payment_status === 'payment_claimed' ||\n    order.payment_status === 'pending_confirmation'\n\n  // Cancellation is the buyer's choice, so the platform fee (moderator\n  // commission) is NOT refunded — it covers the gateway/software cost already\n  // incurred. We refund the produce price only; the fee stamped on this row\n  // (the cart's first row carries it) is withheld. Surfaced to the buyer so the\n  // deduction is shown clearly.\n  const platformFeeWithheld = Math.max(0, Number(order.platform_fee) || 0)\n  const refundAmount = Math.max(0, Number(order.total_price) || 0)\n\n  // Part-paid COD: the deposit is forfeited when the BUYER cancels. That is the\n  // entire reason it exists — on full COD a buyer could walk away from a\n  // confirmed order having risked nothing, after the farmer had already\n  // harvested for it. Refunding it here would make the deposit pointless.\n  //\n  // A farmer decline/cancel is the opposite case and DOES refund it in full —\n  // see /api/farmer/orders/[id]/decline. Note deposit_paid is deliberately\n  // absent from paidByRazorpay/paidByOther above, so no refund call is made.\n  const depositForfeited = isDepositPaid(order.payment_status)\n    ? Math.max(0, Number(order.cod_deposit) || 0)\n    : 0\n  if (depositForfeited > 0) {\n    update.deposit_forfeited_at = new Date().toISOString()\n    update.cod_balance_due = 0\n  }\n\n  if (paidByRazorpay) {\n    const amountPaise = Math.round(refundAmount * 100)\n    if (amountPaise > 0) {\n      try {\n        const refund = await refundPayment({\n          paymentId: order.razorpay_payment_id as string,\n          amountPaise,\n          notes: { order_code: order.order_code ?? '', order_id: order.id, reason: 'buyer_cancel' },\n        })\n        update.refund_id = refund.id\n        update.refund_status = refund.status ?? 'processed'\n        update.refund_amount = Math.round(refund.amountPaise / 100)\n        update.refunded_at = new Date().toISOString()\n      } catch (e) {\n        // The gateway refused the refund (e.g. account/gateway state). Don't\n        // trap the buyer with an order they can't cancel: cancel it anyway and\n        // flag the refund as failed, recording the amount owed so the team can\n        // settle it manually from the Razorpay dashboard. The buyer sees a\n        // \"refund failed / will be processed manually\" note.\n        console.error('[YFF] razorpay refund on cancel failed:', e)\n        update.refund_status = 'failed'\n        update.refund_amount = refundAmount\n      }\n    }\n  } else if (paidByOther) {\n    update.refund_status = 'initiated'\n  }\n\n  const { error: updErr } = await supabase.from('orders').update(update).eq('id', id)\n  if (updErr) {\n    console.error('[YFF] cancel update failed:', updErr.message)\n    return NextResponse.json({ error: 'Could not cancel the order. Please try again.' }, { status: 500 })\n  }\n\n  return NextResponse.json({\n    ok: true,\n    refunded: !!update.refund_id,\n    refundInitiated: update.refund_status === 'initiated',\n    refundFailed: update.refund_status === 'failed',\n    refundAmount,\n    platformFeeWithheld,\n    // The buyer must be told plainly what the cancellation cost them.\n    depositForfeited,\n  })\n}\n","numLines":78,"startLine":80,"totalLines":157}},"sourceToolAssistantUUID":"8a7eae31-1f70-4176-b8d8-30a297b2d30e","session_id":"b6577fe7-68cf-4607-bdd4-71d04060cfcc","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"b6