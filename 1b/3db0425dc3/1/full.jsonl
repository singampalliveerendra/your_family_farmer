d and clear cart. The farmer is alerted via\n406:    clearFarmer(screen.farmerId)\n411:  }, [clearFarmer])\n456:  // Fetch latest UPI IDs and QR codes for all farmers in cart when sheet opens\n458:    const farmerIds = [...new Set(items.map((i) => i.farmerId).filter(Boolean))]\n459:    if (farmerIds.length === 0) return\n461:      .from('farmers')\n463:      .in('id', farmerIds)\n497:  // delivery choice below can be limited to what the farmer permits per produce.\n526:  // Group items by farmer\n527:  const byFarmer = items.reduce<Record<string, CartItem[]>>((acc, item) => {\n528:    (acc[item.farmerId] = acc[item.farmerId] ?? []).push(item)\n531:  const farmerGroups = Object.values(byFarmer)\n533:  // Per-item fulfillment permissions from each produce's farmer-set\n585:    group: CartItem[],\n591:    const f = group[0]\n592:    // Whether this farmer's order has any home-delivery line — decides if we\n595:    const groupHasDelivery = group.some((it) => deliveryOf(it) === 'home_delivery')\n596:    const r = await fetch('/api/orders/place', {\n601:        farmerId: f.farmerId,\n603:        pickupLocation: pickupByFarmer[f.farmerId] || null,\n604:        items: group.map((it) => ({\n610:        deliveryAddress: groupHasDelivery ? deliveryAddress.trim() : null,\n611:        deliveryCity: groupHasDelivery ? deliveryCity.trim() : null,\n612:        deliveryLandmark: groupHasDelivery ? deliveryLandmark.trim() : null,\n613:        deliveryPincode: groupHasDelivery ? deliveryPincode.trim() : null,\n614:        deliveryAltPhone: groupHasDelivery ? deliveryAltPhone.replace(/\\D/g, '').slice(-10) : null,\n615:        idempotencyKey: getIdempotencyKey(f.farmerId),","is_error":false}]},"uuid":"137098e5-a5b8-4c29-8064-6d841c5bc82d","timestamp":"2026-07-20T04:10:47.179Z","toolUseResult":{"stdout":"12:import { DELIVERY_FEE_RUPEES } from '@/lib/delivery-fee'\n85:  farmerId: string\n86:  farmerName: string\n87:  farmerPhone: string\n88:  farmerVillage: string\n89:  farmerSlug: string\n90:  farmerPickupLocations?: string[]\n91:  farmerPickupSlots?: PickupSchedule\n92:  farmerUpiId?: string\n93:  farmerQrCodeUrl?: string\n190:  const clearFarmer = useCallback((farmerId: string) => {\n193:      if (next[key].farmerId === farmerId) delete next[key]\n199:  const count = items.reduce((sum, i) => sum + i.qty, 0)\n201:  return { cart, items, count, addItem, setQty, removeItem, clear, clearFarmer }\n224:  farmerName: string\n225:  farmerVillage: string\n226:  farmerPhone: string\n231:  farmerId: string\n301:  const { setQty, removeItem, clear, clearFarmer } = useCart()\n315:  // DELIVERY_FEE_RUPEES is charged once per farmer group and collected by the\n318:  // Per-produce fulfillment the farmer allowed ('pickup' | 'courier' | 'both'),\n328:  const [sentFarmers, setSentFarmers] = useState<Record<string, boolean>>({})\n329:  const [pickupByFarmer, setPickupByFarmer] = useState<Record<string, string>>({})\n333:  // One idempotency key per farmer checkout attempt. Kept until the order\n337:  const getIdempotencyKey = (farmerId: string): string => {\n338:    if (!idempotencyKeys.current[farmerId]) {\n339:      idempotencyKeys.current[farmerId] =\n344:    return idempotencyKeys.current[farmerId]\n350:  // Live COD acceptance per farmer (default false until fetched)\n365:  // Razorpay online payment: which farmer group is mid-payment, and whether\n370:  // Global platform fee (moderator commission), added on top of each farmer\n371:  // group's subtotal. 0 unless a moderator has set one.\n391:  // Update payment status to claimed and clear cart. The farmer is alerted via\n406:    clearFarmer(screen.farmerId)\n411:  }, [clearFarmer])\n456:  // Fetch latest UPI IDs and QR codes for all farmers in cart when sheet opens\n458:    const farmerIds = [...new Set(items.map((i) => i.farmerId).filter(Boolean))]\n459:    if (farmerIds.length === 0) return\n461:      .from('farmers')\n463:      .in('id', farmerIds)\n497:  // delivery choice below can be limited to what the farmer permits per produce.\n526:  // Group items by farmer\n527:  const byFarmer = items.reduce<Record<string, CartItem[]>>((acc, item) => {\n528:    (acc[item.farmerId] = acc[item.farmerId] ?? []).push(item)\n531:  const farmerGroups = Object.values(byFarmer)\n533:  // Per-item fulfillment permissions from each produce's farmer-set\n585:    group: CartItem[],\n591:    const f = group[0]\n592:    // Whether this farmer's order has any home-delivery line — decides if we\n595:    const groupHasDelivery = group.some((it) => deliveryOf(it) === 'home_delivery')\n596:    const r = await fetch('/api/orders/place', {\n601:        farmerId: f.farmerId,\n603:        pickupLocation: pickupByFarmer[f.farmerId] || null,\n604:        items: group.map((it) => ({\n610:        deliveryAddress: groupHasDelivery ? deliveryAddress.trim() : null,\n611:        deliveryCity: groupHasDelivery ? deliveryCity.trim() : null,\n612:        deliveryLandmark: groupHasDelivery ? deliveryLandmark.trim() : null,\n613:        deliveryPincode: groupHasDelivery ? deliveryPincode.trim() : null,\n614:        deliveryAltPhone: groupHasDelivery ? deliveryAltPhone.replace(/\\D/g, '').slice(-10) : null,\n615:        idempotencyKey: getIdempotencyKey(f.farmerId),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"3220ff54-dee3-4787-a7a7-405168b1ee6a","session_id":"b6577fe7-68cf-4607-bdd4-71d04060cfcc","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"b6577fe7-68cf-4607-bdd4-71d04060cfcc","version":"2.1.212","gitBranch":"staging"}
