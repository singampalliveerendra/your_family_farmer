<?xml version="1.0" encoding="utf-8"?>
<!-- The Android 11-and-older twin of data_extraction_rules.xml, which those
     versions ignore. Same rule, same reason: the encrypted session is bound to
     this phone's Keystore and is useless — and unwanted — anywhere else. -->
<full-backup-content>
    <exclude domain="sharedpref" path="gg_secure.xml" />
</full-backup-content>
