w up.\n93\t      const r = await fetch(`/api/consumer/orders/${order.id}`, { credentials: 'same-origin' })\n94\t      const fresh = await r.json().catch(() => ({}))\n95\t      if (r.ok && fresh.order) setOrder(fresh.order as Order)\n96\t    } catch {\n97\t      alert('Network error. Please try again. / నెట్‌వర్క్ సమస్య. మళ్ళీ ప్రయత్నించండి.')\n98\t    } finally {\n99\t      setCancelling(false)\n100\t    }"}]},"uuid":"1e9767c7-c4d7-44ab-86d2-0f9e39cbac4b","timestamp":"2026-06-16T19:17:34.104Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/app/consumer/orders/[id]/page.tsx","content":"}\n\nexport default function OrderDetailsPage() {\n  const params = useParams<{ id: string }>()\n  const id = typeof params?.id === 'string' ? params.id : ''\n  const { state, openAuth } = useConsumerAuth()\n  const { tx, L } = useLang()\n  const [order, setOrder] = useState<Order | null>(null)\n  const [loading, setLoading] = useState(true)\n  const [error, setError] = useState('')\n  const [proofUrl, setProofUrl] = useState<string | null>(null)\n  const [proofLoading, setProofLoading] = useState(false)\n  const [showReceipt, setShowReceipt] = useState(false)\n  const [cancelling, setCancelling] = useState(false)\n  const [showComplaint, setShowComplaint] = useState(false)\n\n  // Buyer may cancel only while still pending and within 30 min of placing.\n  const canCancel = !!order\n    && order.status === 'pending'\n    && !!order.created_at\n    && Date.now() - new Date(order.created_at).getTime() < 30 * 60 * 1000\n\n  const handleCancel = async () => {\n    if (!order) return\n    if (!window.confirm('Cancel this order? If you have already paid, you will be refunded automatically.\\n\\nఈ ఆర్డర్‌ను రద్దు చేయాలా? మీరు ఇప్పటికే చెల్లించి ఉంటే, డబ్బు ఆటోమేటిక్‌గా తిరిగి వస్తుంది.')) return\n    setCancelling(true)\n    try {\n      const res = await fetch(`/api/consumer/orders/${order.id}/cancel`, {\n        method: 'POST',\n        credentials: 'same-origin',\n      })\n      const json = await res.json().catch(() => ({}))\n      if (!res.ok) { alert(json.error || 'Could not cancel the order. / ఆర్డర్ రద్దు చేయలేకపోయాం.'); return }\n      // Refresh the order so status + any refund show up.\n      const r = await fetch(`/api/consumer/orders/${order.id}`, { credentials: 'same-origin' })\n      const fresh = await r.json().catch(() => ({}))\n      if (r.ok && fresh.order) setOrder(fresh.order as Order)\n    } catch {\n      alert('Network error. Please try again. / నెట్‌వర్క్ సమస్య. మళ్ళీ ప్రయత్నించండి.')\n    } finally {\n      setCancelling(false)\n    }","numLines":42,"startLine":59,"totalLines":720}},"sourceToolAssistantUUID":"44da9e81-696a-4424-a12e-6379987d1cfd","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"a9aae61b-4a55-4f27-b7c0-22d7e61b6fa7","version":"2.1.178","gitBranch":"feat/suspend-consumer-reason-privacy"}
