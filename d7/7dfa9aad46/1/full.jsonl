veTier(qty: number, item: CartItem): { price?: number; isDiscount: boolean } {\n64\t  const { priceTier1Qty, priceTier1Price, priceTier2Qty, priceTier2Price, priceTier3Price } = item\n65\t  if (priceTier1Qty == null || priceTier1Price == null)\n66\t    return { price: item.pricePerKg, isDiscount: false }\n67\t  if (qty <= priceTier1Qty)\n68\t    return { price: priceTier1Price, isDiscount: false }\n69\t  if (priceTier2Qty != null && priceTier2Price != null) {\n70\t    if (qty <= priceTier2Qty) return { price: priceTier2Price, isDiscount: true }\n71\t    return { price: priceTier3Price ?? priceTier2Price, isDiscount: true }\n72\t  }\n73\t  if (priceTier3Price != null) return { price: priceTier3Price, isDiscount: true }\n74\t  return { price: priceTier1Price, isDiscount: false }\n75\t}\n76\t\n77\texport function useCart() {\n78\t  const [cart, setCart] = useState<CartState>({})\n79\t\n80\t  useEffect(() => {\n81\t    setCart(readCart())\n82\t    const sync = () => setCart(readCart())\n83\t    window.addEventListener(CART_EVENT, sync)\n84\t    window.addEventListener('storage', sync)\n85\t    return () => {\n86\t      window.removeEventListener(CART_EVENT, sync)\n87\t      window.removeEventListener('storage', sync)\n88\t    }\n89\t  }, [])\n90\t\n91\t  const addItem = useCallback((item: Omit<CartItem, 'qty'>, qty = 1) => {\n92\t    const next = { ...readCart() }\n93\t    const existing = next[item.listingId]\n94\t    const rawQty = Math.max(1, (existing?.qty ?? 0) + qty)\n95\t    const newQty = item.stockQty != null ? Math.min(rawQty, item.stockQty) : rawQty\n96\t    const merged = { ...item, qty: newQty }\n97\t    const { price } = getActiveTier(newQty, merged)\n98\t    next[item.listingId] = { ...merged, pricePerKg: price ?? item.pricePerKg }\n99\t    writeCart(next)\n100\t  }, [])"}]},"uuid":"3e502c5f-cd59-47dc-93d6-066353b156fc","timestamp":"2026-05-05T09:58:17.838Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/com