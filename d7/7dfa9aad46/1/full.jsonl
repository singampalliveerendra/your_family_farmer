     >\n              {tab}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      <div className=\"px-4 py-4\">\n        {activeTab === 0 && <StoryTab farmer={farmer} />}\n        {activeTab === 1 && <ProduceTab farmer={farmer} produce={produce} isEditMode={isEditMode} />}","numLines":50,"startLine":1,"totalLines":59}},"sourceToolAssistantUUID":"3731cc97-cd5e-453e-9c32-c8ea8dac56ce","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"7a6aaaaf-7f8a-495a-9a66-4b6152eec242","version":"2.1.128","gitBranch":"main"}
