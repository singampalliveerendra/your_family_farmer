lice(-10) : null\n\n    const supabase = createClient(\n      process.env.NEXT_PUBLIC_SUPABASE_URL!,\n      process.env.SUPABASE_SERVICE_ROLE_KEY ?? process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!\n    )\n\n    // Check for an existing review from the same phone on this farmer\n    if (phone) {\n      const { data: existing } = await supabase\n        .from('reviews')\n        .select('id')\n        .eq('farmer_id', farmer_id)\n        .eq('reviewer_phone', phone)\n        .maybeSingle()\n      if (existing) {\n        return NextResponse.json({ error: 'already_reviewed' }, { status: 409 })\n      }\n    }\n\n    const insertPayload: Record<string, unknown> = {\n      farmer_id,\n      reviewer_name: reviewer_name.trim(),\n      star_rating,\n      review_text: review_text?.trim() || null,\n      produce_ordered: produce_ordered?.trim() || null,\n      approved: true,\n    }\n    if (phone) insertPayload.reviewer_phone = phone\n\n    const { data: review, error } = await supabase\n      .from('reviews')\n      .insert(insertPayload)\n      .select('*')\n      .single()"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2114,"cache_read_input_tokens":157348,"output_tokens":1540,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2114,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[{"input_tokens":1,"output_tokens":1540,"cache_read_input_tokens":157348,"cache_creation_input_tokens":2114,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2114},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CajBw5SzdWiyuJqKE4t56","type":"assistant","uuid":"63a78bab-f951-42bd-91f3-11e698c721f0","timestamp":"2026-05-05T09:31:51.866Z","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"7a