dPickup = () => {\n631\t    const v = newPickup.trim()\n632\t    if (!v) return\n633\t    if (pickupLocations.includes(v)) { setNewPickup(''); return }\n634\t    setPickupLocations((prev) => [...prev, v])\n635\t    setNewPickup('')\n636\t  }\n637\t  const removePickup = (loc: string) =>\n638\t    setPickupLocations((prev) => prev.filter((l) => l !== loc))\n639\t\n640\t  const handleSave = async () => {\n641\t    if (!name.trim()) { setError(tx.nameRequired); return }\n642\t    if (!village.trim()) { setError(tx.villageRequired); return }\n643\t    if (upiId.trim() && !/^[a-zA-Z0-9._\\-]{2,256}@[a-zA-Z]{2,64}$/.test(upiId.trim())) {\n644\t      setError('Invalid UPI ID format. Example: yourname@ybl or 9876543210@paytm')\n645\t      return\n646\t    }\n647\t    setLoading(true)\n648\t    setError('')\n649\t\n650\t    // Build unique slug from name if current slug is still auto-generated\n651\t    const isAutoSlug = /^f-\\d{10}-[a-z0-9]{4}$/.test(farmer.slug ?? '')\n652\t    const baseSlug = name\n653\t      .toLowerCase()\n654\t      .trim()\n655\t      .replace(/[^a-z0-9]+/g, '-')\n656\t      .replace(/(^-|-$)/g, '')\n657\t      .slice(0, 40) || 'farmer'\n658\t    let newSlug = farmer.slug\n659\t    if (isAutoSlug && baseSlug) {\n660\t      const rand = Math.random().toString(36).slice(2, 5)\n661\t      newSlug = `${baseSlug}-${rand}`\n662\t    }\n663\t\n664\t    // Upload photos in parallel\n665\t    const [coverRes, avatarRes, certRes, qrRes] = await Promise.all([\n666\t      coverFile ? uploadProfileImage(coverFile, 'cover') : Promise.resolve({ url: null, err: null }),\n667\t      avatarFile ? uploadProfileImage(avatarFile, 'avatar') : Promise.resolve({ url: null, err: null }),\n668\t      certFile  ? uploadProfileImage(certFile,  'pesticide-cert') : Promise.resolve({ url: null, err: null }),\n669\t      qrFile    ? uploadProfileImage(qrFile,    'upi-qr') : Promise.resolve({ url: null, err: null }),"}]},"uuid":"c429786b-cac7-4f50-83ea-379957f638a7","timestamp":"20