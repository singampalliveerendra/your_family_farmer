me=\"block text-green-200 text-[11px] mt-0.5\">పంట కొనండి</span>\n      </button>\n    </div>\n  )\n}\n","numLines":45,"startLine":1,"totalLines":45}},"sourceToolAssistantUUID":"86cd2c19-2574-4f8a-aa60-d910d3562fbf","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"7a6aaaaf-7f8a-495a-9a66-4b6152eec242","version":"2.1.128","gitBranch":"main"}
{"parentUuid":"e1e1c208-9b8d-46c9-9864-15eb17cb5149","isSidechain":false,"promptId":"1172beb6-f58e-478b-860c-6322e3d08858","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SYhB91x4cJY2cpcZ8J6K8c","type":"tool_result","content":"1\t'use client'\n2\t\n3\timport { useEffect, useState, useCallback } from 'react'\n4\timport Link from 'next/link'\n5\timport { supabase } from '@/lib/supabase'\n6\t\n7\ttype PickupSlots = {\n8\t  days: string[]\n9\t  time_from: string\n10\t  time_to: string\n11\t}\n12\t\n13\texport type CartItem = {\n14\t  listingId: string\n15\t  qty: number\n16\t  name: string\n17\t  variety?: string\n18\t  emoji?: string\n19\t  pricePerKg?: number\n20\t  priceTier1Qty?: number\n21\t  priceTier1Price?: number\n22\t  priceTier2Qty?: number\n23\t  priceTier2Price?: number\n24\t  priceTier3Price?: number\n25\t  unit?: string\n26\t  stockQty?: number\n27\t  farmerId: string\n28\t  farmerName: string\n29\t  farmerPhone: string\n30\t  farmerVillage: string\n31\t  farmerSlug: string\n32\t  farmerPickupLocations?: string[]\n33\t  farmerPickupSlots?: PickupSlots | null\n34\t  farmerUpiId?: string\n35\t  farmerQrCodeUrl?: string\n36\t}\n37\t\n38\texport type CartState = Record<string, CartItem>\n39\t\n40\texport type ConsumerInfo = { name: string; phone: string }\n41\t\n42\tconst CART_KEY = 'yff_cart_v1'\n43\tconst CONSUMER_KEY = 'REDACTED'\n44\tconst CART_EVENT = 'yff:cart-change'\n45\t\n46\tconst readCart = (): CartState => {\n47\t  if (typeof window === 'undefined') return {}\n48\t  try {\n49\t    const raw = localStorage.getItem(CART_KEY)\n50\t    return raw ? (JSON.parse(raw) as CartState) : {}\n51\t  } catch {\n52\t    return {}\n53\t  }\n54\t}\n55\t\n56\tconst writeCart = (next: CartState) => {\n57\t  localStorage.setItem(CART_KEY, JSON.stringify(next))\n58\t  window.dispatchEvent(new Event(CART_EVENT))\n59\t}\n60\t\n61\tfunction getActiveTier(qty: number, item: CartItem): { price?: number; isDiscount: boolean } {\n62\t  const { priceTier1Qty, priceTier1Price, priceTier2Qty, priceTier2Price, priceTier3Price } = item\n63\t  if (priceTier1Qty == null || priceTier1Price == null)\n64\t    return { price: item.pricePerKg, isDiscount: false }\n65\t  if (qty <= priceTier1Qty)\n66\t    return { price: priceTier1Price, isDiscount: false }\n67\t  if (priceTier2Qty != null && priceTier2Price != null) {\n68\t    if (qty <= priceTier2Qty) return { price: priceTier2Price, isDiscount: true }\n69\t    return { price: priceTier3Price ?? priceTier2Price, isDiscount: true }\n70\t  }\n71\t  if (priceTier3Price != null) return { price: priceTier3Price, isDiscount: true }\n72\t  return { price: priceTier1Price, isDiscount: false }\n73\t}\n74\t\n75\texport function useCart() {\n76\t  const [cart, setCart] = useState<CartState>({})\n77\t\n78\t  useEffect(() => {\n79\t    setCart(readCart())\n80\t    const sync = () => setCart(readCart())\n81\t    window.addEventListener(CART_EVENT, sync)\n82\t    window.addEventListener('storage', sync)\n83\t    return () => {\n84\t      window.removeEventListener(CART_EVENT, sync)\n85\t      window.removeEventListener('storage', sync)\n86\t    }\n87\t  }, [])\n88\t\n89\t  const addItem = useCallback((item: Omit<CartItem, 'qty'>, qty = 1) => {\n90\t    const next = { ...readCart() }\n91\t    const existing = next[item.listingId]\n92\t    const rawQty = Math.max(1, (existing?.qty ?? 0) + qty)\n93\t    const newQty = item.stockQty != null ? Math.min(rawQty, item.stockQty) : rawQty\n94\t    const merged = { ...item, qty: newQty }\n95\t    const { price } = getActiveTier(newQty, merged)\n96\t    next[item.listingId] = { ...merged, pricePerKg: price ?? item.pricePerKg }\n97\t    writeCart(next)\n98\t  }, [])\n99\t\n100\t  const setQty = useCallback((listingId: string, qty: number) => {\n101\t    const next = { ...readCart() }\n102\t    if (qty <= 0) delete next[listingId]\n103\t    else if (next[listingId]) {\n104\t      const existing = next[listingId]\n105\t      const cappedQty = existing.stockQty != null ? Math.min(qty, existing.stockQty) : qty\n106\t      const updated = { ...existing, qty: cappedQty }\n107\t      const { price } = getActiveTier(cappedQty, updated)\n108\t      next[listingId] = { ...updated, pricePerKg: price ?? updated.pricePerKg }\n109\t    }\n110\t    writeCart(next)\n111\t  }, [])\n112\t\n113\t  const removeItem = useCallback((listingId: string) => {\n114\t    const next = { ...readCart() }\n115\t    delete next[listingId]\n116\t    writeCart(next)\n117\t  }, [])\n118\t\n119\t  const clear = useCallback(() => writeCart({}), [])\n120\t\n121\t  const clearFarmer = useCallback((farmerId: string) => {\n122\t    const next = { ...readCart() }\n123\t    for (const key of Object.keys(next)) {\n124\t      if (next[key].farmerId === farmerId) delete next[key]\n125\t    }\n126\t    writeCart(next)\n127\t  }, [])\n128\t\n129\t  const items = Object.values(cart)\n130\t  const count = items.reduce((sum, i) => sum + i.qty, 0)\n131\t\n132\t  return { cart, items, count, addItem, setQty, removeItem, clear, clearFarmer }\n133\t}\n134\t\n135\texport function useConsumerInfo() {\n136\t  const [info, setInfo] = useState<ConsumerInfo>({ name: '', phone: '' })\n137\t\n138\t  useEffect(() => {\n139\t    if (typeof window === 'undefined') return\n140\t    try {\n141\t      const raw = localStorage.getItem(CONSUMER_KEY)\n142\t      if (raw) setInfo(JSON.parse(raw))\n143\t    } catch { /* ignore */ }\n144\t  }, [])\n145\t\n146\t  const save = useCallback((next: ConsumerInfo) => {\n147\t    setInfo(next)\n148\t    localStorage.setItem(CONSUMER_KEY, JSON.stringify(next))\n149\t  }, [])\n150\t\n151\t  return { info, save }\n152\t}\n153\t\n154\t/* ─── Cart FAB + Sheet ───────────────────────────────── */\n155\texport function CartFab() {\n156\t  const { items, count } = useCart()\n157\t  const [open, setOpen] = useState(false)\n158\t\n159\t  if (count === 0 && !open) return null\n160\t\n161\t  return (\n162\t    <>\n163\t      {!open && (\n164\t        <button\n165\t          onClick={() => setOpen(true)}\n166\t          className=\"fixed bottom-6 right-4 z-40 bg-green-700 active:bg-green-800 text-white rounded-full shadow-2xl flex items-center gap-2 pl-4 pr-5 py-3.5\"\n167\t          style={{ bottom: 'max(24px, env(safe-area-inset-bottom, 24px))' }}\n168\t          aria-label=\"View cart\"\n169\t        >\n170\t          <CartIcon />\n171\t          <span className=\"font-extrabold text-sm\">\n172\t            {count} {count === 1 ? 'item' : 'items'} / బుట్ట\n173\t          </span>\n174\t        </button>\n175\t      )}\n176\t      {open && (\n177\t        <CartSheet items={items} onClose={() => setOpen(false)} />\n178\t      )}\n179\t    </>\n180\t  )\n181\t}\n182\t\n183\t/* ─── Cart sheet ─────────────────────────────────────── */\n184\tfunction CartSheet({\n185\t  items,\n186\t  onClose,\n187\t}: {\n188\t  items: CartItem[]\n189\t  onClose: () => void\n190\t}) {\n191\t  const { setQty, removeItem, clear, clearFarmer } = useCart()\n192\t  const { info, save: saveInfo } = useConsumerInfo()\n193\t  const [name, setName] = useState('')\n194\t  const [phone, setPhone] = useState('')\n195\t  const [paymentMethod, setPaymentMethod] = useState<'cod' | 'upi'>('cod')\n196\t  const [sentFarmers, setSentFarmers] = useState<Record<string, boolean>>({})\n197\t  const [pickupByFarmer, setPickupByFarmer] = useState<Record<string, string>>({})\n198\t  const [pickupDayByFarmer, setPickupDayByFarmer] = useState<Record<string, string>>({})\n199\t  const [toast, setToast] = useState('')\n200\t  const [placingUpiOrder, setPlacingUpiOrder] = useState<string | null>(null)\n201\t  const [submittingResult, setSubmittingResult] = useState(false)\n202\t  const [paidDone, setPaidDone] = useState(false)\n203\t  // Live UPI IDs and QR codes fetched from DB — always up to date, overrides stale cart data\n204\t  const [liveUpiIds, setLiveUpiIds] = useState<Record<string, string>>({})\n205\t  const [liveQrUrls, setLiveQrUrls] = useState<Record<string, string>>({})\n206\t  const [showUpiAppFallback, setShowUpiAppFallback] = useState(false)\n207\t  const [utrNote, setUtrNote] = useState('')\n208\t  const [cashMode, setCashMode] = useState(false)\n209\t  const [switchingToCash, setSwitchingToCash] = useState(false)\n210\t\n211\t  type UpiPaymentState = {\n212\t    farmerName: string\n213\t    farmerVillage: string\n214\t    farmerPhone: string\n215\t    upiId: string\n216\t    qrCodeUrl?: string\n217\t    amount: number\n218\t    orderIds: string[]\n219\t    farmerId: string\n220\t    buyerName: string\n221\t    buyerPhone: string\n222\t    items: Array<{ name: string; variety?: string; emoji?: string; qty: number; unit?: string; pricePerKg?: number }>\n223\t    pickupLocation?: string\n224\t    pickupDay?: string\n225\t  }\n226\t  const [upiScreen, setUpiScreen] = useState<UpiPaymentState | null>(null)\n227\t\n228\t  const showToast = (msg: string) => {\n229\t    setToast(msg)\n230\t    setTimeout(() => setToast(''), 3000)\n231\t  }\n232\t\n233\t  // Fetch latest UPI IDs and QR codes for all farmers in cart when sheet opens\n234\t  useEffect(() => {\n235\t    const farmerIds = [...new Set(items.map((i) => i.farmerId).filter(Boolean))]\n236\t    if (farmerIds.length === 0) return\n237\t    supabase\n238\t      .from('farmers')\n239\t      .select('id, upi_id, upi_qr_code_url')\n240\t      .in('id', farmerIds)\n241\t      .then(({ data }) => {\n242\t        if (!data) return\n243\t        const upiMap: Record<string, string> = {}\n244\t        const qrMap: Record<string, string> = {}\n245\t        for (const f of data) {\n246\t          if (f.upi_id) upiMap[f.id] = f.upi_id\n247\t          if (f.upi_qr_code_url) qrMap[f.id] = f.upi_qr_code_url\n248\t        }\n249\t        setLiveUpiIds(upiMap)\n250\t        setLiveQrUrls(qrMap)\n251\t      })\n252\t  }, [items])\n253\t\n254\t  useEffect(() => {\n255\t    setName(info.name)\n256\t    setPhone(info.phone)\n257\t  }, [info])\n258\t\n259\t  // Group items by farmer\n260\t  const byFarmer = items.reduce<Record<string, CartItem[]>>((acc, item) => {\n261\t    (acc[item.farmerId] = acc[item.farmerId] ?? []).push(item)\n262\t    return acc\n263\t  }, {})\n264\t  const farmerGroups = Object.values(byFarmer)\n265\t\n266\t  const detailsMissing = !name.trim() || phone.replace(/\\D/g, '').length < 10\n267\t\n268\t  // COD flow: save order + open WhatsApp (existing behaviour)\n269\t  const handleCodOrderFarmer = (group: CartItem[]) => {\n270\t    if (detailsMissing) return\n271\t    saveInfo({ name: name.trim(), phone: phone.trim() })\n272\t\n273\t    const f = group[0]\n274\t    const lines = group.map((it) => {\n275\t      const unit = it.unit || 'kg'\n276\t      const price = it.pricePerKg ? ` @ ₹${it.pricePerKg}/${unit}` : ''\n277\t      return `• ${it.emoji ?? '🌿'} ${it.name}${it.variety ? ` (${it.variety})` : ''} — ${it.qty} ${unit}${price}`\n278\t    })\n279\t\n280\t    const selectedPickup = pickupByFarmer[f.farmerId]\n281\t    const selectedDay    = pickupDayByFarmer[f.farmerId]\n282\t    const pickupLine = selectedPickup\n283\t      ? `\\n\\n*Pickup location / పికప్ స్థలం:* ${selectedPickup} (${f.farmerVillage})`\n284\t      : `\\n\\n*Pickup from your farm / మీ పొలం నుండి పికప్* (${f.farmerVillage})`\n285\t    const dayLine = selectedDay ? `\\n*Pickup day / రోజు:* ${selectedDay}` : ''\n286\t\n287\t    const msg =\n288\t      `Hello ${f.farmerName} anna! 🙏\\n` +\n289\t      `I saw your produce on YourFamilyFarmer and would like to order:\\n\\n` +\n290\t      lines.join('\\n') +\n291\t      pickupLine +\n292\t      dayLine +\n293\t      `\\n\\n*Payment: Cash on Delivery / చెల్లింపు: నగదు డెలివరీ సమయంలో*\\n\\n` +\n294\t      `My name / నా పేరు: ${name.trim()}\\n` +\n295\t      `My WhatsApp / నా వాట్సాప్: +91 ${phone.replace(/\\D/g, '').slice(-10)}\\n\\n` +\n296\t      `Please share a good pickup time. Thank you! / పికప్ సమయం తెలియజేయండి, ధన్యవాదాలు 🌱`\n297\t\n298\t    const digits = f.farmerPhone.replace(/\\D/g, '').replace(/^0+/, '')\n299\t    const waPhone = digits.length === 10 ? `91${digits}` : digits\n300\t    const waUrl = `https://wa.me/${waPhone}?text=${encodeURIComponent(msg)}`\n301\t\n302\t    const buyerPhone = phone.replace(/\\D/g, '').slice(-10)\n303\t    for (const it of group) {\n304\t      const baseRow = {\n305\t        farmer_id: it.farmerId,\n306\t        produce_listing_id: it.listingId,\n307\t        produce_name: it.name,\n308\t        quantity: it.qty,\n309\t        unit: it.unit || 'kg',\n310\t        total_price: it.pricePerKg ? Math.round(it.pricePerKg * it.qty) : null,\n311\t        buyer_name: name.trim(),\n312\t        buyer_phone: buyerPhone,\n313\t        pickup_location: selectedPickup || null,\n314\t        status: 'pending',\n315\t      }\n316\t      supabase.from('orders').insert({ ...baseRow, payment_method: 'cod', payment_status: 'pending' })\n317\t        .then(async ({ error }) => {\n318\t          if (error?.message?.includes('payment_method') || error?.message?.includes('payment_status')) {\n319\t            const { error: err2 } = await supabase.from('orders').insert(baseRow)\n320\t            if (err2) console.error('[YFF] Order save failed:', err2.message)\n321\t          } else if (error) {\n322\t            console.error('[YFF] Order save failed:', error.message, error.details, error.hint)\n323\t          }\n324\t        })\n325\t    }\n326\t\n327\t    window.open(waUrl, '_blank', 'noopener,noreferrer')\n328\t    clearFarmer(f.farmerId)\n329\t    supabase.from('wa_clicks').insert({ farmer_id: f.farmerId }).then()\n330\t    setSentFarmers((s) => ({ ...s, [f.farmerId]: true }))\n331\t  }\n332\t\n333\t  // UPI flow: save orders, collect IDs, show payment screen\n334\t  const handleUpiOrderFarmer = async (group: CartItem[]) => {\n335\t    if (detailsMissing) return\n336\t    const f = group[0]\n337\t    const upiId = liveUpiIds[f.farmerId] ?? f.farmerUpiId ?? ''\n338\t    const qrCodeUrl = liveQrUrls[f.farmerId] ?? f.farmerQrCodeUrl\n339\t    if (!upiId && !qrCodeUrl) return\n340\t\n341\t    setUtrNote('')\n342\t    setShowUpiAppFallback(false)\n343\t    setCashMode(false)\n344\t    saveInfo({ name: name.trim(), phone: phone.trim() })\n345\t    setPlacingUpiOrder(f.farmerId)\n346\t\n347\t    const selectedPickup = pickupByFarmer[f.farmerId] || null\n348\t    const buyerPhone = phone.replace(/\\D/g, '').slice(-10)\n349\t    const orderIds: string[] = []\n350\t    let total = 0\n351\t\n352\t    for (const it of group) {\n353\t      const price = it.pricePerKg ? Math.round(it.pricePerKg * it.qty) : null\n354\t      if (price) total += price\n355\t    }\n356\t\n357\t    total = 0\n358\t\n359\t    for (const it of group) {\n360\t      const price = it.pricePerKg ? Math.round(it.pricePerKg * it.qty) : null\n361\t      if (price) total += price\n362\t      const { data, error } = await supabase.from('orders').insert({\n363\t        farmer_id: it.farmerId,\n364\t        produce_listing_id: it.listingId,\n365\t        produce_name: it.name,\n366\t        quantity: it.qty,\n367\t        unit: it.unit || 'kg',\n368\t        total_price: price,\n369\t        buyer_name: name.trim(),\n370\t        buyer_phone: buyerPhone,\n371\t        pickup_location: selectedPickup,\n372\t        status: 'pending',\n373\t        payment_method: 'upi',\n374\t        payment_status: 'pending',\n375\t      }).select('id').single()\n376\t\n377\t      if (!error && data) orderIds.push(data.id)\n378\t      else if (error) console.error('[YFF] UPI order save failed:', error.message)\n379\t    }\n380\t\n381\t    setPlacingUpiOrder(null)\n382\t    if (orderIds.length === 0) {\n383\t      showToast('Could not place order. Please try again.')\n384\t      return\n385\t    }\n386\t\n387\t    setUpiScreen({\n388\t      farmerName: f.farmerName,\n389\t      farmerVillage: f.farmerVillage,\n390\t      farmerPhone: f.farmerPhone,\n391\t      upiId,\n392\t      qrCodeUrl,\n393\t      amount: total,\n394\t      orderIds,\n395\t      farmerId: f.farmerId,\n396\t      buyerName: name.trim(),\n397\t      buyerPhone: buyerPhone,\n398\t      items: group.map((it) => ({\n399\t        name: it.name,\n400\t        variety: it.variety,\n401\t        emoji: it.emoji,\n402\t        qty: it.qty,\n403\t        unit: it.unit,\n404\t        pricePerKg: it.pricePerKg,\n405\t      })),\n406\t      pickupLocation: selectedPickup || undefined,\n407\t      pickupDay: pickupDayByFarmer[f.farmerId] || undefined,\n408\t    })\n409\t  }\n410\t\n411\t  const handlePaymentSuccess = async () => {\n412\t    if (!upiScreen) return\n413\t    setSubmittingResult(true)\n414\t    const updateData: Record<string, unknown> = { payment_status: 'pending_confirmation' }\n415\t    if (utrNote.trim()) updateData.utr_number = utrNote.trim()\n416\t    await Promise.all(\n417\t      upiScreen.orderIds.map((id) =>\n418\t        supabase.from('orders').update(updateData).eq('id', id)\n419\t      )\n420\t    )\n421\t    clearFarmer(upiScreen.farmerId)\n422\t    setSubmittingResult(false)\n423\t    setPaidDone(true)\n424\t\n425\t    // Notify farmer on WhatsApp (same as COD flow)\n426\t    const lines = upiScreen.items.map((it) => {\n427\t      const unit = it.unit || 'kg'\n428\t      const price = it.pricePerKg ? ` @ ₹${it.pricePerKg}/${unit}` : ''\n429\t      return `• ${it.emoji ?? '🌿'} ${it.name}${it.variety ? ` (${it.variety})` : ''} — ${it.qty} ${unit}${price}`\n430\t    })\n431\t    const pickupLine = upiScreen.pickupLocation\n432\t      ? `\\n\\n*Pickup location / పికప్ స్థలం:* ${upiScreen.pickupLocation} (${upiScreen.farmerVillage})`\n433\t      : `\\n\\n*Pickup from your farm / మీ పొలం నుండి పికప్* (${upiScreen.farmerVillage})`\n434\t    const dayLine = upiScreen.pickupDay ? `\\n*Pickup day / రోజు:* ${upiScreen.pickupDay}` : ''\n435\t    const utrLine = utrNote.trim() ? `\\nTransaction ref / రిఫరెన్స్: ${utrNote.trim()}` : ''\n436\t    const msg =\n437\t      `Hello ${upiScreen.farmerName} anna! 🙏\\n` +\n438\t      `New UPI order from YourFamilyFarmer:\\n\\n` +\n439\t      lines.join('\\n') +\n440\t      pickupLine +\n441\t      dayLine +\n442\t      `\\n\\n*Payment: UPI ₹${upiScreen.amount} — buyer says paid*\\n` +\n443\t      `చెల్లింపు: UPI ₹${upiScreen.amount} — కొనుగోలుదారు చెల్లించారు, మీ UPI యాప్ తనిఖీ చేయండి` +\n444\t      utrLine +\n445\t      `\\n\\nBuyer / కొనుగోలుదారు: ${upiScreen.buyerName}\\n` +\n446\t      `WhatsApp: +91 ${upiScreen.buyerPhone}\\n\\n` +\n447\t      `Please confirm pickup time. / పికప్ సమయం తెలియజేయండి, ధన్యవాదాలు 🌱`\n448\t    const digits = upiScreen.farmerPhone.replace(/\\D/g, '').replace(/^0+/, '')\n449\t    const waPhone = digits.length === 10 ? `91${digits}` : digits\n450\t    window.open(`https://wa.me/${waPhone}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener,noreferrer')\n451\t  }\n452\t\n453\t  const handleCashOnPickup = async () => {\n454\t    if (!upiScreen) return\n455\t    setSwitchingToCash(true)\n456\t    await Promise.all(\n457\t      upiScreen.orderIds.map((id) =>\n458\t        supabase.from('orders').update({ payment_method: 'cod', payment_status: 'pending' }).eq('id', id)\n459\t      )\n460\t    )\n461\t    clearFarmer(upiScreen.farmerId)\n462\t    setSwitchingToCash(false)\n463\t    setCashMode(true)\n464\t    setPaidDone(true)\n465\t  }\n466\t\n467\t  const handleOpenUpiApp = () => {\n468\t    setShowUpiAppFallback(false)\n469\t    window.location.href = 'upi://pay'\n470\t    const t = setTimeout(() => setShowUpiAppFallback(true), 2500)\n471\t    const cleanup = () => { clearTimeout(t); setShowUpiAppFallback(false) }\n472\t    window.addEventListener('blur', cleanup, { once: true })\n473\t  }\n474\t\n475\t  const handleDownloadQR = async () => {\n476\t    if (!upiScreen?.qrCodeUrl) return\n477\t    try {\n478\t      const response = await fetch(upiScreen.qrCodeUrl)\n479\t      const blob = await response.blob()\n480\t      const url = URL.createObjectURL(blob)\n481\t      const a = document.createElement('a')\n482\t      a.href = url\n483\t      a.download = `${upiScreen.farmerName.replace(/\\s+/g, '_')}_UPI_QR.png`\n484\t      document.body.appendChild(a)\n485\t      a.click()\n486\t      document.body.removeChild(a)\n487\t      URL.revokeObjectURL(url)\n488\t      showToast('QR saved! / గ్యాలరీకి సేవ్ అయింది')\n489\t    } catch {\n490\t      showToast('Could not save — please screenshot the QR')\n491\t    }\n492\t  }\n493\t\n494\t  // Success screen — shown after I Have Paid or Cash on Pickup\n495\t  if (upiScreen && paidDone) {\n496\t    return (\n497\t      <div className=\"fixed inset-0 z-50 bg-black/50 flex items-end justify-center\">\n498\t        <div className=\"bg-white w-full max-w-md rounded-t-3xl px-6 py-10 flex flex-col items-center text-center gap-4\">\n499\t          <div className={`w-16 h-16 rounded-full flex items-center justify-center text-3xl ${cashMode ? 'bg-amber-100' : 'bg-green-100'}`}>\n500\t            {cashMode ? '💵' : '✓'}\n501\t          </div>\n502\t          <div>\n503\t            <h2 className=\"font-extrabold text-gray-900 text-xl\">\n504\t              {cashMode ? 'Order placed!' : 'Payment recorded!'}\n505\t            </h2>\n506\t            <p className={`font-semibold mt-0.5 ${cashMode ? 'text-amber-700' : 'text-green-700'}`}>\n507\t              {cashMode ? 'Cash on Pickup / నగదు పికప్' : 'చెల్లింపు నమోదైంది!'}\n508\t            </p>\n509\t          </div>\n510\t          <div className=\"bg-gray-50 rounded-2xl px-5 py-4 w-full text-left space-y-1\">\n511\t            <p className=\"text-xs text-gray-500 font-medium\">{cashMode ? 'Order for' : 'Paid to'}</p>\n512\t            <p className=\"font-bold text-gray-900\">{upiScreen.farmerName}</p>\n513\t            <p className=\"text-xs text-gray-500\">{upiScreen.farmerVillage}</p>\n514\t            <p className=\"text-lg font-black text-green-900 mt-2\">₹{upiScreen.amount}</p>\n515\t          </div>\n516\t          {cashMode ? (\n517\t            <p className=\"text-sm text-gray-600 leading-snug\">\n518\t              Pay ₹{upiScreen.amount} in cash when you collect your order from the farmer.\n519\t            </p>\n520\t          ) : (\n521\t            <>\n522\t              <p className=\"text-sm text-gray-600 leading-snug\">\n523\t                Waiting for farmer confirmation / రైతు నిర్ధారణ కోసం వేచి ఉంది\n524\t              </p>\n525\t              <p className=\"text-xs text-gray-400 leading-snug\">\n526\t                The farmer will check their UPI app and confirm your payment.\n527\t              </p>\n528\t            </>\n529\t          )}\n530\t          <Link\n531\t            href=\"/consumer/orders\"\n532\t            className=\"w-full text-center text-sm font-semibold text-green-700 underline\"\n533\t          >\n534\t            Check order status / ఆర్డర్ స్థితి చూడండి\n535\t          </Link>\n536\t          <button\n537\t            onClick={onClose}\n538\t            className=\"w-full bg-green-700 text-white font-bold py-4 rounded-xl text-base active:bg-green-800\"\n539\t          >\n540\t            Done / మూసివేయి\n541\t          </button>\n542\t        </div>\n543\t      </div>\n544\t    )\n545\t  }\n546\t\n547\t  // Payment screen shown after placing an order\n548\t  if (upiScreen) {\n549\t    return (\n550\t      <div className=\"fixed inset-0 z-50 bg-black/50 flex items-end justify-center\">\n551\t        <div className=\"bg-white w-full max-w-md rounded-t-3xl max-h-[92vh] flex flex-col\">\n552\t          <div className=\"sticky top-0 bg-white flex items-center justify-between px-4 py-3 border-b border-gray-100 rounded-t-3xl\">\n553\t            <div>\n554\t              <h2 className=\"font-extrabold text-gray-900 text-lg\">Pay Farmer / రైతుకు చెల్లించండి</h2>\n555\t              <p className=\"text-xs text-gray-500\">Pay directly — no middleman</p>\n556\t            </div>\n557\t            <button onClick={onClose} className=\"text-gray-400 text-3xl leading-none p-1\">×</button>\n558\t          </div>\n559\t\n560\t          <div className=\"flex-1 overflow-y-auto px-4 py-5 space-y-4\">\n561\t            {/* Amount + farmer */}\n562\t            <div className=\"bg-green-50 rounded-2xl p-4 text-center\">\n563\t              <p className=\"text-sm font-bold text-green-700\">🧑‍🌾 {upiScreen.farmerName}</p>\n564\t              <p className=\"text-xs text-green-600 mt-0.5\">{upiScreen.farmerVillage}</p>\n565\t              <p className=\"text-4xl font-black text-green-900 mt-3\">₹{upiScreen.amount}</p>\n566\t              <p className=\"text-sm text-green-700 mt-1\">Total amount to pay</p>\n567\t            </div>\n568\t\n569\t            {/* QR code (if available) */}\n570\t            {upiScreen.qrCodeUrl && (\n571\t              <div className=\"bg-white border-2 border-gray-200 rounded-2xl p-4 flex flex-col items-center gap-2\">\n572\t                <p className=\"text-xs font-bold text-gray-600 uppercase tracking-wide\">Scan QR Code to Pay</p>\n573\t                {/* eslint-disable-next-line @next/next/no-img-element */}\n574\t                <img src={upiScreen.qrCodeUrl} alt=\"UPI QR Code\" className=\"w-48 h-48 object-contain rounded-xl\" />\n575\t                <p className=\"text-[11px] text-gray-500 text-center\">Open any UPI app → Scan QR / QR స్కాన్ చేయండి</p>\n576\t                <button\n577\t                  onClick={handleDownloadQR}\n578\t                  className=\"w-full border border-gray-300 text-gray-700 font-bold py-2.5 rounded-xl text-sm active:bg-gray-50 flex items-center justify-center gap-1.5 mt-1\"\n579\t                >\n580\t                  <span>⬇️</span> Save QR to Gallery / గ్యాలరీకి సేవ్ చేయండి\n581\t                </button>\n582\t              </div>\n583\t            )}\n584\t\n585\t            {/* UPI pay instructions */}\n586\t            {upiScreen.upiId && (\n587\t              <div className=\"bg-blue-50 border border-blue-200 rounded-2xl px-4 py-4 space-y-3\">\n588\t                <p className=\"text-xs font-extrabold text-blue-800 uppercase tracking-wide\">\n589\t                  How to pay / చెల్లింపు విధానం\n590\t                </p>\n591\t\n592\t                {/* Steps */}\n593\t                <ol className=\"space-y-2.5\">\n594\t                  <li className=\"flex gap-3 items-start\">\n595\t                    <span className=\"flex-shrink-0 w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center mt-0.5\">1</span>\n596\t                    <div>\n597\t                      <p className=\"text-sm font-semibold text-gray-900\">Copy the UPI ID below</p>\n598\t                      <p className=\"text-xs text-gray-500\">క్రింద ఉన్న UPI ID కాపీ చేయండి</p>\n599\t                    </div>\n600\t                  </li>\n601\t                  <li className=\"flex gap-3 items-start\">\n602\t                    <span className=\"flex-shrink-0 w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center mt-0.5\">2</span>\n603\t                    <div>\n604\t                      <p className=\"text-sm font-semibold text-gray-900\">Open your UPI app (PhonePe / GPay / Paytm)</p>\n605\t                      <p className=\"text-xs text-gray-500\">మీ UPI యాప్ తెరవండి</p>\n606\t                    </div>\n607\t                  </li>\n608\t                  <li className=\"flex gap-3 items-start\">\n609\t                    <span className=\"flex-shrink-0 w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center mt-0.5\">3</span>\n610\t                    <div>\n611\t                      <p className=\"text-sm font-semibold text-gray-900\">Tap &quot;Pay&quot; → &quot;Enter UPI ID&quot; → paste the ID</p>\n612\t                      <p className=\"text-xs text-gray-500\">&quot;Pay&quot; నొక్కి → &quot;UPI ID&quot; నమోదు చేసి → పేస్ట్ చేయండి</p>\n613\t                    </div>\n614\t                  </li>\n615\t                  <li className=\"flex gap-3 items-start\">\n616\t                    <span className=\"flex-shrink-0 w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center mt-0.5\">4</span>\n617\t                    <div>\n618\t                      <p className=\"text-sm font-semibold text-gray-900\">Enter ₹{upiScreen.amount} and complete payment</p>\n619\t                      <p className=\"text-xs text-gray-500\">₹{upiScreen.amount} నమోదు చేసి చెల్లింపు పూర్తి చేయండి</p>\n620\t                    </div>\n621\t                  </li>\n622\t                </ol>\n623\t\n624\t                {/* UPI ID copy row */}\n625\t                <div className=\"bg-white border border-blue-200 rounded-xl px-4 py-3 flex items-center gap-3\">\n626\t                  <div className=\"flex-1 min-w-0\">\n627\t                    <p className=\"text-[10px] font-bold text-gray-500 mb-0.5 uppercase tracking-wide\">UPI ID</p>\n628\t                    <p className=\"font-mono text-sm font-bold text-gray-900 break-all\">{upiScreen.upiId}</p>\n629\t                  </div>\n630\t                  <button\n631\t                    onClick={() => {\n632\t                      navigator.clipboard.writeText(upiScreen.upiId).catch(() => {})\n633\t                      showToast('UPI ID copied! / కాపీ అయింది')\n634\t                    }}\n635\t                    className=\"flex-shrink-0 bg-blue-600 text-white font-bold px-4 py-2.5 rounded-xl text-xs active:bg-blue-700\"\n636\t                  >\n637\t                    Copy / కాపీ\n638\t                  </button>\n639\t                </div>\n640\t\n641\t                {/* Open UPI App button */}\n642\t                <button\n643\t                  onClick={handleOpenUpiApp}\n644\t                  className=\"w-full bg-blue-600 text-white font-bold py-4 rounded-xl text-base active:bg-blue-700 flex items-center justify-center gap-2\"\n645\t                >\n646\t                  📲 Open UPI App / UPI యాప్ తెరవండి\n647\t                </button>\n648\t\n649\t                {showUpiAppFallback && (\n650\t                  <p className=\"text-xs text-blue-700 text-center\">\n651\t                    App didn&apos;t open? Copy the UPI ID and pay manually in PhonePe, GPay, or Paytm.<br />\n652\t                    యాప్ తెరుచుకోలేదా? UPI ID కాపీ చేసి మాన్యువల్‌గా చెల్లించండి.\n653\t                  </p>\n654\t                )}\n655\t              </div>\n656\t            )}\n657\t\n658\t            {/* Cash on Pickup option */}\n659\t            <div className=\"bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 space-y-2\">\n660\t              <p className=\"text-sm font-bold text-gray-700\">💵 Prefer Cash on Pickup? / నగదు చెల్లించాలా?</p>\n661\t              <p className=\"text-xs text-gray-500\">Pay cash directly to the farmer when you collect your order.</p>\n662\t              <button\n663\t                onClick={handleCashOnPickup}\n664\t                disabled={switchingToCash || submittingResult}\n665\t                className=\"w-full border-2 border-gray-300 text-gray-700 font-bold py-3 rounded-xl text-sm active:bg-gray-100 disabled:opacity-50\"\n666\t              >\n667\t                {switchingToCash ? 'Switching... / మారుతోంది' : 'Switch to Cash on Pickup / నగదు పికప్‌కు మారండి'}\n668\t              </button>\n669\t            </div>\n670\t\n671\t            {/* Optional transaction note */}\n672\t            <div>\n673\t              <label className=\"text-xs font-bold text-gray-600 uppercase tracking-wide block mb-1.5\">\n674\t                Transaction note (optional) / లావాదేవీ నోట్\n675\t              </label>\n676\t              <input\n677\t                type=\"text\"\n678\t                inputMode=\"text\"\n679\t                placeholder=\"e.g. GPay ref 123456\"\n680\t                value={utrNote}\n681\t                onChange={(e) => setUtrNote(e.target.value)}\n682\t                className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-base focus:border-green-500 focus:outline-none\"\n683\t              />\n684\t            </div>\n685\t\n686\t            {/* I Have Paid */}\n687\t            <button\n688\t              onClick={handlePaymentSuccess}\n689\t              disabled={submittingResult || switchingToCash}\n690\t              className=\"w-full bg-green-700 text-white font-bold py-4 rounded-xl text-base disabled:opacity-50 active:bg-green-800\"\n691\t            >\n692\t              {submittingResult ? 'Saving...' : '✓ I Have Paid / చెల్లించాను'}\n693\t            </button>\n694\t          </div>\n695\t        </div>\n696\t      </div>\n697\t    )\n698\t  }\n699\t\n700\t  return (\n701\t    <div className=\"fixed inset-0 z-50 bg-black/50 flex items-end justify-center\">\n702\t      {/* Toast */}\n703\t      {toast && (\n704\t        <div className=\"fixed top-5 left-0 right-0 flex justify-center z-[60] pointer-events-none px-4\">\n705\t          <div className=\"bg-gray-900 text-white text-sm font-semibold px-5 py-2.5 rounded-full shadow-xl\">\n706\t            {toast}\n707\t          </div>\n708\t        </div>\n709\t      )}\n710\t      <div className=\"bg-white w-full max-w-md rounded-t-3xl max-h-[92vh] flex flex-col\">\n711\t        {/* Header */}\n712\t        <div className=\"sticky top-0 bg-white flex items-center justify-between px-4 py-3 border-b border-gray-100 rounded-t-3xl\">\n713\t          <div>\n714\t            <h2 className=\"font-extrabold text-gray-900 text-lg\">Your cart / మీ బుట్ట</h2>\n715\t            <p className=\"text-xs text-gray-500\">\n716\t              Pickup from farm only / పొలం నుండి పికప్ మాత్రమే\n717\t            </p>\n718\t          </div>\n719\t          <button onClick={onClose} className=\"text-gray-400 text-3xl leading-none p-1\">×</button>\n720\t        </div>\n721\t\n722\t        {/* Body */}\n723\t        <div className=\"flex-1 overflow-y-auto px-4 py-4 space-y-5\">\n724\t          {items.length === 0 ? (\n725\t            <div className=\"text-center py-14 text-gray-400\">\n726\t              <div className=\"text-5xl mb-3\">🛒</div>\n727\t              <p className=\"font-semibold\">Your cart is empty</p>\n728\t              <p className=\"text-sm mt-1\">బుట్ట ఖాళీగా ఉంది</p>\n729\t            </div>\n730\t          ) : (\n731\t            <>\n732\t              {/* Consumer details */}\n733\t              <div className=\"bg-gray-50 rounded-2xl p-4 space-y-3\">\n734\t                <div>\n735\t                  <label className=\"text-xs font-bold text-gray-700 uppercase tracking-wide block mb-1\">\n736\t                    Your name / మీ పేరు\n737\t                  </label>\n738\t                  <input\n739\t                    type=\"text\"\n740\t                    value={name}\n741\t                    onChange={(e) => setName(e.target.value)}\n742\t                    placeholder=\"Ramya\"\n743\t                    className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-base focus:border-green-500 focus:outline-none bg-white\"\n744\t                  />\n745\t                </div>\n746\t                <div>\n747\t                  <label className=\"text-xs font-bold text-gray-700 uppercase tracking-wide block mb-1\">\n748\t                    Your WhatsApp number / వాట్సాప్ నంబర్\n749\t                  </label>\n750\t                  <div className=\"flex gap-2\">\n751\t                    <span className=\"flex items-center px-3 bg-white border border-gray-200 rounded-xl text-sm text-gray-600 font-medium\">\n752\t                      +91\n753\t                    </span>\n754\t                    <input\n755\t                      type=\"tel\"\n756\t                      inputMode=\"numeric\"\n757\t                      value={phone}\n758\t                      onChange={(e) => setPhone(e.target.value)}\n759\t                      placeholder=\"9876543210\"\n760\t                      maxLength={10}\n761\t                      className=\"flex-1 border border-gray-200 rounded-xl px-4 py-3 text-base focus:border-green-500 focus:outline-none bg-white\"\n762\t                    />\n763\t                  </div>\n764\t                </div>\n765\t                <p className=\"text-[11px] text-gray-500 leading-snug\">\n766\t                  The farmer needs this to confirm pickup time.<br />\n767\t                  పికప్ సమయం కోసం రైతుకు ఇది అవసరం.\n768\t                </p>\n769\t              </div>\n770\t\n771\t              {/* Payment method selection */}\n772\t              <div className=\"bg-gray-50 rounded-2xl p-4 space-y-2\">\n773\t                <p className=\"text-xs font-bold text-gray-700 uppercase tracking-wide\">\n774\t                  Payment method / చెల్లింపు విధానం\n775\t                </p>\n776\t                <button\n777\t                  onClick={() => setPaymentMethod('cod')}\n778\t                  className={`w-full flex items-center justify-between px-4 py-3 rounded-xl border-2 text-sm font-bold transition-colors ${\n779\t                    paymentMethod === 'cod'\n780\t                      ? 'border-green-600 bg-green-50 text-green-900'\n781\t                      : 'border-gray-200 bg-white text-gray-700'\n782\t                  }`}\n783\t                >\n784\t                  <span className=\"flex items-center gap-2\">\n785\t                    <span className=\"text-base\">💵</span>\n786\t                    Cash on Delivery / నగదు చెల్లింపు\n787\t                  </span>\n788\t                  {paymentMethod === 'cod' && (\n789\t                    <span className=\"text-green-600 text-base\">✓</span>\n790\t                  )}\n791\t                </button>\n792\t                <button\n793\t                  onClick={() => setPaymentMethod('upi')}\n794\t                  className={`w-full flex items-center justify-between px-4 py-3 rounded-xl border-2 text-sm font-bold transition-colors ${\n795\t                    paymentMethod === 'upi'\n796\t                      ? 'border-blue-600 bg-blue-50 text-blue-900'\n797\t                      : 'border-gray-200 bg-white text-gray-700'\n798\t                  }`}\n799\t                >\n800\t                  <span className=\"flex items-center gap-2\">\n801\t                    <span className=\"text-base\">📲</span>\n802\t                    UPI Payment / యూపీఐ చెల్లింపు\n803\t                  </span>\n804\t                  {paymentMethod === 'upi' && (\n805\t                    <span className=\"text-blue-600 text-base\">✓</span>\n806\t                  )}\n807\t                </button>\n808\t              </div>\n809\t\n810\t              {/* Farmer groups */}\n811\t              {farmerGroups.map((group) => {\n812\t                const f = group[0]\n813\t                const total = group.reduce(\n814\t                  (s, it) => s + (it.pricePerKg ?? 0) * it.qty,\n815\t                  0,\n816\t                )\n817\t                const sent = sentFarmers[f.farmerId]\n818\t                return (\n819\t                  <div\n820\t                    key={f.farmerId}\n821\t                    className=\"border border-gray-200 rounded-2xl overflow-hidden\"\n822\t                  >\n823\t                    <div className=\"bg-green-50 px-4 py-3 border-b border-green-100 flex items-center justify-between\">\n824\t                      <div className=\"min-w-0\">\n825\t                        <p className=\"font-extrabold text-green-900 truncate\">\n826\t                          🧑‍🌾 {f.farmerName}\n827\t                        </p>\n828\t                        <p className=\"text-xs text-green-700\">📍 {f.farmerVillage}</p>\n829\t                      </div>\n830\t                      <span className=\"text-[10px] font-bold bg-green-700 text-white px-2 py-1 rounded-full whitespace-nowrap\">\n831\t                        Pickup\n832\t                      </span>\n833\t                    </div>\n834\t\n835\t                    <div className=\"p-3 space-y-2\">\n836\t                      {group.map((it) => (\n837\t                        <div key={it.listingId} className=\"flex items-center gap-3\">\n838\t                          <div className=\"w-11 h-11 rounded-xl bg-gray-50 flex items-center justify-center text-xl flex-shrink-0\">\n839\t                            {it.emoji ?? '🌿'}\n840\t                          </div>\n841\t                          <div className=\"flex-1 min-w-0\">\n842\t                            <p className=\"font-semibold text-sm text-gray-900 truncate\">\n843\t                              {it.name}\n844\t                            </p>\n845\t                            {it.pricePerKg && (\n846\t                              <p className=\"text-xs text-gray-500\">₹{it.pricePerKg}/{it.unit || 'kg'}</p>\n847\t                            )}\n848\t                            {getActiveTier(it.qty, it).isDiscount && (\n849\t                              <p className=\"text-[10px] font-semibold text-green-700 mt-0.5\">\n850\t                                Bulk price applied / బల్క్ ధర వర్తింపు\n851\t                              </p>\n852\t                            )}\n853\t                          </div>\n854\t                          <QtyStepper\n855\t                            qty={it.qty}\n856\t                            maxQty={it.stockQty}\n857\t                            onDec={() => setQty(it.listingId, it.qty - 1)}\n858\t                            onInc={() => {\n859\t                              if (it.stockQty != null && it.qty >= it.stockQty) {\n860\t                                showToast('No more stock available / స్టాక్ అయిపోయింది')\n861\t                                return\n862\t                              }\n863\t                              setQty(it.listingId, it.qty + 1)\n864\t                            }}\n865\t                          />\n866\t                          <button\n867\t                            onClick={() => removeItem(it.listingId)}\n868\t                            className=\"text-gray-300 text-xl px-1\"\n869\t                            aria-label=\"Remove\"\n870\t                          >\n871\t                            ×\n872\t                          </button>\n873\t                        </div>\n874\t                      ))}\n875\t\n876\t                      {total > 0 && (\n877\t                        <div className=\"flex items-center justify-between pt-2 border-t border-gray-100 mt-2\">\n878\t                          <span className=\"text-xs text-gray-500\">Estimated total / మొత్తం</span>\n879\t                          <span className=\"font-extrabold text-gray-900\">\n880\t                            ₹{total}\n881\t                          </span>\n882\t                        </div>\n883\t                      )}\n884\t\n885\t                      {f.farmerPickupLocations && f.farmerPickupLocations.length > 0 && (\n886\t                        <div className=\"pt-2\">\n887\t                          <label className=\"text-[11px] font-bold text-gray-600 uppercase tracking-wide block mb-1\">\n888\t                            Pickup location / పికప్ స్థలం\n889\t                          </label>\n890\t                          <select\n891\t                            value={pickupByFarmer[f.farmerId] ?? ''}\n892\t                            onChange={(e) =>\n893\t                              setPickupByFarmer((prev) => ({\n894\t                                ...prev,\n895\t                                [f.farmerId]: e.target.value,\n896\t                              }))\n897\t                            }\n898\t                            className=\"w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm bg-white focus:border-green-500 focus:outline-none\"\n899\t                          >\n900\t                            <option value=\"\">Select a pickup point / స్థలం ఎంచుకోండి</option>\n901\t                            {f.farmerPickupLocations.map((loc) => (\n902\t                              <option key={loc} value={loc}>{loc}</option>\n903\t                            ))}\n904\t                          </select>\n905\t                        </div>\n906\t                      )}\n907\t\n908\t                      {f.farmerPickupSlots && f.farmerPickupSlots.days.length > 0 && (\n909\t                        <div className=\"pt-2\">\n910\t                          <label className=\"text-[11px] font-bold text-gray-600 uppercase tracking-wide block mb-1\">\n911\t                            Pickup day / పికప్ రోజు\n912\t                          </label>\n913\t                          <p className=\"text-[11px] text-green-700 font-medium mb-1.5\">\n914\t                            Available {f.farmerPickupSlots.time_from}–{f.farmerPickupSlots.time_to}\n915\t                          </p>\n916\t                          <select\n917\t                            value={pickupDayByFarmer[f.farmerId] ?? ''}\n918\t                            onChange={(e) =>\n919\t                              setPickupDayByFarmer((prev) => ({\n920\t                                ...prev,\n921\t                                [f.farmerId]: e.target.value,\n922\t                              }))\n923\t                            }\n924\t                            className=\"w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm bg-white focus:border-green-500 focus:outline-none\"\n925\t                          >\n926\t                            <option value=\"\">Select a day / రోజు ఎంచుకోండి</option>\n927\t                            {f.farmerPickupSlots.days.map((day) => (\n928\t                              <option key={day} value={day}>{day}</option>\n929\t                            ))}\n930\t                          </select>\n931\t                        </div>\n932\t                      )}\n933\t\n934\t                      {paymentMethod === 'upi' ? (\n935\t                        (liveUpiIds[f.farmerId] || f.farmerUpiId || liveQrUrls[f.farmerId]) ? (\n936\t                          <button\n937\t                            onClick={() => handleUpiOrderFarmer(group)}\n938\t                            disabled={detailsMissing || placingUpiOrder === f.farmerId}\n939\t                            className={`mt-1 w-full font-bold py-3.5 rounded-xl text-sm flex items-center justify-center gap-2 ${\n940\t                              detailsMissing\n941\t                                ? 'bg-gray-200 text-gray-500'\n942\t                                : 'bg-blue-600 text-white active:bg-blue-700 disabled:opacity-50'\n943\t                            }`}\n944\t                          >\n945\t                            {placingUpiOrder === f.farmerId\n946\t                              ? 'Placing order...'\n947\t                              : `📲 Order & Pay ₹${Math.round(group.reduce((s, it) => s + (it.pricePerKg ?? 0) * it.qty, 0))}`}\n948\t                          </button>\n949\t                        ) : (\n950\t                          <div className=\"mt-1 space-y-2\">\n951\t                            <p className=\"text-[11px] text-amber-700 bg-amber-50 rounded-xl px-3 py-2 text-center\">\n952\t                              ⚠️ This farmer hasn&apos;t set up UPI yet. Using Cash on Pickup.\n953\t                            </p>\n954\t                            <button\n955\t                              onClick={() => handleCodOrderFarmer(group)}\n956\t                              disabled={detailsMissing}\n957\t                              className={`w-full font-bold py-3.5 rounded-xl text-sm flex items-center justify-center gap-2 ${\n958\t                                sent\n959\t                                  ? 'bg-green-100 text-green-800'\n960\t                                  : detailsMissing\n961\t                                    ? 'bg-gray-200 text-gray-500'\n962\t                                    : 'bg-green-700 text-white active:bg-green-800'\n963\t                              }`}\n964\t                            >\n965\t                              {sent ? <>✓ Order sent</> : <><WhatsAppIcon /> Cash on Pickup</>}\n966\t                            </button>\n967\t                          </div>\n968\t                        )\n969\t                      ) : (\n970\t                        <button\n971\t                          onClick={() => handleCodOrderFarmer(group)}\n972\t                          disabled={detailsMissing}\n973\t                          className={`mt-1 w-full font-bold py-3.5 rounded-xl text-sm flex items-center justify-center gap-2 ${\n974\t                            sent\n975\t                              ? 'bg-green-100 text-green-800'\n976\t                              : detailsMissing\n977\t                                ? 'bg-gray-200 text-gray-500'\n978\t                                : 'bg-green-700 text-white active:bg-green-800'\n979\t                          }`}\n980\t                        >\n981\t                          {sent ? (\n982\t                            <>✓ Order sent — tap to resend</>\n983\t                          ) : (\n984\t                            <>\n985\t                              <WhatsAppIcon />\n986\t                              Send to {f.farmerName.split(' ')[0] || 'farmer'} / వాట్సాప్\n987\t                            </>\n988\t                          )}\n989\t                        </button>\n990\t                      )}\n991\t                    </div>\n992\t                  </div>\n993\t                )\n994\t              })}\n995\t\n996\t              {farmerGroups.length > 1 && (\n997\t                <p className=\"text-xs text-gray-500 text-center px-4 leading-snug\">\n998\t                  One WhatsApp chat opens per farmer, since each farm handles its own pickup.<br />\n999\t                  ప్రతి రైతుకు ప్రత్యేక వాట్సాప్ చాట్ తెరుచుకుంటుంది.\n1000\t                </p>\n1001\t              )}\n1002\t\n1003\t              <button\n1004\t                onClick={clear}\n1005\t                className=\"w-full text-sm text-gray-500 underline pt-2\"\n1006\t              >\n1007\t                Clear cart / బుట్ట ఖాళీ చేయండి\n1008\t              </button>\n1009\t            </>\n1010\t          )}\n1011\t        </div>\n1012\t      </div>\n1013\t    </div>\n1014\t  )\n1015\t}\n1016\t\n1017\tfunction QtyStepper({\n1018\t  qty,\n1019\t  onDec,\n1020\t  onInc,\n1021\t  maxQty,\n1022\t}: {\n1023\t  qty: number\n1024\t  onDec: () => void\n1025\t  onInc: () => void\n1026\t  maxQty?: number\n1027\t}) {\n1028\t  const atMax = maxQty != null && qty >= maxQty\n1029\t  return (\n1030\t    <div className=\"flex items-center border border-gray-200 rounded-full\">\n1031\t      <button\n1032\t        onClick={onDec}\n1033\t        className=\"w-8 h-8 text-lg text-gray-700 flex items-center justify-center active:bg-gray-100 rounded-l-full\"\n1034\t        aria-label=\"Decrease\"\n1035\t      >\n1036\t        −\n1037\t      </button>\n1038\t      <span className=\"w-10 text-center font-bold text-sm text-gray-900\">\n1039\t        {qty}\n1040\t      </span>\n1041\t      <button\n1042\t        onClick={onInc}\n1043\t        disabled={atMax}\n1044\t        className={`w-8 h-8 text-lg flex items-center justify-center rounded-r-full ${\n1045\t          atMax\n1046\t            ? 'text-gray-300 cursor-not-allowed'\n1047\t            : 'text-gray-700 active:bg-gray-100'\n1048\t        }`}\n1049\t        aria-label=\"Increase\"\n1050\t      >\n1051\t        +\n1052\t      </button>\n1053\t    </div>\n1054\t  )\n1055\t}\n1056\t\n1057\tfunction CartIcon() {\n1058\t  return (\n1059\t    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n1060\t      <circle cx=\"9\" cy=\"21\" r=\"1\" />\n1061\t      <circle cx=\"20\" cy=\"21\" r=\"1\" />\n1062\t      <path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\" />\n1063\t    </svg>\n1064\t  )\n1065\t}\n1066\t\n1067\tfunction WhatsAppIcon() {\n1068\t  return (\n1069\t    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n1070\t      <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\" />\n1071\t    </svg>\n1072\t  )\n1073\t}\n1074\t"}]},"uuid":"58714668-a8bb-4c31-8b91-fe8ada66fcae","timestamp":"2026-05-05T08:49:30.094Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/components/consumer/Cart.tsx","content":"'use client'\n\nimport { useEffect, useState, useCallback } from 'react'\nimport Link from 'next/link'\nimport { supabase } from '@/lib/supabase'\n\ntype PickupSlots = {\n  days: string[]\n  time_from: string\n  time_to: string\n}\n\nexport type CartItem = {\n  listingId: string\n  qty: number\n  name: string\n  variety?: string\n  emoji?: string\n  pricePerKg?: number\n  priceTier1Qty?: number\n  priceTier1Price?: number\n  priceTier2Qty?: number\n  priceTier2Price?: number\n  priceTier3Price?: number\n  unit?: string\n  stockQty?: number\n  farmerId: string\n  farmerName: string\n  farmerPhone: string\n  farmerVillage: string\n  farmerSlug: string\n  farmerPickupLocations?: string[]\n  farmerPickupSlots?: PickupSlots | null\n  farmerUpiId?: string\n  farmerQrCodeUrl?: string\n}\n\nexport type CartState = Record<string, CartItem>\n\nexport type ConsumerInfo = { name: string; phone: string }\n\nconst CART_KEY = 'yff_cart_v1'\nconst CONSUMER_KEY = 'REDACTED'\nconst CART_EVENT = 'yff:cart-change'\n\nconst readCart = (): CartState => {\n  if (typeof window === 'undefined') return {}\n  try {\n    const raw = localStorage.getItem(CART_KEY)\n    return raw ? (JSON.parse(raw) as CartState) : {}\n  } catch {\n    return {}\n  }\n}\n\nconst writeCart = (next: CartState) => {\n  localStorage.setItem(CART_KEY, JSON.stringify(next))\n  window.dispatchEvent(new Event(CART_EVENT))\n}\n\nfunction getActiveTier(qty: number, item: CartItem): { price?: number; isDiscount: boolean } {\n  const { priceTier1Qty, priceTier1Price, priceTier2Qty, priceTier2Price, priceTier3Price } = item\n  if (priceTier1Qty == null || priceTier1Price == null)\n    return { price: item.pricePerKg, isDiscount: false }\n  if (qty <= priceTier1Qty)\n    return { price: priceTier1Price, isDiscount: false }\n  if (priceTier2Qty != null && priceTier2Price != null) {\n    if (qty <= priceTier2Qty) return { price: priceTier2Price, isDiscount: true }\n    return { price: priceTier3Price ?? priceTier2Price, isDiscount: true }\n  }\n  if (priceTier3Price != null) return { price: priceTier3Price, isDiscount: true }\n  return { price: priceTier1Price, isDiscount: false }\n}\n\nexport function useCart() {\n  const [cart, setCart] = useState<CartState>({})\n\n  useEffect(() => {\n    setCart(readCart())\n    const sync = () => setCart(readCart())\n    window.addEventListener(CART_EVENT, sync)\n    window.addEventListener('storage', sync)\n    return () => {\n      window.removeEventListener(CART_EVENT, sync)\n      window.removeEventListener('storage', sync)\n    }\n  }, [])\n\n  const addItem = useCallback((item: Omit<CartItem, 'qty'>, qty = 1) => {\n    const next = { ...readCart() }\n    const existing = next[item.listingId]\n    const rawQty = Math.max(1, (existing?.qty ?? 0) + qty)\n    const newQty = item.stockQty != null ? Math.min(rawQty, item.stockQty) : rawQty\n    const merged = { ...item, qty: newQty }\n    const { price } = getActiveTier(newQty, merged)\n    next[item.listingId] = { ...merged, pricePerKg: price ?? item.pricePerKg }\n    writeCart(next)\n  }, [])\n\n  const setQty = useCallback((listingId: string, qty: number) => {\n    const next = { ...readCart() }\n    if (qty <= 0) delete next[listingId]\n    else if (next[listingId]) {\n      const existing = next[listingId]\n      const cappedQty = existing.stockQty != null ? Math.min(qty, existing.stockQty) : qty\n      const updated = { ...existing, qty: cappedQty }\n      const { price } = getActiveTier(cappedQty, updated)\n      next[listingId] = { ...updated, pricePerKg: price ?? updated.pricePerKg }\n    }\n    writeCart(next)\n  }, [])\n\n  const removeItem = useCallback((listingId: string) => {\n    const next = { ...readCart() }\n    delete next[listingId]\n    writeCart(next)\n  }, [])\n\n  const clear = useCallback(() => writeCart({}), [])\n\n  const clearFarmer = useCallback((farmerId: string) => {\n    const next = { ...readCart() }\n    for (const key of Object.keys(next)) {\n      if (next[key].farmerId === farmerId) delete next[key]\n    }\n    writeCart(next)\n  }, [])\n\n  const items = Object.values(cart)\n  const count = items.reduce((sum, i) => sum + i.qty, 0)\n\n  return { cart, items, count, addItem, setQty, removeItem, clear, clearFarmer }\n}\n\nexport function useConsumerInfo() {\n  const [info, setInfo] = useState<ConsumerInfo>({ name: '', phone: '' })\n\n  useEffect(() => {\n    if (typeof window === 'undefined') return\n    try {\n      const raw = localStorage.getItem(CONSUMER_KEY)\n      if (raw) setInfo(JSON.parse(raw))\n    } catch { /* ignore */ }\n  }, [])\n\n  const save = useCallback((next: ConsumerInfo) => {\n    setInfo(next)\n    localStorage.setItem(CONSUMER_KEY, JSON.stringify(next))\n  }, [])\n\n  return { info, save }\n}\n\n/* ─── Cart FAB + Sheet ───────────────────────────────── */\nexport function CartFab() {\n  const { items, count } = useCart()\n  const [open, setOpen] = useState(false)\n\n  if (count === 0 && !open) return null\n\n  return (\n    <>\n      {!open && (\n        <button\n          onClick={() => setOpen(true)}\n          className=\"fixed bottom-6 right-4 z-40 bg-green-700 active:bg-green-800 text-white rounded-full shadow-2xl flex items-center gap-2 pl-4 pr-5 py-3.5\"\n          style={{ bottom: 'max(24px, env(safe-area-inset-bottom, 24px))' }}\n          aria-label=\"View cart\"\n        >\n          <CartIcon />\n          <span className=\"font-extrabold text-sm\">\n            {count} {count === 1 ? 'item' : 'items'} / బుట్ట\n          </span>\n        </button>\n      )}\n      {open && (\n        <CartSheet items={items} onClose={() => setOpen(false)} />\n      )}\n    </>\n  )\n}\n\n/* ─── Cart sheet ─────────────────────────────────────── */\nfunction CartSheet({\n  items,\n  onClose,\n}: {\n  items: CartItem[]\n  onClose: () => void\n}) {\n  const { setQty, removeItem, clear, clearFarmer } = useCart()\n  const { info, save: saveInfo } = useConsumerInfo()\n  const [name, setName] = useState('')\n  const [phone, setPhone] = useState('')\n  const [paymentMethod, setPaymentMethod] = useState<'cod' | 'upi'>('cod')\n  const [sentFarmers, setSentFarmers] = useState<Record<string, boolean>>({})\n  const [pickupByFarmer, setPickupByFarmer] = useState<Record<string, string>>({})\n  const [pickupDayByFarmer, setPickupDayByFarmer] = useState<Record<string, string>>({})\n  const [toast, setToast] = useState('')\n  const [placingUpiOrder, setPlacingUpiOrder] = useState<string | null>(null)\n  const [submittingResult, setSubmittingResult] = useState(false)\n  const [paidDone, setPaidDone] = useState(false)\n  // Live UPI IDs and QR codes fetched from DB — always up to date, overrides stale cart data\n  const [liveUpiIds, setLiveUpiIds] = useState<Record<string, string>>({})\n  const [liveQrUrls, setLiveQrUrls] = useState<Record<string, string>>({})\n  const [showUpiAppFallback, setShowUpiAppFallback] = useState(false)\n  const [utrNote, setUtrNote] = useState('')\n  const [cashMode, setCashMode] = useState(false)\n  const [switchingToCash, setSwitchingToCash] = useState(false)\n\n  type UpiPaymentState = {\n    farmerName: string\n    farmerVillage: string\n    farmerPhone: string\n    upiId: string\n    qrCodeUrl?: string\n    amount: number\n    orderIds: string[]\n    farmerId: string\n    buyerName: string\n    buyerPhone: string\n    items: Array<{ name: string; variety?: string; emoji?: string; qty: number; unit?: string; pricePerKg?: number }>\n    pickupLocation?: string\n    pickupDay?: string\n  }\n  const [upiScreen, setUpiScreen] = useState<UpiPaymentState | null>(null)\n\n  const showToast = (msg: string) => {\n    setToast(msg)\n    setTimeout(() => setToast(''), 3000)\n  }\n\n  // Fetch latest UPI IDs and QR codes for all farmers in cart when sheet opens\n  useEffect(() => {\n    const farmerIds = [...new Set(items.map((i) => i.farmerId).filter(Boolean))]\n    if (farmerIds.length === 0) return\n    supabase\n      .from('farmers')\n      .select('id, upi_id, upi_qr_code_url')\n      .in('id', farmerIds)\n      .then(({ data }) => {\n        if (!data) return\n        const upiMap: Record<string, string> = {}\n        const qrMap: Record<string, string> = {}\n        for (const f of data) {\n          if (f.upi_id) upiMap[f.id] = f.upi_id\n          if (f.upi_qr_code_url) qrMap[f.id] = f.upi_qr_code_url\n        }\n        setLiveUpiIds(upiMap)\n        setLiveQrUrls(qrMap)\n      })\n  }, [items])\n\n  useEffect(() => {\n    setName(info.name)\n    setPhone(info.phone)\n  }, [info])\n\n  // Group items by farmer\n  const byFarmer = items.reduce<Record<string, CartItem[]>>((acc, item) => {\n    (acc[item.farmerId] = acc[item.farmerId] ?? []).push(item)\n    return acc\n  }, {})\n  const farmerGroups = Object.values(byFarmer)\n\n  const detailsMissing = !name.trim() || phone.replace(/\\D/g, '').length < 10\n\n  // COD flow: save order + open WhatsApp (existing behaviour)\n  const handleCodOrderFarmer = (group: CartItem[]) => {\n    if (detailsMissing) return\n    saveInfo({ name: name.trim(), phone: phone.trim() })\n\n    const f = group[0]\n    const lines = group.map((it) => {\n      const unit = it.unit || 'kg'\n      const price = it.pricePerKg ? ` @ ₹${it.pricePerKg}/${unit}` : ''\n      return `• ${it.emoji ?? '🌿'} ${it.name}${it.variety ? ` (${it.variety})` : ''} — ${it.qty} ${unit}${price}`\n    })\n\n    const selectedPickup = pickupByFarmer[f.farmerId]\n    const selectedDay    = pickupDayByFarmer[f.farmerId]\n    const pickupLine = selectedPickup\n      ? `\\n\\n*Pickup location / పికప్ స్థలం:* ${selectedPickup} (${f.farmerVillage})`\n      : `\\n\\n*Pickup from your farm / మీ పొలం నుండి పికప్* (${f.farmerVillage})`\n    const dayLine = selectedDay ? `\\n*Pickup day / రోజు:* ${selectedDay}` : ''\n\n    const msg =\n      `Hello ${f.farmerName} anna! 🙏\\n` +\n      `I saw your produce on YourFamilyFarmer and would like to order:\\n\\n` +\n      lines.join('\\n') +\n      pickupLine +\n      dayLine +\n      `\\n\\n*Payment: Cash on Delivery / చెల్లింపు: నగదు డెలివరీ సమయంలో*\\n\\n` +\n      `My name / నా పేరు: ${name.trim()}\\n` +\n      `My WhatsApp / నా వాట్సాప్: +91 ${phone.replace(/\\D/g, '').slice(-10)}\\n\\n` +\n      `Please share a good pickup time. Thank you! / పికప్ సమయం తెలియజేయండి, ధన్యవాదాలు 🌱`\n\n    const digits = f.farmerPhone.replace(/\\D/g, '').replace(/^0+/, '')\n    const waPhone = digits.length === 10 ? `91${digits}` : digits\n    const waUrl = `https://wa.me/${waPhone}?text=${encodeURIComponent(msg)}`\n\n    const buyerPhone = phone.replace(/\\D/g, '').slice(-10)\n    for (const it of group) {\n      const baseRow = {\n        farmer_id: it.farmerId,\n        produce_listing_id: it.listingId,\n        produce_name: it.name,\n        quantity: it.qty,\n        unit: it.unit || 'kg',\n        total_price: it.pricePerKg ? Math.round(it.pricePerKg * it.qty) : null,\n        buyer_name: name.trim(),\n        buyer_phone: buyerPhone,\n        pickup_location: selectedPickup || null,\n        status: 'pending',\n      }\n      supabase.from('orders').insert({ ...baseRow, payment_method: 'cod', payment_status: 'pending' })\n        .then(async ({ error }) => {\n          if (error?.message?.includes('payment_method') || error?.message?.includes('payment_status')) {\n            const { error: err2 } = await supabase.from('orders').insert(baseRow)\n            if (err2) console.error('[YFF] Order save failed:', err2.message)\n          } else if (error) {\n            console.error('[YFF] Order save failed:', error.message, error.details, error.hint)\n          }\n        })\n    }\n\n    window.open(waUrl, '_blank', 'noopener,noreferrer')\n    clearFarmer(f.farmerId)\n    supabase.from('wa_clicks').insert({ farmer_id: f.farmerId }).then()\n    setSentFarmers((s) => ({ ...s, [f.farmerId]: true }))\n  }\n\n  // UPI flow: save orders, collect IDs, show payment screen\n  const handleUpiOrderFarmer = async (group: CartItem[]) => {\n    if (detailsMissing) return\n    const f = group[0]\n    const upiId = liveUpiIds[f.farmerId] ?? f.farmerUpiId ?? ''\n    const qrCodeUrl = liveQrUrls[f.farmerId] ?? f.farmerQrCodeUrl\n    if (!upiId && !qrCodeUrl) return\n\n    setUtrNote('')\n    setShowUpiAppFallback(false)\n    setCashMode(false)\n    saveInfo({ name: name.trim(), phone: phone.trim() })\n    setPlacingUpiOrder(f.farmerId)\n\n    const selectedPickup = pickupByFarmer[f.farmerId] || null\n    const buyerPhone = phone.replace(/\\D/g, '').slice(-10)\n    const orderIds: string[] = []\n    let total = 0\n\n    for (const it of group) {\n      const price = it.pricePerKg ? Math.round(it.pricePerKg * it.qty) : null\n      if (price) total += price\n    }\n\n    total = 0\n\n    for (const it of group) {\n      const price = it.pricePerKg ? Math.round(it.pricePerKg * it.qty) : null\n      if (price) total += price\n      const { data, error } = await supabase.from('orders').insert({\n        farmer_id: it.farmerId,\n        produce_listing_id: it.listingId,\n        produce_name: it.name,\n        quantity: it.qty,\n        unit: it.unit || 'kg',\n        total_price: price,\n        buyer_name: name.trim(),\n        buyer_phone: buyerPhone,\n        pickup_location: selectedPickup,\n        status: 'pending',\n        payment_method: 'upi',\n        payment_status: 'pending',\n      }).select('id').single()\n\n      if (!error && data) orderIds.push(data.id)\n      else if (error) console.error('[YFF] UPI order save failed:', error.message)\n    }\n\n    setPlacingUpiOrder(null)\n    if (orderIds.length === 0) {\n      showToast('Could not place order. Please try again.')\n      return\n    }\n\n    setUpiScreen({\n      farmerName: f.farmerName,\n      farmerVillage: f.farmerVillage,\n      farmerPhone: f.farmerPhone,\n      upiId,\n      qrCodeUrl,\n      amount: total,\n      orderIds,\n      farmerId: f.farmerId,\n      buyerName: name.trim(),\n      buyerPhone: buyerPhone,\n      items: group.map((it) => ({\n        name: it.name,\n        variety: it.variety,\n        emoji: it.emoji,\n        qty: it.qty,\n        unit: it.unit,\n        pricePerKg: it.pricePerKg,\n      })),\n      pickupLocation: selectedPickup || undefined,\n      pickupDay: pickupDayByFarmer[f.farmerId] || undefined,\n    })\n  }\n\n  const handlePaymentSuccess = async () => {\n    if (!upiScreen) return\n    setSubmittingResult(true)\n    const updateData: Record<string, unknown> = { payment_status: 'pending_confirmation' }\n    if (utrNote.trim()) updateData.utr_number = utrNote.trim()\n    await Promise.all(\n      upiScreen.orderIds.map((id) =>\n        supabase.from('orders').update(updateData).eq('id', id)\n      )\n    )\n    clearFarmer(upiScreen.farmerId)\n    setSubmittingResult(false)\n    setPaidDone(true)\n\n    // Notify farmer on WhatsApp (same as COD flow)\n    const lines = upiScreen.items.map((it) => {\n      const unit = it.unit || 'kg'\n      const price = it.pricePerKg ? ` @ ₹${it.pricePerKg}/${unit}` : ''\n      return `• ${it.emoji ?? '🌿'} ${it.name}${it.variety ? ` (${it.variety})` : ''} — ${it.qty} ${unit}${price}`\n    })\n    const pickupLine = upiScreen.pickupLocation\n      ? `\\n\\n*Pickup location / పికప్ స్థలం:* ${upiScreen.pickupLocation} (${upiScreen.farmerVillage})`\n      : `\\n\\n*Pickup from your farm / మీ పొలం నుండి పికప్* (${upiScreen.farmerVillage})`\n    const dayLine = upiScreen.pickupDay ? `\\n*Pickup day / రోజు:* ${upiScreen.pickupDay}` : ''\n    const utrLine = utrNote.trim() ? `\\nTransaction ref / రిఫరెన్స్: ${utrNote.trim()}` : ''\n    const msg =\n      `Hello ${upiScreen.farmerName} anna! 🙏\\n` +\n      `New UPI order from YourFamilyFarmer:\\n\\n` +\n      lines.join('\\n') +\n      pickupLine +\n      dayLine +\n      `\\n\\n*Payment: UPI ₹${upiScreen.amount} — buyer says paid*\\n` +\n      `చెల్లింపు: UPI ₹${upiScreen.amount} — కొనుగోలుదారు చెల్లించారు, మీ UPI యాప్ తనిఖీ చేయండి` +\n      utrLine +\n      `\\n\\nBuyer / కొనుగోలుదారు: ${upiScreen.buyerName}\\n` +\n      `WhatsApp: +91 ${upiScreen.buyerPhone}\\n\\n` +\n      `Please confirm pickup time. / పికప్ సమయం తెలియజేయండి, ధన్యవాదాలు 🌱`\n    const digits = upiScreen.farmerPhone.replace(/\\D/g, '').replace(/^0+/, '')\n    const waPhone = digits.length === 10 ? `91${digits}` : digits\n    window.open(`https://wa.me/${waPhone}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener,noreferrer')\n  }\n\n  const handleCashOnPickup = async () => {\n    if (!upiScreen) return\n    setSwitchingToCash(true)\n    await Promise.all(\n      upiScreen.orderIds.map((id) =>\n        supabase.from('orders').update({ payment_method: 'cod', payment_status: 'pending' }).eq('id', id)\n      )\n    )\n    clearFarmer(upiScreen.farmerId)\n    setSwitchingToCash(false)\n    setCashMode(true)\n    setPaidDone(true)\n  }\n\n  const handleOpenUpiApp = () => {\n    setShowUpiAppFallback(false)\n    window.location.href = 'upi://pay'\n    const t = setTimeout(() => setShowUpiAppFallback(true), 2500)\n    const cleanup = () => { clearTimeout(t); setShowUpiAppFallback(false) }\n    window.addEventListener('blur', cleanup, { once: true })\n  }\n\n  const handleDownloadQR = async () => {\n    if (!upiScreen?.qrCodeUrl) return\n    try {\n      const response = await fetch(upiScreen.qrCodeUrl)\n      const blob = await response.blob()\n      const url = URL.createObjectURL(blob)\n      const a = document.createElement('a')\n      a.href = url\n      a.download = `${upiScreen.farmerName.replace(/\\s+/g, '_')}_UPI_QR.png`\n      document.body.appendChild(a)\n      a.click()\n      document.body.removeChild(a)\n      URL.revokeObjectURL(url)\n      showToast('QR saved! / గ్యాలరీకి సేవ్ అయింది')\n    } catch {\n      showToast('Could not save — please screenshot the QR')\n    }\n  }\n\n  // Success screen — shown after I Have Paid or Cash on Pickup\n  if (upiScreen && paidDone) {\n    return (\n      <div className=\"fixed inset-0 z-50 bg-black/50 flex items-end justify-center\">\n        <div className=\"bg-white w-full max-w-md rounded-t-3xl px-6 py-10 flex flex-col items-center text-center gap-4\">\n          <div className={`w-16 h-16 rounded-full flex items-center justify-center text-3xl ${cashMode ? 'bg-amber-100' : 'bg-green-100'}`}>\n            {cashMode ? '💵' : '✓'}\n          </div>\n          <div>\n            <h2 className=\"font-extrabold text-gray-900 text-xl\">\n              {cashMode ? 'Order placed!' : 'Payment recorded!'}\n            </h2>\n            <p className={`font-semibold mt-0.5 ${cashMode ? 'text-amber-700' : 'text-green-700'}`}>\n              {cashMode ? 'Cash on Pickup / నగదు పికప్' : 'చెల్లింపు నమోదైంది!'}\n            </p>\n          </div>\n          <div className=\"bg-gray-50 rounded-2xl px-5 py-4 w-full text-left space-y-1\">\n            <p className=\"text-xs text-gray-500 font-medium\">{cashMode ? 'Order for' : 'Paid to'}</p>\n            <p className=\"font-bold text-gray-900\">{upiScreen.farmerName}</p>\n            <p className=\"text-xs text-gray-500\">{upiScreen.farmerVillage}</p>\n            <p className=\"text-lg font-black text-green-900 mt-2\">₹{upiScreen.amount}</p>\n          </div>\n          {cashMode ? (\n            <p className=\"text-sm text-gray-600 leading-snug\">\n              Pay ₹{upiScreen.amount} in cash when you collect your order from the farmer.\n            </p>\n          ) : (\n            <>\n              <p className=\"text-sm text-gray-600 leading-snug\">\n                Waiting for farmer confirmation / రైతు నిర్ధారణ కోసం వేచి ఉంది\n              </p>\n              <p className=\"text-xs text-gray-400 leading-snug\">\n                The farmer will check their UPI app and confirm your payment.\n              </p>\n            </>\n          )}\n          <Link\n            href=\"/consumer/orders\"\n            className=\"w-full text-center text-sm font-semibold text-green-700 underline\"\n          >\n            Check order status / ఆర్డర్ స్థితి చూడండి\n          </Link>\n          <button\n            onClick={onClose}\n            className=\"w-full bg-green-700 text-white font-bold py-4 rounded-xl text-base active:bg-green-800\"\n          >\n            Done / మూసివేయి\n          </button>\n        </div>\n      </div>\n    )\n  }\n\n  // Payment screen shown after placing an order\n  if (upiScreen) {\n    return (\n      <div className=\"fixed inset-0 z-50 bg-black/50 flex items-end justify-center\">\n        <div className=\"bg-white w-full max-w-md rounded-t-3xl max-h-[92vh] flex flex-col\">\n          <div className=\"sticky top-0 bg-white flex items-center justify-between px-4 py-3 border-b border-gray-100 rounded-t-3xl\">\n            <div>\n              <h2 className=\"font-extrabold text-gray-900 text-lg\">Pay Farmer / రైతుకు చెల్లించండి</h2>\n              <p className=\"text-xs text-gray-500\">Pay directly — no middleman</p>\n            </div>\n            <button onClick={onClose} className=\"text-gray-400 text-3xl leading-none p-1\">×</button>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto px-4 py-5 space-y-4\">\n            {/* Amount + farmer */}\n            <div className=\"bg-green-50 rounded-2xl p-4 text-center\">\n              <p className=\"text-sm font-bold text-green-700\">🧑‍🌾 {upiScreen.farmerName}</p>\n              <p className=\"text-xs text-green-600 mt-0.5\">{upiScreen.farmerVillage}</p>\n              <p className=\"text-4xl font-black text-green-900 mt-3\">₹{upiScreen.amount}</p>\n              <p className=\"text-sm text-green-700 mt-1\">Total amount to pay</p>\n            </div>\n\n            {/* QR code (if available) */}\n            {upiScreen.qrCodeUrl && (\n              <div className=\"bg-white border-2 border-gray-200 rounded-2xl p-4 flex flex-col items-center gap-2\">\n                <p className=\"text-xs font-bold text-gray-600 uppercase tracking-wide\">Scan QR Code to Pay</p>\n                {/* eslint-disable-next-line @next/next/no-img-element */}\n                <img src={upiScreen.qrCodeUrl} alt=\"UPI QR Code\" className=\"w-48 h-48 object-contain rounded-xl\" />\n                <p className=\"text-[11px] text-gray-500 text-center\">Open any UPI app → Scan QR / QR స్కాన్ చేయండి</p>\n                <button\n                  onClick={handleDownloadQR}\n                  className=\"w-full border border-gray-300 text-gray-700 font-bold py-2.5 rounded-xl text-sm active:bg-gray-50 flex items-center justify-center gap-1.5 mt-1\"\n                >\n                  <span>⬇️</span> Save QR to Gallery / గ్యాలరీకి సేవ్ చేయండి\n                </button>\n              </div>\n            )}\n\n            {/* UPI pay instructions */}\n            {upiScreen.upiId && (\n              <div className=\"bg-blue-50 border border-blue-200 rounded-2xl px-4 py-4 space-y-3\">\n                <p className=\"text-xs font-extrabold text-blue-800 uppercase tracking-wide\">\n                  How to pay / చెల్లింపు విధానం\n                </p>\n\n                {/* Steps */}\n                <ol className=\"space-y-2.5\">\n                  <li className=\"flex gap-3 items-start\">\n                    <span className=\"flex-shrink-0 w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center mt-0.5\">1</span>\n                    <div>\n                      <p className=\"text-sm font-semibold text-gray-900\">Copy the UPI ID below</p>\n                      <p className=\"text-xs text-gray-500\">క్రింద ఉన్న UPI ID కాపీ చేయండి</p>\n                    </div>\n                  </li>\n                  <li className=\"flex gap-3 items-start\">\n                    <span className=\"flex-shrink-0 w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center mt-0.5\">2</span>\n                    <div>\n                      <p className=\"text-sm font-semibold text-gray-900\">Open your UPI app (PhonePe / GPay / Paytm)</p>\n                      <p className=\"text-xs text-gray-500\">మీ UPI యాప్ తెరవండి</p>\n                    </div>\n                  </li>\n                  <li className=\"flex gap-3 items-start\">\n                    <span className=\"flex-shrink-0 w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center mt-0.5\">3</span>\n                    <div>\n                      <p className=\"text-sm font-semibold text-gray-900\">Tap &quot;Pay&quot; → &quot;Enter UPI ID&quot; → paste the ID</p>\n                      <p className=\"text-xs text-gray-500\">&quot;Pay&quot; నొక్కి → &quot;UPI ID&quot; నమోదు చేసి → పేస్ట్ చేయండి</p>\n                    </div>\n                  </li>\n                  <li className=\"flex gap-3 items-start\">\n                    <span className=\"flex-shrink-0 w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center mt-0.5\">4</span>\n                    <div>\n                      <p className=\"text-sm font-semibold text-gray-900\">Enter ₹{upiScreen.amount} and complete payment</p>\n                      <p className=\"text-xs text-gray-500\">₹{upiScreen.amount} నమోదు చేసి చెల్లింపు పూర్తి చేయండి</p>\n                    </div>\n                  </li>\n                </ol>\n\n                {/* UPI ID copy row */}\n                <div className=\"bg-white border border-blue-200 rounded-xl px-4 py-3 flex items-center gap-3\">\n                  <div className=\"flex-1 min-w-0\">\n                    <p className=\"text-[10px] font-bold text-gray-500 mb-0.5 uppercase tracking-wide\">UPI ID</p>\n                    <p className=\"font-mono text-sm font-bold text-gray-900 break-all\">{upiScreen.upiId}</p>\n                  </div>\n                  <button\n                    onClick={() => {\n                      navigator.clipboard.writeText(upiScreen.upiId).catch(() => {})\n                      showToast('UPI ID copied! / కాపీ అయింది')\n                    }}\n                    className=\"flex-shrink-0 bg-blue-600 text-white font-bold px-4 py-2.5 rounded-xl text-xs active:bg-blue-700\"\n                  >\n                    Copy / కాపీ\n                  </button>\n                </div>\n\n                {/* Open UPI App button */}\n                <button\n                  onClick={handleOpenUpiApp}\n                  className=\"w-full bg-blue-600 text-white font-bold py-4 rounded-xl text-base active:bg-blue-700 flex items-center justify-center gap-2\"\n                >\n                  📲 Open UPI App / UPI యాప్ తెరవండి\n                </button>\n\n                {showUpiAppFallback && (\n                  <p className=\"text-xs text-blue-700 text-center\">\n                    App didn&apos;t open? Copy the UPI ID and pay manually in PhonePe, GPay, or Paytm.<br />\n                    యాప్ తెరుచుకోలేదా? UPI ID కాపీ చేసి మాన్యువల్‌గా చెల్లించండి.\n                  </p>\n                )}\n              </div>\n            )}\n\n            {/* Cash on Pickup option */}\n            <div className=\"bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 space-y-2\">\n              <p className=\"text-sm font-bold text-gray-700\">💵 Prefer Cash on Pickup? / నగదు చెల్లించాలా?</p>\n              <p className=\"text-xs text-gray-500\">Pay cash directly to the farmer when you collect your order.</p>\n              <button\n                onClick={handleCashOnPickup}\n                disabled={switchingToCash || submittingResult}\n                className=\"w-full border-2 border-gray-300 text-gray-700 font-bold py-3 rounded-xl text-sm active:bg-gray-100 disabled:opacity-50\"\n              >\n                {switchingToCash ? 'Switching... / మారుతోంది' : 'Switch to Cash on Pickup / నగదు పికప్‌కు మారండి'}\n              </button>\n            </div>\n\n            {/* Optional transaction note */}\n            <div>\n              <label className=\"text-xs font-bold text-gray-600 uppercase tracking-wide block mb-1.5\">\n                Transaction note (optional) / లావాదేవీ నోట్\n              </label>\n              <input\n                type=\"text\"\n                inputMode=\"text\"\n                placeholder=\"e.g. GPay ref 123456\"\n                value={utrNote}\n                onChange={(e) => setUtrNote(e.target.value)}\n                className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-base focus:border-green-500 focus:outline-none\"\n              />\n            </div>\n\n            {/* I Have Paid */}\n            <button\n              onClick={handlePaymentSuccess}\n              disabled={submittingResult || switchingToCash}\n              className=\"w-full bg-green-700 text-white font-bold py-4 rounded-xl text-base disabled:opacity-50 active:bg-green-800\"\n            >\n              {submittingResult ? 'Saving...' : '✓ I Have Paid / చెల్లించాను'}\n            </button>\n          </div>\n        </div>\n      </div>\n    )\n  }\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-black/50 flex items-end justify-center\">\n      {/* Toast */}\n      {toast && (\n        <div className=\"fixed top-5 left-0 right-0 flex justify-center z-[60] pointer-events-none px-4\">\n          <div className=\"bg-gray-900 text-white text-sm font-semibold px-5 py-2.5 rounded-full shadow-xl\">\n            {toast}\n          </div>\n        </div>\n      )}\n      <div className=\"bg-white w-full max-w-md rounded-t-3xl max-h-[92vh] flex flex-col\">\n        {/* Header */}\n        <div className=\"sticky top-0 bg-white flex items-center justify-between px-4 py-3 border-b border-gray-100 rounded-t-3xl\">\n          <div>\n            <h2 className=\"font-extrabold text-gray-900 text-lg\">Your cart / మీ బుట్ట</h2>\n            <p className=\"text-xs text-gray-500\">\n              Pickup from farm only / పొలం నుండి పికప్ మాత్రమే\n            </p>\n          </div>\n          <button onClick={onClose} className=\"text-gray-400 text-3xl leading-none p-1\">×</button>\n        </div>\n\n        {/* Body */}\n        <div className=\"flex-1 overflow-y-auto px-4 py-4 space-y-5\">\n          {items.length === 0 ? (\n            <div className=\"text-center py-14 text-gray-400\">\n              <div className=\"text-5xl mb-3\">🛒</div>\n              <p className=\"font-semibold\">Your cart is empty</p>\n              <p className=\"text-sm mt-1\">బుట్ట ఖాళీగా ఉంది</p>\n            </div>\n          ) : (\n            <>\n              {/* Consumer details */}\n              <div className=\"bg-gray-50 rounded-2xl p-4 space-y-3\">\n                <div>\n                  <label className=\"text-xs font-bold text-gray-700 uppercase tracking-wide block mb-1\">\n                    Your name / మీ పేరు\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={name}\n                    onChange={(e) => setName(e.target.value)}\n                    placeholder=\"Ramya\"\n                    className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-base focus:border-green-500 focus:outline-none bg-white\"\n                  />\n                </div>\n                <div>\n                  <label className=\"text-xs font-bold text-gray-700 uppercase tracking-wide block mb-1\">\n                    Your WhatsApp number / వాట్సాప్ నంబర్\n                  </label>\n                  <div className=\"flex gap-2\">\n                    <span className=\"flex items-center px-3 bg-white border border-gray-200 rounded-xl text-sm text-gray-600 font-medium\">\n                      +91\n                    </span>\n                    <input\n                      type=\"tel\"\n                      inputMode=\"numeric\"\n                      value={phone}\n                      onChange={(e) => setPhone(e.target.value)}\n                      placeholder=\"9876543210\"\n                      maxLength={10}\n                      className=\"flex-1 border border-gray-200 rounded-xl px-4 py-3 text-base focus:border-green-500 focus:outline-none bg-white\"\n                    />\n                  </div>\n                </div>\n                <p className=\"text-[11px] text-gray-500 leading-snug\">\n                  The farmer needs this to confirm pickup time.<br />\n                  పికప్ సమయం కోసం రైతుకు ఇది అవసరం.\n                </p>\n              </div>\n\n              {/* Payment method selection */}\n              <div className=\"bg-gray-50 rounded-2xl p-4 space-y-2\">\n                <p className=\"text-xs font-bold text-gray-700 uppercase tracking-wide\">\n                  Payment method / చెల్లింపు విధానం\n                </p>\n                <button\n                  onClick={() => setPaymentMethod('cod')}\n                  className={`w-full flex items-center justify-between px-4 py-3 rounded-xl border-2 text-sm font-bold transition-colors ${\n                    paymentMethod === 'cod'\n                      ? 'border-green-600 bg-green-50 text-green-900'\n                      : 'border-gray-200 bg-white text-gray-700'\n                  }`}\n                >\n                  <span className=\"flex items-center gap-2\">\n                    <span className=\"text-base\">💵</span>\n                    Cash on Delivery / నగదు చెల్లింపు\n                  </span>\n                  {paymentMethod === 'cod' && (\n                    <span className=\"text-green-600 text-base\">✓</span>\n                  )}\n                </button>\n                <button\n                  onClick={() => setPaymentMethod('upi')}\n                  className={`w-full flex items-center justify-between px-4 py-3 rounded-xl border-2 text-sm font-bold transition-colors ${\n                    paymentMethod === 'upi'\n                      ? 'border-blue-600 bg-blue-50 text-blue-900'\n                      : 'border-gray-200 bg-white text-gray-700'\n                  }`}\n                >\n                  <span className=\"flex items-center gap-2\">\n                    <span className=\"text-base\">📲</span>\n                    UPI Payment / యూపీఐ చెల్లింపు\n                  </span>\n                  {paymentMethod === 'upi' && (\n                    <span className=\"text-blue-600 text-base\">✓</span>\n                  )}\n                </button>\n              </div>\n\n              {/* Farmer groups */}\n              {farmerGroups.map((group) => {\n                const f = group[0]\n                const total = group.reduce(\n                  (s, it) => s + (it.pricePerKg ?? 0) * it.qty,\n                  0,\n                )\n                const sent = sentFarmers[f.farmerId]\n                return (\n                  <div\n                    key={f.farmerId}\n                    className=\"border border-gray-200 rounded-2xl overflow-hidden\"\n                  >\n                    <div className=\"bg-green-50 px-4 py-3 border-b border-green-100 flex items-center justify-between\">\n                      <div className=\"min-w-0\">\n                        <p className=\"font-extrabold text-green-900 truncate\">\n                          🧑‍🌾 {f.farmerName}\n                        </p>\n                        <p className=\"text-xs text-green-700\">📍 {f.farmerVillage}</p>\n                      </div>\n                      <span className=\"text-[10px] font-bold bg-green-700 text-white px-2 py-1 rounded-full whitespace-nowrap\">\n                        Pickup\n                      </span>\n                    </div>\n\n                    <div className=\"p-3 space-y-2\">\n                      {group.map((it) => (\n                        <div key={it.listingId} className=\"flex items-center gap-3\">\n                          <div className=\"w-11 h-11 rounded-xl bg-gray-50 flex items-center justify-center text-xl flex-shrink-0\">\n                            {it.emoji ?? '🌿'}\n                          </div>\n                          <div className=\"flex-1 min-w-0\">\n                            <p className=\"font-semibold text-sm text-gray-900 truncate\">\n                              {it.name}\n                            </p>\n                            {it.pricePerKg && (\n                              <p className=\"text-xs text-gray-500\">₹{it.pricePerKg}/{it.unit || 'kg'}</p>\n                            )}\n                            {getActiveTier(it.qty, it).isDiscount && (\n                              <p className=\"text-[10px] font-semibold text-green-700 mt-0.5\">\n                                Bulk price applied / బల్క్ ధర వర్తింపు\n                              </p>\n                            )}\n                          </div>\n                          <QtyStepper\n                            qty={it.qty}\n                            maxQty={it.stockQty}\n                            onDec={() => setQty(it.listingId, it.qty - 1)}\n                            onInc={() => {\n                              if (it.stockQty != null && it.qty >= it.stockQty) {\n                                showToast('No more stock available / స్టాక్ అయిపోయింది')\n                                return\n                              }\n                              setQty(it.listingId, it.qty + 1)\n                            }}\n                          />\n                          <button\n                            onClick={() => removeItem(it.listingId)}\n                            className=\"text-gray-300 text-xl px-1\"\n                            aria-label=\"Remove\"\n                          >\n                            ×\n                          </button>\n                        </div>\n                      ))}\n\n                      {total > 0 && (\n                        <div className=\"flex items-center justify-between pt-2 border-t border-gray-100 mt-2\">\n                          <span className=\"text-xs text-gray-500\">Estimated total / మొత్తం</span>\n                          <span className=\"font-extrabold text-gray-900\">\n                            ₹{total}\n                          </span>\n                        </div>\n                      )}\n\n                      {f.farmerPickupLocations && f.farmerPickupLocations.length > 0 && (\n                        <div className=\"pt-2\">\n                          <label className=\"text-[11px] font-bold text-gray-600 uppercase tracking-wide block mb-1\">\n                            Pickup location / పికప్ స్థలం\n                          </label>\n                          <select\n                            value={pickupByFarmer[f.farmerId] ?? ''}\n                            onChange={(e) =>\n                              setPickupByFarmer((prev) => ({\n                                ...prev,\n                                [f.farmerId]: e.target.value,\n                              }))\n                            }\n                            className=\"w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm bg-white focus:border-green-500 focus:outline-none\"\n                          >\n                            <option value=\"\">Select a pickup point / స్థలం ఎంచుకోండి</option>\n                            {f.farmerPickupLocations.map((loc) => (\n                              <option key={loc} value={loc}>{loc}</option>\n                            ))}\n                          </select>\n                        </div>\n                      )}\n\n                      {f.farmerPickupSlots && f.farmerPickupSlots.days.length > 0 && (\n                        <div className=\"pt-2\">\n                          <label className=\"text-[11px] font-bold text-gray-600 uppercase tracking-wide block mb-1\">\n                            Pickup day / పికప్ రోజు\n                          </label>\n                          <p className=\"text-[11px] text-green-700 font-medium mb-1.5\">\n                            Available {f.farmerPickupSlots.time_from}–{f.farmerPickupSlots.time_to}\n                          </p>\n                          <select\n                            value={pickupDayByFarmer[f.farmerId] ?? ''}\n                            onChange={(e) =>\n                              setPickupDayByFarmer((prev) => ({\n                                ...prev,\n                                [f.farmerId]: e.target.value,\n                              }))\n                            }\n                            className=\"w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm bg-white focus:border-green-500 focus:outline-none\"\n                          >\n                            <option value=\"\">Select a day / రోజు ఎంచుకోండి</option>\n                            {f.farmerPickupSlots.days.map((day) => (\n                              <option key={day} value={day}>{day}</option>\n                            ))}\n                          </select>\n                        </div>\n                      )}\n\n                      {paymentMethod === 'upi' ? (\n                        (liveUpiIds[f.farmerId] || f.farmerUpiId || liveQrUrls[f.farmerId]) ? (\n                          <button\n                            onClick={() => handleUpiOrderFarmer(group)}\n                            disabled={detailsMissing || placingUpiOrder === f.farmerId}\n                            className={`mt-1 w-full font-bold py-3.5 rounded-xl text-sm flex items-center justify-center gap-2 ${\n                              detailsMissing\n                                ? 'bg-gray-200 text-gray-500'\n                                : 'bg-blue-600 text-white active:bg-blue-700 disabled:opacity-50'\n                            }`}\n                          >\n                            {placingUpiOrder === f.farmerId\n                              ? 'Placing order...'\n                              : `📲 Order & Pay ₹${Math.round(group.reduce((s, it) => s + (it.pricePerKg ?? 0) * it.qty, 0))}`}\n                          </button>\n                        ) : (\n                          <div className=\"mt-1 space-y-2\">\n                            <p className=\"text-[11px] text-amber-700 bg-amber-50 rounded-xl px-3 py-2 text-center\">\n                              ⚠️ This farmer hasn&apos;t set up UPI yet. Using Cash on Pickup.\n                            </p>\n                            <button\n                              onClick={() => handleCodOrderFarmer(group)}\n                              disabled={detailsMissing}\n                              className={`w-full font-bold py-3.5 rounded-xl text-sm flex items-center justify-center gap-2 ${\n                                sent\n                                  ? 'bg-green-100 text-green-800'\n                                  : detailsMissing\n                                    ? 'bg-gray-200 text-gray-500'\n                                    : 'bg-green-700 text-white active:bg-green-800'\n                              }`}\n                            >\n                              {sent ? <>✓ Order sent</> : <><WhatsAppIcon /> Cash on Pickup</>}\n                            </button>\n                          </div>\n                        )\n                      ) : (\n                        <button\n                          onClick={() => handleCodOrderFarmer(group)}\n                          disabled={detailsMissing}\n                          className={`mt-1 w-full font-bold py-3.5 rounded-xl text-sm flex items-center justify-center gap-2 ${\n                            sent\n                              ? 'bg-green-100 text-green-800'\n                              : detailsMissing\n                                ? 'bg-gray-200 text-gray-500'\n                                : 'bg-green-700 text-white active:bg-green-800'\n                          }`}\n                        >\n                          {sent ? (\n                            <>✓ Order sent — tap to resend</>\n                          ) : (\n                            <>\n                              <WhatsAppIcon />\n                              Send to {f.farmerName.split(' ')[0] || 'farmer'} / వాట్సాప్\n                            </>\n                          )}\n                        </button>\n                      )}\n                    </div>\n                  </div>\n                )\n              })}\n\n              {farmerGroups.length > 1 && (\n                <p className=\"text-xs text-gray-500 text-center px-4 leading-snug\">\n                  One WhatsApp chat opens per farmer, since each farm handles its own pickup.<br />\n                  ప్రతి రైతుకు ప్రత్యేక వాట్సాప్ చాట్ తెరుచుకుంటుంది.\n                </p>\n              )}\n\n              <button\n                onClick={clear}\n                className=\"w-full text-sm text-gray-500 underline pt-2\"\n              >\n                Clear cart / బుట్ట ఖాళీ చేయండి\n              </button>\n            </>\n          )}\n        </div>\n      </div>\n    </div>\n  )\n}\n\nfunction QtyStepper({\n  qty,\n  onDec,\n  onInc,\n  maxQty,\n}: {\n  qty: number\n  onDec: () => void\n  onInc: () => void\n  maxQty?: number\n}) {\n  const atMax = maxQty != null && qty >= maxQty\n  return (\n    <div className=\"flex items-center border border-gray-200 rounded-full\">\n      <button\n        onClick={onDec}\n        className=\"w-8 h-8 text-lg text-gray-700 flex items-center justify-center active:bg-gray-100 rounded-l-full\"\n        aria-label=\"Decrease\"\n      >\n        −\n      </button>\n      <span className=\"w-10 text-center font-bold text-sm text-gray-900\">\n        {qty}\n      </span>\n      <button\n        onClick={onInc}\n        disabled={atMax}\n        className={`w-8 h-8 text-lg flex items-center justify-center rounded-r-full ${\n          atMax\n            ? 'text-gray-300 cursor-not-allowed'\n            : 'text-gray-700 active:bg-gray-100'\n        }`}\n        aria-label=\"Increase\"\n      >\n        +\n      </button>\n    </div>\n  )\n}\n\nfunction CartIcon() {\n  return (\n    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <circle cx=\"9\" cy=\"21\" r=\"1\" />\n      <circle cx=\"20\" cy=\"21\" r=\"1\" />\n      <path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\" />\n    </svg>\n  )\n}\n\nfunction WhatsAppIcon() {\n  return (\n    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n      <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\" />\n    </svg>\n  )\n}\n","numLines":1074,"startLine":1,"totalLines":1074}},"sourceToolAssistantUUID":"e1e1c208-9b8d-46c9-9864-15eb17cb5149","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"7a6aaaaf-7f8a-495a-9a66-4b6152eec242","version":"2.1.128","gitBranch":"main"}
