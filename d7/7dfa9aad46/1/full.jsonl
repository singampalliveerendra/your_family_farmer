s\n54\t}\n55\t\n56\tasync function fetchSuggestions(q: string, signal: AbortSignal): Promise<Suggestion[]> {\n57\t  const url = new URL('https://photon.komoot.io/api/')\n58\t  url.searchParams.set('q', q)\n59\t  url.searchParams.set('limit', '8')\n60\t  url.searchParams.set('bbox', BBOX)\n61\t  url.searchParams.set('lang', 'en')\n62\t\n63\t  const res = await fetch(url.toString(), { signal })\n64\t  if (!res.ok) throw new Error(`HTTP ${res.status}`)\n65\t  const json = await res.json()\n66\t  return parsePhoton(json)\n67\t}\n68\t\n69\texport default function LocationSearch({\n70\t  placeholder = 'Search city, town or village... / పట్టణం వెతకండి',\n71\t  onSelect,\n72\t  initialValue = '',\n73\t}: {\n74\t  placeholder?: string\n75\t  onSelect: (lat: number, lng: number, name: string) => void\n76\t  initialValue?: string\n77\t}) {\n78\t  const [query, setQuery]             = useState(initialValue)\n79\t  const [suggestions, setSuggestions] = useState<Suggestion[]>([])\n80\t  const [loading, setLoading]         = useState(false)\n81\t  const [showDrop, setShowDrop]       = useState(false)\n82\t  const [noResults, setNoResults]     = useState(false)\n83\t  const abortRef     = useRef<AbortController | null>(null)\n84\t  const timerRef     = useRef<ReturnType<typeof setTimeout> | null>(null)\n85\t  const containerRef = useRef<HTMLDivElement>(null)\n86\t\n87\t  const doSearch = async (q: string) => {\n88\t    abortRef.current?.abort()\n89\t    const clean = q.trim()\n90\t    if (clean.length < 2) {\n91\t      setSuggestions([])\n92\t      setNoResults(false)\n93\t      setLoading(false)\n94\t      setShowDrop(false)\n95\t      return\n96\t    }\n97\t    abortRef.current = new AbortController()\n98\t    setLoading(true)\n99\t    setNoResults(false)\n100\t    try {\n101\t      const results = await fetchSuggestions(clean, abortRef.current.signal)\n102\t      setSuggestions(results)\n103\t      setNoResults(results.length === 0)\n104\t      setShowDrop(true)\n105\t    } catch (err: unknown) {\n106\t      if ((err as Error).name !== 'AbortError') {\n107\t        setSuggestions([])\n108\t        setNoResults(true)\n109\t      }\n110\t    } finally {\n111\t      setLoading(false)\n112\t    }\n113\t  }\n114\t\n115\t  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n116\t    const val = e.target.value\n117\t    setQuery(val)\n118\t    if (timerRef.current) clearTimeout(timerRef.current)\n119\t    timerRef.current = setTimeout(() => doSearch(val), 350)\n120\t    if (val.trim().length < 2) {\n121\t      setSuggestions([])\n122\t      setNoResults(false)\n123\t      setShowDrop(false)\n124\t    }\n125\t  }\n126\t\n127\t  const handleSelect = (s: Suggestion) => {\n128\t    setQuery(s.name)\n129\t    setSuggestions([])\n130\t    setShowDrop(false)\n131\t    setNoResults(false)\n132\t    onSelect(s.lat, s.lng, s.name)\n133\t  }\n134\t\n135\t  const handleClear = () => {\n136\t    setQuery('')\n137\t    setSuggestions([])\n138\t    setShowDrop(false)\n139\t    setNoResults(false)\n140\t    abortRef.current?.abort()\n141\t  }\n142\t\n143\t  // Close on outside click\n144\t  useEffect(() => {\n145\t    const handler = (e: MouseEvent) => {\n146\t      if (containerRef.current && !containerRef.current.contains(e.target as Node)) {\n147\t        setShowDrop(false)\n148\t      }\n149\t    }\n150\t    document.addEventListener('mousedown', handler)\n151\t    return () => document.removeEventListener('mousedown', handler)\n152\t  }, [])\n153\t\n154\t  useEffect(() => () => { abortRef.current?.abort() }, [])\n155\t\n156\t  return (\n157\t    <div ref={containerRef} className=\"relative\">\n158\t      {/* Input */}\n159\t      <div className=\"relative\">\n160\t        <svg\n161\t          className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none\"\n162\t          width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\"\n163\t          stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\"\n164\t        >\n165\t          <circle cx=\"11\" cy=\"11\" r=\"8\" />\n166\t          <path d=\"m21 21-4.35-4.35\" />\n167\t        </svg>\n168\t        <input\n169\t          type=\"text\"\n170\t          value={query}\n171\t          onChange={handleChange}\n172\t          onFocus={() => { if (suggestions.length > 0) setShowDrop(true) }}\n173\t          placeholder={placeholder}\n174\t          autoComplete=\"off\"\n175\t          spellCheck={false}\n176\t          className=\"w-full border-2 border-gray-200 rounded-xl pl-9 pr-9 py-3 text-base focus:border-green-500 focus:outline-none bg-white\"\n177\t        />\n178\t        {loading && (\n179\t          <span className=\"absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none\">\n180\t            <span className=\"animate-spin inline-block w-4 h-4 border-2 border-green-600 border-t-transparent rounded-full\" />\n181\t          </span>\n182\t        )}\n183\t        {!loading && query && (\n184\t          <button\n185\t            type=\"button\"\n186\t            onMouseDown={(e) => { e.preventDefault(); handleClear() }}\n187\t            className=\"absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xl leading-none\"\n188\t          >\n189\t            ×\n190\t          </button>\n191\t        )}\n192\t      </div>\n193\t\n194\t      {/* Suggestions dropdown */}\n195\t      {showDrop && suggestions.length > 0 && (\n196\t        <div className=\"absolute z-30 top-full left-0 right-0 bg-white border border-gray-200 rounded-xl shadow-xl mt-1 overflow-hidden max-h-64 overflow-y-auto\">\n197\t          {suggestions.map((s, i) => (\n198\t            <button\n199\t              key={i}\n200\t              type=\"button\"\n201\t              onMouseDown={(e) => { e.preventDefault(); handleSelect(s) }}\n202\t              className=\"w-full text-left px-4 py-3 hover:bg-green-50 active:bg-green-100 border-b border-gray-100 last:border-0\"\n203\t            >\n204\t              <p className=\"font-semibold text-sm text-gray-900 leading-snug\">📍 {s.name}</p>\n205\t              {s.subtitle && (\n206\t                <p className=\"text-xs text-gray-500 mt-0.5\">{s.subtitle}</p>\n207\t              )}\n208\t            </button>\n209\t          ))}\n210\t        </div>\n211\t      )}\n212\t\n213\t      {/* No results */}\n214\t      {showDrop && noResults && !loading && (\n215\t        <div className=\"absolute z-30 top-full left-0 right-0 bg-white border border-gray-200 rounded-xl shadow-xl mt-1 px-4 py-4 text-center\">\n216\t          <p className=\"text-sm font-semibold text-gray-600\">\n217\t            No results / ఫలితాలు లేవు\n218\t          </p>\n219\t          <p className=\"text-xs text-gray-400 mt-1 leading-snug\">\n220\t            Try the full name or a nearby larger town<br />\n221\t            పూర్తి పేరు లేదా దగ్గరలోని పెద్ద పట్టణం వెతకండి\n222\t          </p>\n223\t        </div>\n224\t      )}\n225\t    </div>\n226\t  )\n227\t}\n228\t"}]},"uuid":"cadf4a50-d7a2-4e1c-83f7-184fccee04ea","timestamp":"2026-05-05T09:12:52.615Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/components/LocationSearch.tsx","content":"'use client'\n\nimport { useState, useRef, useEffect } from 'react'\n\ntype Suggestion = {\n  name: string\n  subtitle: string\n  lat: number\n  lng: number\n}\n\n// AP + Telangana bbox: min_lon,min_lat,max_lon,max_lat\nconst BBOX = '76.0,12.0,85.5,20.5'\n\n// States we allow in results\nconst ALLOWED_STATES = ['andhra pradesh', 'telangana']\n\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction parsePhoton(data: any): Suggestion[] {\n  const seen = new Set<string>()\n  const results: Suggestion[] = []\n\n  for (const feature of data?.features ?? []) {\n    const p = feature?.properties ?? {}\n    const coords: [number, number] = feature?.geometry?.coordinates ?? [0, 0]\n    const lng = coords[0]\n    const lat = coords[1]\n\n    if (!lat || !lng) continue\n\n    // Filter to AP + Telangana only\n    const state: string = (p.state ?? '').toLowerCase()\n    if (state && !ALLOWED_STATES.some((s) => state.includes(s))) continue\n\n    // Best name for this result\n    const name: string = (\n      p.name || p.city || p.town || p.village || p.hamlet || p.suburb || p.county || ''\n    ).trim()\n    if (!name) continue\n\n    const key = name.toLowerCase()\n    if (seen.has(key)) continue\n    seen.add(key)\n\n    const parts: string[] = []\n    const district = p.county || p.district || p.state_district\n    if (district && district.toLowerCase() !== key) parts.push(district)\n    if (p.state) parts.push(p.state)\n\n    results.push({ name, subtitle: parts.join(', '), lat, lng })\n  }\n\n  return results\n}\n\nasync function fetchSuggestions(q: string, signal: AbortSignal): Promise<Suggestion[]> {\n  const url = new URL('https://photon.komoot.io/api/')\n  url.searchParams.set('q', q)\n  url.searchParams.set('limit', '8')\n  url.searchParams.set('bbox', BBOX)\n  url.searchParams.set('lang', 'en')\n\n  const res = await fetch(url.toString(), { signal })\n  if (!res.ok) throw new Error(`HTTP ${res.status}`)\n  const json = await res.json()\n  return parsePhoton(json)\n}\n\nexport default function LocationSearch({\n  placeholder = 'Search city, town or village... / పట్టణం వెతకండి',\n  onSelect,\n  initialValue = '',\n}: {\n  placeholder?: string\n  onSelect: (lat: number, lng: number, name: string) => void\n  initialValue?: string\n}) {\n  const [query, setQuery]             = useState(initialValue)\n  const [suggestions, setSuggestions] = useState<Suggestion[]>([])\n  const [loading, setLoading]         = useState(false)\n  const [showDrop, setShowDrop]       = useState(false)\n  const [noResults, setNoResults]     = useState(false)\n  const abortRef     = useRef<AbortController | null>(null)\n  const timerRef     = useRef<ReturnType<typeof setTimeout> | null>(null)\n  const containerRef = useRef<HTMLDivElement>(null)\n\n  const doSearch = async (q: string) => {\n    abortRef.current?.abort()\n    const clean = q.trim()\n    if (clean.length < 2) {\n      setSuggestions([])\n      setNoResults(false)\n      setLoading(false)\n      setShowDrop(false)\n      return\n    }\n    abortRef.current = new AbortController()\n    setLoading(true)\n    setNoResults(false)\n    try {\n      const results = await fetchSuggestions(clean, abortRef.current.signal)\n      setSuggestions(results)\n      setNoResults(results.length === 0)\n      setShowDrop(true)\n    } catch (err: unknown) {\n      if ((err as Error).name !== 'AbortError') {\n        setSuggestions([])\n        setNoResults(true)\n      }\n    } finally {\n      setLoading(false)\n    }\n  }\n\n  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const val = e.target.value\n    setQuery(val)\n    if (timerRef.current) clearTimeout(timerRef.current)\n    timerRef.current = setTimeout(() => doSearch(val), 350)\n    if (val.trim().length < 2) {\n      setSuggestions([])\n      setNoResults(false)\n      setShowDrop(false)\n    }\n  }\n\n  const handleSelect = (s: Suggestion) => {\n    setQuery(s.name)\n    setSuggestions([])\n    setShowDrop(false)\n    setNoResults(false)\n    onSelect(s.lat, s.lng, s.name)\n  }\n\n  const handleClear = () => {\n    setQuery('')\n    setSuggestions([])\n    setShowDrop(false)\n    setNoResults(false)\n    abortRef.current?.abort()\n  }\n\n  // Close on outside click\n  useEffect(() => {\n    const handler = (e: MouseEvent) => {\n      if (containerRef.current && !containerRef.current.contains(e.target as Node)) {\n        setShowDrop(false)\n      }\n    }\n    document.addEventListener('mousedown', handler)\n    return () => document.removeEventListener('mousedown', handler)\n  }, [])\n\n  useEffect(() => () => { abortRef.current?.abort() }, [])\n\n  return (\n    <div ref={containerRef} className=\"relative\">\n      {/* Input */}\n      <div className=\"relative\">\n        <svg\n          className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none\"\n          width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\"\n        >\n          <circle cx=\"11\" cy=\"11\" r=\"8\" />\n          <path d=\"m21 21-4.35-4.35\" />\n        </svg>\n        <input\n          type=\"text\"\n          value={query}\n          onChange={handleChange}\n          onFocus={() => { if (suggestions.length > 0) setShowDrop(true) }}\n          placeholder={placeholder}\n          autoComplete=\"off\"\n          spellCheck={false}\n          className=\"w-full border-2 border-gray-200 rounded-xl pl-9 pr-9 py-3 text-base focus:border-green-500 focus:outline-none bg-white\"\n        />\n        {loading && (\n          <span className=\"absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none\">\n            <span className=\"animate-spin inline-block w-4 h-4 border-2 border-green-600 border-t-transparent rounded-full\" />\n          </span>\n        )}\n        {!loading && query && (\n          <button\n            type=\"button\"\n            onMouseDown={(e) => { e.preventDefault(); handleClear() }}\n            className=\"absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xl leading-none\"\n          >\n            ×\n          </button>\n        )}\n      </div>\n\n      {/* Suggestions dropdown */}\n      {showDrop && suggestions.length > 0 && (\n        <div className=\"absolute z-30 top-full left-0 right-0 bg-white border border-gray-200 rounded-xl shadow-xl mt-1 overflow-hidden max-h-64 overflow-y-auto\">\n          {suggestions.map((s, i) => (\n            <button\n              key={i}\n              type=\"button\"\n              onMouseDown={(e) => { e.preventDefault(); handleSelect(s) }}\n              className=\"w-full text-left px-4 py-3 hover:bg-green-50 active:bg-green-100 border-b border-gray-100 last:border-0\"\n            >\n              <p className=\"font-semibold text-sm text-gray-900 leading-snug\">📍 {s.name}</p>\n              {s.subtitle && (\n                <p className=\"text-xs text-gray-500 mt-0.5\">{s.subtitle}</p>\n              )}\n            </button>\n          ))}\n        </div>\n      )}\n\n      {/* No results */}\n      {showDrop && noResults && !loading && (\n        <div className=\"absolute z-30 top-full left-0 right-0 bg-white border border-gray-200 rounded-xl shadow-xl mt-1 px-4 py-4 text-center\">\n          <p className=\"text-sm font-semibold text-gray-600\">\n            No results / ఫలితాలు లేవు\n          </p>\n          <p className=\"text-xs text-gray-400 mt-1 leading-snug\">\n            Try the full name or a nearby larger town<br />\n            పూర్తి పేరు లేదా దగ్గరలోని పెద్ద పట్టణం వెతకండి\n          </p>\n        </div>\n      )}\n    </div>\n  )\n}\n","numLines":228,"startLine":1,"totalLines":228}},"sourceToolAssistantUUID":"a8ea02f0-2320-4bef-aafe-bf876ab4bb9f","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"7a6aaaaf-7f8a-495a-9a66-4b6152eec242","version":"2.1.128","gitBranch":"main"}
