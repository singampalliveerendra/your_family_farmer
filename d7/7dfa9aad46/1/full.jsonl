{"parentUuid":"7e7c7109-191f-4d54-8dd2-0a15a8699b6a","isSidechain":false,"promptId":"1172beb6-f58e-478b-860c-6322e3d08858","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GrwvDBJQ9p8KvwCeyyobDH","type":"tool_result","content":"1\t'use client'\n2\t\n3\timport { useState } from 'react'\n4\timport { supabase } from '@/lib/supabase'\n5\timport { useLang } from '@/lib/LanguageContext'\n6\timport { FreshnessBadge } from '@/components/FreshnessBadge'\n7\timport { useCart } from '@/components/consumer/Cart'\n8\t\n9\ttype Produce = {\n10\t  id: string\n11\t  name: string\n12\t  variety?: string\n13\t  emoji?: string\n14\t  method?: string\n15\t  status: string\n16\t  price_tier_1_qty?: number\n17\t  price_tier_1_price?: number\n18\t  price_tier_2_qty?: number\n19\t  price_tier_2_price?: number\n20\t  price_tier_3_qty?: number\n21\t  price_tier_3_price?: number\n22\t  stock_qty?: number\n23\t  brix?: number\n24\t  pesticide_result?: string\n25\t  shelf_life_days?: number\n26\t  available_to?: string\n27\t  description?: string\n28\t  image_url?: string\n29\t  harvest_date?: string | null\n30\t}\n31\t\n32\ttype PickupSlots = { days: string[]; time_from: string; time_to: string }\n33\t\n34\ttype Farmer = {\n35\t  id?: string\n36\t  name?: string\n37\t  phone?: string\n38\t  village?: string\n39\t  slug?: string\n40\t  pickup_locations?: string[] | null\n41\t  pickup_slots?: PickupSlots | null\n42\t  upi_id?: string | null\n43\t}\n44\t\n45\tconst EMOJI_OPTIONS = ['🍅', '🍌', '🥭', '🫑', '🥬', '🍆', '🥕', '🌽', '🧅', '🧄', '🥦', '🌿', '🍓', '🫒', '🌾']\n46\tconst STATUS_OPTIONS = ['available', 'coming_soon']\n47\t\n48\texport default function ProduceTab({\n49\t  farmer,\n50\t  produce,\n51\t  isEditMode = false,\n52\t}: {\n53\t  farmer: Record<string, unknown>\n54\t  produce: Record<string, unknown>[]\n55\t  isEditMode?: boolean\n56\t}) {\n57\t  const { tx } = useLang()\n58\t  const f = farmer as Farmer\n59\t  const { addItem } = useCart()\n60\t  const [listings, setListings] = useState<Produce[]>(produce as Produce[])\n61\t  const available = listings.filter((p) => p.status === 'available' && p.stock_qty !== 0)\n62\t  const comingSoon = listings.filter((p) => p.status === 'coming_soon')\n63\t\n64\t  const handleProduceAdded = (newItem: Produce) => {\n65\t    setListings((prev) => [newItem, ...prev])\n66\t  }\n67\t\n68\t  const handleDelete = async (id: string) => {\n69\t    if (!confirm('Are you sure? / మీరు నిశ్చితంగా ఉన్నారా?')) return\n70\t    const { error } = await supabase.from('produce_listings').delete().eq('id', id)\n71\t    if (error) {\n72\t      alert(`Could not delete: ${error.message}`)\n73\t      return\n74\t    }\n75\t    setListings((prev) => prev.filter((p) => p.id !== id))\n76\t  }\n77\t\n78\t  const farmerCartInfo = {\n79\t    farmerId: f.id ?? '',\n80\t    farmerName: f.name ?? '',\n81\t    farmerPhone: f.phone ?? '',\n82\t    farmerVillage: f.village ?? '',\n83\t    farmerSlug: f.slug ?? '',\n84\t    farmerPickupLocations: Array.isArray(f.pickup_locations) ? f.pickup_locations : [],\n85\t    farmerPickupSlots: f.pickup_slots ?? null,\n86\t    farmerUpiId: f.upi_id ?? undefined,\n87\t  }\n88\t\n89\t  return (\n90\t    <div className=\"space-y-6\">\n91\t      {available.length > 0 && (\n92\t        <div>\n93\t          <div className=\"flex items-center gap-2 mb-3\">\n94\t            <span className=\"bg-green-700 text-white text-xs font-bold px-3 py-1 rounded-full\">\n95\t              {tx.availableNow}\n96\t            </span>\n97\t          </div>\n98\t          <div className=\"space-y-3\">\n99\t            {available.map((item) => (\n100\t              <ProduceCard\n101\t                key={item.id}\n102\t                item={item}\n103\t                farmerInfo={farmerCartInfo}\n104\t                onAddToCart={(qty) => addItem({\n105\t                  listingId: item.id,\n106\t                  name: item.name,\n107\t                  variety: item.variety,\n108\t                  emoji: item.emoji,\n109\t                  pricePerKg: item.price_tier_1_price,\n110\t                  priceTier1Qty: item.price_tier_1_qty,\n111\t                  priceTier1Price: item.price_tier_1_price,\n112\t                  priceTier2Qty: item.price_tier_2_qty,\n113\t                  priceTier2Price: item.price_tier_2_price,\n114\t                  priceTier3Price: item.price_tier_3_price,\n115\t                  unit: undefined,\n116\t                  stockQty: item.stock_qty,\n117\t                  ...farmerCartInfo,\n118\t                }, qty)}\n119\t                onDelete={isEditMode ? () => handleDelete(item.id) : undefined}\n120\t              />\n121\t            ))}\n122\t          </div>\n123\t        </div>\n124\t      )}\n125\t\n126\t      {comingSoon.length > 0 && (\n127\t        <div>\n128\t          <div className=\"flex items-center gap-2 mb-3\">\n129\t            <span className=\"bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full\">\n130\t              {tx.comingSoon}\n131\t            </span>\n132\t          </div>\n133\t          <div className=\"space-y-3\">\n134\t            {comingSoon.map((item) => (\n135\t              <ComingSoonCard\n136\t                key={item.id}\n137\t                item={item}\n138\t                farmerId={item.id}\n139\t                onDelete={isEditMode ? () => handleDelete(item.id) : undefined}\n140\t              />\n141\t            ))}\n142\t          </div>\n143\t        </div>\n144\t      )}\n145\t\n146\t      {listings.length === 0 && (\n147\t        <div className=\"text-center py-6 text-gray-400 text-sm\">{tx.noProduceListed}</div>\n148\t      )}\n149\t\n150\t      {isEditMode && f.id && (\n151\t        <AddProduceForm farmerId={f.id} onAdded={handleProduceAdded} />\n152\t      )}\n153\t    </div>\n154\t  )\n155\t}\n156\t\n157\tfunction AddProduceForm({ farmerId, onAdded }: { farmerId: string; onAdded: (item: Produce) => void }) {\n158\t  const [open, setOpen] = useState(false)\n159\t  const [name, setName] = useState('')\n160\t  const [variety, setVariety] = useState('')\n161\t  const [emoji, setEmoji] = useState('🌿')\n162\t  const [status, setStatus] = useState<'available' | 'coming_soon'>('available')\n163\t  const [price, setPrice] = useState('')\n164\t  const [stock, setStock] = useState('')\n165\t  const [loading, setLoading] = useState(false)\n166\t  const [success, setSuccess] = useState(false)\n167\t  const [error, setError] = useState('')\n168\t\n169\t  const reset = () => {\n170\t    setName(''); setVariety(''); setEmoji('🌿'); setStatus('available')\n171\t    setPrice(''); setStock(''); setSuccess(false); setError('')\n172\t  }\n173\t\n174\t  const handleSubmit = async () => {\n175\t    if (!name.trim()) return\n176\t    setLoading(true)\n177\t    setError('')\n178\t\n179\t    const payload: Record<string, unknown> = {\n180\t      farmer_id: farmerId,\n181\t      name: name.trim(),\n182\t      emoji,\n183\t      status,\n184\t      method: 'Natural',\n185\t    }\n186\t    if (variety.trim()) payload.variety = variety.trim()\n187\t    if (price) payload.price_tier_1_price = Number(price)\n188\t    if (stock) payload.stock_qty = Number(stock)\n189\t\n190\t    const { data, error: insertError } = await supabase.from('produce_listings').insert(payload).select().single()\n191\t    setLoading(false)\n192\t    if (!insertError && data) {\n193\t      onAdded(data as Produce)\n194\t      setSuccess(true)\n195\t      setTimeout(() => { reset(); setOpen(false) }, 1500)\n196\t    } else {\n197\t      setError(insertError?.message ?? 'Failed to add produce. Check Supabase RLS policies.')\n198\t    }\n199\t  }\n200\t\n201\t  if (!open) {\n202\t    return (\n203\t      <button\n204\t        onClick={() => setOpen(true)}\n205\t        className=\"w-full border-2 border-dashed border-green-300 rounded-xl py-4 text-green-700 text-sm font-semibold flex items-center justify-center gap-2 hover:border-green-500 hover:bg-green-50 transition-colors\"\n206\t      >\n207\t        <span className=\"text-lg\">+</span> Add your produce / మీ పంట చేర్చండి\n208\t      </button>\n209\t    )\n210\t  }\n211\t\n212\t  return (\n213\t    <div className=\"bg-white rounded-xl border border-gray-200 p-4 space-y-4\">\n214\t      <div className=\"flex items-center justify-between\">\n215\t        <h3 className=\"font-bold text-gray-800 text-sm\">Add produce / పంట చేర్చండి</h3>\n216\t        <button onClick={() => { reset(); setOpen(false) }} className=\"text-gray-400 text-lg leading-none\">×</button>\n217\t      </div>\n218\t\n219\t      {/* Emoji picker */}\n220\t      <div>\n221\t        <p className=\"text-xs text-gray-500 mb-2\">Pick an icon / ఐకాన్ ఎంచుకోండి</p>\n222\t        <div className=\"flex flex-wrap gap-2\">\n223\t          {EMOJI_OPTIONS.map((e) => (\n224\t            <button\n225\t              key={e}\n226\t              onClick={() => setEmoji(e)}\n227\t              className={`w-9 h-9 rounded-lg text-xl flex items-center justify-center transition-all ${emoji === e ? 'bg-green-100 ring-2 ring-green-500' : 'bg-gray-50'}`}\n228\t            >\n229\t              {e}\n230\t            </button>\n231\t          ))}\n232\t        </div>\n233\t      </div>\n234\t\n235\t      {/* Name + variety */}\n236\t      <div className=\"space-y-2\">\n237\t        <input\n238\t          type=\"text\"\n239\t          placeholder=\"Produce name / పంట పేరు (e.g. Papaya)\"\n240\t          value={name}\n241\t          onChange={(e) => setName(e.target.value)}\n242\t          className=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm\"\n243\t        />\n244\t        <input\n245\t          type=\"text\"\n246\t          placeholder=\"Variety (optional) / రకం\"\n247\t          value={variety}\n248\t          onChange={(e) => setVariety(e.target.value)}\n249\t          className=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm\"\n250\t        />\n251\t      </div>\n252\t\n253\t      {/* Price + stock */}\n254\t      <div className=\"grid grid-cols-2 gap-2\">\n255\t        <input\n256\t          type=\"number\"\n257\t          placeholder=\"Price / kg (₹) / ధర\"\n258\t          value={price}\n259\t          onChange={(e) => setPrice(e.target.value)}\n260\t          className=\"border border-gray-200 rounded-lg px-3 py-2 text-sm\"\n261\t        />\n262\t        <input\n263\t          type=\"number\"\n264\t          placeholder=\"Stock (kg) / నిల్వ\"\n265\t          value={stock}\n266\t          onChange={(e) => setStock(e.target.value)}\n267\t          className=\"border border-gray-200 rounded-lg px-3 py-2 text-sm\"\n268\t        />\n269\t      </div>\n270\t\n271\t      {/* Status */}\n272\t      <div className=\"flex gap-2\">\n273\t        {STATUS_OPTIONS.map((s) => (\n274\t          <button\n275\t            key={s}\n276\t            onClick={() => setStatus(s as 'available' | 'coming_soon')}\n277\t            className={`flex-1 py-2 rounded-lg text-xs font-semibold transition-colors ${\n278\t              status === s\n279\t                ? s === 'available' ? 'bg-green-700 text-white' : 'bg-amber-500 text-white'\n280\t                : 'bg-gray-100 text-gray-600'\n281\t            }`}\n282\t          >\n283\t            {s === 'available' ? 'Available now / అందుబాటులో' : 'Coming soon / త్వరలో'}\n284\t          </button>\n285\t        ))}\n286\t      </div>\n287\t\n288\t      {error && (\n289\t        <p className=\"text-center text-xs text-red-600 bg-red-50 rounded-lg px-3 py-2\">{error}</p>\n290\t      )}\n291\t\n292\t      {success ? (\n293\t        <p className=\"text-center text-sm text-green-700 font-semibold py-1\">\n294\t          ✓ Added successfully! / చేర్చబడింది!\n295\t        </p>\n296\t      ) : (\n297\t        <button\n298\t          onClick={handleSubmit}\n299\t          disabled={loading || !name.trim()}\n300\t          className=\"w-full bg-green-700 text-white text-sm font-semibold py-2.5 rounded-lg disabled:opacity-50\"\n301\t        >\n302\t          {loading ? 'Adding... / చేరుస్తోంది' : 'Add produce / పంట చేర్చండి'}\n303\t        </button>\n304\t      )}\n305\t    </div>\n306\t  )\n307\t}\n308\t\n309\ttype FarmerCartInfo = {\n310\t  farmerId: string\n311\t  farmerName: string\n312\t  farmerPhone: string\n313\t  farmerVillage: string\n314\t  farmerSlug: string\n315\t  farmerPickupLocations: string[]\n316\t  farmerPickupSlots: PickupSlots | null\n317\t  farmerUpiId?: string\n318\t}\n319\t\n320\tfunction ProduceCard({\n321\t  item,\n322\t  farmerInfo,\n323\t  onAddToCart,\n324\t  onDelete,\n325\t}: {\n326\t  item: Produce\n327\t  farmerInfo: FarmerCartInfo\n328\t  onAddToCart: (qty: number) => void\n329\t  onDelete?: () => void\n330\t}) {\n331\t  const { tx } = useLang()\n332\t  const [added, setAdded] = useState(false)\n333\t\n334\t  const bgColors: Record<string, string> = {\n335\t    '🍅': 'bg-red-100', '🥬': 'bg-green-100', '🥭': 'bg-orange-100',\n336\t    '🍆': 'bg-purple-100', '🥕': 'bg-orange-100', '🌽': 'bg-yellow-100',\n337\t    '🍌': 'bg-yellow-100', '🫑': 'bg-green-100',\n338\t  }\n339\t  const emoji = item.emoji ?? '🌿'\n340\t  const bg = bgColors[emoji] ?? 'bg-green-100'\n341\t\n342\t  const handleAdd = () => {\n343\t    onAddToCart(1)\n344\t    setAdded(true)\n345\t    setTimeout(() => setAdded(false), 1500)\n346\t  }\n347\t\n348\t  return (\n349\t    <div className=\"bg-white rounded-xl border border-gray-100 overflow-hidden shadow-sm\">\n350\t      <div className=\"flex gap-3 p-3\">\n351\t        {item.image_url ? (\n352\t          <img\n353\t            src={item.image_url}\n354\t            alt={item.name}\n355\t            loading=\"lazy\"\n356\t            className=\"rounded-xl w-14 h-14 object-cover flex-shrink-0 bg-gray-100\"\n357\t          />\n358\t        ) : (\n359\t          <div className={`${bg} rounded-xl w-14 h-14 flex items-center justify-center text-3xl flex-shrink-0`}>\n360\t            {emoji}\n361\t          </div>\n362\t        )}\n363\t        <div className=\"flex-1 min-w-0\">\n364\t          <div className=\"flex items-start justify-between gap-2\">\n365\t            <div>\n366\t              <h3 className=\"font-bold text-gray-900 text-sm\">{item.name}</h3>\n367\t              {item.variety && <p className=\"text-xs text-gray-500\">{item.variety}</p>}\n368\t            </div>\n369\t            {item.stock_qty !== undefined && (\n370\t              <span className=\"text-xs text-gray-500 flex-shrink-0\">{item.stock_qty} {tx.stockLeft}</span>\n371\t            )}\n372\t          </div>\n373\t          <div className=\"flex flex-wrap gap-1 mt-1.5\">\n374\t            {item.method && (\n375\t              <span className=\"bg-green-100 text-green-800 text-[10px] font-semibold px-2 py-0.5 rounded-full\">{item.method}</span>\n376\t            )}\n377\t            {item.pesticide_result && (\n378\t              <span className=\"bg-blue-100 text-blue-800 text-[10px] font-semibold px-2 py-0.5 rounded-full\">{item.pesticide_result}</span>\n379\t            )}\n380\t            {item.brix && (\n381\t              <span className=\"bg-amber-100 text-amber-800 text-[10px] font-semibold px-2 py-0.5 rounded-full\">BRIX {item.brix}</span>\n382\t            )}\n383\t            {item.harvest_date && <FreshnessBadge harvestDate={item.harvest_date} />}\n384\t          </div>\n385\t          {item.description && (\n386\t            <p className=\"text-xs text-gray-600 mt-2 leading-snug whitespace-pre-line\">\n387\t              {item.description}\n388\t            </p>\n389\t          )}\n390\t        </div>\n391\t      </div>\n392\t\n393\t      {item.price_tier_1_price && (\n394\t        <div className=\"border-t border-gray-100 px-3 py-2 bg-gray-50\">\n395\t          <div className=\"flex flex-wrap gap-x-3 gap-y-1 text-xs text-gray-700\">\n396\t            {item.price_tier_1_price && (\n397\t              <span>{item.price_tier_1_qty ? `1–${item.price_tier_2_qty ? item.price_tier_2_qty - 1 : item.price_tier_1_qty} kg` : 'Per kg'}: <strong>₹{item.price_tier_1_price}</strong></span>\n398\t            )}\n399\t            {item.price_tier_2_qty && item.price_tier_2_price && (\n400\t              <span>{item.price_tier_2_qty}–{item.price_tier_3_qty ? item.price_tier_3_qty - 1 : '+'} kg: <strong>₹{item.price_tier_2_price}</strong></span>\n401\t            )}\n402\t            {item.price_tier_3_qty && item.price_tier_3_price && (\n403\t              <span>{item.price_tier_3_qty}+ kg: <strong>₹{item.price_tier_3_price}</strong></span>\n404\t            )}\n405\t          </div>\n406\t        </div>\n407\t      )}\n408\t\n409\t      <div className=\"px-3 pb-3 pt-2 space-y-2\">\n410\t        <button\n411\t          onClick={handleAdd}\n412\t          className={`flex items-center justify-center gap-2 w-full font-bold py-3.5 rounded-xl text-base transition-colors ${\n413\t            added\n414\t              ? 'bg-green-100 text-green-800'\n415\t              : 'bg-green-700 text-white active:bg-green-800'\n416\t          }`}\n417\t        >\n418\t          {added ? (\n419\t            <>✓ Added to cart / బుట్టకు చేర్చబడింది</>\n420\t          ) : (\n421\t            <>\n422\t              <span className=\"text-xl leading-none\">+</span>\n423\t              Add to cart / బుట్టకు చేర్చండి\n424\t            </>\n425\t          )}\n426\t        </button>\n427\t        {onDelete && (\n428\t          <button\n429\t            onClick={onDelete}\n430\t            className=\"w-full border border-red-200 text-red-600 font-semibold py-2.5 rounded-xl text-sm active:bg-red-50\"\n431\t          >\n432\t            🗑 Delete / తొలగించు\n433\t          </button>\n434\t        )}\n435\t      </div>\n436\t    </div>\n437\t  )\n438\t}\n439\t\n440\tfunction ComingSoonCard({ item, farmerId, onDelete }: { item: Produce; farmerId: string; onDelete?: () => void }) {\n441\t  const { tx } = useLang()\n442\t  const [name, setName] = useState('')\n443\t  const [phone, setPhone] = useState('')\n444\t  const [submitted, setSubmitted] = useState(false)\n445\t  const [loading, setLoading] = useState(false)\n446\t\n447\t  const handleNotify = async () => {\n448\t    if (!name || !phone) return\n449\t    setLoading(true)\n450\t    await supabase.from('notify_requests').insert({\n451\t      farmer_id: farmerId,\n452\t      produce_name: item.name,\n453\t      requester_name: name,\n454\t      requester_phone: phone,\n455\t    })\n456\t    setSubmitted(true)\n457\t    setLoading(false)\n458\t  }\n459\t\n460\t  return (\n461\t    <div className=\"bg-white rounded-xl border-2 border-dashed border-gray-200 p-4\">\n462\t      <div className=\"flex items-center justify-between mb-2\">\n463\t        <div>\n464\t          <h3 className=\"font-bold text-gray-700 text-sm\">{item.emoji ?? '🌱'} {item.name}</h3>\n465\t          {item.available_to && (\n466\t            <p className=\"text-xs text-gray-500 mt-0.5\">\n467\t              {tx.expected} {new Date(item.available_to).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })}\n468\t            </p>\n469\t          )}\n470\t        </div>\n471\t        <span className=\"bg-amber-100 text-amber-700 text-[10px] font-bold px-2 py-1 rounded-full\">\n472\t          {tx.comingSoon}\n473\t        </span>\n474\t      </div>\n475\t\n476\t      {submitted ? (\n477\t        <p className=\"text-sm text-green-700 font-semibold text-center py-2\">{tx.notifySuccess}</p>\n478\t      ) : (\n479\t        <div className=\"space-y-2 mt-3\">\n480\t          <input type=\"text\" placeholder={tx.yourName} value={name} onChange={(e) => setName(e.target.value)}\n481\t            className=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm\" />\n482\t          <input type=\"tel\" placeholder={tx.yourPhone} value={phone} onChange={(e) => setPhone(e.target.value)}\n483\t            className=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm\" />\n484\t          <button onClick={handleNotify} disabled={loading}\n485\t            className=\"w-full bg-amber-600 text-white text-sm font-semibold py-2.5 rounded-lg disabled:opacity-60\">\n486\t            {loading ? tx.saving : tx.notifyMe}\n487\t          </button>\n488\t        </div>\n489\t      )}\n490\t\n491\t      {onDelete && (\n492\t        <button\n493\t          onClick={onDelete}\n494\t          className=\"mt-3 w-full border border-red-200 text-red-600 font-semibold py-2.5 rounded-lg text-sm active:bg-red-50\"\n495\t        >\n496\t          🗑 Delete / తొలగించు\n497\t        </button>\n498\t      )}\n499\t    </div>\n500\t  )\n501\t}\n502\t"}]},"uuid":"7af2704a-b32d-4039-9a32-0a8d3a0d4090","timestamp":"2026-05-05T08:49:36.462Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/components/farmer/tabs/ProduceTab.tsx","content":"'use client'\n\nimport { useState } from 'react'\nimport { supabase } from '@/lib/supabase'\nimport { useLang } from '@/lib/LanguageContext'\nimport { FreshnessBadge } from '@/components/FreshnessBadge'\nimport { useCart } from '@/components/consumer/Cart'\n\ntype Produce = {\n  id: string\n  name: string\n  variety?: string\n  emoji?: string\n  method?: string\n  status: string\n  price_tier_1_qty?: number\n  price_tier_1_price?: number\n  price_tier_2_qty?: number\n  price_tier_2_price?: number\n  price_tier_3_qty?: number\n  price_tier_3_price?: number\n  stock_qty?: number\n  brix?: number\n  pesticide_result?: string\n  shelf_life_days?: number\n  available_to?: string\n  description?: string\n  image_url?: string\n  harvest_date?: string | null\n}\n\ntype PickupSlots = { days: string[]; time_from: string; time_to: string }\n\ntype Farmer = {\n  id?: string\n  name?: string\n  phone?: string\n  village?: string\n  slug?: string\n  pickup_locations?: string[] | null\n  pickup_slots?: PickupSlots | null\n  upi_id?: string | null\n}\n\nconst EMOJI_OPTIONS = ['🍅', '🍌', '🥭', '🫑', '🥬', '🍆', '🥕', '🌽', '🧅', '🧄', '🥦', '🌿', '🍓', '🫒', '🌾']\nconst STATUS_OPTIONS = ['available', 'coming_soon']\n\nexport default function ProduceTab({\n  farmer,\n  produce,\n  isEditMode = false,\n}: {\n  farmer: Record<string, unknown>\n  produce: Record<string, unknown>[]\n  isEditMode?: boolean\n}) {\n  const { tx } = useLang()\n  const f = farmer as Farmer\n  const { addItem } = useCart()\n  const [listings, setListings] = useState<Produce[]>(produce as Produce[])\n  const available = listings.filter((p) => p.status === 'available' && p.stock_qty !== 0)\n  const comingSoon = listings.filter((p) => p.status === 'coming_soon')\n\n  const handleProduceAdded = (newItem: Produce) => {\n    setListings((prev) => [newItem, ...prev])\n  }\n\n  const handleDelete = async (id: string) => {\n    if (!confirm('Are you sure? / మీరు నిశ్చితంగా ఉన్నారా?')) return\n    const { error } = await supabase.from('produce_listings').delete().eq('id', id)\n    if (error) {\n      alert(`Could not delete: ${error.message}`)\n      return\n    }\n    setListings((prev) => prev.filter((p) => p.id !== id))\n  }\n\n  const farmerCartInfo = {\n    farmerId: f.id ?? '',\n    farmerName: f.name ?? '',\n    farmerPhone: f.phone ?? '',\n    farmerVillage: f.village ?? '',\n    farmerSlug: f.slug ?? '',\n    farmerPickupLocations: Array.isArray(f.pickup_locations) ? f.pickup_locations : [],\n    farmerPickupSlots: f.pickup_slots ?? null,\n    farmerUpiId: f.upi_id ?? undefined,\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      {available.length > 0 && (\n        <div>\n          <div className=\"flex items-center gap-2 mb-3\">\n            <span className=\"bg-green-700 text-white text-xs font-bold px-3 py-1 rounded-full\">\n              {tx.availableNow}\n            </span>\n          </div>\n          <div className=\"space-y-3\">\n            {available.map((item) => (\n              <ProduceCard\n                key={item.id}\n                item={item}\n                farmerInfo={farmerCartInfo}\n                onAddToCart={(qty) => addItem({\n                  listingId: item.id,\n                  name: item.name,\n                  variety: item.variety,\n                  emoji: item.emoji,\n                  pricePerKg: item.price_tier_1_price,\n                  priceTier1Qty: item.price_tier_1_qty,\n                  priceTier1Price: item.price_tier_1_price,\n                  priceTier2Qty: item.price_tier_2_qty,\n                  priceTier2Price: item.price_tier_2_price,\n                  priceTier3Price: item.price_tier_3_price,\n                  unit: undefined,\n                  stockQty: item.stock_qty,\n                  ...farmerCartInfo,\n                }, qty)}\n                onDelete={isEditMode ? () => handleDelete(item.id) : undefined}\n              />\n            ))}\n          </div>\n        </div>\n      )}\n\n      {comingSoon.length > 0 && (\n        <div>\n          <div className=\"flex items-center gap-2 mb-3\">\n            <span className=\"bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full\">\n              {tx.comingSoon}\n            </span>\n          </div>\n          <div className=\"space-y-3\">\n            {comingSoon.map((item) => (\n              <ComingSoonCard\n                key={item.id}\n                item={item}\n                farmerId={item.id}\n                onDelete={isEditMode ? () => handleDelete(item.id) : undefined}\n              />\n            ))}\n          </div>\n        </div>\n      )}\n\n      {listings.length === 0 && (\n        <div className=\"text-center py-6 text-gray-400 text-sm\">{tx.noProduceListed}</div>\n      )}\n\n      {isEditMode && f.id && (\n        <AddProduceForm farmerId={f.id} onAdded={handleProduceAdded} />\n      )}\n    </div>\n  )\n}\n\nfunction AddProduceForm({ farmerId, onAdded }: { farmerId: string; onAdded: (item: Produce) => void }) {\n  const [open, setOpen] = useState(false)\n  const [name, setName] = useState('')\n  const [variety, setVariety] = useState('')\n  const [emoji, setEmoji] = useState('🌿')\n  const [status, setStatus] = useState<'available' | 'coming_soon'>('available')\n  const [price, setPrice] = useState('')\n  const [stock, setStock] = useState('')\n  const [loading, setLoading] = useState(false)\n  const [success, setSuccess] = useState(false)\n  const [error, setError] = useState('')\n\n  const reset = () => {\n    setName(''); setVariety(''); setEmoji('🌿'); setStatus('available')\n    setPrice(''); setStock(''); setSuccess(false); setError('')\n  }\n\n  const handleSubmit = async () => {\n    if (!name.trim()) return\n    setLoading(true)\n    setError('')\n\n    const payload: Record<string, unknown> = {\n      farmer_id: farmerId,\n      name: name.trim(),\n      emoji,\n      status,\n      method: 'Natural',\n    }\n    if (variety.trim()) payload.variety = variety.trim()\n    if (price) payload.price_tier_1_price = Number(price)\n    if (stock) payload.stock_qty = Number(stock)\n\n    const { data, error: insertError } = await supabase.from('produce_listings').insert(payload).select().single()\n    setLoading(false)\n    if (!insertError && data) {\n      onAdded(data as Produce)\n      setSuccess(true)\n      setTimeout(() => { reset(); setOpen(false) }, 1500)\n    } else {\n      setError(insertError?.message ?? 'Failed to add produce. Check Supabase RLS policies.')\n    }\n  }\n\n  if (!open) {\n    return (\n      <button\n        onClick={() => setOpen(true)}\n        className=\"w-full border-2 border-dashed border-green-300 rounded-xl py-4 text-green-700 text-sm font-semibold flex items-center justify-center gap-2 hover:border-green-500 hover:bg-green-50 transition-colors\"\n      >\n        <span className=\"text-lg\">+</span> Add your produce / మీ పంట చేర్చండి\n      </button>\n    )\n  }\n\n  return (\n    <div className=\"bg-white rounded-xl border border-gray-200 p-4 space-y-4\">\n      <div className=\"flex items-center justify-between\">\n        <h3 className=\"font-bold text-gray-800 text-sm\">Add produce / పంట చేర్చండి</h3>\n        <button onClick={() => { reset(); setOpen(false) }} className=\"text-gray-400 text-lg leading-none\">×</button>\n      </div>\n\n      {/* Emoji picker */}\n      <div>\n        <p className=\"text-xs text-gray-500 mb-2\">Pick an icon / ఐకాన్ ఎంచుకోండి</p>\n        <div className=\"flex flex-wrap gap-2\">\n          {EMOJI_OPTIONS.map((e) => (\n            <button\n              key={e}\n              onClick={() => setEmoji(e)}\n              className={`w-9 h-9 rounded-lg text-xl flex items-center justify-center transition-all ${emoji === e ? 'bg-green-100 ring-2 ring-green-500' : 'bg-gray-50'}`}\n            >\n              {e}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Name + variety */}\n      <div className=\"space-y-2\">\n        <input\n          type=\"text\"\n          placeholder=\"Produce name / పంట పేరు (e.g. Papaya)\"\n          value={name}\n          onChange={(e) => setName(e.target.value)}\n          className=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm\"\n        />\n        <input\n          type=\"text\"\n          placeholder=\"Variety (optional) / రకం\"\n          value={variety}\n          onChange={(e) => setVariety(e.target.value)}\n          className=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm\"\n        />\n      </div>\n\n      {/* Price + stock */}\n      <div className=\"grid grid-cols-2 gap-2\">\n        <input\n          type=\"number\"\n          placeholder=\"Price / kg (₹) / ధర\"\n          value={price}\n          onChange={(e) => setPrice(e.target.value)}\n          className=\"border border-gray-200 rounded-lg px-3 py-2 text-sm\"\n        />\n        <input\n          type=\"number\"\n          placeholder=\"Stock (kg) / నిల్వ\"\n          value={stock}\n          onChange={(e) => setStock(e.target.value)}\n          className=\"border border-gray-200 rounded-lg px-3 py-2 text-sm\"\n        />\n      </div>\n\n      {/* Status */}\n      <div className=\"flex gap-2\">\n        {STATUS_OPTIONS.map((s) => (\n          <button\n            key={s}\n            onClick={() => setStatus(s as 'available' | 'coming_soon')}\n            className={`flex-1 py-2 rounded-lg text-xs font-semibold transition-colors ${\n              status === s\n                ? s === 'available' ? 'bg-green-700 text-white' : 'bg-amber-500 text-white'\n                : 'bg-gray-100 text-gray-600'\n            }`}\n          >\n            {s === 'available' ? 'Available now / అందుబాటులో' : 'Coming soon / త్వరలో'}\n          </button>\n        ))}\n      </div>\n\n      {error && (\n        <p className=\"text-center text-xs text-red-600 bg-red-50 rounded-lg px-3 py-2\">{error}</p>\n      )}\n\n      {success ? (\n        <p className=\"text-center text-sm text-green-700 font-semibold py-1\">\n          ✓ Added successfully! / చేర్చబడింది!\n        </p>\n      ) : (\n        <button\n          onClick={handleSubmit}\n          disabled={loading || !name.trim()}\n          className=\"w-full bg-green-700 text-white text-sm font-semibold py-2.5 rounded-lg disabled:opacity-50\"\n        >\n          {loading ? 'Adding... / చేరుస్తోంది' : 'Add produce / పంట చేర్చండి'}\n        </button>\n      )}\n    </div>\n  )\n}\n\ntype FarmerCartInfo = {\n  farmerId: string\n  farmerName: string\n  farmerPhone: string\n  farmerVillage: string\n  farmerSlug: string\n  farmerPickupLocations: string[]\n  farmerPickupSlots: PickupSlots | null\n  farmerUpiId?: string\n}\n\nfunction ProduceCard({\n  item,\n  farmerInfo,\n  onAddToCart,\n  onDelete,\n}: {\n  item: Produce\n  farmerInfo: FarmerCartInfo\n  onAddToCart: (qty: number) => void\n  onDelete?: () => void\n}) {\n  const { tx } = useLang()\n  const [added, setAdded] = useState(false)\n\n  const bgColors: Record<string, string> = {\n    '🍅': 'bg-red-100', '🥬': 'bg-green-100', '🥭': 'bg-orange-100',\n    '🍆': 'bg-purple-100', '🥕': 'bg-orange-100', '🌽': 'bg-yellow-100',\n    '🍌': 'bg-yellow-100', '🫑': 'bg-green-100',\n  }\n  const emoji = item.emoji ?? '🌿'\n  const bg = bgColors[emoji] ?? 'bg-green-100'\n\n  const handleAdd = () => {\n    onAddToCart(1)\n    setAdded(true)\n    setTimeout(() => setAdded(false), 1500)\n  }\n\n  return (\n    <div className=\"bg-white rounded-xl border border-gray-100 overflow-hidden shadow-sm\">\n      <div className=\"flex gap-3 p-3\">\n        {item.image_url ? (\n          <img\n            src={item.image_url}\n            alt={item.name}\n            loading=\"lazy\"\n            className=\"rounded-xl w-14 h-14 object-cover flex-shrink-0 bg-gray-100\"\n          />\n        ) : (\n          <div className={`${bg} rounded-xl w-14 h-14 flex items-center justify-center text-3xl flex-shrink-0`}>\n            {emoji}\n          </div>\n        )}\n        <div className=\"flex-1 min-w-0\">\n          <div className=\"flex items-start justify-between gap-2\">\n            <div>\n              <h3 className=\"font-bold text-gray-900 text-sm\">{item.name}</h3>\n              {item.variety && <p className=\"text-xs text-gray-500\">{item.variety}</p>}\n            </div>\n            {item.stock_qty !== undefined && (\n              <span className=\"text-xs text-gray-500 flex-shrink-0\">{item.stock_qty} {tx.stockLeft}</span>\n            )}\n          </div>\n          <div className=\"flex flex-wrap gap-1 mt-1.5\">\n            {item.method && (\n              <span className=\"bg-green-100 text-green-800 text-[10px] font-semibold px-2 py-0.5 rounded-full\">{item.method}</span>\n            )}\n            {item.pesticide_result && (\n              <span className=\"bg-blue-100 text-blue-800 text-[10px] font-semibold px-2 py-0.5 rounded-full\">{item.pesticide_result}</span>\n            )}\n            {item.brix && (\n              <span className=\"bg-amber-100 text-amber-800 text-[10px] font-semibold px-2 py-0.5 rounded-full\">BRIX {item.brix}</span>\n            )}\n            {item.harvest_date && <FreshnessBadge harvestDate={item.harvest_date} />}\n          </div>\n          {item.description && (\n            <p className=\"text-xs text-gray-600 mt-2 leading-snug whitespace-pre-line\">\n              {item.description}\n            </p>\n          )}\n        </div>\n      </div>\n\n      {item.price_tier_1_price && (\n        <div className=\"border-t border-gray-100 px-3 py-2 bg-gray-50\">\n          <div className=\"flex flex-wrap gap-x-3 gap-y-1 text-xs text-gray-700\">\n            {item.price_tier_1_price && (\n              <span>{item.price_tier_1_qty ? `1–${item.price_tier_2_qty ? item.price_tier_2_qty - 1 : item.price_tier_1_qty} kg` : 'Per kg'}: <strong>₹{item.price_tier_1_price}</strong></span>\n            )}\n            {item.price_tier_2_qty && item.price_tier_2_price && (\n              <span>{item.price_tier_2_qty}–{item.price_tier_3_qty ? item.price_tier_3_qty - 1 : '+'} kg: <strong>₹{item.price_tier_2_price}</strong></span>\n            )}\n            {item.price_tier_3_qty && item.price_tier_3_price && (\n              <span>{item.price_tier_3_qty}+ kg: <strong>₹{item.price_tier_3_price}</strong></span>\n            )}\n          </div>\n        </div>\n      )}\n\n      <div className=\"px-3 pb-3 pt-2 space-y-2\">\n        <button\n          onClick={handleAdd}\n          className={`flex items-center justify-center gap-2 w-full font-bold py-3.5 rounded-xl text-base transition-colors ${\n            added\n              ? 'bg-green-100 text-green-800'\n              : 'bg-green-700 text-white active:bg-green-800'\n          }`}\n        >\n          {added ? (\n            <>✓ Added to cart / బుట్టకు చేర్చబడింది</>\n          ) : (\n            <>\n              <span className=\"text-xl leading-none\">+</span>\n              Add to cart / బుట్టకు చేర్చండి\n            </>\n          )}\n        </button>\n        {onDelete && (\n          <button\n            onClick={onDelete}\n            className=\"w-full border border-red-200 text-red-600 font-semibold py-2.5 rounded-xl text-sm active:bg-red-50\"\n          >\n            🗑 Delete / తొలగించు\n          </button>\n        )}\n      </div>\n    </div>\n  )\n}\n\nfunction ComingSoonCard({ item, farmerId, onDelete }: { item: Produce; farmerId: string; onDelete?: () => void }) {\n  const { tx } = useLang()\n  const [name, setName] = useState('')\n  const [phone, setPhone] = useState('')\n  const [submitted, setSubmitted] = useState(false)\n  const [loading, setLoading] = useState(false)\n\n  const handleNotify = async () => {\n    if (!name || !phone) return\n    setLoading(true)\n    await supabase.from('notify_requests').insert({\n      farmer_id: farmerId,\n      produce_name: item.name,\n      requester_name: name,\n      requester_phone: phone,\n    })\n    setSubmitted(true)\n    setLoading(false)\n  }\n\n  return (\n    <div className=\"bg-white rounded-xl border-2 border-dashed border-gray-200 p-4\">\n      <div className=\"flex items-center justify-between mb-2\">\n        <div>\n          <h3 className=\"font-bold text-gray-700 text-sm\">{item.emoji ?? '🌱'} {item.name}</h3>\n          {item.available_to && (\n            <p className=\"text-xs text-gray-500 mt-0.5\">\n              {tx.expected} {new Date(item.available_to).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })}\n            </p>\n          )}\n        </div>\n        <span className=\"bg-amber-100 text-amber-700 text-[10px] font-bold px-2 py-1 rounded-full\">\n          {tx.comingSoon}\n        </span>\n      </div>\n\n      {submitted ? (\n        <p className=\"text-sm text-green-700 font-semibold text-center py-2\">{tx.notifySuccess}</p>\n      ) : (\n        <div className=\"space-y-2 mt-3\">\n          <input type=\"text\" placeholder={tx.yourName} value={name} onChange={(e) => setName(e.target.value)}\n            className=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm\" />\n          <input type=\"tel\" placeholder={tx.yourPhone} value={phone} onChange={(e) => setPhone(e.target.value)}\n            className=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm\" />\n          <button onClick={handleNotify} disabled={loading}\n            className=\"w-full bg-amber-600 text-white text-sm font-semibold py-2.5 rounded-lg disabled:opacity-60\">\n            {loading ? tx.saving : tx.notifyMe}\n          </button>\n        </div>\n      )}\n\n      {onDelete && (\n        <button\n          onClick={onDelete}\n          className=\"mt-3 w-full border border-red-200 text-red-600 font-semibold py-2.5 rounded-lg text-sm active:bg-red-50\"\n        >\n          🗑 Delete / తొలగించు\n        </button>\n      )}\n    </div>\n  )\n}\n","numLines":502,"startLine":1,"totalLines":502}},"sourceToolAssistantUUID":"7e7c7109-191f-4d54-8dd2-0a15a8699b6a","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"7a6aaaaf-7f8a-495a-9a66-4b6152eec242","version":"2.1.128","gitBranch":"main"}
