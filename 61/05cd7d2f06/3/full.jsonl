{"parentUuid":"c0fa3bbe-2c96-45ce-8ab9-3eb63c8bb3c9","isSidechain":false,"promptId":"8995b283-45e8-40aa-ad9b-265beb0e3d60","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PE9uWexAeYA3R3DjZtn8aw","type":"tool_result","content":"1\t'use client'\n2\t\n3\timport { useState } from 'react'\n4\timport { useRouter } from 'next/navigation'\n5\timport ModeratorShell, { useModeratorAuth } from '../../ModeratorShell'\n6\t\n7\ttype Created = { id: string; slug: string; name: string; phone: string | null }\n8\t\n9\texport default function NewFarmerPage() {\n10\t  const router = useRouter()\n11\t  const { zone, checked } = useModeratorAuth()\n12\t\n13\t  const EMPTY_FORM = {\n14\t    name: '', phone: '', village: '', district: '',\n15\t    method: 'natural', farm_size_acres: '', farming_since_year: '', story_quote: '',\n16\t    farm_address: '', upi_id: '',\n17\t  }\n18\t  const [form, setForm] = useState(EMPTY_FORM)\n19\t  const [error, setError] = useState('')\n20\t  const [submitting, setSubmitting] = useState(false)\n21\t  const [created, setCreated] = useState<Created | null>(null)\n22\t\n23\t  // Pickup & payout details (same shape as the farmer's own profile editor).\n24\t  const ALL_DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']\n25\t  const [pickupLocations, setPickupLocations] = useState<string[]>([])\n26\t  const [newPickup, setNewPickup] = useState('')\n27\t  const [slotDays, setSlotDays] = useState<string[]>([])\n28\t  const [slotFrom, setSlotFrom] = useState('08:00')\n29\t  const [slotTo, setSlotTo] = useState('12:00')\n30\t  const [codEnabled, setCodEnabled] = useState(false)\n31\t\n32\t  const resetAll = () => {\n33\t    setForm(EMPTY_FORM)\n34\t    setPickupLocations([]); setNewPickup('')\n35\t    setSlotDays([]); setSlotFrom('08:00'); setSlotTo('12:00')\n36\t    setCodEnabled(false)\n37\t  }\n38\t\n39\t  const addPickup = () => {\n40\t    const v = newPickup.trim()\n41\t    if (!v || pickupLocations.includes(v)) { setNewPickup(''); return }\n42\t    setPickupLocations((prev) => [...prev, v]); setNewPickup('')\n43\t  }\n44\t  const removePickup = (loc: string) => setPickupLocations((prev) => prev.filter((l) => l !== loc))\n45\t  const toggleDay = (d: string) =>\n46\t    setSlotDays((prev) => (prev.includes(d) ? prev.filter((x) => x !== d) : [...prev, d]))\n47\t\n48\t  const set = (k: keyof typeof form) => (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) =>\n49\t    setForm((f) => ({ ...f, [k]: e.target.value }))\n50\t\n51\t  const submit = async (e: React.FormEvent) => {\n52\t    e.preventDefault()\n53\t    if (submitting) return\n54\t    setError('')\n55\t    setSubmitting(true)\n56\t    const r = await fetch('/api/moderator/farmers', {\n57\t      method: 'POST',\n58\t      headers: { 'Content-Type': 'application/json' },\n59\t      credentials: 'same-origin',\n60\t      body: JSON.stringify({\n61\t        ...form,\n62\t        pickup_locations: pickupLocations,\n63\t        pickup_slots: slotDays.length > 0 ? { days: slotDays, time_from: slotFrom, time_to: slotTo } : null,\n64\t        cod_enabled: codEnabled,\n65\t      }),\n66\t    }).catch(() => null)\n67\t    setSubmitting(false)\n68\t    if (!r) { setError('Network error.'); return }\n69\t    const json = await r.json().catch(() => ({}))\n70\t    if (!r.ok || !json?.farmer) { setError(json?.error ?? 'Could not save farmer.'); return }\n71\t    setCreated(json.farmer as Created)\n72\t  }\n73\t\n74\t  if (!checked || !zone) {\n75\t    return (\n76\t      <main className=\"min-h-screen bg-gray-50 flex items-center justify-center\">\n77\t        <div className=\"w-10 h-10 border-4 border-green-700 border-t-transparent rounded-full animate-spin\" />\n78\t      </main>\n79\t    )\n80\t  }\n81\t\n82\t  // Success screen with profile link + WhatsApp share.\n83\t  if (created) {\n84\t    const profileUrl = `${typeof window !== 'undefined' ? window.location.origin : ''}/farmer/${created.slug}`\n85\t    const digits = (created.phone ?? '').replace(/\\D/g, '')\n86\t    const waPhone = digits.length === 10 ? `91${digits}` : digits\n87\t    const waText = encodeURIComponent(`Your farm page is live: ${profileUrl}`)\n88\t    const waLink = `https://wa.me/${waPhone}?text=${waText}`\n89\t\n90\t    return (\n91\t      <ModeratorShell title=\"Farmer added\" zone={zone}>\n92\t        <div className=\"bg-white rounded-2xl border border-gray-100 p-6 max-w-md\">\n93\t          <div className=\"text-4xl mb-2\">✅</div>\n94\t          <h2 className=\"text-lg font-extrabold text-gray-900\">{created.name} is registered</h2>\n95\t          <p className=\"text-sm text-gray-500 mt-1\">Their profile page is live:</p>\n96\t          <a href={`/farmer/${created.slug}`} target=\"_blank\" className=\"block text-green-700 underline text-sm mt-1 break-all\">{profileUrl}</a>\n97\t\n98\t          <div className=\"flex flex-col gap-2 mt-5\">\n99\t            {waPhone && (\n100\t              <a\n101\t                href={waLink}\n102\t                target=\"_blank\"\n103\t                className=\"bg-green-600 text-white text-sm font-bold px-4 py-3 rounded-xl text-center active:bg-green-700\"\n104\t              >\n105\t                Share via WhatsApp\n106\t              </a>\n107\t            )}\n108\t            <button\n109\t              onClick={() => { setCreated(null); resetAll() }}\n110\t              className=\"bg-white border border-gray-200 text-gray-700 text-sm font-bold px-4 py-3 rounded-xl active:bg-gray-50\"\n111\t            >\n112\t              + Add another farmer\n113\t            </button>\n114\t            <button\n115\t              onClick={() => router.push('/moderator/farmers')}\n116\t              className=\"text-gray-500 text-sm underline\"\n117\t            >\n118\t              Back to farmer list\n119\t            </button>\n120\t          </div>\n121\t        </div>\n122\t      </ModeratorShell>\n123\t    )\n124\t  }\n125\t\n126\t 