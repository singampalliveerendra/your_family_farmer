Keep it last in the picker.\n115\tconst EMOJI_OPTIONS = ['🍅', '🍌', '🥭', '🫑', '🥬', '🍆', '🥕', '🌽', '🧅', '🧄', '🥦', '🌿', '🍓', '🫒', '🌾', '🥥', '📦']\n116\t\n117\tasync function compressImage(file: File, maxPx = 800, quality = 0.7): Promise<File> {\n118\t  return new Promise((resolve) => {\n119\t    const img = new Image()\n120\t    const blobUrl = URL.createObjectURL(file)\n121\t    img.onload = () => {\n122\t      URL.revokeObjectURL(blobUrl)\n123\t      const scale = Math.min(1, maxPx / Math.max(img.naturalWidth, img.naturalHeight))\n124\t      const canvas = document.createElement('canvas')\n125\t      canvas.width = Math.round(img.naturalWidth * scale)\n126\t      canvas.height = Math.round(img.naturalHeight * scale)\n127\t      const ctx = canvas.getContext('2d')\n128\t      if (!ctx) { resolve(file); return }\n129\t      ctx.drawImage(img, 0, 0, canvas.width, canvas.height)\n130\t      canvas.toBlob(\n131\t        (blob) => {\n132\t          if (!blob) { resolve(file); return }\n133\t          const name = file.name.replace(/\\.[^.]+$/, '.jpg')\n134\t          resolve(new File([blob], name, { type: 'image/jpeg' }))\n135\t        },\n136\t        'image/jpeg',\n137\t        quality,\n138\t      )\n139\t    }\n140\t    img.onerror = () => { URL.revokeObjectURL(blobUrl); resolve(file) }\n141\t    img.src = blobUrl\n142\t  })\n143\t}\n144\t\n145\tconst isProfileComplete = (f: Farmer | null) =>\n146\t  !!f && f.name?.trim().length > 0 && f.village?.trim().length > 0\n147\t\n148\texport default function FarmerDashboard() {\n149\t  const router = useRouter()\n150\t  const { tx } = useLang()\n151\t  const [farmer, setFarmer] = useState<Farmer | null>(null)\n152\t  const [loading, setLoading] = useState(true)\n153\t  const [notFound, setNotFound] = useState(false)\n154\t  const [activeListings, setActiveListings] = useState(0)\n155\t  const [pendingOrders, setPendingOrders] = useState<Order[]>([])\n156\t  const [approvedCount, setApprovedCount] = useState(0)\n157\t  const [totalRevenue, setTotalRevenue] = useState(0)\n158\t  const [ordersFilter, setOrdersFilter] = useState<'today' | 'week' | 'month'>('week')\n159\t  const [processingOrderId, setProcessingOrderId] = useState<string | null>(null)\n160\t  const [processingPaidId, setProcessingPaidId] = useState<string | null>(null)\n161\t  const [decliningOrder, setDecliningOrder] = useState<Order | null>(null)\n162\t  const [declineResult, setDeclineResult] = useState<\n163\t    { buyerName: string | null; amount: number | null; refundInitiated: boolean } | null\n164\t  >(null)\n165\t  const [demandBars, setDemandBars] = useState<DemandBar[]>([])\n166\t  const [monthlyRevenue, setMonthlyRevenue] = useState(0)\n167\t  const [monthlyOrderCount, setMonthlyOrderCount] = useState(0)\n168\t  const [weeklyEarnings, setWeeklyEarnings] = useState<number[]>([0, 0, 0, 0])\n169\t  const [showForm, setShowForm] = useState(false)\n170\t  const [showProfileEdit, setShowProfileEdit] = useState(false)\n171\t  const [showListings, setShowListings] = useState(false)\n172\t\n173\t  const loadDashboard = useCallback(async () => {\n174\t    const farmerId = localStorage.getItem('yff_farmer_id')\n175\t    if (!farmerId) { router.replace('/farmer/login'); return }\n176\t\n177\t    const { data: farmerData } = await supabase\n178\t      .from('farmers')\n179\t      .select('*')\n180\t      .eq('id', farmerId)\n181\t      .maybeSingle()\n182\t\n183\t    if (!farmerData) { setNotFound(true); setLoading(false); return }\n184\t    setFarmer(farmerData)\n185\t\n186\t    const monthStart = new Date()\n187\t    monthStart.setDate(1)\n188\t    monthStart.setHours(0, 0, 0, 0)\n189\t\n190\t    const [listingsRes, pendingRes, approvedRes, intentsRes, monthlyRes] = await Promise.all([\n191\t      supabase.from('produce_listings').select('id', { count: 'exact', head: true }).eq('farmer_id', farmerData.id).eq('status', 'available'),\n192\t      supabase.from('orders').select('*').eq('farmer_id', farmerData.id).eq('status', 'pending').order('created_at', { ascending: false }),\n193\t      supabase.from('orders').select('id, total_price').eq('farmer_id', farmerData.id).eq('status', 'approved').gte('created_at', new Date(Date.now() - 7 * 86400000).toISOString()),\n194\t      supabase.from('demand_intents').select('crop_name, quantity_kg').eq('region_slug', farmerData.region_slug).eq('fulfilled', false),\n195\t      supabase.from('orders').select('id, total_price, created_at').eq('farmer_id', farmerData.id).eq('status', 'approved').gte('created_at', monthStart.toISOString()),\n196\t    ])\n197\t\n198\t    setActiveListings(listingsRes.count ?? 0)\n199\t    setPendingOrders((pendingRes.data ?? []) as Order[])\n200\t    const approved = approvedRes.data ?? []\n201\t    setApprovedCount(approved.length)\n202\t    setTotalRevenue(approved.reduce((sum, o) => sum + (o.total_price ?? 0), 0))\n203\t\n204\t    // Monthly earnings\n205\t    const monthly = monthlyRes.data ?? []\n206\t    setMonthlyRevenue(monthly.reduce((sum, o) => sum + (o.total_price ?? 0), 0))\n207\t    setMonthlyOrderCount(monthly.length)\n208\t\n209\t    // Break into 4 weekly buckets (days 1-7, 8-14, 15-21, 22+)\n210\t    const weeks = [0, 0, 0, 0]\n211\t    for (const o of monthly) {\n212\t      const day = new Date(o.created_at).getDate()\n213\t      const bucket = day <= 7 ? 0 : day <= 14 ? 1 : day <= 21 ? 2 : 3\n214\t      weeks[bucket] += o.total_price ?? 0\n215\t    }\n216\t    setWeeklyEarnings(weeks)\n217\t\n218\t    const map: Record<string, number> = {}\n219\t    for (const row of intentsRes.data ?? []) {\n220\t      map[row.crop_name] = (map[row.crop_name] ?? 0) + (Number(row.quantity_kg) || 0)\n221\t    }\n222\t    setDemandBars(\n223\t      Object.entries(map)\n224\t        .map(([crop_name, total_qty]) => ({ crop_name, total_qty }))\n225\t        .sort((a, b) => b.total_qty - a.total_qty)\n226\t        .slice(0, 5)\n227\t    )\n228\t\n229\t    setLoading(false)\n230\t  }, [router])\n231\t\n232\t  useEffect(() => { loadDashboard() }, [loadDashboard])\n233\t\n234\t  // Auto-open the profile edit modal the first time an incomplete farmer lands here.\n235\t  useEffect(() => {\n236\t    if (!loading && farmer && !isProfileComplete(farmer)) {\n237\t      setShowProfileEdit(true)\n238\t    }\n239\t  }, [loading, farmer])\n240\t\n241\t  // Realtime subscription: new orders + payment status changes.\n242\t  // Replaces the old \"consumer opens WhatsApp to notify farmer\" flow.\n243\t  // Fires a browser notification when:\n244\t  //   - A new pending order is inserted\n245\t  //   - An existing order's payment_status flips to payment_claimed (incl. retries)\n246\t  useEffect(() => {\n247\t    if (!farmer) return\n248\t\n249\t    const fireNotification = (title: string, body: string) => {\n250\t      if (typeof window === 'undefined') return\n251\t      if (!('Notification' in window)) return\n252\t      if (Notification.permission !== 'granted') return\n253\t      try {\n254\t        new Notification(title, { body, icon: '/icon-192.png', tag: 'yff-order' })\n255\t      } catch { /* some browsers throw on background tabs — ignore */ }\n256\t    }\n257\t\n258\t    const channel = supabase\n259\t      .channel(`orders_${farmer.id}`)\n260\t      .on(\n261\t        'postgres_changes',\n262\t        { event: 'INSERT', schema: 'public', table: 'orders', filter: `farmer_id=eq.${farmer.id}` },\n263\t        (payload) => {\n264\t          const row = payload.new as Order\n265\t          if (row.status !== 'pending') return\n266\t          setPendingOrders((prev) => prev.some((o) => o.id === row.id) ? prev : [row, ...prev])\n267\t          fireNotification(\n268\t            `New order from ${row.buyer_name ?? 'buyer'}`,\n269\t            `${row.produce_name ?? ''} ${row.quantity ?? ''} ${row.unit ?? ''}${row.total_price ? ` · ₹${row.total_price}` : ''}`.trim(),\n270\t          )\n271\t        },\n272\t      )\n273\t      .on(\n274\t        'postgres_changes',\n275\t        { event: 'UPDATE', schema: 'public', table: 'orders', filter: `farmer_id=eq.${farmer.id}` },\n276\t        (payload) => {\n277\t          const row = payload.new as Order\n278\t          const prev = payload.old as Partial<Order>\n279\t          // Order moved out of pending — drop from list\n280\t          if (row.status !== 'pending') {\n281\t            setPendingOrders((cur) => cur.filter((o) => o.id !== row.id))\n282\t            return\n283\t          }\n284\t          // Update or insert in pending list\n285\t          setPendingOrders((cur) => {\n286\t            const exists = cur.some((o) => o.id === row.id)\n287\t            return exists ? cur.map((o) => o.id === row.id ? row : o) : [row, ...cur]\n288\t          })\n289\t          // Fire notification when buyer claims payment (covers initial pay AND retry)\n290\t          const becameClaimed =\n291\t            (row.payment_status === 'payment_claimed' || row.payment_status === 'pending_confirmation')\n292\t            && prev.payment_status !== row.payment_status\n293\t          if (becameClaimed) {\n294\t            fireNotification(\n295\t              `Buyer paid — verify payment`,\n296\t              `${row.buyer_name ?? 'Buyer'} sent ₹${row.total_price ?? '?'} for ${row.produce_name ?? 'order'}`,\n297\t            )\n298\t          }\n299\t        },\n300\t      )\n301\t      .subscribe()\n302\t\n303\t    return () => { supabase.removeChannel(channel) }\n304\t  }, [farmer])\n305\t\n306\t  // Safety net for the realtime subscription: on slow/spotty 4G the websocket\n307\t  // can silently drop while the farmer is on another app. Refetch whenever the\n308\t  // dashboard tab regains focus so they never miss a new order.\n309\t  useEffect(() => {\n310\t    const refetch = () => { if (document.visibilityState === 'visible') loadDashboard() }\n311\t    document.addEventListener('visibilitychange', refetch)\n312\t    window.addEventListener('focus', refetch)\n313\t    return () => {\n314\t      document.removeEventListener('visibilitychange', refetch)\n315\t      window.removeEventListener('focus', refetch)\n316\t    }\n317\t  }, [loadDashboard])\n318\t\n319\t  const handleLogout = () => {\n320\t    localStorage.removeItem('yff_farmer_id')\n321\t    localStorage.removeItem('yff_farmer_slug')\n322\t    router.replace('/farmer/login')\n323\t  }\n324\t\n325\t  const handleApprove = async (orderId: string) => {\n326\t    setProcessingOrderId(orderId)\n327\t    await supabase.from('orders').update({ status: 'approved' }).eq('id', orderId)\n328\t    setPendingOrders((prev) => prev.filter((o) => o.id !== orderId))\n329\t    setApprovedCount((c) => c + 1)\n330\t    setProcessingOrderId(null)\n331\t  }\n332\t\n333\t  const handleConfirmDecline = async (orderId: string, reason: string) => {\n334\t    const declined = decliningOrder\n335\t    setProcessingOrderId(orderId)\n336\t    // Declining runs server-side: it returns the reserved stock and, for a\n337\t    // paid order, issues a REAL Razorpay refund (the secret can't live in the\n338\t    // browser). If the refund fails the order stays pending so we can retry.\n339\t    try {\n340\t      const res = await fetch(`/api/farmer/orders/${orderId}/decline`, {\n341\t        method: 'POST',\n342\t        credentials: 'same-origin',\n343\t        headers: { 'Content-Type': 'application/json' },\n344\t        body: JSON.stringify({ reason }),\n345\t      })\n346\t      const json = await res.json().catch(() => ({}))\n347\t      if (!res.ok) {\n348\t        alert(json.error || 'Could not decline the order. Please try again. / ఆర్డర్ తిరస్కరించలేకపోయాం. మళ్ళీ ప్రయత్నించండి.')\n349\t        return\n350\t      }\n351\t      // Whether a refund went out (real Razorpay refund, or 'initiated' for\n352\t      // other paid methods) so we can confirm it to the farmer in plain terms.\n353\t      const refundInitiated = !!json.refunded || !!json.refundStatus\n354\t      setPendingOrders((prev) => prev.filter((o) => o.id !== orderId))\n355\t      setDeclineResult({\n356\t        buyerName: declined?.buyer_name ?? null,\n357\t        amount: declined?.total_price ?? null,\n358\t        refundInitiated,\n359\t      })\n360\t      setDecliningOrder(null)\n361\t    } catch {\n362\t      alert('Network error. Please try again. / నెట్‌వర్క్ సమస్య. మళ్ళీ ప్రయత్నించండి.')\n363\t    } finally {\n364\t      setProcessingOrderId(null)\n365\t    }\n366\t  }\n367\t\n368\t  const handleMarkPaid = async (orderId: string) => {\n369\t    setProcessingPaidId(orderId)\n370\t    await supabase.from('orders').update({ payment_status: 'completed' }).eq('id', orderId)\n371\t    setPendingOrders((prev) =>\n372\t      prev.map((o) => o.id === orderId ? { ...o, payment_status: 'completed' } : o)\n373\t    )\n374\t    setProcessingPaidId(null)\n375\t  }\n376\t\n377\t  const handleUpdatePaymentStatus = async (orderId: string, status: 'completed' | 'failed' | 'pending') => {\n378\t    setProcessingPaidId(orderId)\n379\t    const update: Record<string, string> = { payment_status: status }\n380\t    if (status === 'completed') update.status = 'approved'\n381\t    await supabase.from('orders').update(update).eq('id', orderId)\n382\t    setPendingOrders((prev) =>\n383\t      prev.map((o) => o.id === orderId ? { ...o, payment_status: status, ...(status === 'completed' ? { status: 'approved' } : {}) } : o)\n384\t    )\n385\t    setProcessingPaidId(null)\n386\t  }\n387\t\n388\t  const filteredPendingOrders = pendingOrders.filter((o) => {\n389\t    const t = new Date(o.created_at).getTime()\n390\t    const now = Date.now()\n391\t    if (ordersFilter === 'today') {\n392\t      const todayStart = new Date()\n393\t      todayStart.setHours(0, 0, 0, 0)\n394\t      return t >= todayStart.getTime()\n395\t    }\n396\t    if (ordersFilter === 'week') return t >= now - 7 * 86400000\n397\t    return t >= now - 30 * 86400000\n398\t  })\n399\t\n400\t  if (loading) return <LoadingScreen />\n401\t  if (notFound) return <FarmerNotFound onLogout={handleLogout} />\n402\t\n403\t  const profileComplete = isProfileComplete(farmer)\n404\t  const displayName = farmer!.name?.trim() || tx.welcome\n405\t\n406\t  return (\n407\t    <main className=\"min-h-screen bg-gray-50 pb-16\">\n408\t      {/* Header */}\n409\t      <div className=\"bg-green-900 px-4 pt-6 pb-10\">\n410\t        <div className=\"flex justify-end mb-2\">\n411\t          <LanguageToggle />\n412\t        </div>\n413\t        <div className=\"flex items-start justify-between\">\n414\t          <div>\n415\t            <p className=\"text-green-400 text-xs font-semibold mb-0.5 uppercase tracking-wide\">\n416\t              {tx.farmerDashboard}\n417\t            </p>\n418\t            <h1 className=\"text-white text-xl font-extrabold leading-tight\">{displayName}</h1>\n419\t            <p className=\"text-green-300 text-sm mt-0.5\">\n420\t              {profileComplete\n421\t                ? `${farmer!.village}, ${farmer!.district}`\n422\t                : tx.completeProfilePrompt}\n423\t            </p>\n424\t            <p className=\"text-green-500 text-xs mt-1\">+91 {farmer!.phone}</p>\n425\t          </div>\n426\t          <div className=\"flex flex-col items-end gap-2 flex-shrink-0\">\n427\t            {profileComplete ? (\n428\t              <Link\n429\t                href={`/farmer/${farmer!.slug}`}\n430\t                className=\"bg-white text-green-800 text-xs font-bold px-3 py-2 rounded-xl\"\n431\t              >\n432\t                {tx.viewProfile} ↗\n433\t              </Link>\n434\t            ) : (\n435\t              <span className=\"bg-amber-400 text-amber-900 text-[10px] font-bold px-2 py-1 rounded-full\">\n436\t                {tx.incomplete}\n437\t              </span>\n438\t            )}\n439\t            <button\n440\t              onClick={() => setShowProfileEdit(true)}\n441\t              className=\"text-white text-xs underline\"\n442\t            >\n443\t              {tx.editProfile}\n444\t            </button>\n445\t            <Link href=\"/farmer/complaints\" className=\"text-white text-xs underline\">\n446\t              {tx.complaints}\n447\t            </Link>\n448\t            <button onClick={handleLogout} className=\"text-green-500 text-xs underline\">\n449\t              {tx.logout}\n450\t            </button>\n451\t          </div>\n452\t        </div>\n453\t      </div>\n454\t\n455\t      <div className=\"px-4 -mt-5 space-y-4\">\n456\t        {/* Notification permission banner — shown only if browser supports it\n457\t            and the farmer hasn't decided yet. Permission must be requested via\n458\t            a user gesture so we can't auto-call it on mount. */}\n459\t        <NotificationPermissionBanner />\n460\t\n461\t        {/* Complete profile banner */}\n462\t        {!profileComplete && (\n463\t          <div className=\"bg-amber-50 border-2 border-amber-300 rounded-2xl p-4 flex items-start gap-3\">\n464\t            <span className=\"text-2xl flex-shrink-0\">📝</span>\n465\t            <div className=\"flex-1 min-w-0\">\n466\t              <h3 className=\"font-extrabold text-amber-900 text-base leading-tight\">\n467\t                {tx.completeProfileTitle}\n468\t              </h3>\n469\t              <p className=\"text-amber-700 text-xs mt-0.5\">\n470\t                {tx.completeProfileHelp}\n471\t              </p>\n472\t              <button\n473\t                onClick={() => setShowProfileEdit(true)}\n474\t                className=\"mt-3 bg-amber-600 text-white font-bold px-4 py-2.5 rounded-xl text-sm\"\n475\t              >\n476\t                {tx.fillDetails}\n477\t              </button>\n478\t            </div>\n479\t          </div>\n480\t        )}\n481\t\n482\t        {/* Stat cards */}\n483\t        <div className=\"grid grid-cols-2 gap-3\">\n484\t          <button\n485\t            onClick={() => setShowListings(true)}\n486\t            className=\"border-green-200 bg-green-50 border rounded-2xl p-4 text-left active:bg-green-100 relative\"\n487\t          >\n488\t            <div className=\"text-3xl font-black text-green-800\">{activeListings}</div>\n489\t            <div className=\"text-sm font-semibold text-gray-800 mt-1 leading-tight\">{tx.activeListings}</div>\n490\t            <div className=\"text-[11px] font-bold text-green-700 mt-2 flex items-center gap-1\">\n491\t              {tx.manage} <span aria-hidden>→</span>\n492\t            </div>\n493\t          </button>\n494\t          {[\n495\t            { label: tx.pendingOrders, value: pendingOrders.length, color: pendingOrders.length > 0 ? 'border-orange-300 bg-orange-50' : 'border-gray-200 bg-gray-50', vcolor: pendingOrders.length > 0 ? 'text-orange-700' : 'text-gray-500' },\n496\t            { label: tx.approvedThisWeek, value: approvedCount, color: 'border-green-200 bg-green-50', vcolor: 'text-green-800' },\n497\t            { label: tx.totalRevenue, value: totalRevenue > 0 ? `₹${totalRevenue}` : '—', color: 'border-purple-200 bg-purple-50', vcolor: 'text-purple-800' },\n498\t          ].map((s) => (\n499\t            <div key={s.label} className={`${s.color} border rounded-2xl p-4`}>\n500\t              <div className={`text-3xl font-black ${s.vcolor}`}>{s.value}</div>\n501\t              <div className=\"text-sm font-semibold text-gray-800 mt-1 leading-tight\">{s.label}</div>\n502\t            </div>\n503\t          ))}\n504\t        </div>\n505\t\n506\t        {/* Monthly earnings summary */}\n507\t        <EarningsCard\n508\t          revenue={monthlyRevenue}\n509\t          orderCount={monthlyOrderCount}\n510\t          weekly={weeklyEarnings}\n511\t        />\n512\t\n513\t        {/* Orders section */}\n514\t        <div className=\"bg-white rounded-2xl border border-gray-100 overflow-hidden\">\n515\t          <div className=\"px-4 pt-4 pb-3 flex items-center justify-between border-b border-gray-100\">\n516\t            <div>\n517\t              <h2 className=\"font-extrabold text-gray-900 text-base leading-tight\">\n518\t                {tx.ordersTab}\n519\t              </h2>\n520\t              <p className=\"text-xs text-gray-500 mt-0.5\">Pending orders need your response</p>\n521\t            </div>\n522\t            <Link href=\"/farmer/dashboard/orders\" className=\"text-xs font-bold text-green-700\">\n523\t              {tx.viewOrderHistory}\n524\t            </Link>\n525\t          </div>\n526\t\n527\t          <div className=\"px-4 pt-3 pb-2 flex gap-2\">\n528\t            {(['today', 'week', 'month'] as const).map((period) => (\n529\t              <button\n530\t                key={period}\n531\t                onClick={() => setOrdersFilter(period)}\n532\t                className={`px-3 py-1.5 rounded-full text-xs font-bold transition-colors ${\n533\t                  ordersFilter === period\n534\t                    ? 'bg-green-700 text-white'\n535\t                    : 'bg-gray-100 text-gray-600 active:bg-gray-200'\n536\t                }`}\n537\t              >\n538\t                {period === 'today' ? tx.filterToday : period === 'week' ? tx.filterWeek : tx.filterMonth}\n539\t              </button>\n540\t            ))}\n541\t          </div>\n542\t\n543\t          <div className=\"px-4 pb-4 space-y-3\">\n544\t            {filteredPendingOrders.length === 0 ? (\n545\t              <div className=\"text-center py-8\">\n546\t                <div className=\"text-4xl mb-2\">📭</div>\n547\t                <p className=\"font-semibold text-gray-500 text-sm\">{tx.noPendingOrders}</p>\n548\t                <p className=\"text-xs text-gray-400 mt-1\">{tx.noPendingHelp}</p>\n549\t              </div>\n550\t            ) : (\n551\t              filteredPendingOrders.map((order) => (\n552\t                <OrderCard\n553\t                  key={order.id}\n554\t                  order={order}\n555\t                  processing={processingOrderId === order.id}\n556\t                  processingPaid={processingPaidId === order.id}\n557\t                  onApprove={() => handleApprove(order.id)}\n558\t                  onDecline={() => setDecliningOrder(order)}\n559\t                  onMarkPaid={() => handleMarkPaid(order.id)}\n560\t                  onUpdatePaymentStatus={(s) => handleUpdatePaymentStatus(order.id, s)}\n561\t                />\n562\t              ))\n563\t            )}\n564\t          </div>\n565\t        </div>\n566\t\n567\t        {/* Demand chart */}\n568\t        <div className=\"bg-white rounded-2xl border border-gray-100 p-4\">\n569\t          <h2 className=\"font-extrabold text-gray-900 text-base leading-tight\">\n570\t            {tx.localDemand}\n571\t          </h2>\n572\t          <p className=\"text-xs text-gray-500 mt-0.5 mb-4\">\n573\t            {tx.localDemandHelp}\n574\t          </p>\n575\t\n576\t          {demandBars.length === 0 ? (\n577\t            <div className=\"text-center py-6\">\n578\t              <p className=\"text-gray-400 text-sm\">{tx.noDemandSignals}</p>\n579\t              <p className=\"text-gray-400 text-xs mt-1\">{tx.shareProfileLink}</p>\n580\t            </div>\n581\t          ) : (\n582\t            <div className=\"space-y-3\">\n583\t              {demandBars.map((bar) => {\n584\t                const pct = Math.round((bar.total_qty / demandBars[0].total_qty) * 100)\n585\t                return (\n586\t                  <div key={bar.crop_name}>\n587\t                    <div className=\"flex items-center justify-between mb-1\">\n588\t                      <span className=\"text-sm font-semibold text-gray-800\">{bar.crop_name}</span>\n589\t                      <span className=\"text-xs text-gray-400 font-medium\">{bar.total_qty} kg</span>\n590\t                    </div>\n591\t                    <div className=\"h-3 bg-gray-100 rounded-full overflow-hidden\">\n592\t                      <div\n593\t                        className=\"h-full bg-green-600 rounded-full\"\n594\t                        style={{ width: `${pct}%` }}\n595\t                      />\n596\t                    </div>\n597\t                  </div>\n598\t                )\n599\t              })}\n600\t            </div>\n601\t          )}\n602\t        </div>\n603\t\n604\t        {/* Add listing button */}\n605\t        {profileComplete ? (\n606\t          !showForm && (\n607\t            <button\n608\t              onClick={() => setShowForm(true)}\n609\t              className=\"w-full bg-white border-2 border-green-700 text-green-700 font-bold py-4 rounded-2xl text-base flex items-center justify-center gap-2 active:bg-green-50\"\n610\t            >\n611\t              <span className=\"text-xl leading-none\">+</span>\n612\t              {tx.addNewProduce}\n613\t            </button>\n614\t          )\n615\t        ) : (\n616\t          <div className=\"w-full bg-gray-100 text-gray-500 font-semibold py-4 rounded-2xl text-sm text-center\">\n617\t            {tx.completeBeforeAdd}\n618\t          </div>\n619\t        )}\n620\t\n621\t        {/* Listing form */}\n622\t        {showForm && profileComplete && (\n623\t          <ProduceListingForm\n624\t            farmerId={farmer!.id}\n625\t            farmerSlug={farmer!.slug}\n626\t            farmerRegion={farmer!.region_slug}\n627\t            defaultMethod={farmer!.method}\n628\t            onClose={() => setShowForm(false)}\n629\t            onPublished={() => { setShowForm(false); loadDashboard() }}\n630\t          />\n631\t        )}\n632\t\n633\t        {/* Farm photos */}\n634\t        {farmer && <FarmPhotosSection farmerId={farmer.id} />}\n635\t      </div>\n636\t\n637\t      {/* Manage listings modal */}\n638\t      {showListings && farmer && (\n639\t        <ManageListingsModal\n640\t          farmerId={farmer.id}\n641\t          farmerSlug={farmer.slug}\n642\t          farmerRegion={farmer.region_slug}\n643\t          defaultMethod={farmer.method ?? 'natural'}\n644\t          onClose={() => setShowListings(false)}\n645\t          onChanged={loadDashboard}\n646\t        />\n647\t      )}\n648\t\n649\t      {/* Edit profile modal */}\n650\t      {showProfileEdit && farmer && (\n651\t        <ProfileEditModal\n652\t          farmer={farmer}\n653\t          onClose={() => {\n654\t            // If profile still incomplete, don't allow close (keep banner as fallback)\n655\t            if (isProfileComplete(farmer)) setShowProfileEdit(false)\n656\t            else setShowProfileEdit(false) // allow dismiss; banner still shown\n657\t          }}\n658\t          onSaved={(updated) => {\n659\t            setFarmer(updated)\n660\t            setShowProfileEdit(false)\n661\t          }}\n662\t        />\n663\t      )}\n664\t\n665\t      {/* Decline reason sheet — mandatory reason capture */}\n666\t      {decliningOrder && (\n667\t        <DeclineReasonSheet\n668\t          order={decliningOrder}\n669\t          processing={processingOrderId === decliningOrder.id}\n670\t          onCancel={() => setDecliningOrder(null)}\n671\t          onConfirm={(reason) => handleConfirmDecline(decliningOrder.id, reason)}\n672\t        />\n673\t      )}\n674\t\n675\t      {/* Refund confirmation shown to the farmer right after declining */}\n676\t      {declineResult && (\n677\t        <DeclineSuccessSheet\n678\t          result={declineResult}\n679\t          onClose={() => setDeclineResult(null)}\n680\t        />\n681\t      )}\n682\t    </main>\n683\t  )\n684\t}\n685\t\n686\t/* ─── Decline success / refund confirmation sheet ──────────── */\n687\tfunction DeclineSuccessSheet({\n688\t  result,\n689\t  onClose,\n690\t}: {\n691\t  result: { buyerName: string | null; amount: number | null; refundInitiated: boolean }\n692\t  onClose: () => void\n693\t}) {\n694\t  const buyer = result.buyerName || 'the customer'\n695\t  return (\n696\t    <div className=\"fixed inset-0 z-[130] bg-black/50 flex items-end sm:items-center justify-center p-0 sm:p-4\">\n697\t      <div className=\"bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl p-6 text-center space-y-3\">\n698\t        <div className=\"text-4xl\">✅</div>\n699\t        <h2 className=\"font-extrabold text-gray-900 text-lg leading-tight\">\n700\t          Order declined / ఆర్డర్ తిరస్కరించబడింది\n701\t        </h2>\n702\t\n703\t        {result.refundInitiated ? (\n704\t          <div className=\"bg-green-50 border border-green-200 rounded-2xl p-4 text-left space-y-1.5\">\n705\t            <p className=\"font-bold text-green-800 text-sm flex items-center gap-1.5\">\n706\t              <span>💸</span> Refund initiated / రీఫండ్ ప్రారంభమైంది\n707\t            </p>\n708\t            <p className=\"text-sm text-gray-700 leading-snug\">\n709\t              {result.amount != null && result.amount > 0 ? (\n710\t                <>A refund of <span className=\"font-extrabold text-green-800\">₹{result.amount}</span> has been started to {buyer}.</>\n711\t              ) : (\n712\t                <>A refund has been started to {buyer}.</>\n713\t              )}\n714\t            </p>\n715\t            <p className=\"text-xs text-gray-500 leading-snug\">\n716\t              It will reach their account in <span className=\"font-semibold\">3–5 business days</span>.\n717\t              The customer has been told this automatically.\n718\t              <br />\n719\t              కొనుగోలుదారు ఖాతాకు 3–5 పని దినాలలో జమ అవుతుంది.\n720\t            </p>\n721\t          </div>\n722\t        ) : (\n723\t          <div className=\"bg-gray-50 border border-gray-200 rounded-2xl p-4 text-left\">\n724\t            <p className=\"text-sm text-gray-700 leading-snug\">\n725\t              {buyer} hadn&apos;t paid yet, so no refund is needed.\n726\t              <br />\n727\t              <span className=\"text-gray-500 text-xs\">చెల్లింపు జరగలేదు, రీఫండ్ అవసరం లేదు.</span>\n728\t            </p>\n729\t          </div>\n730\t        )}\n731\t\n732\t        <button\n733\t          onClick={onClose}\n734\t          className=\"w-full bg-green-700 text-white font-bold py-3 rounded-xl text-sm active:bg-green-800\"\n735\t        >\n736\t          Done / సరే\n737\t        </button>\n738\t      </div>\n739\t    </div>\n740\t  )\n741\t}\n742\t\n743\t/* ─── Decline reason bottom sheet ──────────────────────────── */\n744\tconst DECLINE_PRESETS = [\n745\t  'Stock finished',\n746\t  'Not available this week',\n747\t  'Price changed',\n748\t  'Incorrect order details',\n749\t]\n750\t\n751\tfunction DeclineReasonSheet({\n752\t  order,\n753\t  processing,\n754\t  onCancel,\n755\t  onConfirm,\n756\t}: {\n757\t  order: Order\n758\t  processing: boolean\n759\t  onCancel: () => void\n760\t  onConfirm: (reason: string) => void\n761\t}) {\n762\t  const [selected, setSelected] = useState<string | null>(null)\n763\t  const [custom, setCustom] = useState('')\n764\t\n765\t  const finalReason = selected ?? custom.trim()\n766\t  const canSubmit = finalReason.length >= 3 && !processing\n767\t\n768\t  return (\n769\t    <div className=\"fixed inset-0 z-[120] bg-black/50 flex items-end justify-center\">\n770\t      <div className=\"bg-white w-full max-w-md rounded-t-3xl p-5 space-y-4\">\n771\t        <div className=\"flex items-start justify-between gap-3\">\n772\t          <div>\n773\t            <h2 className=\"font-extrabold text-gray-900 text-lg leading-tight\">\n774\t              Why decline this order? / ఎందుకు తిరస్కరిస్తున్నారు?\n775\t            </h2>\n776\t            <p className=\"text-xs text-gray-500 mt-0.5 leading-snug\">\n777\t              The reason will be shown to the buyer / కారణం కొనుగోలుదారుకు చూపబడుతుంది\n778\t            </p>\n779\t          </div>\n780\t          <button\n781\t            onClick={onCancel}\n782\t            disabled={processing}\n783\t            className=\"text-gray-400 text-3xl leading-none p-1 disabled:opacity-50\"\n784\t          >\n785\t            ×\n786\t          </button>\n787\t        </div>\n788\t\n789\t        <div className=\"bg-gray-50 rounded-xl px-3 py-2 text-xs text-gray-700\">\n790\t          <span className=\"font-semibold\">{order.buyer_name || 'Buyer'}</span>\n791\t          {order.produce_name && <> · {order.produce_name}</>}\n792\t          {order.quantity != null && <> · {order.quantity} {order.unit || 'kg'}</>}\n793\t        </div>\n794\t\n795\t        <div className=\"space-y-2\">\n796\t          <p className=\"text-xs font-bold text-gray-700 uppercase tracking-wide\">\n797\t            Pick a reason / కారణం ఎంచుకోండి\n798\t          </p>\n799\t          <div className=\"grid grid-cols-2 gap-2\">\n800\t            {DECLINE_PRESETS.map((preset) => (\n801\t              <button\n802\t                key={preset}\n803\t                type=\"button\"\n804\t                onClick={() => { setSelected(preset); setCustom('') }}\n805\t                className={`px-3 py-2.5 rounded-xl text-xs font-bold border-2 transition-colors text-left leading-snug ${\n806\t                  selected === preset\n807\t                    ? 'border-red-500 bg-red-50 text-red-800'\n808\t                    : 'border-gray-200 bg-white text-gray-700 active:bg-gray-50'\n809\t                }`}\n810\t              >\n811\t                {preset}\n812\t              </button>\n813\t            ))}\n814\t          </div>\n815\t        </div>\n816\t\n817\t        <div>\n818\t          <label className=\"text-xs font-bold text-gray-700 uppercase tracking-wide block mb-1.5\">\n819\t            Or type your reason / లేదా టైప్ చేయండి\n820\t          </label>\n821\t          <textarea\n822\t            value={custom}\n823\t            onChange={(e) => { setCustom(e.target.value); if (e.target.value.trim()) setSelected(null) }}\n824\t            placeholder=\"e.g. Heavy rain damaged the harvest\"\n825\t            rows={2}\n826\t            className=\"w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:border-green-500 focus:outline-none resize-none\"\n827\t          />\n828\t        </div>\n829\t\n830\t        <div className=\"flex gap-2 pt-1\">\n831\t          <button\n832\t            onClick={onCancel}\n833\t            disabled={processing}\n834\t            className=\"flex-1 border-2 border-gray-300 text-gray-700 font-bold py-3 rounded-xl text-sm disabled:opacity-50\"\n835\t          >\n836\t            Cancel / రద్దు\n837\t          </button>\n838\t          <button\n839\t            onClick={() => onConfirm(finalReason)}\n840\t            disabled={!canSubmit}\n841\t            className=\"flex-1 bg-red-600 text-white font-bold py-3 rounded-xl text-sm disabled:opacity-50 active:bg-red-700\"\n842\t          >\n843\t            {processing ? 'Declining...' : 'Confirm decline'}\n844\t          </button>\n845\t        </div>\n846\t      </div>\n847\t    </div>\n848\t  )\n849\t}\n850\t\n851\t/* ─── Notification permission banner ───────────────────────── */\n852\tfunction NotificationPermissionBanner() {\n853\t  const [perm, setPerm] = useState<'unsupported' | 'default' | 'granted' | 'denied'>('unsupported')\n854\t  const [dismissed, setDismissed] = useState(false)\n855\t\n856\t  useEffect(() => {\n857\t    if (typeof window === 'undefined' || !('Notification' in window)) {\n858\t      setPerm('unsupported')\n859\t      return\n860\t    }\n861\t    setPerm(Notification.permission as 'default' | 'granted' | 'denied')\n862\t    setDismissed(localStorage.getItem('yff_notif_banner_dismissed') === '1')\n863\t  }, [])\n864\t\n865\t  const handleEnable = async () => {\n866\t    if (typeof window === 'undefined' || !('Notification' in window)) return\n867\t    const result = await Notification.requestPermission()\n868\t    setPerm(result)\n869\t    if (result === 'granted') {\n870\t      try { new Notification('YourFamilyFarmer', { body: 'You will be alerted on every new order.' }) } catch {}\n871\t    }\n872\t  }\n873\t\n874\t  const handleDismiss = () => {\n875\t    localStorage.setItem('yff_notif_banner_dismissed', '1')\n876\t    setDismissed(true)\n877\t  }\n878\t\n879\t  if (perm === 'unsupported' || perm === 'granted') return null\n880\t  if (dismissed) return null\n881\t\n882\t  if (perm === 'denied') {\n883\t    return (\n884\t      <div className=\"bg-amber-50 border border-amber-200 rounded-2xl p-3 flex items-start gap-3\">\n885\t        <span className=\"text-xl flex-shrink-0\">🔕</span>\n886\t        <div className=\"flex-1 min-w-0\">\n887\t          <p className=\"text-xs font-bold text-amber-900 leading-snug\">\n888\t            Notifications blocked / నోటిఫికేషన్‌లు బ్లాక్\n889\t          </p>\n890\t          <p className=\"text-[11px] text-amber-700 mt-0.5 leading-snug\">\n891\t            Enable notifications in your browser settings to get alerted on new orders.\n892\t          </p>\n893\t        </div>\n894\t        <button onClick={handleDismiss} className=\"text-amber-700 text-xl leading-none px-1\">×</button>\n895\t      </div>\n896\t    )\n897\t  }\n898\t\n899\t  return (\n900\t    <div className=\"bg-blue-50 border border-blue-200 rounded-2xl p-3 flex items-start gap-3\">\n901\t      <span className=\"text-xl flex-shrink-0\">🔔</span>\n902\t      <div className=\"flex-1 min-w-0\">\n903\t        <p className=\"text-xs font-bold text-blue-900 leading-snug\">\n904\t          Get notified instantly / తక్షణ నోటిఫికేషన్\n905\t        </p>\n906\t        <p className=\"text-[11px] text-blue-700 mt-0.5 leading-snug\">\n907\t          Allow notifications to be alerted the moment a buyer places an order.\n908\t        </p>\n909\t        <div className=\"flex gap-2 mt-2\">\n910\t          <button\n911\t            onClick={handleEnable}\n912\t            className=\"bg-blue-600 text-white font-bold px-3 py-1.5 rounded-lg text-xs active:bg-blue-700\"\n913\t          >\n914\t            Enable / ఆన్ చేయండి\n915\t          </button>\n916\t          <button\n917\t            onClick={handleDismiss}\n918\t            className=\"border border-blue-300 text-blue-700 font-semibold px-3 py-1.5 rounded-lg text-xs\"\n919\t          >\n920\t            Not now\n921\t          </button>\n922\t        </div>\n923\t      </div>\n924\t    </div>\n925\t  )\n926\t}\n927\t\n928\t/* ─── Profile edit modal ─────────────────────────────────── */\n929\tfunction ProfileEditModal({\n930\t  farmer,\n931\t  onClose,\n932\t  onSaved,\n933\t}: {\n934\t  farmer: Farmer\n935\t  onClose: () => void\n936\t  onSaved: (updated: Farmer) => void\n937\t}) {\n938\t  const { tx } = useLang()\n939\t  const [name, setName] = useState(farmer.name ?? '')\n940\t  const [village, setVillage] = useState(farmer.village ?? '')\n941\t  const [district, setDistrict] = useState(farmer.district ?? '')\n942\t  const [method, setMethod] = useState(farmer.method ?? 'natural')\n943\t  const [sinceYear, setSinceYear] = useState(\n944\t    farmer.farming_since_year ? String(farmer.farming_since_year) : '',\n945\t  )\n946\t  const [pickupLocations, setPickupLocations] = useState<string[]>(\n947\t    Array.isArray(farmer.pickup_locations) ? farmer.pickup_locations : [],\n948\t  )\n949\t  const [newPickup, setNewPickup] = useState('')\n950\t  const [farmAddress, setFarmAddress] = useState(farmer.farm_address ?? '')\n951\t\n952\t  // Cover photo\n953\t  const [coverFile, setCoverFile] = useState<File | null>(null)\n954\t  const [coverPreview, setCoverPreview] = useState('')\n955\t  const [existingCoverUrl, setExistingCoverUrl] = useState(farmer.cover_photo_url ?? '')\n956\t\n957\t  // Avatar photo\n958\t  const [avatarFile, setAvatarFile] = useState<File | null>(null)\n959\t  const [avatarPreview, setAvatarPreview] = useState('')\n960\t  const [existingAvatarUrl, setExistingAvatarUrl] = useState(farmer.photo_url ?? '')\n961\t\n962\t  // Pesticide cert\n963\t  const [certFile, setCertFile] = useState<File | null>(null)\n964\t  const [certPreview, setCertPreview] = useState('')\n965\t  const [existingCertUrl, setExistingCertUrl] = useState(farmer.pesticide_cert_url ?? '')\n966\t\n967\t  // Pickup schedule\n968\t  const ALL_DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']\n969\t  const [slotDays, setSlotDays] = useState<string[]>(farmer.pickup_slots?.days ?? [])\n970\t  const [slotFrom, setSlotFrom] = useState(farmer.pickup_slots?.time_from ?? '08:00')\n971\t  const [slotTo, setSlotTo]   = useState(farmer.pickup_slots?.time_to   ?? '12:00')\n972\t\n973\t  // UPI ID + QR\n974\t  const [upiId, setUpiId] = useState(farmer.upi_id ?? '')\n975\t  const [qrFile, setQrFile] = useState<File | null>(null)\n976\t  const [qrPreview, setQrPreview] = useState('')\n977\t  const [existingQrUrl, setExistingQrUrl] = useState(farmer.upi_qr_code_url ?? '')\n978\t\n979\t  // Cash on Delivery acceptance — default off\n980\t  const [codEnabled, setCodEnabled] = useState<boolean>(farmer.cod_enabled === true)\n981\t\n982\t  // Change password\n983\t  const [showPwSection, setShowPwSection] = useState(false)\n984\t  const [currentPassword, setCurrentPassword] = useState('')\n985\t  const [newPassword, setNewPassword]     = useState('')\n986\t  const [confirmPassword, setConfirmPassword] = useState('')\n987\t  const [pwLoading, setPwLoading]         = useState(false)\n988\t  const [pwError, setPwError]             = useState('')\n989\t  const [pwSuccess, setPwSuccess]         = useState(false)\n990\t\n991\t  // Farm GPS location\n992\t  const [farmerLat, setFarmerLat] = useState<number | null>(farmer.lat ?? null)\n993\t  const [farmerLng, setFarmerLng] = useState<number | null>(farmer.lng ?? null)\n994\t  const [farmerLocationName, setFarmerLocationName] = useState(farmer.location_name ?? '')\n995\t  const [locating, setLocating] = useState(false)\n996\t  const [locError, setLocError] = useState('')\n997\t\n998\t  const [loading, setLoading] = useState(false)\n999\t  const [error, setError] = useState('')\n1000\t\n1001\t  const handleFarmerGPS = () => {\n1002\t    if (!navigator.geolocation) {\n1003\t      setLocError('Geolocation not supported on this device.')\n1004\t      return\n1005\t    }\n1006\t    setLocating(true)\n1007\t    setLocError('')\n1008\t    navigator.geolocation.getCurrentPosition(\n1009\t      (pos) => {\n1010\t        const { latitude, longitude } = pos.coords\n1011\t        setFarmerLat(latitude)\n1012\t        setFarmerLng(longitude)\n1013\t        // Use village name as display name since we have it\n1014\t        setFarmerLocationName(farmer.village || 'Farm')\n1015\t        setLocating(false)\n1016\t      },\n1017\t      (err) => {\n1018\t        setLocError(\n1019\t          err.code === 1\n1020\t            ? 'Location permission denied / లొకేషన్ అనుమతి లేదు. Please allow location in browser settings.'\n1021\t            : 'Could not get location. Please try again. / మళ్ళీ ప్రయత్నించండి.'\n1022\t        )\n1023\t        setLocating(false)\n1024\t      },\n1025\t      { timeout: 15000, enableHighAccuracy: true },\n1026\t    )\n1027\t  }\n1028\t\n1029\t  const handlePickFile = async (\n1030\t    e: React.ChangeEvent<HTMLInputElement>,\n1031\t    setFile: (f: File | null) => void,\n1032\t    setPreview: (s: string) => void,\n1033\t    currentPreview: string,\n1034\t  ) => {\n1035\t    const file = e.target.files?.[0]\n1036\t    if (!file) return\n1037\t    if (!file.type.startsWith('image/')) { setError(tx.pickImageFile); return }\n1038\t    if (file.size > 8 * 1024 * 1024) { setError(tx.imageTooLarge); return }\n1039\t    setError('')\n1040\t    if (currentPreview) URL.revokeObjectURL(currentPreview)\n1041\t    const compressed = await compressImage(file)\n1042\t    setFile(compressed)\n1043\t    setPreview(URL.createObjectURL(compressed))\n1044\t  }\n1045\t\n1046\t  const uploadProfileImage = async (file: File, pathSuffix: string): Promise<{ url: string | null; err: string | null }> => {\n1047\t    const ext = file.name.split('.').pop()?.toLowerCase() || 'jpg'\n1048\t    // Include timestamp in path so each upload gets a unique URL, busting browser cache\n1049\t    const path = `${farmer.id}/${pathSuffix}-${Date.now()}.${ext}`\n1050\t    const { error: upErr } = await supabase.storage\n1051\t      .from('farm-images')\n1052\t      .upload(path, file, { contentType: file.type, upsert: false })\n1053\t    if (upErr) return { url: null, err: `Upload failed: ${upErr.message}` }\n1054\t    const { data } = supabase.storage.from('farm-images').getPublicUrl(path)\n1055\t    return { url: data.publicUrl, err: null }\n1056\t  }\n1057\t\n1058\t  const toggleDay = (day: string) => {\n1059\t    setSlotDays((prev) =>\n1060\t      prev.includes(day) ? prev.filter((d) => d !== day) : [...prev, day],\n1061\t    )\n1062\t  }\n1063\t\n1064\t  const addPickup = () => {\n1065\t    const v = newPickup.trim()\n1066\t    if (!v) return\n1067\t    if (pickupLocations.includes(v)) { setNewPickup(''); return }\n1068\t    setPickupLocations((prev) => [...prev, v])\n1069\t    setNewPickup('')\n1070\t  }\n1071\t  const removePickup = (loc: string) =>\n1072\t    setPickupLocations((prev) => prev.filter((l) => l !== loc))\n1073\t\n1074\t  const handleSave = async () => {\n1075\t    if (!name.trim()) { setError(tx.nameRequired); return }\n1076\t    if (!village.trim()) { setError(tx.villageRequired); return }\n1077\t    if (upiId.trim() && !/^[a-zA-Z0-9._\\-]{2,256}@[a-zA-Z]{2,64}$/.test(upiId.trim())) {\n1078\t      setError('Invalid UPI ID format. Example: yourname@ybl or 9876543210@paytm')\n1079\t      return\n1080\t    }\n1081\t    setLoading(true)\n1082\t    setError('')\n1083\t\n1084\t    // Build unique slug from name if current slug is still auto-generated\n1085\t    const isAutoSlug = /^f-\\d{10}-[a-z0-9]{4}$/.test(farmer.slug ?? '')\n1086\t    const baseSlug = name\n1087\t      .toLowerCase()\n1088\t      .trim()\n1089\t      .replace(/[^a-z0-9]+/g, '-')\n1090\t      .replace(/(^-|-$)/g, '')\n1091\t      .slice(0, 40) || 'farmer'\n1092\t    let newSlug = farmer.slug\n1093\t    if (isAutoSlug && baseSlug) {\n1094\t      const rand = Math.random().toString(36).slice(2, 5)\n1095\t      newSlug = `${baseSlug}-${rand}`\n1096\t    }\n1097\t\n1098\t    // Upload photos in parallel\n1099\t    const [coverRes, avatarRes, certRes, qrRes] = await Promise.all([\n1100\t      coverFile ? uploadProfileImage(coverFile, 'cover') : Promise.resolve({ url: null, err: null }),\n1101\t      avatarFile ? uploadProfileImage(avatarFile, 'avatar') : Promise.resolve({ url: null, err: null }),\n1102\t      certFile  ? uploadProfileImage(certFile,  'pesticide-cert') : Promise.resolve({ url: null, err: null }),\n1103\t      qrFile    ? uploadProfileImage(qrFile,    'upi-qr') : Promise.resolve({ url: null, err: null }),\n1104\t    ])\n1105\t    const uploadErr = coverRes.err ?? avatarRes.err ?? certRes.err ?? qrRes.err\n1106\t    if (uploadErr) { setError(uploadErr); setLoading(false); return }\n1107\t\n1108\t    const payload: Record<string, unknown> = {\n1109\t      name:             name.trim(),\n1110\t      village:          village.trim(),\n1111\t      district:         district.trim(),\n1112\t      method,\n1113\t      slug:             newSlug,\n1114\t      pickup_locations: pickupLocations,\n1115\t      farm_address:     farmAddress.trim() || null,\n1116\t      cover_photo_url:  (coverRes.url ?? existingCoverUrl) || null,\n1117\t      photo_url:        (avatarRes.url ?? existingAvatarUrl) || null,\n1118\t      pesticide_cert_url: (certRes.url ?? existingCertUrl) || null,\n1119\t      upi_id:           upiId.trim() || null,\n1120\t      upi_qr_code_url:  (qrRes.url ?? existingQrUrl) || null,\n1121\t      cod_enabled:      codEnabled,\n1122\t      pickup_slots: slotDays.length > 0\n1123\t        ? { days: slotDays, time_from: slotFrom, time_to: slotTo }\n1124\t        : null,\n1125\t      lat: farmerLat,\n1126\t      lng: farmerLng,\n1127\t      location_name: farmerLat ? (farmerLocationName || name.trim()) : null,\n1128\t    }\n1129\t    if (sinceYear) payload.farming_since_year = Number(sinceYear)\n1130\t\n1131\t    const { data, error: err } = await supabase\n1132\t      .from('farmers')\n1133\t      .update(payload)\n1134\t      .eq('id', farmer.id)\n1135\t      .select('*')\n1136\t      .single()\n1137\t\n1138\t    setLoading(false)\n1139\t\n1140\t    if (err || !data) {\n1141\t      setError(err?.message ?? tx.couldNotSave)\n1142\t      return\n1143\t    }\n1144\t\n1145\t    localStorage.setItem('yff_farmer_slug', data.slug)\n1146\t    onSaved(data)\n1147\t  }\n1148\t\n1149\t  const handleChangePassword = async () => {\n1150\t    if (!currentPassword) { setPwError('Current password is required / ప్రస్తుత పాస్‌వర్డ్ అవసరం'); return }\n1151\t    if (newPassword.length < 6) { setPwError('Minimum 6 characters / కనీసం 6 అక్షరాలు'); return }\n1152\t    if (newPassword !== confirmPassword) { setPwError('Passwords do not match / పాస్‌వర్డ్‌లు సరిపోలలేదు'); return }\n1153\t    setPwLoading(true)\n1154\t    setPwError('')\n1155\t    const res = await fetch('/api/auth/reset-password', {\n1156\t      method: 'POST',\n1157\t      headers: { 'Content-Type': 'application/json' },\n1158\t      credentials: 'same-origin',\n1159\t      body: JSON.stringify({ currentPassword, newPassword }),\n1160\t    })\n1161\t    const json = await res.json().catch(() => ({}))\n1162\t    setPwLoading(false)\n1163\t    if (!res.ok) { setPwError(json.error ?? 'Could not update password.'); return }\n1164\t    setPwSuccess(true)\n1165\t    setCurrentPassword('')\n1166\t    setNewPassword('')\n1167\t    setConfirmPassword('')\n1168\t    setTimeout(() => { setPwSuccess(false); setShowPwSection(false) }, 2000)\n1169\t  }\n1170\t\n1171\t  return (\n1172\t    <div className=\"fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4\">\n1173\t      <div className=\"bg-white rounded-t-2xl sm:rounded-2xl w-full max-w-md max-h-[92vh] overflow-y-auto\">\n1174\t        <div className=\"sticky top-0 bg-white flex items-center justify-between px-4 py-3 border-b border-gray-100\">\n1175\t          <div>\n1176\t            <h3 className=\"font-extrabold text-gray-900 text-base\">\n1177\t              {tx.profileModalTitle}\n1178\t            </h3>\n1179\t            <p className=\"text-xs text-gray-500\">{tx.profileModalSubtitle}</p>\n1180\t          </div>\n1181\t          <button onClick={onClose} className=\"text-gray-400 text-3xl leading-none p-1\">×</button>\n1182\t        </div>\n1183\t\n1184\t        <div className=\"p-4 space-y-4\">\n1185\t          {/* ── Section 1: Farm Profile ── */}\n1186\t          <div className=\"pt-1 border-t-2 border-green-100 first:border-t-0\">\n1187\t            <h4 className=\"text-sm font-extrabold text-green-800\">Farm Profile / పొలం వివరాలు</h4>\n1188\t            <p className=\"text-[11px] text-gray-500\">Name, photo, certifications</p>\n1189\t          </div>\n1190\t\n1191\t          <Field\n1192\t            label={tx.yourNameLabel}\n1193\t            placeholder=\"Ramu Reddy\"\n1194\t            value={name}\n1195\t            onChange={setName}\n1196\t          />\n1197\t          <Field\n1198\t            label={tx.villageLabel}\n1199\t            placeholder=\"Tadepalligudem\"\n1200\t            value={village}\n1201\t            onChange={setVillage}\n1202\t          />\n1203\t          <Field\n1204\t            label={tx.districtLabel}\n1205\t            placeholder=\"West Godavari\"\n1206\t            value={district}\n1207\t            onChange={setDistrict}\n1208\t          />\n1209\t\n1210\t          <div>\n1211\t            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n1212\t              {tx.farmingMethodLabel}\n1213\t            </label>\n1214\t            <select\n1215\t              value={method}\n1216\t              onChange={(e) => setMethod(e.target.value)}\n1217\t              className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-green-500 focus:outline-none\"\n1218\t            >\n1219\t              <option value=\"natural\">{tx.methodNatural}</option>\n1220\t              <option value=\"organic\">{tx.methodOrganic}</option>\n1221\t              <option value=\"low_chemical\">{tx.methodLowChemical}</option>\n1222\t              <option value=\"chemical\">{tx.methodChemical}</option>\n1223\t            </select>\n1224\t          </div>\n1225\t\n1226\t          <Field\n1227\t            label={tx.farmingSinceLabel}\n1228\t            placeholder=\"e.g. 2005\"\n1229\t            value={sinceYear}\n1230\t            onChange={setSinceYear}\n1231\t            type=\"number\"\n1232\t          />\n1233\t\n1234\t          {/* Farm GPS location */}\n1235\t          <div>\n1236\t            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n1237\t              Farm location / పొలం లొకేషన్\n1238\t            </label>\n1239\t            <p className=\"text-[11px] text-gray-500 mb-2 leading-snug\">\n1240\t              Set your farm location so nearby buyers discover your produce first.<br />\n1241\t              దగ్గరలో ఉన్న కొనుగోలుదారులు మీ పంటను ముందుగా కనుగొంటారు.\n1242\t            </p>\n1243\t            {farmerLat && farmerLng ? (\n1244\t              <div className=\"flex items-center justify-between bg-green-50 border border-green-200 rounded-xl px-4 py-3\">\n1245\t                <span className=\"text-sm font-semibold text-green-800\">\n1246\t                  ✓ 📍 {farmerLocationName || 'Location set'}\n1247\t                </span>\n1248\t                <button\n1249\t                  type=\"button\"\n1250\t                  onClick={() => { setFarmerLat(null); setFarmerLng(null); setFarmerLocationName('') }}\n1251\t                  className=\"text-xs text-green-700 underline font-semibold\"\n1252\t                >\n1253\t                  Change / మార్చు\n1254\t                </button>\n1255\t              </div>\n1256\t            ) : (\n1257\t              <div className=\"space-y-2\">\n1258\t                <button\n1259\t                  type=\"button\"\n1260\t                  onClick={handleFarmerGPS}\n1261\t                  disabled={locating}\n1262\t                  className=\"w-full flex items-center justify-center gap-2 bg-green-700 text-white font-bold py-3.5 rounded-xl text-sm active:bg-green-800 disabled:opacity-50\"\n1263\t                >\n1264\t                  {locating ? (\n1265\t                    <>\n1266\t                      <span className=\"animate-spin inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full\" />\n1267\t                      Getting location... / లొకేషన్ తెస్తోంది\n1268\t                    </>\n1269\t                  ) : (\n1270\t                    <>📍 Use GPS (most accurate) / GPS వాడండి</>\n1271\t                  )}\n1272\t                </button>\n1273\t                <div className=\"flex items-center gap-2\">\n1274\t                  <div className=\"flex-1 border-t border-gray-200\" />\n1275\t                  <span className=\"text-[10px] text-gray-400 font-semibold\">OR / లేదా</span>\n1276\t                  <div className=\"flex-1 border-t border-gray-200\" />\n1277\t                </div>\n1278\t                <LocationSearch\n1279\t                  placeholder=\"Search farm location / పొలం లొకేషన్ వెతకండి\"\n1280\t                  onSelect={(lat, lng, name) => {\n1281\t                    setFarmerLat(lat)\n1282\t                    setFarmerLng(lng)\n1283\t                    setFarmerLocationName(name)\n1284\t                  }}\n1285\t                />\n1286\t              </div>\n1287\t            )}\n1288\t            {locError && (\n1289\t              <p className=\"text-xs text-red-600 bg-red-50 rounded-xl px-3 py-2 mt-2\">{locError}</p>\n1290\t            )}\n1291\t          </div>\n1292\t\n1293\t          {/* Farm cover photo */}\n1294\t          <div>\n1295\t            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n1296\t              {tx.coverPhotoLabel}\n1297\t            </label>\n1298\t            <p className=\"text-[11px] text-gray-500 mb-2\">{tx.coverPhotoHelp}</p>\n1299\t            <ProfilePhotoUpload\n1300\t              preview={coverPreview}\n1301\t              existingUrl={existingCoverUrl}\n1302\t              onPick={(e) => handlePickFile(e, setCoverFile, setCoverPreview, coverPreview)}\n1303\t              onClear={() => { if (coverPreview) URL.revokeObjectURL(coverPreview); setCoverFile(null); setCoverPreview(''); setExistingCoverUrl('') }}\n1304\t              takeLabel={tx.takePhoto}\n1305\t              galleryLabel={tx.fromGallery}\n1306\t              aspectClass=\"aspect-[3/1]\"\n1307\t            />\n1308\t          </div>\n1309\t\n1310\t          {/* Farmer avatar */}\n1311\t          <div>\n1312\t            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n1313\t              {tx.avatarLabel}\n1314\t            </label>\n1315\t            <p className=\"text-[11px] text-gray-500 mb-2\">{tx.avatarHelp}</p>\n1316\t            <ProfilePhotoUpload\n1317\t              preview={avatarPreview}\n1318\t              existingUrl={existingAvatarUrl}\n1319\t              onPick={(e) => handlePickFile(e, setAvatarFile, setAvatarPreview, avatarPreview)}\n1320\t              onClear={() => { if (avatarPreview) URL.revokeObjectURL(avatarPreview); setAvatarFile(null); setAvatarPreview(''); setExistingAvatarUrl('') }}\n1321\t              takeLabel={tx.takePhoto}\n1322\t              galleryLabel={tx.fromGallery}\n1323\t              aspectClass=\"aspect-square max-w-[120px]\"\n1324\t            />\n1325\t          </div>\n1326\t\n1327\t          {/* Pesticide cert */}\n1328\t          <div>\n1329\t            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n1330\t              {tx.pesticideCertLabel}\n1331\t            </label>\n1332\t            <p className=\"text-[11px] text-gray-500 mb-2\">{tx.pesticideCertHelp}</p>\n1333\t            {existingCertUrl && !certPreview ? (\n1334\t              <div className=\"flex items-center gap-3 bg-green-50 border border-green-200 rounded-xl p-3\">\n1335\t                <span className=\"text-green-700 font-semibold text-sm\">{tx.certUploaded}</span>\n1336\t                <a href={existingCertUrl} target=\"_blank\" rel=\"noopener noreferrer\"\n1337\t                  className=\"text-xs text-green-700 underline font-semibold ml-auto\">{tx.viewCertificate}</a>\n1338\t                <button type=\"button\" onClick={() => setExistingCertUrl('')}\n1339\t                  className=\"text-xs text-red-500 underline\">{tx.removeCert}</button>\n1340\t              </div>\n1341\t            ) : (\n1342\t              <ProfilePhotoUpload\n1343\t                preview={certPreview}\n1344\t                existingUrl=\"\""}]},"uuid":"f6031ea3-9617-4e12-8db9-51f5e2f80068","timestamp":"2026-06-13T06:36:18.952Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/app/farmer/dashboard/page.tsx","content":"'use client'\n\nimport { useState, useEffect, useCallback } from 'react'\nimport { useRouter } from 'next/navigation'\nimport { supabase } from '@/lib/supabase'\nimport Link from 'next/link'\nimport LanguageToggle from '@/components/LanguageToggle'\nimport { useLang } from '@/lib/LanguageContext'\nimport LocationSearch from '@/components/LocationSearch'\nimport { FreshnessBadge } from '@/components/FreshnessBadge'\n\ntype PickupSlots = {\n  days: string[]\n  time_from: string\n  time_to: string\n}\n\ntype Farmer = {\n  id: string\n  name: string\n  slug: string\n  village: string\n  district: string\n  phone: string\n  method: string\n  region_slug: string\n  rating_avg: number | null\n  buyer_count: number\n  farming_since_year: number | null\n  pickup_locations: string[] | null\n  farm_address: string | null\n  cover_photo_url: string | null\n  photo_url: string | null\n  pesticide_cert_url: string | null\n  pickup_slots: PickupSlots | null\n  lat: number | null\n  lng: number | null\n  location_name: string | null\n  upi_id: string | null\n  upi_qr_code_url: string | null\n  cod_enabled: boolean | null\n}\n\ntype DemandBar = {\n  crop_name: string\n  total_qty: number\n}\n\ntype ListingRow = {\n  id: string\n  name: string\n  variety: string | null\n  emoji: string | null\n  status: string\n  method: string | null\n  stock_qty: number | null\n  price_tier_1_price: number | null\n  price_tier_1_qty: number | null\n  price_tier_2_price: number | null\n  price_tier_2_qty: number | null\n  price_tier_3_price: number | null\n  description: string | null\n  image_url: string | null\n  brix: number | null\n  soil_organic_carbon: number | null\n  unit: string | null\n  harvest_date: string | null\n  availability_period: string | null\n  created_at: string\n}\n\ntype DeliveryStatus = 'unassigned' | 'assigned' | 'picked_up' | 'out_for_delivery' | 'delivered'\n\ntype Order = {\n  id: string\n  farmer_id: string\n  produce_listing_id: string | null\n  produce_name: string | null\n  quantity: number | null\n  unit: string | null\n  total_price: number | null\n  buyer_name: string | null\n  buyer_phone: string | null\n  pickup_location: string | null\n  status: 'pending' | 'approved' | 'declined'\n  payment_method: string | null\n  payment_status: string | null\n  utr_number: string | null\n  decline_reason: string | null\n  created_at: string\n  delivery_type?: 'self_pickup' | 'home_delivery' | null\n  delivery_status?: DeliveryStatus | null\n  delivery_boy_id?: string | null\n}\n\nconst UNIT_OPTIONS = [\n  { value: 'kg', label: 'kg' },\n  { value: 'gram', label: 'gram' },\n  { value: 'piece', label: 'piece / నగ' },\n  { value: 'bunch', label: 'bunch / కట్ట' },\n  { value: 'litre', label: 'litre' },\n]\n\ntype PreviewData = {\n  name: string\n  variety: string\n  emoji: string\n  price: string\n  method: string\n  stock: string\n}\n\n// 📦 is a generic \"Other / ఇతర\" icon so a farmer can list any produce\n// even when no specific icon exists. Keep it last in the picker.\nconst EMOJI_OPTIONS = ['🍅', '🍌', '🥭', '🫑', '🥬', '🍆', '🥕', '🌽', '🧅', '🧄', '🥦', '🌿', '🍓', '🫒', '🌾', '🥥', '📦']\n\nasync function compressImage(file: File, maxPx = 800, quality = 0.7): Promise<File> {\n  return new Promise((resolve) => {\n    const img = new Image()\n    const blobUrl = URL.createObjectURL(file)\n    img.onload = () => {\n      URL.revokeObjectURL(blobUrl)\n      const scale = Math.min(1, maxPx / Math.max(img.naturalWidth, img.naturalHeight))\n      const canvas = document.createElement('canvas')\n      canvas.width = Math.round(img.naturalWidth * scale)\n      canvas.height = Math.round(img.naturalHeight * scale)\n      const ctx = canvas.getContext('2d')\n      if (!ctx) { resolve(file); return }\n      ctx.drawImage(img, 0, 0, canvas.width, canvas.height)\n      canvas.toBlob(\n        (blob) => {\n          if (!blob) { resolve(file); return }\n          const name = file.name.replace(/\\.[^.]+$/, '.jpg')\n          resolve(new File([blob], name, { type: 'image/jpeg' }))\n        },\n        'image/jpeg',\n        quality,\n      )\n    }\n    img.onerror = () => { URL.revokeObjectURL(blobUrl); resolve(file) }\n    img.src = blobUrl\n  })\n}\n\nconst isProfileComplete = (f: Farmer | null) =>\n  !!f && f.name?.trim().length > 0 && f.village?.trim().length > 0\n\nexport default function FarmerDashboard() {\n  const router = useRouter()\n  const { tx } = useLang()\n  const [farmer, setFarmer] = useState<Farmer | null>(null)\n  const [loading, setLoading] = useState(true)\n  const [notFound, setNotFound] = useState(false)\n  const [activeListings, setActiveListings] = useState(0)\n  const [pendingOrders, setPendingOrders] = useState<Order[]>([])\n  const [approvedCount, setApprovedCount] = useState(0)\n  const [totalRevenue, setTotalRevenue] = useState(0)\n  const [ordersFilter, setOrdersFilter] = useState<'today' | 'week' | 'month'>('week')\n  const [processingOrderId, setProcessingOrderId] = useState<string | null>(null)\n  const [processingPaidId, setProcessingPaidId] = useState<string | null>(null)\n  const [decliningOrder, setDecliningOrder] = useState<Order | null>(null)\n  const [declineResult, setDeclineResult] = useState<\n    { buyerName: string | null; amount: number | null; refundInitiated: boolean } | null\n  >(null)\n  const [demandBars, setDemandBars] = useState<DemandBar[]>([])\n  const [monthlyRevenue, setMonthlyRevenue] = useState(0)\n  const [monthlyOrderCount, setMonthlyOrderCount] = useState(0)\n  const [weeklyEarnings, setWeeklyEarnings] = useState<number[]>([0, 0, 0, 0])\n  const [showForm, setShowForm] = useState(false)\n  const [showProfileEdit, setShowProfileEdit] = useState(false)\n  const [showListings, setShowListings] = useState(false)\n\n  const loadDashboard = useCallback(async () => {\n    const farmerId = localStorage.getItem('yff_farmer_id')\n    if (!farmerId) { router.replace('/farmer/login'); return }\n\n    const { data: farmerData } = await supabase\n      .from('farmers')\n      .select('*')\n      .eq('id', farmerId)\n      .maybeSingle()\n\n    if (!farmerData) { setNotFound(true); setLoading(false); return }\n    setFarmer(farmerData)\n\n    const monthStart = new Date()\n    monthStart.setDate(1)\n    monthStart.setHours(0, 0, 0, 0)\n\n    const [listingsRes, pendingRes, approvedRes, intentsRes, monthlyRes] = await Promise.all([\n      supabase.from('produce_listings').select('id', { count: 'exact', head: true }).eq('farmer_id', farmerData.id).eq('status', 'available'),\n      supabase.from('orders').select('*').eq('farmer_id', farmerData.id).eq('status', 'pending').order('created_at', { ascending: false }),\n      supabase.from('orders').select('id, total_price').eq('farmer_id', farmerData.id).eq('status', 'approved').gte('created_at', new Date(Date.now() - 7 * 86400000).toISOString()),\n      supabase.from('demand_intents').select('crop_name, quantity_kg').eq('region_slug', farmerData.region_slug).eq('fulfilled', false),\n      supabase.from('orders').select('id, total_price, created_at').eq('farmer_id', farmerData.id).eq('status', 'approved').gte('created_at', monthStart.toISOString()),\n    ])\n\n    setActiveListings(listingsRes.count ?? 0)\n    setPendingOrders((pendingRes.data ?? []) as Order[])\n    const approved = approvedRes.data ?? []\n    setApprovedCount(approved.length)\n    setTotalRevenue(approved.reduce((sum, o) => sum + (o.total_price ?? 0), 0))\n\n    // Monthly earnings\n    const monthly = monthlyRes.data ?? []\n    setMonthlyRevenue(monthly.reduce((sum, o) => sum + (o.total_price ?? 0), 0))\n    setMonthlyOrderCount(monthly.length)\n\n    // Break into 4 weekly buckets (days 1-7, 8-14, 15-21, 22+)\n    const weeks = [0, 0, 0, 0]\n    for (const o of monthly) {\n      const day = new Date(o.created_at).getDate()\n      const bucket = day <= 7 ? 0 : day <= 14 ? 1 : day <= 21 ? 2 : 3\n      weeks[bucket] += o.total_price ?? 0\n    }\n    setWeeklyEarnings(weeks)\n\n    const map: Record<string, number> = {}\n    for (const row of intentsRes.data ?? []) {\n      map[row.crop_name] = (map[row.crop_name] ?? 0) + (Number(row.quantity_kg) || 0)\n    }\n    setDemandBars(\n      Object.entries(map)\n        .map(([crop_name, total_qty]) => ({ crop_name, total_qty }))\n        .sort((a, b) => b.total_qty - a.total_qty)\n        .slice(0, 5)\n    )\n\n    setLoading(false)\n  }, [router])\n\n  useEffect(() => { loadDashboard() }, [loadDashboard])\n\n  // Auto-open the profile edit modal the first time an incomplete farmer lands here.\n  useEffect(() => {\n    if (!loading && farmer && !isProfileComplete(farmer)) {\n      setShowProfileEdit(true)\n    }\n  }, [loading, farmer])\n\n  // Realtime subscription: new orders + payment status changes.\n  // Replaces the old \"consumer opens WhatsApp to notify farmer\" flow.\n  // Fires a browser notification when:\n  //   - A new pending order is inserted\n  //   - An existing order's payment_status flips to payment_claimed (incl. retries)\n  useEffect(() => {\n    if (!farmer) return\n\n    const fireNotification = (title: string, body: string) => {\n      if (typeof window === 'undefined') return\n      if (!('Notification' in window)) return\n      if (Notification.permission !== 'granted') return\n      try {\n        new Notification(title, { body, icon: '/icon-192.png', tag: 'yff-order' })\n      } catch { /* some browsers throw on background tabs — ignore */ }\n    }\n\n    const channel = supabase\n      .channel(`orders_${farmer.id}`)\n      .on(\n        'postgres_changes',\n        { event: 'INSERT', schema: 'public', table: 'orders', filter: `farmer_id=eq.${farmer.id}` },\n        (payload) => {\n          const row = payload.new as Order\n          if (row.status !== 'pending') return\n          setPendingOrders((prev) => prev.some((o) => o.id === row.id) ? prev : [row, ...prev])\n          fireNotification(\n            `New order from ${row.buyer_name ?? 'buyer'}`,\n            `${row.produce_name ?? ''} ${row.quantity ?? ''} ${row.unit ?? ''}${row.total_price ? ` · ₹${row.total_price}` : ''}`.trim(),\n          )\n        },\n      )\n      .on(\n        'postgres_changes',\n        { event: 'UPDATE', schema: 'public', table: 'orders', filter: `farmer_id=eq.${farmer.id}` },\n        (payload) => {\n          const row = payload.new as Order\n          const prev = payload.old as Partial<Order>\n          // Order moved out of pending — drop from list\n          if (row.status !== 'pending') {\n            setPendingOrders((cur) => cur.filter((o) => o.id !== row.id))\n            return\n          }\n          // Update or insert in pending list\n          setPendingOrders((cur) => {\n            const exists = cur.some((o) => o.id === row.id)\n            return exists ? cur.map((o) => o.id === row.id ? row : o) : [row, ...cur]\n          })\n          // Fire notification when buyer claims payment (covers initial pay AND retry)\n          const becameClaimed =\n            (row.payment_status === 'payment_claimed' || row.payment_status === 'pending_confirmation')\n            && prev.payment_status !== row.payment_status\n          if (becameClaimed) {\n            fireNotification(\n              `Buyer paid — verify payment`,\n              `${row.buyer_name ?? 'Buyer'} sent ₹${row.total_price ?? '?'} for ${row.produce_name ?? 'order'}`,\n            )\n          }\n        },\n      )\n      .subscribe()\n\n    return () => { supabase.removeChannel(channel) }\n  }, [farmer])\n\n  // Safety net for the realtime subscription: on slow/spotty 4G the websocket\n  // can silently drop while the farmer is on another app. Refetch whenever the\n  // dashboard tab regains focus so they never miss a new order.\n  useEffect(() => {\n    const refetch = () => { if (document.visibilityState === 'visible') loadDashboard() }\n    document.addEventListener('visibilitychange', refetch)\n    window.addEventListener('focus', refetch)\n    return () => {\n      document.removeEventListener('visibilitychange', refetch)\n      window.removeEventListener('focus', refetch)\n    }\n  }, [loadDashboard])\n\n  const handleLogout = () => {\n    localStorage.removeItem('yff_farmer_id')\n    localStorage.removeItem('yff_farmer_slug')\n    router.replace('/farmer/login')\n  }\n\n  const handleApprove = async (orderId: string) => {\n    setProcessingOrderId(orderId)\n    await supabase.from('orders').update({ status: 'approved' }).eq('id', orderId)\n    setPendingOrders((prev) => prev.filter((o) => o.id !== orderId))\n    setApprovedCount((c) => c + 1)\n    setProcessingOrderId(null)\n  }\n\n  const handleConfirmDecline = async (orderId: string, reason: string) => {\n    const declined = decliningOrder\n    setProcessingOrderId(orderId)\n    // Declining runs server-side: it returns the reserved stock and, for a\n    // paid order, issues a REAL Razorpay refund (the secret can't live in the\n    // browser). If the refund fails the order stays pending so we can retry.\n    try {\n      const res = await fetch(`/api/farmer/orders/${orderId}/decline`, {\n        method: 'POST',\n        credentials: 'same-origin',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ reason }),\n      })\n      const json = await res.json().catch(() => ({}))\n      if (!res.ok) {\n        alert(json.error || 'Could not decline the order. Please try again. / ఆర్డర్ తిరస్కరించలేకపోయాం. మళ్ళీ ప్రయత్నించండి.')\n        return\n      }\n      // Whether a refund went out (real Razorpay refund, or 'initiated' for\n      // other paid methods) so we can confirm it to the farmer in plain terms.\n      const refundInitiated = !!json.refunded || !!json.refundStatus\n      setPendingOrders((prev) => prev.filter((o) => o.id !== orderId))\n      setDeclineResult({\n        buyerName: declined?.buyer_name ?? null,\n        amount: declined?.total_price ?? null,\n        refundInitiated,\n      })\n      setDecliningOrder(null)\n    } catch {\n      alert('Network error. Please try again. / నెట్‌వర్క్ సమస్య. మళ్ళీ ప్రయత్నించండి.')\n    } finally {\n      setProcessingOrderId(null)\n    }\n  }\n\n  const handleMarkPaid = async (orderId: string) => {\n    setProcessingPaidId(orderId)\n    await supabase.from('orders').update({ payment_status: 'completed' }).eq('id', orderId)\n    setPendingOrders((prev) =>\n      prev.map((o) => o.id === orderId ? { ...o, payment_status: 'completed' } : o)\n    )\n    setProcessingPaidId(null)\n  }\n\n  const handleUpdatePaymentStatus = async (orderId: string, status: 'completed' | 'failed' | 'pending') => {\n    setProcessingPaidId(orderId)\n    const update: Record<string, string> = { payment_status: status }\n    if (status === 'completed') update.status = 'approved'\n    await supabase.from('orders').update(update).eq('id', orderId)\n    setPendingOrders((prev) =>\n      prev.map((o) => o.id === orderId ? { ...o, payment_status: status, ...(status === 'completed' ? { status: 'approved' } : {}) } : o)\n    )\n    setProcessingPaidId(null)\n  }\n\n  const filteredPendingOrders = pendingOrders.filter((o) => {\n    const t = new Date(o.created_at).getTime()\n    const now = Date.now()\n    if (ordersFilter === 'today') {\n      const todayStart = new Date()\n      todayStart.setHours(0, 0, 0, 0)\n      return t >= todayStart.getTime()\n    }\n    if (ordersFilter === 'week') return t >= now - 7 * 86400000\n    return t >= now - 30 * 86400000\n  })\n\n  if (loading) return <LoadingScreen />\n  if (notFound) return <FarmerNotFound onLogout={handleLogout} />\n\n  const profileComplete = isProfileComplete(farmer)\n  const displayName = farmer!.name?.trim() || tx.welcome\n\n  return (\n    <main className=\"min-h-screen bg-gray-50 pb-16\">\n      {/* Header */}\n      <div className=\"bg-green-900 px-4 pt-6 pb-10\">\n        <div className=\"flex justify-end mb-2\">\n          <LanguageToggle />\n        </div>\n        <div className=\"flex items-start justify-between\">\n          <div>\n            <p className=\"text-green-400 text-xs font-semibold mb-0.5 uppercase tracking-wide\">\n              {tx.farmerDashboard}\n            </p>\n            <h1 className=\"text-white text-xl font-extrabold leading-tight\">{displayName}</h1>\n            <p className=\"text-green-300 text-sm mt-0.5\">\n              {profileComplete\n                ? `${farmer!.village}, ${farmer!.district}`\n                : tx.completeProfilePrompt}\n            </p>\n            <p className=\"text-green-500 text-xs mt-1\">+91 {farmer!.phone}</p>\n          </div>\n          <div className=\"flex flex-col items-end gap-2 flex-shrink-0\">\n            {profileComplete ? (\n              <Link\n                href={`/farmer/${farmer!.slug}`}\n                className=\"bg-white text-green-800 text-xs font-bold px-3 py-2 rounded-xl\"\n              >\n                {tx.viewProfile} ↗\n              </Link>\n            ) : (\n              <span className=\"bg-amber-400 text-amber-900 text-[10px] font-bold px-2 py-1 rounded-full\">\n                {tx.incomplete}\n              </span>\n            )}\n            <button\n              onClick={() => setShowProfileEdit(true)}\n              className=\"text-white text-xs underline\"\n            >\n              {tx.editProfile}\n            </button>\n            <Link href=\"/farmer/complaints\" className=\"text-white text-xs underline\">\n              {tx.complaints}\n            </Link>\n            <button onClick={handleLogout} className=\"text-green-500 text-xs underline\">\n              {tx.logout}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"px-4 -mt-5 space-y-4\">\n        {/* Notification permission banner — shown only if browser supports it\n            and the farmer hasn't decided yet. Permission must be requested via\n            a user gesture so we can't auto-call it on mount. */}\n        <NotificationPermissionBanner />\n\n        {/* Complete profile banner */}\n        {!profileComplete && (\n          <div className=\"bg-amber-50 border-2 border-amber-300 rounded-2xl p-4 flex items-start gap-3\">\n            <span className=\"text-2xl flex-shrink-0\">📝</span>\n            <div className=\"flex-1 min-w-0\">\n              <h3 className=\"font-extrabold text-amber-900 text-base leading-tight\">\n                {tx.completeProfileTitle}\n              </h3>\n              <p className=\"text-amber-700 text-xs mt-0.5\">\n                {tx.completeProfileHelp}\n              </p>\n              <button\n                onClick={() => setShowProfileEdit(true)}\n                className=\"mt-3 bg-amber-600 text-white font-bold px-4 py-2.5 rounded-xl text-sm\"\n              >\n                {tx.fillDetails}\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Stat cards */}\n        <div className=\"grid grid-cols-2 gap-3\">\n          <button\n            onClick={() => setShowListings(true)}\n            className=\"border-green-200 bg-green-50 border rounded-2xl p-4 text-left active:bg-green-100 relative\"\n          >\n            <div className=\"text-3xl font-black text-green-800\">{activeListings}</div>\n            <div className=\"text-sm font-semibold text-gray-800 mt-1 leading-tight\">{tx.activeListings}</div>\n            <div className=\"text-[11px] font-bold text-green-700 mt-2 flex items-center gap-1\">\n              {tx.manage} <span aria-hidden>→</span>\n            </div>\n          </button>\n          {[\n            { label: tx.pendingOrders, value: pendingOrders.length, color: pendingOrders.length > 0 ? 'border-orange-300 bg-orange-50' : 'border-gray-200 bg-gray-50', vcolor: pendingOrders.length > 0 ? 'text-orange-700' : 'text-gray-500' },\n            { label: tx.approvedThisWeek, value: approvedCount, color: 'border-green-200 bg-green-50', vcolor: 'text-green-800' },\n            { label: tx.totalRevenue, value: totalRevenue > 0 ? `₹${totalRevenue}` : '—', color: 'border-purple-200 bg-purple-50', vcolor: 'text-purple-800' },\n          ].map((s) => (\n            <div key={s.label} className={`${s.color} border rounded-2xl p-4`}>\n              <div className={`text-3xl font-black ${s.vcolor}`}>{s.value}</div>\n              <div className=\"text-sm font-semibold text-gray-800 mt-1 leading-tight\">{s.label}</div>\n            </div>\n          ))}\n        </div>\n\n        {/* Monthly earnings summary */}\n        <EarningsCard\n          revenue={monthlyRevenue}\n          orderCount={monthlyOrderCount}\n          weekly={weeklyEarnings}\n        />\n\n        {/* Orders section */}\n        <div className=\"bg-white rounded-2xl border border-gray-100 overflow-hidden\">\n          <div className=\"px-4 pt-4 pb-3 flex items-center justify-between border-b border-gray-100\">\n            <div>\n              <h2 className=\"font-extrabold text-gray-900 text-base leading-tight\">\n                {tx.ordersTab}\n              </h2>\n              <p className=\"text-xs text-gray-500 mt-0.5\">Pending orders need your response</p>\n            </div>\n            <Link href=\"/farmer/dashboard/orders\" className=\"text-xs font-bold text-green-700\">\n              {tx.viewOrderHistory}\n            </Link>\n          </div>\n\n          <div className=\"px-4 pt-3 pb-2 flex gap-2\">\n            {(['today', 'week', 'month'] as const).map((period) => (\n              <button\n                key={period}\n                onClick={() => setOrdersFilter(period)}\n                className={`px-3 py-1.5 rounded-full text-xs font-bold transition-colors ${\n                  ordersFilter === period\n                    ? 'bg-green-700 text-white'\n                    : 'bg-gray-100 text-gray-600 active:bg-gray-200'\n                }`}\n              >\n                {period === 'today' ? tx.filterToday : period === 'week' ? tx.filterWeek : tx.filterMonth}\n              </button>\n            ))}\n          </div>\n\n          <div className=\"px-4 pb-4 space-y-3\">\n            {filteredPendingOrders.length === 0 ? (\n              <div className=\"text-center py-8\">\n                <div className=\"text-4xl mb-2\">📭</div>\n                <p className=\"font-semibold text-gray-500 text-sm\">{tx.noPendingOrders}</p>\n                <p className=\"text-xs text-gray-400 mt-1\">{tx.noPendingHelp}</p>\n              </div>\n            ) : (\n              filteredPendingOrders.map((order) => (\n                <OrderCard\n                  key={order.id}\n                  order={order}\n                  processing={processingOrderId === order.id}\n                  processingPaid={processingPaidId === order.id}\n                  onApprove={() => handleApprove(order.id)}\n                  onDecline={() => setDecliningOrder(order)}\n                  onMarkPaid={() => handleMarkPaid(order.id)}\n                  onUpdatePaymentStatus={(s) => handleUpdatePaymentStatus(order.id, s)}\n                />\n              ))\n            )}\n          </div>\n        </div>\n\n        {/* Demand chart */}\n        <div className=\"bg-white rounded-2xl border border-gray-100 p-4\">\n          <h2 className=\"font-extrabold text-gray-900 text-base leading-tight\">\n            {tx.localDemand}\n          </h2>\n          <p className=\"text-xs text-gray-500 mt-0.5 mb-4\">\n            {tx.localDemandHelp}\n          </p>\n\n          {demandBars.length === 0 ? (\n            <div className=\"text-center py-6\">\n              <p className=\"text-gray-400 text-sm\">{tx.noDemandSignals}</p>\n              <p className=\"text-gray-400 text-xs mt-1\">{tx.shareProfileLink}</p>\n            </div>\n          ) : (\n            <div className=\"space-y-3\">\n              {demandBars.map((bar) => {\n                const pct = Math.round((bar.total_qty / demandBars[0].total_qty) * 100)\n                return (\n                  <div key={bar.crop_name}>\n                    <div className=\"flex items-center justify-between mb-1\">\n                      <span className=\"text-sm font-semibold text-gray-800\">{bar.crop_name}</span>\n                      <span className=\"text-xs text-gray-400 font-medium\">{bar.total_qty} kg</span>\n                    </div>\n                    <div className=\"h-3 bg-gray-100 rounded-full overflow-hidden\">\n                      <div\n                        className=\"h-full bg-green-600 rounded-full\"\n                        style={{ width: `${pct}%` }}\n                      />\n                    </div>\n                  </div>\n                )\n              })}\n            </div>\n          )}\n        </div>\n\n        {/* Add listing button */}\n        {profileComplete ? (\n          !showForm && (\n            <button\n              onClick={() => setShowForm(true)}\n              className=\"w-full bg-white border-2 border-green-700 text-green-700 font-bold py-4 rounded-2xl text-base flex items-center justify-center gap-2 active:bg-green-50\"\n            >\n              <span className=\"text-xl leading-none\">+</span>\n              {tx.addNewProduce}\n            </button>\n          )\n        ) : (\n          <div className=\"w-full bg-gray-100 text-gray-500 font-semibold py-4 rounded-2xl text-sm text-center\">\n            {tx.completeBeforeAdd}\n          </div>\n        )}\n\n        {/* Listing form */}\n        {showForm && profileComplete && (\n          <ProduceListingForm\n            farmerId={farmer!.id}\n            farmerSlug={farmer!.slug}\n            farmerRegion={farmer!.region_slug}\n            defaultMethod={farmer!.method}\n            onClose={() => setShowForm(false)}\n            onPublished={() => { setShowForm(false); loadDashboard() }}\n          />\n        )}\n\n        {/* Farm photos */}\n        {farmer && <FarmPhotosSection farmerId={farmer.id} />}\n      </div>\n\n      {/* Manage listings modal */}\n      {showListings && farmer && (\n        <ManageListingsModal\n          farmerId={farmer.id}\n          farmerSlug={farmer.slug}\n          farmerRegion={farmer.region_slug}\n          defaultMethod={farmer.method ?? 'natural'}\n          onClose={() => setShowListings(false)}\n          onChanged={loadDashboard}\n        />\n      )}\n\n      {/* Edit profile modal */}\n      {showProfileEdit && farmer && (\n        <ProfileEditModal\n          farmer={farmer}\n          onClose={() => {\n            // If profile still incomplete, don't allow close (keep banner as fallback)\n            if (isProfileComplete(farmer)) setShowProfileEdit(false)\n            else setShowProfileEdit(false) // allow dismiss; banner still shown\n          }}\n          onSaved={(updated) => {\n            setFarmer(updated)\n            setShowProfileEdit(false)\n          }}\n        />\n      )}\n\n      {/* Decline reason sheet — mandatory reason capture */}\n      {decliningOrder && (\n        <DeclineReasonSheet\n          order={decliningOrder}\n          processing={processingOrderId === decliningOrder.id}\n          onCancel={() => setDecliningOrder(null)}\n          onConfirm={(reason) => handleConfirmDecline(decliningOrder.id, reason)}\n        />\n      )}\n\n      {/* Refund confirmation shown to the farmer right after declining */}\n      {declineResult && (\n        <DeclineSuccessSheet\n          result={declineResult}\n          onClose={() => setDeclineResult(null)}\n        />\n      )}\n    </main>\n  )\n}\n\n/* ─── Decline success / refund confirmation sheet ──────────── */\nfunction DeclineSuccessSheet({\n  result,\n  onClose,\n}: {\n  result: { buyerName: string | null; amount: number | null; refundInitiated: boolean }\n  onClose: () => void\n}) {\n  const buyer = result.buyerName || 'the customer'\n  return (\n    <div className=\"fixed inset-0 z-[130] bg-black/50 flex items-end sm:items-center justify-center p-0 sm:p-4\">\n      <div className=\"bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl p-6 text-center space-y-3\">\n        <div className=\"text-4xl\">✅</div>\n        <h2 className=\"font-extrabold text-gray-900 text-lg leading-tight\">\n          Order declined / ఆర్డర్ తిరస్కరించబడింది\n        </h2>\n\n        {result.refundInitiated ? (\n          <div className=\"bg-green-50 border border-green-200 rounded-2xl p-4 text-left space-y-1.5\">\n            <p className=\"font-bold text-green-800 text-sm flex items-center gap-1.5\">\n              <span>💸</span> Refund initiated / రీఫండ్ ప్రారంభమైంది\n            </p>\n            <p className=\"text-sm text-gray-700 leading-snug\">\n              {result.amount != null && result.amount > 0 ? (\n                <>A refund of <span className=\"font-extrabold text-green-800\">₹{result.amount}</span> has been started to {buyer}.</>\n              ) : (\n                <>A refund has been started to {buyer}.</>\n              )}\n            </p>\n            <p className=\"text-xs text-gray-500 leading-snug\">\n              It will reach their account in <span className=\"font-semibold\">3–5 business days</span>.\n              The customer has been told this automatically.\n              <br />\n              కొనుగోలుదారు ఖాతాకు 3–5 పని దినాలలో జమ అవుతుంది.\n            </p>\n          </div>\n        ) : (\n          <div className=\"bg-gray-50 border border-gray-200 rounded-2xl p-4 text-left\">\n            <p className=\"text-sm text-gray-700 leading-snug\">\n              {buyer} hadn&apos;t paid yet, so no refund is needed.\n              <br />\n              <span className=\"text-gray-500 text-xs\">చెల్లింపు జరగలేదు, రీఫండ్ అవసరం లేదు.</span>\n            </p>\n          </div>\n        )}\n\n        <button\n          onClick={onClose}\n          className=\"w-full bg-green-700 text-white font-bold py-3 rounded-xl text-sm active:bg-green-800\"\n        >\n          Done / సరే\n        </button>\n      </div>\n    </div>\n  )\n}\n\n/* ─── Decline reason bottom sheet ──────────────────────────── */\nconst DECLINE_PRESETS = [\n  'Stock finished',\n  'Not available this week',\n  'Price changed',\n  'Incorrect order details',\n]\n\nfunction DeclineReasonSheet({\n  order,\n  processing,\n  onCancel,\n  onConfirm,\n}: {\n  order: Order\n  processing: boolean\n  onCancel: () => void\n  onConfirm: (reason: string) => void\n}) {\n  const [selected, setSelected] = useState<string | null>(null)\n  const [custom, setCustom] = useState('')\n\n  const finalReason = selected ?? custom.trim()\n  const canSubmit = finalReason.length >= 3 && !processing\n\n  return (\n    <div className=\"fixed inset-0 z-[120] bg-black/50 flex items-end justify-center\">\n      <div className=\"bg-white w-full max-w-md rounded-t-3xl p-5 space-y-4\">\n        <div className=\"flex items-start justify-between gap-3\">\n          <div>\n            <h2 className=\"font-extrabold text-gray-900 text-lg leading-tight\">\n              Why decline this order? / ఎందుకు తిరస్కరిస్తున్నారు?\n            </h2>\n            <p className=\"text-xs text-gray-500 mt-0.5 leading-snug\">\n              The reason will be shown to the buyer / కారణం కొనుగోలుదారుకు చూపబడుతుంది\n            </p>\n          </div>\n          <button\n            onClick={onCancel}\n            disabled={processing}\n            className=\"text-gray-400 text-3xl leading-none p-1 disabled:opacity-50\"\n          >\n            ×\n          </button>\n        </div>\n\n        <div className=\"bg-gray-50 rounded-xl px-3 py-2 text-xs text-gray-700\">\n          <span className=\"font-semibold\">{order.buyer_name || 'Buyer'}</span>\n          {order.produce_name && <> · {order.produce_name}</>}\n          {order.quantity != null && <> · {order.quantity} {order.unit || 'kg'}</>}\n        </div>\n\n        <div className=\"space-y-2\">\n          <p className=\"text-xs font-bold text-gray-700 uppercase tracking-wide\">\n            Pick a reason / కారణం ఎంచుకోండి\n          </p>\n          <div className=\"grid grid-cols-2 gap-2\">\n            {DECLINE_PRESETS.map((preset) => (\n              <button\n                key={preset}\n                type=\"button\"\n                onClick={() => { setSelected(preset); setCustom('') }}\n                className={`px-3 py-2.5 rounded-xl text-xs font-bold border-2 transition-colors text-left leading-snug ${\n                  selected === preset\n                    ? 'border-red-500 bg-red-50 text-red-800'\n                    : 'border-gray-200 bg-white text-gray-700 active:bg-gray-50'\n                }`}\n              >\n                {preset}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        <div>\n          <label className=\"text-xs font-bold text-gray-700 uppercase tracking-wide block mb-1.5\">\n            Or type your reason / లేదా టైప్ చేయండి\n          </label>\n          <textarea\n            value={custom}\n            onChange={(e) => { setCustom(e.target.value); if (e.target.value.trim()) setSelected(null) }}\n            placeholder=\"e.g. Heavy rain damaged the harvest\"\n            rows={2}\n            className=\"w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:border-green-500 focus:outline-none resize-none\"\n          />\n        </div>\n\n        <div className=\"flex gap-2 pt-1\">\n          <button\n            onClick={onCancel}\n            disabled={processing}\n            className=\"flex-1 border-2 border-gray-300 text-gray-700 font-bold py-3 rounded-xl text-sm disabled:opacity-50\"\n          >\n            Cancel / రద్దు\n          </button>\n          <button\n            onClick={() => onConfirm(finalReason)}\n            disabled={!canSubmit}\n            className=\"flex-1 bg-red-600 text-white font-bold py-3 rounded-xl text-sm disabled:opacity-50 active:bg-red-700\"\n          >\n            {processing ? 'Declining...' : 'Confirm decline'}\n          </button>\n        </div>\n      </div>\n    </div>\n  )\n}\n\n/* ─── Notification permission banner ───────────────────────── */\nfunction NotificationPermissionBanner() {\n  const [perm, setPerm] = useState<'unsupported' | 'default' | 'granted' | 'denied'>('unsupported')\n  const [dismissed, setDismissed] = useState(false)\n\n  useEffect(() => {\n    if (typeof window === 'undefined' || !('Notification' in window)) {\n      setPerm('unsupported')\n      return\n    }\n    setPerm(Notification.permission as 'default' | 'granted' | 'denied')\n    setDismissed(localStorage.getItem('yff_notif_banner_dismissed') === '1')\n  }, [])\n\n  const handleEnable = async () => {\n    if (typeof window === 'undefined' || !('Notification' in window)) return\n    const result = await Notification.requestPermission()\n    setPerm(result)\n    if (result === 'granted') {\n      try { new Notification('YourFamilyFarmer', { body: 'You will be alerted on every new order.' }) } catch {}\n    }\n  }\n\n  const handleDismiss = () => {\n    localStorage.setItem('yff_notif_banner_dismissed', '1')\n    setDismissed(true)\n  }\n\n  if (perm === 'unsupported' || perm === 'granted') return null\n  if (dismissed) return null\n\n  if (perm === 'denied') {\n    return (\n      <div className=\"bg-amber-50 border border-amber-200 rounded-2xl p-3 flex items-start gap-3\">\n        <span className=\"text-xl flex-shrink-0\">🔕</span>\n        <div className=\"flex-1 min-w-0\">\n          <p className=\"text-xs font-bold text-amber-900 leading-snug\">\n            Notifications blocked / నోటిఫికేషన్‌లు బ్లాక్\n          </p>\n          <p className=\"text-[11px] text-amber-700 mt-0.5 leading-snug\">\n            Enable notifications in your browser settings to get alerted on new orders.\n          </p>\n        </div>\n        <button onClick={handleDismiss} className=\"text-amber-700 text-xl leading-none px-1\">×</button>\n      </div>\n    )\n  }\n\n  return (\n    <div className=\"bg-blue-50 border border-blue-200 rounded-2xl p-3 flex items-start gap-3\">\n      <span className=\"text-xl flex-shrink-0\">🔔</span>\n      <div className=\"flex-1 min-w-0\">\n        <p className=\"text-xs font-bold text-blue-900 leading-snug\">\n          Get notified instantly / తక్షణ నోటిఫికేషన్\n        </p>\n        <p className=\"text-[11px] text-blue-700 mt-0.5 leading-snug\">\n          Allow notifications to be alerted the moment a buyer places an order.\n        </p>\n        <div className=\"flex gap-2 mt-2\">\n          <button\n            onClick={handleEnable}\n            className=\"bg-blue-600 text-white font-bold px-3 py-1.5 rounded-lg text-xs active:bg-blue-700\"\n          >\n            Enable / ఆన్ చేయండి\n          </button>\n          <button\n            onClick={handleDismiss}\n            className=\"border border-blue-300 text-blue-700 font-semibold px-3 py-1.5 rounded-lg text-xs\"\n          >\n            Not now\n          </button>\n        </div>\n      </div>\n    </div>\n  )\n}\n\n/* ─── Profile edit modal ─────────────────────────────────── */\nfunction ProfileEditModal({\n  farmer,\n  onClose,\n  onSaved,\n}: {\n  farmer: Farmer\n  onClose: () => void\n  onSaved: (updated: Farmer) => void\n}) {\n  const { tx } = useLang()\n  const [name, setName] = useState(farmer.name ?? '')\n  const [village, setVillage] = useState(farmer.village ?? '')\n  const [district, setDistrict] = useState(farmer.district ?? '')\n  const [method, setMethod] = useState(farmer.method ?? 'natural')\n  const [sinceYear, setSinceYear] = useState(\n    farmer.farming_since_year ? String(farmer.farming_since_year) : '',\n  )\n  const [pickupLocations, setPickupLocations] = useState<string[]>(\n    Array.isArray(farmer.pickup_locations) ? farmer.pickup_locations : [],\n  )\n  const [newPickup, setNewPickup] = useState('')\n  const [farmAddress, setFarmAddress] = useState(farmer.farm_address ?? '')\n\n  // Cover photo\n  const [coverFile, setCoverFile] = useState<File | null>(null)\n  const [coverPreview, setCoverPreview] = useState('')\n  const [existingCoverUrl, setExistingCoverUrl] = useState(farmer.cover_photo_url ?? '')\n\n  // Avatar photo\n  const [avatarFile, setAvatarFile] = useState<File | null>(null)\n  const [avatarPreview, setAvatarPreview] = useState('')\n  const [existingAvatarUrl, setExistingAvatarUrl] = useState(farmer.photo_url ?? '')\n\n  // Pesticide cert\n  const [certFile, setCertFile] = useState<File | null>(null)\n  const [certPreview, setCertPreview] = useState('')\n  const [existingCertUrl, setExistingCertUrl] = useState(farmer.pesticide_cert_url ?? '')\n\n  // Pickup schedule\n  const ALL_DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']\n  const [slotDays, setSlotDays] = useState<string[]>(farmer.pickup_slots?.days ?? [])\n  const [slotFrom, setSlotFrom] = useState(farmer.pickup_slots?.time_from ?? '08:00')\n  const [slotTo, setSlotTo]   = useState(farmer.pickup_slots?.time_to   ?? '12:00')\n\n  // UPI ID + QR\n  const [upiId, setUpiId] = useState(farmer.upi_id ?? '')\n  const [qrFile, setQrFile] = useState<File | null>(null)\n  const [qrPreview, setQrPreview] = useState('')\n  const [existingQrUrl, setExistingQrUrl] = useState(farmer.upi_qr_code_url ?? '')\n\n  // Cash on Delivery acceptance — default off\n  const [codEnabled, setCodEnabled] = useState<boolean>(farmer.cod_enabled === true)\n\n  // Change password\n  const [showPwSection, setShowPwSection] = useState(false)\n  const [currentPassword, setCurrentPassword] = useState('')\n  const [newPassword, setNewPassword]     = useState('')\n  const [confirmPassword, setConfirmPassword] = useState('')\n  const [pwLoading, setPwLoading]         = useState(false)\n  const [pwError, setPwError]             = useState('')\n  const [pwSuccess, setPwSuccess]         = useState(false)\n\n  // Farm GPS location\n  const [farmerLat, setFarmerLat] = useState<number | null>(farmer.lat ?? null)\n  const [farmerLng, setFarmerLng] = useState<number | null>(farmer.lng ?? null)\n  const [farmerLocationName, setFarmerLocationName] = useState(farmer.location_name ?? '')\n  const [locating, setLocating] = useState(false)\n  const [locError, setLocError] = useState('')\n\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState('')\n\n  const handleFarmerGPS = () => {\n    if (!navigator.geolocation) {\n      setLocError('Geolocation not supported on this device.')\n      return\n    }\n    setLocating(true)\n    setLocError('')\n    navigator.geolocation.getCurrentPosition(\n      (pos) => {\n        const { latitude, longitude } = pos.coords\n        setFarmerLat(latitude)\n        setFarmerLng(longitude)\n        // Use village name as display name since we have it\n        setFarmerLocationName(farmer.village || 'Farm')\n        setLocating(false)\n      },\n      (err) => {\n        setLocError(\n          err.code === 1\n            ? 'Location permission denied / లొకేషన్ అనుమతి లేదు. Please allow location in browser settings.'\n            : 'Could not get location. Please try again. / మళ్ళీ ప్రయత్నించండి.'\n        )\n        setLocating(false)\n      },\n      { timeout: 15000, enableHighAccuracy: true },\n    )\n  }\n\n  const handlePickFile = async (\n    e: React.ChangeEvent<HTMLInputElement>,\n    setFile: (f: File | null) => void,\n    setPreview: (s: string) => void,\n    currentPreview: string,\n  ) => {\n    const file = e.target.files?.[0]\n    if (!file) return\n    if (!file.type.startsWith('image/')) { setError(tx.pickImageFile); return }\n    if (file.size > 8 * 1024 * 1024) { setError(tx.imageTooLarge); return }\n    setError('')\n    if (currentPreview) URL.revokeObjectURL(currentPreview)\n    const compressed = await compressImage(file)\n    setFile(compressed)\n    setPreview(URL.createObjectURL(compressed))\n  }\n\n  const uploadProfileImage = async (file: File, pathSuffix: string): Promise<{ url: string | null; err: string | null }> => {\n    const ext = file.name.split('.').pop()?.toLowerCase() || 'jpg'\n    // Include timestamp in path so each upload gets a unique URL, busting browser cache\n    const path = `${farmer.id}/${pathSuffix}-${Date.now()}.${ext}`\n    const { error: upErr } = await supabase.storage\n      .from('farm-images')\n      .upload(path, file, { contentType: file.type, upsert: false })\n    if (upErr) return { url: null, err: `Upload failed: ${upErr.message}` }\n    const { data } = supabase.storage.from('farm-images').getPublicUrl(path)\n    return { url: data.publicUrl, err: null }\n  }\n\n  const toggleDay = (day: string) => {\n    setSlotDays((prev) =>\n      prev.includes(day) ? prev.filter((d) => d !== day) : [...prev, day],\n    )\n  }\n\n  const addPickup = () => {\n    const v = newPickup.trim()\n    if (!v) return\n    if (pickupLocations.includes(v)) { setNewPickup(''); return }\n    setPickupLocations((prev) => [...prev, v])\n    setNewPickup('')\n  }\n  const removePickup = (loc: string) =>\n    setPickupLocations((prev) => prev.filter((l) => l !== loc))\n\n  const handleSave = async () => {\n    if (!name.trim()) { setError(tx.nameRequired); return }\n    if (!village.trim()) { setError(tx.villageRequired); return }\n    if (upiId.trim() && !/^[a-zA-Z0-9._\\-]{2,256}@[a-zA-Z]{2,64}$/.test(upiId.trim())) {\n      setError('Invalid UPI ID format. Example: yourname@ybl or 9876543210@paytm')\n      return\n    }\n    setLoading(true)\n    setError('')\n\n    // Build unique slug from name if current slug is still auto-generated\n    const isAutoSlug = /^f-\\d{10}-[a-z0-9]{4}$/.test(farmer.slug ?? '')\n    const baseSlug = name\n      .toLowerCase()\n      .trim()\n      .replace(/[^a-z0-9]+/g, '-')\n      .replace(/(^-|-$)/g, '')\n      .slice(0, 40) || 'farmer'\n    let newSlug = farmer.slug\n    if (isAutoSlug && baseSlug) {\n      const rand = Math.random().toString(36).slice(2, 5)\n      newSlug = `${baseSlug}-${rand}`\n    }\n\n    // Upload photos in parallel\n    const [coverRes, avatarRes, certRes, qrRes] = await Promise.all([\n      coverFile ? uploadProfileImage(coverFile, 'cover') : Promise.resolve({ url: null, err: null }),\n      avatarFile ? uploadProfileImage(avatarFile, 'avatar') : Promise.resolve({ url: null, err: null }),\n      certFile  ? uploadProfileImage(certFile,  'pesticide-cert') : Promise.resolve({ url: null, err: null }),\n      qrFile    ? uploadProfileImage(qrFile,    'upi-qr') : Promise.resolve({ url: null, err: null }),\n    ])\n    const uploadErr = coverRes.err ?? avatarRes.err ?? certRes.err ?? qrRes.err\n    if (uploadErr) { setError(uploadErr); setLoading(false); return }\n\n    const payload: Record<string, unknown> = {\n      name:             name.trim(),\n      village:          village.trim(),\n      district:         district.trim(),\n      method,\n      slug:             newSlug,\n      pickup_locations: pickupLocations,\n      farm_address:     farmAddress.trim() || null,\n      cover_photo_url:  (coverRes.url ?? existingCoverUrl) || null,\n      photo_url:        (avatarRes.url ?? existingAvatarUrl) || null,\n      pesticide_cert_url: (certRes.url ?? existingCertUrl) || null,\n      upi_id:           upiId.trim() || null,\n      upi_qr_code_url:  (qrRes.url ?? existingQrUrl) || null,\n      cod_enabled:      codEnabled,\n      pickup_slots: slotDays.length > 0\n        ? { days: slotDays, time_from: slotFrom, time_to: slotTo }\n        : null,\n      lat: farmerLat,\n      lng: farmerLng,\n      location_name: farmerLat ? (farmerLocationName || name.trim()) : null,\n    }\n    if (sinceYear) payload.farming_since_year = Number(sinceYear)\n\n    const { data, error: err } = await supabase\n      .from('farmers')\n      .update(payload)\n      .eq('id', farmer.id)\n      .select('*')\n      .single()\n\n    setLoading(false)\n\n    if (err || !data) {\n      setError(err?.message ?? tx.couldNotSave)\n      return\n    }\n\n    localStorage.setItem('yff_farmer_slug', data.slug)\n    onSaved(data)\n  }\n\n  const handleChangePassword = async () => {\n    if (!currentPassword) { setPwError('Current password is required / ప్రస్తుత పాస్‌వర్డ్ అవసరం'); return }\n    if (newPassword.length < 6) { setPwError('Minimum 6 characters / కనీసం 6 అక్షరాలు'); return }\n    if (newPassword !== confirmPassword) { setPwError('Passwords do not match / పాస్‌వర్డ్‌లు సరిపోలలేదు'); return }\n    setPwLoading(true)\n    setPwError('')\n    const res = await fetch('/api/auth/reset-password', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      credentials: 'same-origin',\n      body: JSON.stringify({ currentPassword, newPassword }),\n    })\n    const json = await res.json().catch(() => ({}))\n    setPwLoading(false)\n    if (!res.ok) { setPwError(json.error ?? 'Could not update password.'); return }\n    setPwSuccess(true)\n    setCurrentPassword('')\n    setNewPassword('')\n    setConfirmPassword('')\n    setTimeout(() => { setPwSuccess(false); setShowPwSection(false) }, 2000)\n  }\n\n  return (\n    <div className=\"fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4\">\n      <div className=\"bg-white rounded-t-2xl sm:rounded-2xl w-full max-w-md max-h-[92vh] overflow-y-auto\">\n        <div className=\"sticky top-0 bg-white flex items-center justify-between px-4 py-3 border-b border-gray-100\">\n          <div>\n            <h3 className=\"font-extrabold text-gray-900 text-base\">\n              {tx.profileModalTitle}\n            </h3>\n            <p className=\"text-xs text-gray-500\">{tx.profileModalSubtitle}</p>\n          </div>\n          <button onClick={onClose} className=\"text-gray-400 text-3xl leading-none p-1\">×</button>\n        </div>\n\n        <div className=\"p-4 space-y-4\">\n          {/* ── Section 1: Farm Profile ── */}\n          <div className=\"pt-1 border-t-2 border-green-100 first:border-t-0\">\n            <h4 className=\"text-sm font-extrabold text-green-800\">Farm Profile / పొలం వివరాలు</h4>\n            <p className=\"text-[11px] text-gray-500\">Name, photo, certifications</p>\n          </div>\n\n          <Field\n            label={tx.yourNameLabel}\n            placeholder=\"Ramu Reddy\"\n            value={name}\n            onChange={setName}\n          />\n          <Field\n            label={tx.villageLabel}\n            placeholder=\"Tadepalligudem\"\n            value={village}\n            onChange={setVillage}\n          />\n          <Field\n            label={tx.districtLabel}\n            placeholder=\"West Godavari\"\n            value={district}\n            onChange={setDistrict}\n          />\n\n          <div>\n            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n              {tx.farmingMethodLabel}\n            </label>\n            <select\n              value={method}\n              onChange={(e) => setMethod(e.target.value)}\n              className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-green-500 focus:outline-none\"\n            >\n              <option value=\"natural\">{tx.methodNatural}</option>\n              <option value=\"organic\">{tx.methodOrganic}</option>\n              <option value=\"low_chemical\">{tx.methodLowChemical}</option>\n              <option value=\"chemical\">{tx.methodChemical}</option>\n            </select>\n          </div>\n\n          <Field\n            label={tx.farmingSinceLabel}\n            placeholder=\"e.g. 2005\"\n            value={sinceYear}\n            onChange={setSinceYear}\n            type=\"number\"\n          />\n\n          {/* Farm GPS location */}\n          <div>\n            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n              Farm location / పొలం లొకేషన్\n            </label>\n            <p className=\"text-[11px] text-gray-500 mb-2 leading-snug\">\n              Set your farm location so nearby buyers discover your produce first.<br />\n              దగ్గరలో ఉన్న కొనుగోలుదారులు మీ పంటను ముందుగా కనుగొంటారు.\n            </p>\n            {farmerLat && farmerLng ? (\n              <div className=\"flex items-center justify-between bg-green-50 border border-green-200 rounded-xl px-4 py-3\">\n                <span className=\"text-sm font-semibold text-green-800\">\n                  ✓ 📍 {farmerLocationName || 'Location set'}\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={() => { setFarmerLat(null); setFarmerLng(null); setFarmerLocationName('') }}\n                  className=\"text-xs text-green-700 underline font-semibold\"\n                >\n                  Change / మార్చు\n                </button>\n              </div>\n            ) : (\n              <div className=\"space-y-2\">\n                <button\n                  type=\"button\"\n                  onClick={handleFarmerGPS}\n                  disabled={locating}\n                  className=\"w-full flex items-center justify-center gap-2 bg-green-700 text-white font-bold py-3.5 rounded-xl text-sm active:bg-green-800 disabled:opacity-50\"\n                >\n                  {locating ? (\n                    <>\n                      <span className=\"animate-spin inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full\" />\n                      Getting location... / లొకేషన్ తెస్తోంది\n                    </>\n                  ) : (\n                    <>📍 Use GPS (most accurate) / GPS వాడండి</>\n                  )}\n                </button>\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"flex-1 border-t border-gray-200\" />\n                  <span className=\"text-[10px] text-gray-400 font-semibold\">OR / లేదా</span>\n                  <div className=\"flex-1 border-t border-gray-200\" />\n                </div>\n                <LocationSearch\n                  placeholder=\"Search farm location / పొలం లొకేషన్ వెతకండి\"\n                  onSelect={(lat, lng, name) => {\n                    setFarmerLat(lat)\n                    setFarmerLng(lng)\n                    setFarmerLocationName(name)\n                  }}\n                />\n              </div>\n            )}\n            {locError && (\n              <p className=\"text-xs text-red-600 bg-red-50 rounded-xl px-3 py-2 mt-2\">{locError}</p>\n            )}\n          </div>\n\n          {/* Farm cover photo */}\n          <div>\n            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n              {tx.coverPhotoLabel}\n            </label>\n            <p className=\"text-[11px] text-gray-500 mb-2\">{tx.coverPhotoHelp}</p>\n            <ProfilePhotoUpload\n              preview={coverPreview}\n              existingUrl={existingCoverUrl}\n              onPick={(e) => handlePickFile(e, setCoverFile, setCoverPreview, coverPreview)}\n              onClear={() => { if (coverPreview) URL.revokeObjectURL(coverPreview); setCoverFile(null); setCoverPreview(''); setExistingCoverUrl('') }}\n              takeLabel={tx.takePhoto}\n              galleryLabel={tx.fromGallery}\n              aspectClass=\"aspect-[3/1]\"\n            />\n          </div>\n\n          {/* Farmer avatar */}\n          <div>\n            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n              {tx.avatarLabel}\n            </label>\n            <p className=\"text-[11px] text-gray-500 mb-2\">{tx.avatarHelp}</p>\n            <ProfilePhotoUpload\n              preview={avatarPreview}\n              existingUrl={existingAvatarUrl}\n              onPick={(e) => handlePickFile(e, setAvatarFile, setAvatarPreview, avatarPreview)}\n              onClear={() => { if (avatarPreview) URL.revokeObjectURL(avatarPreview); setAvatarFile(null); setAvatarPreview(''); setExistingAvatarUrl('') }}\n              takeLabel={tx.takePhoto}\n              galleryLabel={tx.fromGallery}\n              aspectClass=\"aspect-square max-w-[120px]\"\n            />\n          </div>\n\n          {/* Pesticide cert */}\n          <div>\n            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n              {tx.pesticideCertLabel}\n            </label>\n            <p className=\"text-[11px] text-gray-500 mb-2\">{tx.pesticideCertHelp}</p>\n            {existingCertUrl && !certPreview ? (\n              <div className=\"flex items-center gap-3 bg-green-50 border border-green-200 rounded-xl p-3\">\n                <span className=\"text-green-700 font-semibold text-sm\">{tx.certUploaded}</span>\n                <a href={existingCertUrl} target=\"_blank\" rel=\"noopener noreferrer\"\n                  className=\"text-xs text-green-700 underline font-semibold ml-auto\">{tx.viewCertificate}</a>\n                <button type=\"button\" onClick={() => setExistingCertUrl('')}\n                  className=\"text-xs text-red-500 underline\">{tx.removeCert}</button>\n              </div>\n            ) : (\n              <ProfilePhotoUpload\n                preview={certPreview}\n                existingUrl=\"\"","numLines":1344,"startLine":1,"totalLines":3070,"truncatedByTokenCap":true}},"sourceToolAssistantUUID":"41deec75-4d52-4179-b03a-2c797ab15286","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"d51f736f-d9c2-4f30-8e62-dc1002a92f5b","version":"2.1.177","gitBranch":"main"}
