{"parentUuid":"5d17d680-c898-4595-a95c-fd78523fad78","isSidechain":false,"promptId":"8995b283-45e8-40aa-ad9b-265beb0e3d60","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pt3ZAgnkyivqAXhBVYP8md","type":"tool_result","content":"1\timport { createClient } from '@supabase/supabase-js'\n2\timport { NextRequest, NextResponse } from 'next/server'\n3\timport { isModeratorRequest, getModeratorZone } from '@/lib/moderator-session'\n4\t\n5\texport const runtime = 'nodejs'\n6\texport const dynamic = 'force-dynamic'\n7\t\n8\tconst METHODS = ['natural', 'low_chemical', 'chemical'] as const\n9\t\n10\tfunction slugify(name: string): string {\n11\t  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')\n12\t}\n13\t\n14\tfunction svc() {\n15\t  return createClient(\n16\t    process.env.NEXT_PUBLIC_SUPABASE_URL!,\n17\t    process.env.SUPABASE_SERVICE_ROLE_KEY!,\n18\t  )\n19\t}\n20\t\n21\t// GET — all farmers in the moderator's zone, with a live listing count.\n22\texport async function GET(req: NextRequest) {\n23\t  if (!isModeratorRequest(req)) {\n24\t    return NextResponse.json({ error: 'Moderator login required.' }, { status: 401 })\n25\t  }\n26\t  const zone = getModeratorZone()\n27\t  const supabase = svc()\n28\t\n29\t  const { data: farmers, error } = await supabase\n30\t    .from('farmers')\n31\t    .select('id, slug, name, village, district, method, phone, active, created_at')\n32\t    .eq('region_slug', zone)\n33\t    .order('created_at', { ascending: false })\n34\t\n35\t  if (error) {\n36\t    console.error('[YFF moderator/farmers] query failed:', error.message)\n37\t    return NextResponse.json({ error: error.message }, { status: 500 })\n38\t  }\n39\t\n40\t  // Listing count per farmer (one grouped query, merged in JS).\n41\t  const ids = (farmers ?? []).map((f) => f.id)\n42\t  const counts: Record<string, number> = {}\n43\t  if (ids.length > 0) {\n44\t    const { data: listings } = await supabase\n45\t      .from('produce_listings')\n46\t      .select('farmer_id')\n47\t      .in('farmer_id', ids)\n48\t    for (const l of listings ?? []) {\n49\t      if (l.farmer_id) counts[l.farmer_id] = (counts[l.farmer_id] ?? 0) + 1\n50\t    }\n51\t  }\n52\t\n53\t  const withCounts = (farmers ?? []).map((f) => ({ ...f, listing_count: counts[f.id] ?? 0 }))\n54\t  return NextResponse.json({ farmers: withCounts })\n55\t}\n56\t\n57\t// POST — register a new farmer in the zone. Auto-generates a unique slug.\n58\texport async function POST(req: NextRequest) {\n59\t  if (!isModeratorRequest(req)) {\n60\t    return NextResponse.json({ error: 'Moderator login required.' }, { status: 401 })\n61\t  }\n62\t  const zone = getModeratorZone()\n63\t  const supabase = svc()\n64\t\n65\t  const body = await req.json().catch(() => null)\n66\t  if (!body) return NextResponse.json({ error: 'Invalid body.' }, { status: 400 })\n67\t\n68\t  const name = String((body as { name?: unknown }).name ?? '').trim()\n69\t  const phone = String((body as { phone?: unknown }).phone ?? '').trim()\n70\t  const village = String((body as { village?: unknown }).village ?? '').trim()\n71\t  const district = String((body as { district?: unknown }).district ?? '').trim()\n72\t  const methodRaw = String((body as { method?: unknown }).method ?? 'natural').trim()\n73\t  const story_quote = String((body as { story_quote?: unknown }).story_quote ?? '').trim()\n74\t  const farm_size_acres = Number((body as { farm_size_acres?: unknown }).farm_size_acres ?? 0) || null\n75\t  const farming_since_year = Number((body as { farming_since_year?: unknown }).farming_since_year ?? 0) || null\n76\t\n77\t  // Marketing / payout details — the same things a farmer fills on their own\n78\t  // profile, so a moderator onboarding on their behalf can capture them up front.\n79\t  const farm_address = String((body as { farm_address?: unknown }).farm_address ?? '').trim()\n80\t  const upi_id = String((body as { upi_id?: unknown }).upi_id ?? '').trim()\n81\t  const cod_enabled = (body as { cod_enabled?: unknown }).cod_enabled === true\n82\t\n83\t  const rawPickups = (body as { pickup_locations?: unknown }).pickup_locations\n84\t  const pickup_locations = Array.isArray(rawPickups)\n85\t    ? Array.from(new Set(rawPickups.map((p) => String(p).trim()).filter(Boolean)))\n86\t    : []\n87\t\n88\t  // pickup_slots: { days: string[], time_from, time_to } — stored only when at\n89\t  // least one day is chosen, matching the farmer-side profile editor.\n90\t  const slots = (body as { pickup_slots?: unknown }).pickup_slots as\n91\t    | { days?: unknown; time_from?: unknown; time_to?: unknown }\n92\t    | null\n93\t    | undefined\n94\t  const slotDays = Array.isArray(slots?.days) ? slots!.days.map((d) => String(d)).filter(Boolean) : []\n95\t  const pickup_slots = slotDays.length > 0\n96\t    ? { days: slotDays, time_from: String(slots?.time_from ?? '08:00'), time_to: String(slots?.time_to ?? '12:00') }\n97\t    : null\n98\t\n99\t  if (!name) return NextResponse.json({ error: 'Name is required.' }, { status: 400 })\n100\t  if (upi_id && !/^[a-zA-Z0-9._-]{2,256}@[a-zA-Z]{2,64}$/.test(upi_id)) {\n101\t    return NextResponse.json({ error: 'Invalid UPI ID. Example: name@ybl' }, { status: 400 })\n102\t  }\n103\t  const method = (METHODS as readonly string[]).includes(methodRaw) ? methodRaw : 'natural'\n104\t\n105\t  // Unique slug — append -2, -3, ... if taken.\n106\t  const base = slugify(name) || 'farmer'\n107\t  let slug = base\n108\t  for (let i = 2; i < 50; i++) {\n109\t    const { data: existing } = await supabase.from('farmers').select('id').eq('slug', slug).maybeSingle()\n110\t    if (!existing) break\n111\t    slug = `${base}-${i}`\n112\t  }\n113\t\n114\t  const { data: inserted, error } = await supabase\n115\t    .from('farmers')\n116\t    .insert({\n117\t      slug,\n118\t      name,\n119\t      phone: phone || null,\n120\t      village: village || null,\n121\t      district: district || null,\n122\t      method,\n123\t      story_quote: story_quote || null,\n124\t      farm_size_acres,\n125\t      farming_since_year,\n126\t      farm_address: farm_address || null,\n127\t      pickup_locations,\n128\t      pickup_slots,\n129\t      upi_id: upi_id || null,\n130\t      cod_enabled,\n131\t      region_slug: zone,\n132\t      active: true,\n133\t    })\n134\t    .select('id, slug, name, phone')\n135\t    .single()\n136\t\n137\t  if (error) {\n138\t    console.error('[YFF moderator/farmers] insert failed:', error.message)\n139\t    return NextResponse.json({ error: error.message }, { status: 500 })\n140\t  }\n141\t\n142\t  return NextResponse.json({ farmer: inserted })\n143\t}\n144\t"}]},"uuid":"b21973e8-7f1c-42ae-a78f-e33eaddebc03","timestamp":"2026-06-13T06:36:30.470Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/app/api/moderator/farmers/route.ts","content":"import { createClient } from '@supabase/supabase-js'\nimport { NextRequest, NextResponse } from 'next/server'\nimport { isModeratorRequest, getModeratorZone } from '@/lib/moderator-session'\n\nexport const runtime = 'nodejs'\nexport const dynamic = 'force-dynamic'\n\nconst METHODS = ['natural', 'low_chemical', 'chemical'] as const\n\nfunction slugify(name: string): string {\n  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')\n}\n\nfunction svc() {\n  return createClient(\n    process.env.NEXT_PUBLIC_SUPABASE_URL!,\n    process.env.SUPABASE_SERVICE_ROLE_KEY!,\n  )\n}\n\n// GET — all farmers in the moderator's zone, with a live listing count.\nexport async function GET(req: NextRequest) {\n  if (!isModeratorRequest(req)) {\n    return NextResponse.json({ error: 'Moderator login required.' }, { status: 401 })\n  }\n  const zone = getModeratorZone()\n  const supabase = svc()\n\n  const { data: farmers, error } = await supabase\n    .from('farmers')\n    .select('id, slug, name, village, district, method, phone, active, created_at')\n    .eq('region_slug', zone)\n    .order('created_at', { ascending: false })\n\n  if (error) {\n    console.error('[YFF moderator/farmers] query failed:', error.message)\n    return NextResponse.json({ error: error.message }, { status: 500 })\n  }\n\n  // Listing count per farmer (one grouped query, merged in JS).\n  const ids = (farmers ?? []).map((f) => f.id)\n  const counts: Record<string, number> = {}\n  if (ids.length > 0) {\n    const { data: listings } = await supabase\n      .from('produce_listings')\n      .select('farmer_id')\n      .in('farmer_id', ids)\n    for (const l of listings ?? []) {\n      if (l.farmer_id) counts[l.farmer_id] = (counts[l.farmer_id] ?? 0) + 1\n    }\n  }\n\n  const withCounts = (farmers ?? []).map((f) => ({ ...f, listing_count: counts[f.id] ?? 0 }))\n  return NextResponse.json({ farmers: withCounts })\n}\n\n// POST — register a new farmer in the zone. Auto-generates a unique slug.\nexport async function POST(req: NextRequest) {\n  if (!isModeratorRequest(req)) {\n    return NextResponse.json({ error: 'Moderator login required.' }, { status: 401 })\n  }\n  const zone = getModeratorZone()\n  const supabase = svc()\n\n  const body = await req.json().catch(() => null)\n  if (!body) return NextResponse.json({ error: 'Invalid body.' }, { status: 400 })\n\n  const name = String((body as { name?: unknown }).name ?? '').trim()\n  const phone = String((body as { phone?: unknown }).phone ?? '').trim()\n  const village = String((body as { village?: unknown }).village ?? '').trim()\n  const district = String((body as { district?: unknown }).district ?? '').trim()\n  const methodRaw = String((body as { method?: unknown }).method ?? 'natural').trim()\n  const story_quote = String((body as { story_quote?: unknown }).story_quote ?? '').trim()\n  const farm_size_acres = Number((body as { farm_size_acres?: unknown }).farm_size_acres ?? 0) || null\n  const farming_since_year = Number((body as { farming_since_year?: unknown }).farming_since_year ?? 0) || null\n\n  // Marketing / payout details — the same things a farmer fills on their own\n  // profile, so a moderator onboarding on their behalf can capture them up front.\n  const farm_address = String((body as { farm_address?: unknown }).farm_address ?? '').trim()\n  const upi_id = String((body as { upi_id?: unknown }).upi_id ?? '').trim()\n  const cod_enabled = (body as { cod_enabled?: unknown }).cod_enabled === true\n\n  const rawPickups = (body as { pickup_locations?: unknown }).pickup_locations\n  const pickup_locations = Array.isArray(rawPickups)\n    ? Array.from(new Set(rawPickups.map((p) => String(p).trim()).filter(Boolean)))\n    : []\n\n  // pickup_slots: { days: string[], time_from, time_to } — stored only when at\n  // least one day is chosen, matching the farmer-side profile editor.\n  const slots = (body as { pickup_slots?: unknown }).pickup_slots as\n    | { days?: unknown; time_from?: unknown; time_to?: unknown }\n    | null\n    | undefined\n  const slotDays = Array.isArray(slots?.days) ? slots!.days.map((d) => String(d)).filter(Boolean) : []\n  const pickup_slots = slotDays.length > 0\n    ? { days: slotDays, time_from: String(slots?.time_from ?? '08:00'), time_to: String(slots?.time_to ?? '12:00') }\n    : null\n\n  if (!name) return NextResponse.json({ error: 'Name is required.' }, { status: 400 })\n  if (upi_id && !/^[a-zA-Z0-9._-]{2,256}@[a-zA-Z]{2,64}$/.test(upi_id)) {\n    return NextResponse.json({ error: 'Invalid UPI ID. Example: name@ybl' }, { status: 400 })\n  }\n  const method = (METHODS as readonly string[]).includes(methodRaw) ? methodRaw : 'natural'\n\n  // Unique slug — append -2, -3, ... if taken.\n  const base = slugify(name) || 'farmer'\n  let slug = base\n  for (let i = 2; i < 50; i++) {\n    const { data: existing } = await supabase.from('farmers').select('id').eq('slug', slug).maybeSingle()\n    if (!existing) break\n    slug = `${base}-${i}`\n  }\n\n  const { data: inserted, error } = await supabase\n    .from('farmers')\n    .insert({\n      slug,\n      name,