{"parentUuid":"2e35b0b1-2841-423f-8299-1973a20c85a2","isSidechain":false,"promptId":"6c013195-48de-41ec-afd8-5f54e76d9b01","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FjmQmLUFkWSZVvJKCmMmb8","type":"tool_result","content":"1\t'use client'\n2\t\n3\timport Link from 'next/link'\n4\timport { useLang } from '@/lib/LanguageContext'\n5\t\n6\ttype Farmer = {\n7\t  id: string\n8\t  slug: string\n9\t  name: string\n10\t  village?: string\n11\t  district?: string\n12\t  method?: string\n13\t  rating_avg?: number\n14\t  farming_since_year?: number\n15\t}\n16\t\n17\ttype Produce = {\n18\t  farmer_id: string\n19\t  name: string\n20\t  emoji?: string\n21\t}\n22\t\n23\texport default function FarmersTab({\n24\t  farmers,\n25\t  produce,\n26\t  highlightedFarmerId,\n27\t}: {\n28\t  farmers: Record<string, unknown>[]\n29\t  produce: Record<string, unknown>[]\n30\t  highlightedFarmerId: string | null\n31\t}) {\n32\t  const { tx } = useLang()\n33\t  const list = farmers as Farmer[]\n34\t  const produceList = produce as Produce[]\n35\t\n36\t  if (list.length === 0) {\n37\t    return <div className=\"text-center py-10 text-gray-400 text-sm\">{tx.noFarmersFound}</div>\n38\t  }\n39\t\n40\t  return (\n41\t    <div className=\"space-y-3\">\n42\t      {list.map((farmer, index) => {\n43\t        const farmerProduce = produceList.filter((p) => p.farmer_id === farmer.id)\n44\t        const isHighlighted = highlightedFarmerId === farmer.id\n45\t        const isCofounder = index === 0\n46\t        const initials = farmer.name.slice(0, 2).toUpperCase()\n47\t        const yearsfarming = farmer.farming_since_year\n48\t          ? new Date().getFullYear() - farmer.farming_since_year\n49\t          : null\n50\t\n51\t        return (\n52\t          <div key={farmer.id}\n53\t            className={`bg-white rounded-xl border p-4 transition-all ${\n54\t              isHighlighted ? 'border-green-500 shadow-md' : 'border-gray-100'\n55\t            } ${isCofounder ? 'border-l-