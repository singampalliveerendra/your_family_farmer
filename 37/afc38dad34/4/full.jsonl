{"parentUuid":"e1d2f8e4-cd71-49a8-b613-8153c75870d2","isSidechain":false,"promptId":"6c013195-48de-41ec-afd8-5f54e76d9b01","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AtCf3ZEcLFkTLuTqQWjTvd","type":"tool_result","content":"1\t'use client'\n2\t\n3\timport { useState, useEffect, useCallback } from 'react'\n4\timport { useRouter } from 'next/navigation'\n5\timport { supabase } from '@/lib/supabase'\n6\timport Link from 'next/link'\n7\timport LanguageToggle from '@/components/LanguageToggle'\n8\t\n9\ttype Farmer = {\n10\t  id: string\n11\t  name: string\n12\t  slug: string\n13\t  village: string\n14\t  district: string\n15\t  phone: string\n16\t  method: string\n17\t  region_slug: string\n18\t  rating_avg: number | null\n19\t  buyer_count: number\n20\t  farming_since_year: number | null\n21\t}\n22\t\n23\ttype DemandBar = {\n24\t  crop_name: string\n25\t  total_qty: number\n26\t}\n27\t\n28\ttype PreviewData = {\n29\t  name: string\n30\t  variety: string\n31\t  emoji: string\n32\t  price: string\n33\t  method: string\n34\t  stock: string\n35\t}\n36\t\n37\tconst EMOJI_OPTIONS = ['🍅', '🍌', '🥭', '🫑', '🥬', '🍆', '🥕', '🌽', '🧅', '🧄', '🥦', '🌿', '🍓', '🫒', '🌾', '🥥']\n38\t\n39\tconst isProfileComplete = (f: Farmer | null) =>\n40\t  !!f && f.name?.trim().length > 0 && f.village?.trim().length > 0\n41\t\n42\texport default function FarmerDashboard() {\n43\t  const router = useRouter()\n44\t  const [farmer, setFarmer] = useState<Farmer | null>(null)\n45\t  const [loading, setLoading] = useState(true)\n46\t  const [notFound, setNotFound] = useState(false)\n47\t  const [activeListings, setActiveListings] = useState(0)\n48\t  const [ordersCount, setOrdersCount] = useState(0)\n49\t  const [demandBars, setDemandBars] = useState<DemandBar[]>([])\n50\t  const [showForm, setShowForm] = useState(false)\n51\t  const [showProfileEdit, setShowProfileEdit] = useState(false)\n52\t\n53\t  const loadDashboard = useCallback(async () => {\n54\t    const farmerId = localStorage.getItem('yff_farmer_id')\n55\t    if (!farmerId) { router.replace('/farmer/login'); return }\n56\t\n57\t    const { data: farmerData } = await supabase\n58\t      .from('farmers')\n59\t      .select('*')\n60\t      .eq('id', farmerId)\n61\t      .maybeSingle()\n62\t\n63\t    if (!farmerData) { setNotFound(true); setLoading(false); return }\n64\t    setFarmer(farmerData)\n65\t\n66\t    const [listingsRes, ordersRes, intentsRes] = await Promise.all([\n67\t      supabase.from('produce_listings').select('id', { count: 'exact', head: true }).eq('farmer_id', farmerData.id).eq('status', 'available'),\n68\t      supabase.from('orders').select('id', { count: 'exact', head: true }).eq('farmer_id', farmerData.id).gte('created_at', new Date(Date.now() - 7 * 86400000).toISOString()),\n69\t      supabase.from('demand_intents').select('crop_name, quantity_kg').eq('region_slug', farmerData.region_slug).eq('fulfilled', false),\n70\t    ])\n71\t\n72\t    setActiveListings(listingsRes.count ?? 0)\n73\t    setOrdersCount(ordersRes.count ?? 0)\n74\t\n75\t    const map: Record<string, number> = {}\n76\t    for (const row of intentsRes.data ?? []) {\n77\t      map[row.crop_name] = (map[row.crop_name] ?? 0) + (Number(row.quantity_kg) || 0)\n78\t    }\n79\t    setDemandBars(\n80\t      Object.entries(map)\n81\t        .map(([crop_name, total_qty]) => ({ crop_name, total_qty }))\n82\t        .sort((a, b) => b.total_qty - a.total_qty)\n83\t        .slice(0, 5)\n84\t    )\n85\t\n86\t    setLoading(false)\n87\t  }, [router])\n88\t\n89\t  useEffect(() => { loadDashboard() }, [loadDashboard])\n90\t\n91\t  // Auto-open the profile edit modal the first time an incomplete farmer lands here.\n92\t  useEffect(() => {\n93\t    if (!loading && farmer && !isProfileComplete(farmer)) {\n94\t      setShowProfileEdit(true)\n95\t    }\n96\t  }, [loading, farmer])\n97\t\n98\t  const handleLogout = () => {\n99\t    localStorage.removeItem('yff_farmer_id')\n100\t    localStorage.removeItem('yff_farmer_slug')\n101\t    router.replace('/farmer/login')\n102\t  }\n103\t\n104\t  if (loading) return <LoadingScreen />\n105\t  if (notFound) return <FarmerNotFound onLogout={handleLogout} />\n106\t\n107\t  const profileComplete = isProfileComplete(farmer)\n108\t  const displayName = farmer!.name?.trim() || 'Welcome'\n109\t\n110\t  return (\n111\t    <main className=\"min-h-screen bg-gray-50 pb-16\">\n112\t      {/* Header */}\n113\t      <div className=\"bg-green-900 px-4 pt-6 pb-10\">\n114\t        <div className=\"flex justify-end mb-2\">\n115\t          <LanguageToggle />\n116\t        </div>\n117\t        <div className=\"flex items-start justify-between\">\n118\t          <div>\n119\t            <p className=\"text-green-400 text-xs font-semibold mb-0.5 uppercase tracking-wide\">\n120\t              Farmer Dashboard / రైతు డాష్‌బోర్డ్\n121\t            </p>\n122\t            <h1 className=\"text-white text-xl font-extrabold leading-tight\">{displayName}</h1>\n123\t            <p className=\"text-green-300 text-sm mt-0.5\">\n124\t              {profileComplete\n125\t                ? `${farmer!.village}, ${farmer!.district}`\n126\t                : 'Complete your profile to get started / ప్రొఫైల్ పూర్తి చేయండి'}\n127\t            </p>\n128\t            <p className=\"text-green-500 text-xs mt-1\">+91 {farmer!.phone}</p>\n129\t          </div>\n130\t          <div className=\"flex flex-col items-end gap-2 flex-shrink-0\">\n131\t            {profileComplete ? (\n132\t              <Link\n133\t                href={`/farmer/${farmer!.slug}`}\n134\t                className=\"bg-white text-green-800 text-xs font-bold px-3 py-2 rounded-xl\"\n135\t              >\n136\t                View profile ↗\n137\t              </Link>\n138\t            ) : (\n139\t              <span className=\"bg-amber-400 text-amber-900 text-[10px] font-bold px-2 py-1 rounded-full\">\n140\t                Incomplete\n141\t              </span>\n142\t            )}\n143\t            <button\n144\t              onClick={() => setShowProfileEdit(true)}\n145\t              className=\"text-white text-xs underline\"\n146\t            >\n147\t              Edit profile\n148\t            </button>\n149\t            <button onClick={handleLogout} className=\"text-green-500 text-xs underline\">\n150\t              Logout\n151\t            </button>\n152\t          </div>\n153\t        </div>\n154\t      </div>\n155\t\n156\t      <div className=\"px-4 -mt-5 space-y-4\">\n157\t        {/* Complete profile banner */}\n158\t        {!profileComplete && (\n159\t          <div className=\"bg-amber-50 border-2 border-amber-300 rounded-2xl p-4 flex items-start gap-3\">\n160\t            <span className=\"text-2xl flex-shrink-0\">📝</span>\n161\t            <div className=\"flex-1 min-w-0\">\n162\t              <h3 className=\"font-extrabold text-amber-900 text-base leading-tight\">\n163\t                Complete your profile\n164\t              </h3>\n165\t              <p className=\"text-amber-700 text-xs mt-0.5\">\n166\t                ప్రొఫైల్ పూర్తి చేస్తే బయ్యర్లు మిమ్మల్ని కనుగొంటారు\n167\t              </p>\n168\t              <button\n169\t                onClick={() => setShowProfileEdit(true)}\n170\t                className=\"mt-3 bg-amber-600 text-white font-bold px-4 py-2.5 rounded-xl text-sm\"\n171\t              >\n172\t                Fill details / వివరాలు నింపండి\n173\t              </button>\n174\t            </div>\n175\t          </div>\n176\t        )}\n177\t\n178\t        {/* Stat cards */}\n179\t        <div className=\"grid grid-cols-2 gap-3\">\n180\t          {[\n181\t            { label: 'Active listings', sub: 'చురుకైన పంటలు', value: activeListings, color: 'border-green-200 bg-green-50', vcolor: 'text-green-800' },\n182\t            { label: 'Orders this week', sub: 'ఈ వారం ఆర్డర్లు', value: ordersCount, color: 'border-blue-200 bg-blue-50', vcolor: 'text-blue-800' },\n183\t            { label: 'Avg rating', sub: 'సగటు రేటింగ్', value: farmer!.rating_avg ? `${Number(farmer!.rating_avg).toFixed(1)} ★` : '—', color: 'border-amber-200 bg-amber-50', vcolor: 'text-amber-800' },\n184\t            { label: 'Total buyers', sub: 'మొత్తం కొనుగోలుదారులు', value: farmer!.buyer_count ?? 0, color: 'border-purple-200 bg-purple-50', vcolor: 'text-purple-800' },\n185\t          ].map((s) => (\n186\t            <div key={s.label} className={`${s.color} border rounded-2xl p-4`}>\n187\t              <div className={`text-3xl font-black ${s.vcolor}`}>{s.value}</div>\n188\t              <div className=\"text-sm font-semibold text-gray-800 mt-1 leading-tight\">{s.label}</div>\n189\t              <div className=\"text-xs text-gray-500 mt-0.5\">{s.sub}</div>\n190\t            </div>\n191\t          ))}\n192\t        </div>\n193\t\n194\t        {/* Demand chart */}\n195\t        <div className=\"bg-white rounded-2xl border border-gray-100 p-4\">\n196\t          <h2 className=\"font-extrabold text-gray-900 text-base leading-tight\">\n197\t            Local demand / స్థానిక డిమాండ్\n198\t          </h2>\n199\t          <p className=\"text-xs text-gray-500 mt-0.5 mb-4\">\n200\t            మీ ప్రాంతంలో వినియోగదారులు ఏమి కోరుతున్నారు\n201\t          </p>\n202\t\n203\t          {demandBars.length === 0 ? (\n204\t            <div className=\"text-center py-6\">\n205\t              <p className=\"text-gray-400 text-sm\">No demand signals yet.</p>\n206\t              <p className=\"text-gray-400 text-xs mt-1\">Share your profile link to attract buyers.</p>\n207\t            </div>\n208\t          ) : (\n209\t            <div className=\"space-y-3\">\n210\t              {demandBars.map((bar) => {\n211\t                const pct = Math.round((bar.total_qty / demandBars[0].total_qty) * 100)\n212\t                return (\n213\t                  <div key={bar.crop_name}>\n214\t                    <div className=\"flex items-center justify-between mb-1\">\n215\t                      <span className=\"text-sm font-semibold text-gray-800\">{bar.crop_name}</span>\n216\t                      <span className=\"text-xs text-gray-400 font-medium\">{bar.total_qty} kg</span>\n217\t                    </div>\n218\t                    <div className=\"h-3 bg-gray-100 rounded-full overflow-hidden\">\n219\t                      <div\n220\t                        className=\"h-full bg-green-600 rounded-full\"\n221\t                        style={{ width: `${pct}%` }}\n222\t                      />\n223\t                    </div>\n224\t                  </div>\n225\t                )\n226\t              })}\n227\t            </div>\n228\t          )}\n229\t        </div>\n230\t\n231\t        {/* Add listing button */}\n232\t        {profileComplete ? (\n233\t          !showForm && (\n234\t            <button\n235\t              onClick={() => setShowForm(true)}\n236\t              className=\"w-full bg-white border-2 border-green-700 text-green-700 font-bold py-4 rounded-2xl text-base flex items-center justify-center gap-2 active:bg-green-50\"\n237\t            >\n238\t              <span className=\"text-xl leading-none\">+</span>\n239\t              Add new produce / కొత్త పంట చేర్చండి\n240\t            </button>\n241\t          )\n242\t        ) : (\n243\t          <div className=\"w-full bg-gray-100 text-gray-500 font-semibold py-4 rounded-2xl text-sm text-center\">\n244\t            Complete your profile before adding produce<br />\n245\t            <span className=\"text-xs\">ముందుగా ప్రొఫైల్ పూర్తి చేయండి</span>\n246\t          </div>\n247\t        )}\n248\t\n249\t        {/* Listing form */}\n250\t        {showForm && profileComplete && (\n251\t          <ProduceListingForm\n252\t            farmerId={farmer!.id}\n253\t            farmerSlug={farmer!.slug}\n254\t            defaultMethod={farmer!.method}\n255\t            onClose={() => setShowForm(false)}\n256\t            onPublished={() => { setShowForm(false); loadDashboard() }}\n257\t          />\n258\t        )}\n259\t      </div>\n260\t\n261\t      {/* Edit profile modal */}\n262\t      {showProfileEdit && farmer && (\n263\t        <ProfileEditModal\n264\t          farmer={farmer}\n265\t          onClose={() => {\n266\t            // If profile still incomplete, don't allow close (keep banner as fallback)\n267\t            if (isProfileComplete(farmer)) setShowProfileEdit(false)\n268\t            else setShowProfileEdit(false) // allow dismiss; banner still shown\n269\t          }}\n270\t          onSaved={(updated) => {\n271\t            setFarmer(updated)\n272\t            setShowProfileEdit(false)\n273\t          }}\n274\t        />\n275\t      )}\n276\t    </main>\n277\t  )\n278\t}\n279\t\n280\t/* ─── Profile edit modal ─────────────────────────────────── */\n281\tfunction ProfileEditModal({\n282\t  farmer,\n283\t  onClose,\n284\t  onSaved,\n285\t}: {\n286\t  farmer: Farmer\n287\t  onClose: () => void\n288\t  onSaved: (updated: Farmer) => void\n289\t}) {\n290\t  const [name, setName] = useState(farmer.name ?? '')\n291\t  const [village, setVillage] = useState(farmer.village ?? '')\n292\t  const [district, setDistrict] = useState(farmer.district ?? '')\n293\t  const [method, setMethod] = useState(farmer.method ?? 'natural')\n294\t  const [sinceYear, setSinceYear] = useState(\n295\t    farmer.farming_since_year ? String(farmer.farming_since_year) : '',\n296\t  )\n297\t  const [loading, setLoading] = useState(false)\n298\t  const [error, setError] = useState('')\n299\t\n300\t  const handleSave = async () => {\n301\t    if (!name.trim()) { setError('Your name is required / మీ పేరు అవసరం'); return }\n302\t    if (!village.trim()) { setError('Village is required / గ్రామం అవసరం'); return }\n303\t    setLoading(true)\n304\t    setError('')\n305\t\n306\t    // Build a unique slug from the name once the farmer actually has one.\n307\t    // Only regenerate slug if current slug still looks auto-generated (f-<digits>-xxxx).\n308\t    const isAutoSlug = /^f-\\d{10}-[a-z0-9]{4}$/.test(farmer.slug ?? '')\n309\t    const baseSlug = name\n310\t      .toLowerCase()\n311\t      .trim()\n312\t      .replace(/[^a-z0-9]+/g, '-')\n313\t      .replace(/(^-|-$)/g, '')\n314\t      .slice(0, 40) || 'farmer'\n315\t\n316\t    let newSlug = farmer.slug\n317\t    if (isAutoSlug && baseSlug) {\n318\t      const rand = Math.random().toString(36).slice(2, 5)\n319\t      newSlug = `${baseSlug}-${rand}`\n320\t    }\n321\t\n322\t    const payload: Record<string, unknown> = {\n323\t      name: name.trim(),\n324\t      village: village.trim(),\n325\t      district: district.trim(),\n326\t      method,\n327\t      slug: newSlug,\n328\t    }\n329\t    if (sinceYear) payload.farming_since_year = Number(sinceYear)\n330\t\n331\t    const { data, error: err } = await supabase\n332\t      .from('farmers')\n333\t      .update(payload)\n334\t      .eq('id', farmer.id)\n335\t      .select('*')\n336\t      .single()\n337\t\n338\t    setLoading(false)\n339\t\n340\t    if (err || !data) {\n341\t      setError(err?.message ?? 'Could not save. Please try again.')\n342\t      return\n343\t    }\n344\t\n345\t    localStorage.setItem('yff_farmer_slug', data.slug)\n346\t    onSaved(data)\n347\t  }\n348\t\n349\t  return (\n350\t    <div className=\"fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4\">\n351\t      <div className=\"bg-white rounded-t-2xl sm:rounded-2xl w-full max-w-md max-h-[92vh] overflow-y-auto\">\n352\t        <div className=\"sticky top-0 bg-white flex items-center justify-between px-4 py-3 border-b border-gray-100\">\n353\t          <div>\n354\t            <h3 className=\"font-extrabold text-gray-900 text-base\">Your farmer profile</h3>\n355\t            <p className=\"text-xs text-gray-500\">మీ రైతు ప్రొఫైల్</p>\n356\t          </div>\n357\t          <button onClick={onClose} className=\"text-gray-400 text-3xl leading-none p-1\">×</button>\n358\t        </div>\n359\t\n360\t        <div className=\"p-4 space-y-4\">\n361\t          <Field\n362\t            label=\"Your name / మీ పేరు *\"\n363\t            placeholder=\"Ramu Reddy\"\n364\t            value={name}\n365\t            onChange={setName}\n366\t          />\n367\t          <Field\n368\t            label=\"Village / గ్రామం *\"\n369\t            placeholder=\"Tadepalligudem\"\n370\t            value={village}\n371\t            onChange={setVillage}\n372\t          />\n373\t          <Field\n374\t            label=\"District / జిల్లా\"\n375\t            placeholder=\"West Godavari\"\n376\t            value={district}\n377\t            onChange={setDistrict}\n378\t          />\n379\t\n380\t          <div>\n381\t            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n382\t              Farming method / వ్యవసాయ పద్ధతి\n383\t            </label>\n384\t            <select\n385\t              value={method}\n386\t              onChange={(e) => setMethod(e.target.value)}\n387\t              className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-green-500 focus:outline-none\"\n388\t            >\n389\t              <option value=\"natural\">🌱 Natural / సహజం</option>\n390\t              <option value=\"organic\">🍃 Organic / సేంద్రీయ</option>\n391\t              <option value=\"low_chemical\">⚡ Low chemical / తక్కువ రసాయన</option>\n392\t              <option value=\"chemical\">Chemical / రసాయన</option>\n393\t            </select>\n394\t          </div>\n395\t\n396\t          <Field\n397\t            label=\"Farming since (year) / ఏ సంవత్సరం నుండి\"\n398\t            placeholder=\"e.g. 2005\"\n399\t            value={sinceYear}\n400\t            onChange={setSinceYear}\n401\t            type=\"number\"\n402\t          />\n403\t\n404\t          {error && (\n405\t            <p className=\"text-sm text-red-600 bg-red-50 rounded-xl px-3 py-2\">{error}</p>\n406\t          )}\n407\t\n408\t          <button\n409\t            onClick={handleSave}\n410\t            disabled={loading || !name.trim() || !village.trim()}\n411\t            className=\"w-full bg-green-700 text-white font-bold py-4 rounded-xl text-base disabled:opacity-50 active:bg-green-800\"\n412\t          >\n413\t            {loading ? 'Saving...' : 'Save profile / ప్రొఫైల్ సేవ్'}\n414\t          </button>\n415\t        </div>\n416\t      </div>\n417\t    </div>\n418\t  )\n419\t}\n420\t\n421\tfunction Field({\n422\t  label,\n423\t  placeholder,\n424\t  value,\n425\t  onChange,\n426\t  type = 'text',\n427\t}: {\n428\t  label: string\n429\t  placeholder?: string\n430\t  value: string\n431\t  onChange: (v: string) => void\n432\t  type?: string\n433\t}) {\n434\t  return (\n435\t    <div>\n436\t      <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n437\t        {label}\n438\t      </label>\n439\t      <input\n440\t        type={type}\n441\t        placeholder={placeholder}\n442\t        value={value}\n443\t        onChange={(e) => onChange(e.target.value)}\n444\t        className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-green-500 focus:outline-none\"\n445\t      />\n446\t    </div>\n447\t  )\n448\t}\n449\t\n450\t/* ─── Produce listing form ──────────────────────────────────── */\n451\tfunction ProduceListingForm({\n452\t  farmerId,\n453\t  farmerSlug,\n454\t  defaultMethod,\n455\t  onClose,\n456\t  onPublished,\n457\t}: {\n458\t  farmerId: string\n459\t  farmerSlug: string\n460\t  defaultMethod: string\n461\t  onClose: () => void\n462\t  onPublished: () => void\n463\t}) {\n464\t  const [name, setName] = useState('')\n465\t  const [variety, setVariety] = useState('')\n466\t  const [emoji, setEmoji] = useState('🌿')\n467\t  const [qty, setQty] = useState('')\n468\t  const [period, setPeriod] = useState('')\n469\t  const [farmingMethod, setFarmingMethod] = useState(defaultMethod || 'natural')\n470\t  const [price1, setPrice1] = useState('')\n471\t  const [price1Qty, setPrice1Qty] = useState('5')\n472\t  const [price2, setPrice2] = useState('')\n473\t  const [price2Qty, setPrice2Qty] = useState('20')\n474\t  const [price3, setPrice3] = useState('')\n475\t  const [description, setDescription] = useState('')\n476\t  const [brix, setBrix] = useState('')\n477\t  const [soc, setSoc] = useState('')\n478\t  const [loading, setLoading] = useState(false)\n479\t  const [error, setError] = useState('')\n480\t  const [preview, setPreview] = useState(false)\n481\t  const [published, setPublished] = useState(false)\n482\t  const [publishedSlug, setPublishedSlug] = useState('')\n483\t\n484\t  const previewData: PreviewData = {\n485\t    name: name || 'Produce name',\n486\t    variety: variety || '',\n487\t    emoji,\n488\t    price: price1 || '—',\n489\t    method: farmingMethod,\n490\t    stock: qty || '—',\n491\t  }\n492\t\n493\t  const handlePublish = async () => {\n494\t    if (!name.trim()) { setError('Produce name is required'); return }\n495\t    setLoading(true)\n496\t    setError('')\n497\t\n498\t    const payload: Record<string, unknown> = {\n499\t      farmer_id: farmerId,\n500\t      name: name.trim(),\n501\t      emoji,\n502\t      status: 'available',\n503\t      method: farmingMethod,\n504\t    }\n505\t    if (variety.trim()) payload.variety = variety.trim()\n506\t    if (qty) payload.stock_qty = Number(qty)\n507\t    if (description.trim()) payload.description = description.trim()\n508\t    if (brix) payload.brix = Number(brix)\n509\t    if (soc) payload.soil_organic_carbon = Number(soc)\n510\t    if (price1) { payload.price_tier_1_price = Number(price1); payload.price_tier_1_qty = Number(price1Qty) }\n511\t    if (price2) { payload.price_tier_2_price = Number(price2); payload.price_tier_2_qty = Number(price2Qty) }\n512\t    if (price3) { payload.price_tier_3_price = Number(price3); payload.price_tier_3_qty = Number(price2Qty) + 1 }\n513\t\n514\t    const { error: err } = await supabase.from('produce_listings').insert(payload)\n515\t    setLoading(false)\n516\t\n517\t    if (err) { setError(err.message); return }\n518\t\n519\t    setPublished(true)\n520\t    setPublishedSlug(farmerSlug)\n521\t    setTimeout(() => onPublished(), 2500)\n522\t  }\n523\t\n524\t  if (published) {\n525\t    return (\n526\t      <div className=\"bg-green-50 border-2 border-green-200 rounded-2xl p-6 text-center space-y-3\">\n527\t        <div className=\"text-4xl\">✅</div>\n528\t        <p className=\"font-extrabold text-green-800 text-lg\">Published!</p>\n529\t        <p className=\"text-green-700 text-sm\">Your listing is now live on the consumer page.</p>\n530\t        <Link\n531\t          href={`/farmer/${publishedSlug}`}\n532\t          className=\"inline-block bg-green-700 text-white font-bold px-6 py-3 rounded-xl text-sm\"\n533\t        >\n534\t          View your profile ↗\n535\t        </Link>\n536\t      </div>\n537\t    )\n538\t  }\n539\t\n540\t  return (\n541\t    <div className=\"bg-white rounded-2xl border border-gray-200 overflow-hidden\">\n542\t      {/* Form header */}\n543\t      <div className=\"flex items-center justify-between px-4 py-3 border-b border-gray-100 bg-gray-50\">\n544\t        <h3 className=\"font-extrabold text-gray-900 text-base\">New produce listing</h3>\n545\t        <button onClick={onClose} className=\"text-gray-400 text-2xl leading-none p-1\">×</button>\n546\t      </div>\n547\t\n548\t      <div className=\"p-4 space-y-5\">\n549\t        {/* Emoji picker */}\n550\t        <div>\n551\t          <p className=\"text-xs font-semibold text-gray-600 mb-2\">Pick an icon</p>\n552\t          <div className=\"flex flex-wrap gap-2\">\n553\t            {EMOJI_OPTIONS.map((e) => (\n554\t              <button\n555\t                key={e}\n556\t                onClick={() => setEmoji(e)}\n557\t                className={`w-10 h-10 rounded-xl text-xl flex items-center justify-center transition-all ${\n558\t                  emoji === e ? 'bg-green-100 ring-2 ring-green-500' : 'bg-gray-50'\n559\t                }`}\n560\t              >\n561\t                {e}\n562\t              </button>\n563\t            ))}\n564\t          </div>\n565\t        </div>\n566\t\n567\t        {/* Name + variety */}\n568\t        <div className=\"space-y-2\">\n569\t          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">Produce details</label>\n570\t          <input\n571\t            type=\"text\"\n572\t            placeholder=\"Produce name * (e.g. Tomato / టమాటా)\"\n573\t            value={name}\n574\t            onChange={(e) => setName(e.target.value)}\n575\t            className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-green-500 focus:outline-none\"\n576\t          />\n577\t          <input\n578\t            type=\"text\"\n579\t            placeholder=\"Variety (e.g. Naati heirloom)\"\n580\t            value={variety}\n581\t            onChange={(e) => setVariety(e.target.value)}\n582\t            className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-green-500 focus:outline-none\"\n583\t          />\n584\t        </div>\n585\t\n586\t        {/* Qty + period */}\n587\t        <div className=\"space-y-2\">\n588\t          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">Availability</label>\n589\t          <div className=\"grid grid-cols-2 gap-2\">\n590\t            <input\n591\t              type=\"number\"\n592\t              placeholder=\"Quantity (kg)\"\n593\t              value={qty}\n594\t              onChange={(e) => setQty(e.target.value)}\n595\t              className=\"border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-green-500 focus:outline-none\"\n596\t            />\n597\t            <input\n598\t              type=\"text\"\n599\t              placeholder=\"Period (e.g. Apr–May)\"\n600\t              value={period}\n601\t              onChange={(e) => setPeriod(e.target.value)}\n602\t              className=\"border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-green-500 focus:outline-none\"\n603\t            />\n604\t          </div>\n605\t        </div>\n606\t\n607\t        {/* Farming method */}\n608\t        <div className=\"space-y-2\">\n609\t          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">Farming method</label>\n610\t          <select\n611\t            value={farmingMethod}\n612\t            onChange={(e) => setFarmingMethod(e.target.value)}\n613\t            className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-green-500 focus:outline-none\"\n614\t          >\n615\t            <option value=\"natural\">🌱 Natural / సహజం</option>\n616\t            <option value=\"organic\">🍃 Organic / సేంద్రీయ</option>\n617\t            <option value=\"low_chemical\">⚡ Low chemical</option>\n618\t            <option value=\"chemical\">Chemical</option>\n619\t          </select>\n620\t        </div>\n621\t\n622\t        {/* Delivery method */}\n623\t        <div className=\"space-y-2\">\n624\t          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">Delivery method</label>\n625\t          <div className=\"grid grid-cols-2 gap-2\">\n626\t            <div className=\"flex items-center gap-2 border-2 border-green-600 bg-green-50 rounded-xl px-3 py-3\">\n627\t              <div className=\"w-4 h-4 rounded-full bg-green-600 flex items-center justify-center flex-shrink-0\">\n628\t                <div className=\"w-1.5 h-1.5 bg-white rounded-full\" />\n629\t              </div>\n630\t              <span className=\"text-sm font-semibold text-green-800\">Pickup only</span>\n631\t            </div>\n632\t            <div className=\"flex items-center gap-2 border border-gray-200 bg-gray-50 rounded-xl px-3 py-3 opacity-50 cursor-not-allowed\">\n633\t              <div className=\"w-4 h-4 rounded-full border-2 border-gray-300 flex-shrink-0\" />\n634\t              <div>\n635\t                <span className=\"text-sm font-medium text-gray-400\">I will courier</span>\n636\t                <span className=\"block text-[10px] text-gray-400\">Coming soon</span>\n637\t              </div>\n638\t            </div>\n639\t          </div>\n640\t        </div>\n641\t\n642\t        {/* Pricing tiers */}\n643\t        <div className=\"space-y-2\">\n644\t          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">Pricing tiers</label>\n645\t          <div className=\"space-y-2\">\n646\t            <div className=\"flex gap-2 items-center\">\n647\t              <span className=\"text-xs text-gray-500 w-14 flex-shrink-0\">Tier 1</span>\n648\t              <input\n649\t                type=\"number\"\n650\t                placeholder={`Up to ${price1Qty} kg qty`}\n651\t                value={price1Qty}\n652\t                onChange={(e) => setPrice1Qty(e.target.value)}\n653\t                className=\"w-20 border border-gray-200 rounded-lg px-2 py-2 text-sm\"\n654\t              />\n655\t              <span className=\"text-xs text-gray-400\">kg →</span>\n656\t              <div className=\"flex-1 relative\">\n657\t                <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm\">₹</span>\n658\t                <input\n659\t                  type=\"number\"\n660\t                  placeholder=\"Price/kg\"\n661\t                  value={price1}\n662\t                  onChange={(e) => setPrice1(e.target.value)}\n663\t                  className=\"w-full border border-gray-200 rounded-lg pl-7 pr-3 py-2 text-sm\"\n664\t                />\n665\t              </div>\n666\t            </div>\n667\t            <div className=\"flex gap-2 items-center\">\n668\t              <span className=\"text-xs text-gray-500 w-14 flex-shrink-0\">Tier 2</span>\n669\t              <input\n670\t                type=\"number\"\n671\t                placeholder=\"Up to kg\"\n672\t                value={price2Qty}\n673\t                onChange={(e) => setPrice2Qty(e.target.value)}\n674\t                className=\"w-20 border border-gray-200 rounded-lg px-2 py-2 text-sm\"\n675\t              />\n676\t              <span className=\"text-xs text-gray-400\">kg →</span>\n677\t              <div className=\"flex-1 relative\">\n678\t                <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm\">₹</span>\n679\t                <input\n680\t                  type=\"number\"\n681\t                  placeholder=\"Price/kg\"\n682\t                  value={price2}\n683\t                  onChange={(e) => setPrice2(e.target.value)}\n684\t                  className=\"w-full border border-gray-200 rounded-lg pl-7 pr-3 py-2 text-sm\"\n685\t                />\n686\t              </div>\n687\t            </div>\n688\t            <div className=\"flex gap-2 items-center\">\n689\t              <span className=\"text-xs text-gray-500 w-14 flex-shrink-0\">Tier 3</span>\n690\t              <span className=\"text-xs text-gray-400 w-20 text-center\">{Number(price2Qty) + 1}+ kg</span>\n691\t              <span className=\"text-xs text-gray-400\">→</span>\n692\t              <div className=\"flex-1 relative\">\n693\t                <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm\">₹</span>\n694\t                <input\n695\t                  type=\"number\"\n696\t                  placeholder=\"Price/kg\"\n697\t                  value={price3}\n698\t                  onChange={(e) => setPrice3(e.target.value)}\n699\t                  className=\"w-full border border-gray-200 rounded-lg pl-7 pr-3 py-2 text-sm\"\n700\t                />\n701\t              </div>\n702\t            </div>\n703\t          </div>\n704\t        </div>\n705\t\n706\t        {/* Description */}\n707\t        <div className=\"space-y-2\">\n708\t          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">\n709\t            Description / Growing notes\n710\t          </label>\n711\t          <textarea\n712\t            placeholder=\"Tell buyers how you grow this produce... (max 500 chars)\"\n713\t            value={description}\n714\t            onChange={(e) => setDescription(e.target.value.slice(0, 500))}\n715\t            rows={3}\n716\t            className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm resize-none focus:border-green-500 focus:outline-none\"\n717\t          />\n718\t          <p className=\"text-right text-xs text-gray-400\">{description.length}/500</p>\n719\t        </div>\n720\t\n721\t        {/* Quality params */}\n722\t        <div className=\"space-y-2\">\n723\t          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">\n724\t            Quality parameters (optional)\n725\t          </label>\n726\t          <div className=\"grid grid-cols-2 gap-2\">\n727\t            <div>\n728\t              <p className=\"text-xs text-gray-500 mb-1\">BRIX reading</p>\n729\t              <input\n730\t                type=\"number\"\n731\t                step=\"0.1\"\n732\t                placeholder=\"e.g. 8.5\"\n733\t                value={brix}\n734\t                onChange={(e) => setBrix(e.target.value)}\n735\t                className=\"w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:border-green-500 focus:outline-none\"\n736\t              />\n737\t            </div>\n738\t            <div>\n739\t              <p className=\"text-xs text-gray-500 mb-1\">Soil Organic Carbon %</p>\n740\t              <input\n741\t                type=\"number\"\n742\t                step=\"0.1\"\n743\t                placeholder=\"e.g. 2.1\"\n744\t                value={soc}\n745\t                onChange={(e) => setSoc(e.target.value)}\n746\t                className=\"w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:border-green-500 focus:outline-none\"\n747\t              />\n748\t            </div>\n749\t          </div>\n750\t        </div>\n751\t\n752\t        {error && (\n753\t          <p className=\"text-sm text-red-600 bg-red-50 rounded-xl px-4 py-3\">{error}</p>\n754\t        )}\n755\t\n756\t        {/* Preview + Publish buttons */}\n757\t        <div className=\"flex gap-3 pt-2\">\n758\t          <button\n759\t            onClick={() => setPreview(true)}\n760\t            className=\"flex-1 border-2 border-gray-300 text-gray-700 font-semibold py-3.5 rounded-xl text-sm\"\n761\t          >\n762\t            Preview listing\n763\t          </button>\n764\t          <button\n765\t            onClick={handlePublish}\n766\t            disabled={loading || !name.trim()}\n767\t            className=\"flex-1 bg-green-700 text-white font-bold py-3.5 rounded-xl text-sm disabled:opacity-50\"\n768\t          >\n769\t            {loading ? 'Publishing...' : 'Publish listing'}\n770\t          </button>\n771\t        </div>\n772\t      </div>\n773\t\n774\t      {/* Preview modal */}\n775\t      {preview && (\n776\t        <PreviewModal data={previewData} onClose={() => setPreview(false)} />\n777\t      )}\n778\t    </div>\n779\t  )\n780\t}\n781\t\n782\t/* ─── Preview modal ─────────────────────────────────────────── */\n783\tfunction PreviewModal({ data, onClose }: { data: PreviewData; onClose: () => void }) {\n784\t  const EMOJI_BG: Record<string, string> = {\n785\t    '🍅': 'bg-red-100', '🥬': 'bg-green-100', '🥭': 'bg-orange-100',\n786\t    '🍆': 'bg-purple-100', '🥕': 'bg-orange-100', '🌽': 'bg-yellow-100',\n787\t    '🍌': 'bg-yellow-100', '🫑': 'bg-green-100', '🌿': 'bg-green-50',\n788\t    '🌾': 'bg-amber-100', '🍓': 'bg-red-50',\n789\t  }\n790\t  const bg = EMOJI_BG[data.emoji] ?? 'bg-green-50'\n791\t\n792\t  return (\n793\t    <div className=\"fixed inset-0 bg-black/50 z-50 flex items-end justify-center p-4\">\n794\t      <div className=\"bg-white rounded-2xl w-full max-w-sm overflow-hidden\">\n795\t        <div className=\"flex items-center justify-between px-4 py-3 border-b border-gray-100\">\n796\t          <p className=\"font-bold text-gray-800 text-sm\">Preview — how buyers will see this</p>\n797\t          <button onClick={onClose} className=\"text-gray-400 text-2xl leading-none\">×</button>\n798\t        </div>\n799\t        <div className=\"p-4\">\n800\t          <div className=\"bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden max-w-[180px] mx-auto\">\n801\t            <div className={`${bg} flex items-center justify-center py-8`}>\n802\t              <span className=\"text-5xl\">{data.emoji}</span>\n803\t            </div>\n804\t            <div className=\"p-3\">\n805\t              <h3 className=\"font-extrabold text-gray-900 text-base\">{data.name}</h3>\n806\t              {data.variety && <p className=\"text-xs text-gray-400 mt-0.5\">{data.variety}</p>}\n807\t              <div className=\"flex items-center justify-between mt-2\">\n808\t                <span className=\"text-green-700 font-black text-lg\">\n809\t                  {data.price !== '—' ? `₹${data.price}` : '—'}\n810\t                  <span className=\"text-xs font-normal text-gray-400\">/kg</span>\n811\t                </span>\n812\t                <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-green-100 text-green-800\">\n813\t                  {data.method}\n814\t                </span>\n815\t              </div>\n816\t              {data.stock !== '—' && (\n817\t                <p className=\"text-xs text-gray-400 mt-1\">{data.stock} kg left</p>\n818\t              )}\n819\t              <div className=\"mt-2 w-full bg-green-700 text-white text-xs font-bold py-2.5 rounded-xl text-center\">\n820\t                Order / ఆర్డర్\n821\t              </div>\n822\t            </div>\n823\t          </div>\n824\t          <p className=\"text-xs text-gray-400 text-center mt-3\">\n825\t            This is how the card appears on the consumer home page.\n826\t          </p>\n827\t        </div>\n828\t        <div className=\"px-4 pb-4\">\n829\t          <button\n830\t            onClick={onClose}\n831\t            className=\"w-full border-2 border-gray-300 text-gray-700 font-semibold py-3 rounded-xl text-sm\"\n832\t          >\n833\t            Close preview\n834\t          </button>\n835\t        </div>\n836\t      </div>\n837\t    </div>\n838\t  )\n839\t}\n840\t\n841\t/* ─── Loading screen ────────────────────────────────────────── */\n842\tfunction LoadingScreen() {\n843\t  return (\n844\t    <main className=\"min-h-screen bg-gray-50 flex items-center justify-center\">\n845\t      <div className=\"text-center space-y-3\">\n846\t        <div className=\"w-12 h-12 border-4 border-green-700 border-t-transparent rounded-full animate-spin mx-auto\" />\n847\t        <p className=\"text-gray-500 text-sm\">Loading dashboard...</p>\n848\t      </div>\n849\t    </main>\n850\t  )\n851\t}\n852\t\n853\t/* ─── Farmer not found ──────────────────────────────────────── */\n854\tfunction FarmerNotFound({ onLogout }: { onLogout: () => void }) {\n855\t  return (\n856\t    <main className=\"min-h-screen bg-gray-50 flex flex-col items-center justify-center px-4\">\n857\t      <div className=\"text-center max-w-sm space-y-4\">\n858\t        <div className=\"text-6xl\">🌾</div>\n859\t        <h2 className=\"text-xl font-extrabold text-gray-900\">Session expired</h2>\n860\t        <p className=\"text-gray-500 text-sm\">\n861\t          Please log in again with your WhatsApp number.\n862\t        </p>\n863\t        <button onClick={onLogout} className=\"bg-green-700 text-white font-bold px-6 py-3 rounded-xl text-sm\">\n864\t          Log in again\n865\t        </button>\n866\t      </div>\n867\t    </main>\n868\t  )\n869\t}\n870\t"}]},"uuid":"a7cb78c3-1813-4d40-bb87-1b69d575b52b","timestamp":"2026-04-21T16:58:22.429Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/app/farmer/dashboard/page.tsx","content":"'use client'\n\nimport { useState, useEffect, useCallback } from 'react'\nimport { useRouter } from 'next/navigation'\nimport { supabase } from '@/lib/supabase'\nimport Link from 'next/link'\nimport LanguageToggle from '@/components/LanguageToggle'\n\ntype Farmer = {\n  id: string\n  name: string\n  slug: string\n  village: string\n  district: string\n  phone: string\n  method: string\n  region_slug: string\n  rating_avg: number | null\n  buyer_count: number\n  farming_since_year: number | null\n}\n\ntype DemandBar = {\n  crop_name: string\n  total_qty: number\n}\n\ntype PreviewData = {\n  name: string\n  variety: string\n  emoji: string\n  price: string\n  method: string\n  stock: string\n}\n\nconst EMOJI_OPTIONS = ['🍅', '🍌', '🥭', '🫑', '🥬', '🍆', '🥕', '🌽', '🧅', '🧄', '🥦', '🌿', '🍓', '🫒', '🌾', '🥥']\n\nconst isProfileComplete = (f: Farmer | null) =>\n  !!f && f.name?.trim().length > 0 && f.village?.trim().length > 0\n\nexport default function FarmerDashboard() {\n  const router = useRouter()\n  const [farmer, setFarmer] = useState<Farmer | null>(null)\n  const [loading, setLoading] = useState(true)\n  const [notFound, setNotFound] = useState(false)\n  const [activeListings, setActiveListings] = useState(0)\n  const [ordersCount, setOrdersCount] = useState(0)\n  const [demandBars, setDemandBars] = useState<DemandBar[]>([])\n  const [showForm, setShowForm] = useState(false)\n  const [showProfileEdit, setShowProfileEdit] = useState(false)\n\n  const loadDashboard = useCallback(async () => {\n    const farmerId = localStorage.getItem('yff_farmer_id')\n    if (!farmerId) { router.replace('/farmer/login'); return }\n\n    const { data: farmerData } = await supabase\n      .from('farmers')\n      .select('*')\n      .eq('id', farmerId)\n      .maybeSingle()\n\n    if (!farmerData) { setNotFound(true); setLoading(false); return }\n    setFarmer(farmerData)\n\n    const [listingsRes, ordersRes, intentsRes] = await Promise.all([\n      supabase.from('produce_listings').select('id', { count: 'exact', head: true }).eq('farmer_id', farmerData.id).eq('status', 'available'),\n      supabase.from('orders').select('id', { count: 'exact', head: true }).eq('farmer_id', farmerData.id).gte('created_at', new Date(Date.now() - 7 * 86400000).toISOString()),\n      supabase.from('demand_intents').select('crop_name, quantity_kg').eq('region_slug', farmerData.region_slug).eq('fulfilled', false),\n    ])\n\n    setActiveListings(listingsRes.count ?? 0)\n    setOrdersCount(ordersRes.count ?? 0)\n\n    const map: Record<string, number> = {}\n    for (const row of intentsRes.data ?? []) {\n      map[row.crop_name] = (map[row.crop_name] ?? 0) + (Number(row.quantity_kg) || 0)\n    }\n    setDemandBars(\n      Object.entries(map)\n        .map(([crop_name, total_qty]) => ({ crop_name, total_qty }))\n        .sort((a, b) => b.total_qty - a.total_qty)\n        .slice(0, 5)\n    )\n\n    setLoading(false)\n  }, [router])\n\n  useEffect(() => { loadDashboard() }, [loadDashboard])\n\n  // Auto-open the profile edit modal the first time an incomplete farmer lands here.\n  useEffect(() => {\n    if (!loading && farmer && !isProfileComplete(farmer)) {\n      setShowProfileEdit(true)\n    }\n  }, [loading, farmer])\n\n  const handleLogout = () => {\n    localStorage.removeItem('yff_farmer_id')\n    localStorage.removeItem('yff_farmer_slug')\n    router.replace('/farmer/login')\n  }\n\n  if (loading) return <LoadingScreen />\n  if (notFound) return <FarmerNotFound onLogout={handleLogout} />\n\n  const profileComplete = isProfileComplete(farmer)\n  const displayName = farmer!.name?.trim() || 'Welcome'\n\n  return (\n    <main className=\"min-h-screen bg-gray-50 pb-16\">\n      {/* Header */}\n      <div className=\"bg-green-900 px-4 pt-6 pb-10\">\n        <div className=\"flex justify-end mb-2\">\n          <LanguageToggle />\n        </div>\n        <div className=\"flex items-start justify-between\">\n          <div>\n            <p className=\"text-green-400 text-xs font-semibold mb-0.5 uppercase tracking-wide\">\n              Farmer Dashboard / రైతు డాష్‌బోర్డ్\n            </p>\n            <h1 className=\"text-white text-xl font-extrabold leading-tight\">{displayName}</h1>\n            <p className=\"text-green-300 text-sm mt-0.5\">\n              {profileComplete\n                ? `${farmer!.village}, ${farmer!.district}`\n                : 'Complete your profile to get started / ప్రొఫైల్ పూర్తి చేయండి'}\n            </p>\n            <p className=\"text-green-500 text-xs mt-1\">+91 {farmer!.phone}</p>\n          </div>\n          <div className=\"flex flex-col items-end gap-2 flex-shrink-0\">\n            {profileComplete ? (\n              <Link\n                href={`/farmer/${farmer!.slug}`}\n                className=\"bg-white text-green-800 text-xs font-bold px-3 py-2 rounded-xl\"\n              >\n                View profile ↗\n              </Link>\n            ) : (\n              <span className=\"bg-amber-400 text-amber-900 text-[10px] font-bold px-2 py-1 rounded-full\">\n                Incomplete\n              </span>\n            )}\n            <button\n              onClick={() => setShowProfileEdit(true)}\n              className=\"text-white text-xs underline\"\n            >\n              Edit profile\n            </button>\n            <button onClick={handleLogout} className=\"text-green-500 text-xs underline\">\n              Logout\n            </button>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"px-4 -mt-5 space-y-4\">\n        {/* Complete profile banner */}\n        {!profileComplete && (\n          <div className=\"bg-amber-50 border-2 border-amber-300 rounded-2xl p-4 flex items-start gap-3\">\n            <span className=\"text-2xl flex-shrink-0\">📝</span>\n            <div className=\"flex-1 min-w-0\">\n              <h3 className=\"font-extrabold text-amber-900 text-base leading-tight\">\n                Complete your profile\n              </h3>\n              <p className=\"text-amber-700 text-xs mt-0.5\">\n                ప్రొఫైల్ పూర్తి చేస్తే బయ్యర్లు మిమ్మల్ని కనుగొంటారు\n              </p>\n              <button\n                onClick={() => setShowProfileEdit(true)}\n                className=\"mt-3 bg-amber-600 text-white font-bold px-4 py-2.5 rounded-xl text-sm\"\n              >\n                Fill details / వివరాలు నింపండి\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Stat cards */}\n        <div className=\"grid grid-cols-2 gap-3\">\n          {[\n            { label: 'Active listings', sub: 'చురుకైన పంటలు', value: activeListings, color: 'border-green-200 bg-green-50', vcolor: 'text-green-800' },\n            { label: 'Orders this week', sub: 'ఈ వారం ఆర్డర్లు', value: ordersCount, color: 'border-blue-200 bg-blue-50', vcolor: 'text-blue-800' },\n            { label: 'Avg rating', sub: 'సగటు రేటింగ్', value: farmer!.rating_avg ? `${Number(farmer!.rating_avg).toFixed(1)} ★` : '—', color: 'border-amber-200 bg-amber-50', vcolor: 'text-amber-800' },\n            { label: 'Total buyers', sub: 'మొత్తం కొనుగోలుదారులు', value: farmer!.buyer_count ?? 0, color: 'border-purple-200 bg-purple-50', vcolor: 'text-purple-800' },\n          ].map((s) => (\n            <div key={s.label} className={`${s.color} border rounded-2xl p-4`}>\n              <div className={`text-3xl font-black ${s.vcolor}`}>{s.value}</div>\n              <div className=\"text-sm font-semibold text-gray-800 mt-1 leading-tight\">{s.label}</div>\n              <div className=\"text-xs text-gray-500 mt-0.5\">{s.sub}</div>\n            </div>\n          ))}\n        </div>\n\n        {/* Demand chart */}\n        <div className=\"bg-white rounded-2xl border border-gray-100 p-4\">\n          <h2 className=\"font-extrabold text-gray-900 text-base leading-tight\">\n            Local demand / స్థానిక డిమాండ్\n          </h2>\n          <p className=\"text-xs text-gray-500 mt-0.5 mb-4\">\n            మీ ప్రాంతంలో వినియోగదారులు ఏమి కోరుతున్నారు\n          </p>\n\n          {demandBars.length === 0 ? (\n            <div className=\"text-center py-6\">\n              <p className=\"text-gray-400 text-sm\">No demand signals yet.</p>\n              <p className=\"text-gray-400 text-xs mt-1\">Share your profile link to attract buyers.</p>\n            </div>\n          ) : (\n            <div className=\"space-y-3\">\n              {demandBars.map((bar) => {\n                const pct = Math.round((bar.total_qty / demandBars[0].total_qty) * 100)\n                return (\n                  <div key={bar.crop_name}>\n                    <div className=\"flex items-center justify-between mb-1\">\n                      <span className=\"text-sm font-semibold text-gray-800\">{bar.crop_name}</span>\n                      <span className=\"text-xs text-gray-400 font-medium\">{bar.total_qty} kg</span>\n                    </div>\n                    <div className=\"h-3 bg-gray-100 rounded-full overflow-hidden\">\n                      <div\n                        className=\"h-full bg-green-600 rounded-full\"\n                        style={{ width: `${pct}%` }}\n                      />\n                    </div>\n                  </div>\n                )\n              })}\n            </div>\n          )}\n        </div>\n\n        {/* Add listing button */}\n        {profileComplete ? (\n          !showForm && (\n            <button\n              onClick={() => setShowForm(true)}\n              className=\"w-full bg-white border-2 border-green-700 text-green-700 font-bold py-4 rounded-2xl text-base flex items-center justify-center gap-2 active:bg-green-50\"\n            >\n              <span className=\"text-xl leading-none\">+</span>\n              Add new produce / కొత్త పంట చేర్చండి\n            </button>\n          )\n        ) : (\n          <div className=\"w-full bg-gray-100 text-gray-500 font-semibold py-4 rounded-2xl text-sm text-center\">\n            Complete your profile before adding produce<br />\n            <span className=\"text-xs\">ముందుగా ప్రొఫైల్ పూర్తి చేయండి</span>\n          </div>\n        )}\n\n        {/* Listing form */}\n        {showForm && profileComplete && (\n          <ProduceListingForm\n            farmerId={farmer!.id}\n            farmerSlug={farmer!.slug}\n            defaultMethod={farmer!.method}\n            onClose={() => setShowForm(false)}\n            onPublished={() => { setShowForm(false); loadDashboard() }}\n          />\n        )}\n      </div>\n\n      {/* Edit profile modal */}\n      {showProfileEdit && farmer && (\n        <ProfileEditModal\n          farmer={farmer}\n          onClose={() => {\n            // If profile still incomplete, don't allow close (keep banner as fallback)\n            if (isProfileComplete(farmer)) setShowProfileEdit(false)\n            else setShowProfileEdit(false) // allow dismiss; banner still shown\n          }}\n          onSaved={(updated) => {\n            setFarmer(updated)\n            setShowProfileEdit(false)\n          }}\n        />\n      )}\n    </main>\n  )\n}\n\n/* ─── Profile edit modal ─────────────────────────────────── */\nfunction ProfileEditModal({\n  farmer,\n  onClose,\n  onSaved,\n}: {\n  farmer: Farmer\n  onClose: () => void\n  onSaved: (updated: Farmer) => void\n}) {\n  const [name, setName] = useState(farmer.name ?? '')\n  const [village, setVillage] = useState(farmer.village ?? '')\n  const [district, setDistrict] = useState(farmer.district ?? '')\n  const [method, setMethod] = useState(farmer.method ?? 'natural')\n  const [sinceYear, setSinceYear] = useState(\n    farmer.farming_since_year ? String(farmer.farming_since_year) : '',\n  )\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState('')\n\n  const handleSave = async () => {\n    if (!name.trim()) { setError('Your name is required / మీ పేరు అవసరం'); return }\n    if (!village.trim()) { setError('Village is required / గ్రామం అవసరం'); return }\n    setLoading(true)\n    setError('')\n\n    // Build a unique slug from the name once the farmer actually has one.\n    // Only regenerate slug if current slug still looks auto-generated (f-<digits>-xxxx).\n    const isAutoSlug = /^f-\\d{10}-[a-z0-9]{4}$/.test(farmer.slug ?? '')\n    const baseSlug = name\n      .toLowerCase()\n      .trim()\n      .replace(/[^a-z0-9]+/g, '-')\n      .replace(/(^-|-$)/g, '')\n      .slice(0, 40) || 'farmer'\n\n    let newSlug = farmer.slug\n    if (isAutoSlug && baseSlug) {\n      const rand = Math.random().toString(36).slice(2, 5)\n      newSlug = `${baseSlug}-${rand}`\n    }\n\n    const payload: Record<string, unknown> = {\n      name: name.trim(),\n      village: village.trim(),\n      district: district.trim(),\n      method,\n      slug: newSlug,\n    }\n    if (sinceYear) payload.farming_since_year = Number(sinceYear)\n\n    const { data, error: err } = await supabase\n      .from('farmers')\n      .update(payload)\n      .eq('id', farmer.id)\n      .select('*')\n      .single()\n\n    setLoading(false)\n\n    if (err || !data) {\n      setError(err?.message ?? 'Could not save. Please try again.')\n      return\n    }\n\n    localStorage.setItem('yff_farmer_slug', data.slug)\n    onSaved(data)\n  }\n\n  return (\n    <div className=\"fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4\">\n      <div className=\"bg-white rounded-t-2xl sm:rounded-2xl w-full max-w-md max-h-[92vh] overflow-y-auto\">\n        <div className=\"sticky top-0 bg-white flex items-center justify-between px-4 py-3 border-b border-gray-100\">\n          <div>\n            <h3 className=\"font-extrabold text-gray-900 text-base\">Your farmer profile</h3>\n            <p className=\"text-xs text-gray-500\">మీ రైతు ప్రొఫైల్</p>\n          </div>\n          <button onClick={onClose} className=\"text-gray-400 text-3xl leading-none p-1\">×</button>\n        </div>\n\n        <div className=\"p-4 space-y-4\">\n          <Field\n            label=\"Your name / మీ పేరు *\"\n            placeholder=\"Ramu Reddy\"\n            value={name}\n            onChange={setName}\n          />\n          <Field\n            label=\"Village / గ్రామం *\"\n            placeholder=\"Tadepalligudem\"\n            value={village}\n            onChange={setVillage}\n          />\n          <Field\n            label=\"District / జిల్లా\"\n            placeholder=\"West Godavari\"\n            value={district}\n            onChange={setDistrict}\n          />\n\n          <div>\n            <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n              Farming method / వ్యవసాయ పద్ధతి\n            </label>\n            <select\n              value={method}\n              onChange={(e) => setMethod(e.target.value)}\n              className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-green-500 focus:outline-none\"\n            >\n              <option value=\"natural\">🌱 Natural / సహజం</option>\n              <option value=\"organic\">🍃 Organic / సేంద్రీయ</option>\n              <option value=\"low_chemical\">⚡ Low chemical / తక్కువ రసాయన</option>\n              <option value=\"chemical\">Chemical / రసాయన</option>\n            </select>\n          </div>\n\n          <Field\n            label=\"Farming since (year) / ఏ సంవత్సరం నుండి\"\n            placeholder=\"e.g. 2005\"\n            value={sinceYear}\n            onChange={setSinceYear}\n            type=\"number\"\n          />\n\n          {error && (\n            <p className=\"text-sm text-red-600 bg-red-50 rounded-xl px-3 py-2\">{error}</p>\n          )}\n\n          <button\n            onClick={handleSave}\n            disabled={loading || !name.trim() || !village.trim()}\n            className=\"w-full bg-green-700 text-white font-bold py-4 rounded-xl text-base disabled:opacity-50 active:bg-green-800\"\n          >\n            {loading ? 'Saving...' : 'Save profile / ప్రొఫైల్ సేవ్'}\n          </button>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nfunction Field({\n  label,\n  placeholder,\n  value,\n  onChange,\n  type = 'text',\n}: {\n  label: string\n  placeholder?: string\n  value: string\n  onChange: (v: string) => void\n  type?: string\n}) {\n  return (\n    <div>\n      <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1.5\">\n        {label}\n      </label>\n      <input\n        type={type}\n        placeholder={placeholder}\n        value={value}\n        onChange={(e) => onChange(e.target.value)}\n        className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-green-500 focus:outline-none\"\n      />\n    </div>\n  )\n}\n\n/* ─── Produce listing form ──────────────────────────────────── */\nfunction ProduceListingForm({\n  farmerId,\n  farmerSlug,\n  defaultMethod,\n  onClose,\n  onPublished,\n}: {\n  farmerId: string\n  farmerSlug: string\n  defaultMethod: string\n  onClose: () => void\n  onPublished: () => void\n}) {\n  const [name, setName] = useState('')\n  const [variety, setVariety] = useState('')\n  const [emoji, setEmoji] = useState('🌿')\n  const [qty, setQty] = useState('')\n  const [period, setPeriod] = useState('')\n  const [farmingMethod, setFarmingMethod] = useState(defaultMethod || 'natural')\n  const [price1, setPrice1] = useState('')\n  const [price1Qty, setPrice1Qty] = useState('5')\n  const [price2, setPrice2] = useState('')\n  const [price2Qty, setPrice2Qty] = useState('20')\n  const [price3, setPrice3] = useState('')\n  const [description, setDescription] = useState('')\n  const [brix, setBrix] = useState('')\n  const [soc, setSoc] = useState('')\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState('')\n  const [preview, setPreview] = useState(false)\n  const [published, setPublished] = useState(false)\n  const [publishedSlug, setPublishedSlug] = useState('')\n\n  const previewData: PreviewData = {\n    name: name || 'Produce name',\n    variety: variety || '',\n    emoji,\n    price: price1 || '—',\n    method: farmingMethod,\n    stock: qty || '—',\n  }\n\n  const handlePublish = async () => {\n    if (!name.trim()) { setError('Produce name is required'); return }\n    setLoading(true)\n    setError('')\n\n    const payload: Record<string, unknown> = {\n      farmer_id: farmerId,\n      name: name.trim(),\n      emoji,\n      status: 'available',\n      method: farmingMethod,\n    }\n    if (variety.trim()) payload.variety = variety.trim()\n    if (qty) payload.stock_qty = Number(qty)\n    if (description.trim()) payload.description = description.trim()\n    if (brix) payload.brix = Number(brix)\n    if (soc) payload.soil_organic_carbon = Number(soc)\n    if (price1) { payload.price_tier_1_price = Number(price1); payload.price_tier_1_qty = Number(price1Qty) }\n    if (price2) { payload.price_tier_2_price = Number(price2); payload.price_tier_2_qty = Number(price2Qty) }\n    if (price3) { payload.price_tier_3_price = Number(price3); payload.price_tier_3_qty = Number(price2Qty) + 1 }\n\n    const { error: err } = await supabase.from('produce_listings').insert(payload)\n    setLoading(false)\n\n    if (err) { setError(err.message); return }\n\n    setPublished(true)\n    setPublishedSlug(farmerSlug)\n    setTimeout(() => onPublished(), 2500)\n  }\n\n  if (published) {\n    return (\n      <div className=\"bg-green-50 border-2 border-green-200 rounded-2xl p-6 text-center space-y-3\">\n        <div className=\"text-4xl\">✅</div>\n        <p className=\"font-extrabold text-green-800 text-lg\">Published!</p>\n        <p className=\"text-green-700 text-sm\">Your listing is now live on the consumer page.</p>\n        <Link\n          href={`/farmer/${publishedSlug}`}\n          className=\"inline-block bg-green-700 text-white font-bold px-6 py-3 rounded-xl text-sm\"\n        >\n          View your profile ↗\n        </Link>\n      </div>\n    )\n  }\n\n  return (\n    <div className=\"bg-white rounded-2xl border border-gray-200 overflow-hidden\">\n      {/* Form header */}\n      <div className=\"flex items-center justify-between px-4 py-3 border-b border-gray-100 bg-gray-50\">\n        <h3 className=\"font-extrabold text-gray-900 text-base\">New produce listing</h3>\n        <button onClick={onClose} className=\"text-gray-400 text-2xl leading-none p-1\">×</button>\n      </div>\n\n      <div className=\"p-4 space-y-5\">\n        {/* Emoji picker */}\n        <div>\n          <p className=\"text-xs font-semibold text-gray-600 mb-2\">Pick an icon</p>\n          <div className=\"flex flex-wrap gap-2\">\n            {EMOJI_OPTIONS.map((e) => (\n              <button\n                key={e}\n                onClick={() => setEmoji(e)}\n                className={`w-10 h-10 rounded-xl text-xl flex items-center justify-center transition-all ${\n                  emoji === e ? 'bg-green-100 ring-2 ring-green-500' : 'bg-gray-50'\n                }`}\n              >\n                {e}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Name + variety */}\n        <div className=\"space-y-2\">\n          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">Produce details</label>\n          <input\n            type=\"text\"\n            placeholder=\"Produce name * (e.g. Tomato / టమాటా)\"\n            value={name}\n            onChange={(e) => setName(e.target.value)}\n            className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-green-500 focus:outline-none\"\n          />\n          <input\n            type=\"text\"\n            placeholder=\"Variety (e.g. Naati heirloom)\"\n            value={variety}\n            onChange={(e) => setVariety(e.target.value)}\n            className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-green-500 focus:outline-none\"\n          />\n        </div>\n\n        {/* Qty + period */}\n        <div className=\"space-y-2\">\n          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">Availability</label>\n          <div className=\"grid grid-cols-2 gap-2\">\n            <input\n              type=\"number\"\n              placeholder=\"Quantity (kg)\"\n              value={qty}\n              onChange={(e) => setQty(e.target.value)}\n              className=\"border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-green-500 focus:outline-none\"\n            />\n            <input\n              type=\"text\"\n              placeholder=\"Period (e.g. Apr–May)\"\n              value={period}\n              onChange={(e) => setPeriod(e.target.value)}\n              className=\"border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-green-500 focus:outline-none\"\n            />\n          </div>\n        </div>\n\n        {/* Farming method */}\n        <div className=\"space-y-2\">\n          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">Farming method</label>\n          <select\n            value={farmingMethod}\n            onChange={(e) => setFarmingMethod(e.target.value)}\n            className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-green-500 focus:outline-none\"\n          >\n            <option value=\"natural\">🌱 Natural / సహజం</option>\n            <option value=\"organic\">🍃 Organic / సేంద్రీయ</option>\n            <option value=\"low_chemical\">⚡ Low chemical</option>\n            <option value=\"chemical\">Chemical</option>\n          </select>\n        </div>\n\n        {/* Delivery method */}\n        <div className=\"space-y-2\">\n          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">Delivery method</label>\n          <div className=\"grid grid-cols-2 gap-2\">\n            <div className=\"flex items-center gap-2 border-2 border-green-600 bg-green-50 rounded-xl px-3 py-3\">\n              <div className=\"w-4 h-4 rounded-full bg-green-600 flex items-center justify-center flex-shrink-0\">\n                <div className=\"w-1.5 h-1.5 bg-white rounded-full\" />\n              </div>\n              <span className=\"text-sm font-semibold text-green-800\">Pickup only</span>\n            </div>\n            <div className=\"flex items-center gap-2 border border-gray-200 bg-gray-50 rounded-xl px-3 py-3 opacity-50 cursor-not-allowed\">\n              <div className=\"w-4 h-4 rounded-full border-2 border-gray-300 flex-shrink-0\" />\n              <div>\n                <span className=\"text-sm font-medium text-gray-400\">I will courier</span>\n                <span className=\"block text-[10px] text-gray-400\">Coming soon</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Pricing tiers */}\n        <div className=\"space-y-2\">\n          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">Pricing tiers</label>\n          <div className=\"space-y-2\">\n            <div className=\"flex gap-2 items-center\">\n              <span className=\"text-xs text-gray-500 w-14 flex-shrink-0\">Tier 1</span>\n              <input\n                type=\"number\"\n                placeholder={`Up to ${price1Qty} kg qty`}\n                value={price1Qty}\n                onChange={(e) => setPrice1Qty(e.target.value)}\n                className=\"w-20 border border-gray-200 rounded-lg px-2 py-2 text-sm\"\n              />\n              <span className=\"text-xs text-gray-400\">kg →</span>\n              <div className=\"flex-1 relative\">\n                <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm\">₹</span>\n                <input\n                  type=\"number\"\n                  placeholder=\"Price/kg\"\n                  value={price1}\n                  onChange={(e) => setPrice1(e.target.value)}\n                  className=\"w-full border border-gray-200 rounded-lg pl-7 pr-3 py-2 text-sm\"\n                />\n              </div>\n            </div>\n            <div className=\"flex gap-2 items-center\">\n              <span className=\"text-xs text-gray-500 w-14 flex-shrink-0\">Tier 2</span>\n              <input\n                type=\"number\"\n                placeholder=\"Up to kg\"\n                value={price2Qty}\n                onChange={(e) => setPrice2Qty(e.target.value)}\n                className=\"w-20 border border-gray-200 rounded-lg px-2 py-2 text-sm\"\n              />\n              <span className=\"text-xs text-gray-400\">kg →</span>\n              <div className=\"flex-1 relative\">\n                <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm\">₹</span>\n                <input\n                  type=\"number\"\n                  placeholder=\"Price/kg\"\n                  value={price2}\n                  onChange={(e) => setPrice2(e.target.value)}\n                  className=\"w-full border border-gray-200 rounded-lg pl-7 pr-3 py-2 text-sm\"\n                />\n              </div>\n            </div>\n            <div className=\"flex gap-2 items-center\">\n              <span className=\"text-xs text-gray-500 w-14 flex-shrink-0\">Tier 3</span>\n              <span className=\"text-xs text-gray-400 w-20 text-center\">{Number(price2Qty) + 1}+ kg</span>\n              <span className=\"text-xs text-gray-400\">→</span>\n              <div className=\"flex-1 relative\">\n                <span className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm\">₹</span>\n                <input\n                  type=\"number\"\n                  placeholder=\"Price/kg\"\n                  value={price3}\n                  onChange={(e) => setPrice3(e.target.value)}\n                  className=\"w-full border border-gray-200 rounded-lg pl-7 pr-3 py-2 text-sm\"\n                />\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Description */}\n        <div className=\"space-y-2\">\n          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">\n            Description / Growing notes\n          </label>\n          <textarea\n            placeholder=\"Tell buyers how you grow this produce... (max 500 chars)\"\n            value={description}\n            onChange={(e) => setDescription(e.target.value.slice(0, 500))}\n            rows={3}\n            className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-sm resize-none focus:border-green-500 focus:outline-none\"\n          />\n          <p className=\"text-right text-xs text-gray-400\">{description.length}/500</p>\n        </div>\n\n        {/* Quality params */}\n        <div className=\"space-y-2\">\n          <label className=\"text-xs font-semibold text-gray-600 uppercase tracking-wide\">\n            Quality parameters (optional)\n          </label>\n          <div className=\"grid grid-cols-2 gap-2\">\n            <div>\n              <p className=\"text-xs text-gray-500 mb-1\">BRIX reading</p>\n              <input\n                type=\"number\"\n                step=\"0.1\"\n                placeholder=\"e.g. 8.5\"\n                value={brix}\n                onChange={(e) => setBrix(e.target.value)}\n                className=\"w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:border-green-500 focus:outline-none\"\n              />\n            </div>\n            <div>\n              <p className=\"text-xs text-gray-500 mb-1\">Soil Organic Carbon %</p>\n              <input\n                type=\"number\"\n                step=\"0.1\"\n                placeholder=\"e.g. 2.1\"\n                value={soc}\n                onChange={(e) => setSoc(e.target.value)}\n                className=\"w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:border-green-500 focus:outline-none\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {error && (\n          <p className=\"text-sm text-red-600 bg-red-50 rounded-xl px-4 py-3\">{error}</p>\n        )}\n\n        {/* Preview + Publish buttons */}\n        <div className=\"flex gap-3 pt-2\">\n          <button\n            onClick={() => setPreview(true)}\n            className=\"flex-1 border-2 border-gray-300 text-gray-700 font-semibold py-3.5 rounded-xl text-sm\"\n          >\n            Preview listing\n          </button>\n          <button\n            onClick={handlePublish}\n            disabled={loading || !name.trim()}\n            className=\"flex-1 bg-green-700 text-white font-bold py-3.5 rounded-xl text-sm disabled:opacity-50\"\n          >\n            {loading ? 'Publishing...' : 'Publish listing'}\n          </button>\n        </div>\n      </div>\n\n      {/* Preview modal */}\n      {preview && (\n        <PreviewModal data={previewData} onClose={() => setPreview(false)} />\n      )}\n    </div>\n  )\n}\n\n/* ─── Preview modal ─────────────────────────────────────────── */\nfunction PreviewModal({ data, onClose }: { data: PreviewData; onClose: () => void }) {\n  const EMOJI_BG: Record<string, string> = {\n    '🍅': 'bg-red-100', '🥬': 'bg-green-100', '🥭': 'bg-orange-100',\n    '🍆': 'bg-purple-100', '🥕': 'bg-orange-100', '🌽': 'bg-yellow-100',\n    '🍌': 'bg-yellow-100', '🫑': 'bg-green-100', '🌿': 'bg-green-50',\n    '🌾': 'bg-amber-100', '🍓': 'bg-red-50',\n  }\n  const bg = EMOJI_BG[data.emoji] ?? 'bg-green-50'\n\n  return (\n    <div className=\"fixed inset-0 bg-black/50 z-50 flex items-end justify-center p-4\">\n      <div className=\"bg-white rounded-2xl w-full max-w-sm overflow-hidden\">\n        <div className=\"flex items-center justify-between px-4 py-3 border-b border-gray-100\">\n          <p className=\"font-bold text-gray-800 text-sm\">Preview — how buyers will see this</p>\n          <button onClick={onClose} className=\"text-gray-400 text-2xl leading-none\">×</button>\n        </div>\n        <div className=\"p-4\">\n          <div className=\"bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden max-w-[180px] mx-auto\">\n            <div className={`${bg} flex items-center justify-center py-8`}>\n              <span className=\"text-5xl\">{data.emoji}</span>\n            </div>\n            <div className=\"p-3\">\n              <h3 className=\"font-extrabold text-gray-900 text-base\">{data.name}</h3>\n              {data.variety && <p className=\"text-xs text-gray-400 mt-0.5\">{data.variety}</p>}\n              <div className=\"flex items-center justify-between mt-2\">\n                <span className=\"text-green-700 font-black text-lg\">\n                  {data.price !== '—' ? `₹${data.price}` : '—'}\n                  <span className=\"text-xs font-normal text-gray-400\">/kg</span>\n                </span>\n                <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-green-100 text-green-800\">\n                  {data.method}\n                </span>\n              </div>\n              {data.stock !== '—' && (\n                <p className=\"text-xs text-gray-400 mt-1\">{data.stock} kg left</p>\n              )}\n              <div className=\"mt-2 w-full bg-green-700 text-white text-xs font-bold py-2.5 rounded-xl text-center\">\n                Order / ఆర్డర్\n              </div>\n            </div>\n          </div>\n          <p className=\"text-xs text-gray-400 text-center mt-3\">\n            This is how the card appears on the consumer home page.\n          </p>\n        </div>\n        <div className=\"px-4 pb-4\">\n          <button\n            onClick={onClose}\n            className=\"w-full border-2 border-gray-300 text-gray-700 font-semibold py-3 rounded-xl text-sm\"\n          >\n            Close preview\n          </button>\n        </div>\n      </div>\n    </div>\n  )\n}\n\n/* ─── Loading screen ────────────────────────────────────────── */\nfunction LoadingScreen() {\n  return (\n    <main className=\"min-h-screen bg-gray-50 flex items-center justify-center\">\n      <div className=\"text-center space-y-3\">\n        <div className=\"w-12 h-12 border-4 border-green-700 border-t-transparent rounded-full animate-spin mx-auto\" />\n        <p className=\"text-gray-500 text-sm\">Loading dashboard...</p>\n      </div>\n    </main>\n  )\n}\n\n/* ─── Farmer not found ──────────────────────────────────────── */\nfunction FarmerNotFound({ onLogout }: { onLogout: () => void }) {\n  return (\n    <main className=\"min-h-screen bg-gray-50 flex flex-col items-center justify-center px-4\">\n      <div className=\"text-center max-w-sm space-y-4\">\n        <div className=\"text-6xl\">🌾</div>\n        <h2 className=\"text-xl font-extrabold text-gray-900\">Session expired</h2>\n        <p className=\"text-gray-500 text-sm\">\n          Please log in again with your WhatsApp number.\n        </p>\n        <button onClick={onLogout} className=\"bg-green-700 text-white font-bold px-6 py-3 rounded-xl text-sm\">\n          Log in again\n        </button>\n      </div>\n    </main>\n  )\n}\n","numLines":870,"startLine":1,"totalLines":870}},"sourceToolAssistantUUID":"e1d2f8e4-cd71-49a8-b613-8153c75870d2","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"eb2775c9-1fd3-4173-b50c-698ac924cb4d","version":"2.1.114","gitBranch":"main"}
