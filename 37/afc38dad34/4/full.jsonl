{"parentUuid":"a3ab8e65-93c4-49a2-9aa0-42b4e1a3e069","isSidechain":false,"promptId":"6c013195-48de-41ec-afd8-5f54e76d9b01","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CvG2T2C32HkMg1v8MRxSct","type":"tool_result","content":"1\t'use client'\n2\t\n3\timport { useEffect, useState, useCallback } from 'react'\n4\t\n5\texport type CartItem = {\n6\t  listingId: string\n7\t  qty: number\n8\t  name: string\n9\t  variety?: string\n10\t  emoji?: string\n11\t  pricePerKg?: number\n12\t  farmerId: string\n13\t  farmerName: string\n14\t  farmerPhone: string\n15\t  farmerVillage: string\n16\t  farmerSlug: string\n17\t}\n18\t\n19\texport type CartState = Record<string, CartItem>\n20\t\n21\texport type ConsumerInfo = { name: string; phone: string }\n22\t\n23\tconst CART_KEY = 'yff_cart_v1'\n24\tconst CONSUMER_KEY = 'REDACTED'\n25\tconst CART_EVENT = 'yff:cart-change'\n26\t\n27\tconst readCart = (): CartState => {\n28\t  if (typeof window === 'undefined') return {}\n29\t  try {\n30\t    const raw = localStorage.getItem(CART_KEY)\n31\t    return raw ? (JSON.parse(raw) as CartState) : {}\n32\t  } catch {\n33\t    return {}\n34\t  }\n35\t}\n36\t\n37\tconst writeCart = (next: CartState) => {\n38\t  localStorage.setItem(CART_KEY, JSON.stringify(next))\n39\t  window.dispatchEvent(new Event(CART_EVENT))\n40\t}\n41\t\n42\texport function useCart() {\n43\t  const [cart, setCart] = useState<CartState>({})\n44\t\n45\t  useEffect(() => {\n46\t    setCart(readCart())\n47\t    const sync = () => setCart(readCart())\n48\t    window.addEventListener(CART_EVENT, sync)\n49\t    window.addEventListener('storage', sync)\n50\t    return () => {\n51\t      window.removeEventListener(CART_EVENT, sync)\n52\t      window.removeEventListener('storage', sync)\n53\t    }\n54\t  }, [])\n55\t\n56\t  const addItem = useCallback((item: Omit<CartItem, 'qty'>, qty = 1) => {\n57\t    const next = { ...readCart() }\n58\t    const existing = next[item.listingId]\n59\t    next[item.listingId] = {\n60\t      ...item,\n61\t      qty: Math.max(1, (existing?.qty ?? 0) + qty),\n62\t    }\n63\t    writeCart(next)\n64\t  }, [])\n65\t\n66\t  const setQty = useCallback((listingId: string, qty: number) => {\n67\t    const next = { ...readCart() }\n68\t    if (qty <= 0) delete next[listingId]\n69\t    else if (next[listingId]) next[listingId] = { ...next[listingId], qty }\n70\t    writeCart(next)\n71\t  }, [])\n72\t\n73\t  const removeItem = useCallback((listingId: string) => {\n74\t    const next = { ...readCart() }\n75\t    delete next[listingId]\n76\t    writeCart(next)\n77\t  }, [])\n78\t\n79\t  const clear = useCallback(() => writeCart({}), [])\n80\t\n81\t  const items = Object.values(cart)\n82\t  const count = items.reduce((sum, i) => sum + i.qty, 0)\n83\t\n84\t  return { cart, items, count, addItem, setQty, removeItem, clear }\n85\t}\n86\t\n87\texport function useConsumerInfo() {\n88\t  const [info, setInfo] = useState<ConsumerInfo>({ name: '', phone: '' })\n89\t\n90\t  useEffect(() => {\n91\t    if (typeof window === 'undefined') return\n92\t    try {\n93\t      const raw = localStorage.getItem(CONSUMER_KEY)\n94\t      if (raw) setInfo(JSON.parse(raw))\n95\t    } catch { /* ignore */ }\n96\t  }, [])\n97\t\n98\t  const save = useCallback((next: ConsumerInfo) => {\n99\t    setInfo(next)\n100\t    localStorage.setItem(CONSUMER_KEY, JSON.stringify(next))\n101\t  }, [])\n102\t\n103\t  return { info, save }\n104\t}\n105\t\n106\t/* ─── Cart FAB + Sheet ───────────────────────────────── */\n107\texport function CartFab() {\n108\t  const { items, count } = useCart()\n109\t  const [open, setOpen] = useState(false)\n110\t\n111\t  if (count === 0 && !open) return null\n112\t\n113\t  return (\n114\t    <>\n115\t      {!open && (\n116\t        <button\n117\t          onClick={() => setOpen(true)}\n118\t          className=\"fixed bottom-5 right-5 z-40 bg-green-700 active:bg-green-800 text-white rounded-full shadow-2xl flex items-center gap-2 pl-4 pr-5 py-3.5\"\n119\t          aria-label=\"View cart\"\n120\t        >\n121\t          <CartIcon />\n122\t          <span className=\"font-extrabold text-sm\">\n123\t            {count} {count === 1 ? 'item' : 'items'} / బుట్ట\n124\t          </span>\n125\t        </button>\n126\t      )}\n127\t      {open && (\n128\t        <CartSheet items={items} onClose={() => setOpen(false)} />\n129\t      )}\n130\t    </>\n131\t  )\n132\t}\n133\t\n134\t/* ─── Cart sheet ─────────────────────────────────────── */\n135\tfunction CartSheet({\n136\t  items,\n137\t  onClose,\n138\t}: {\n139\t  items: CartItem[]\n140\t  onClose: () => void\n141\t}) {\n142\t  const { setQty, removeItem, clear } = useCart()\n143\t  const { info, save: saveInfo } = useConsumerInfo()\n144\t  const [name, setName] = useState('')\n145\t  const [phone, setPhone] = useState('')\n146\t  const [sentFarmers, setSentFarmers] = useState<Record<string, boolean>>({})\n147\t\n148\t  useEffect(() => {\n149\t    setName(info.name)\n150\t    setPhone(info.phone)\n151\t  }, [info])\n152\t\n153\t  // Group items by farmer\n154\t  const byFarmer = items.reduce<Record<string, CartItem[]>>((acc, item) => {\n155\t    (acc[item.farmerId] = acc[item.farmerId] ?? []).push(item)\n156\t    return acc\n157\t  }, {})\n158\t  const farmerGroups = Object.values(byFarmer)\n159\t\n160\t  const detailsMissing = !name.trim() || phone.replace(/\\D/g, '').length < 10\n161\t\n162\t  const handleOrderFarmer = (group: CartItem[]) => {\n163\t    if (detailsMissing) return\n164\t    saveInfo({ name: name.trim(), phone: phone.trim() })\n165\t\n166\t    const f = group[0]\n167\t    const lines = group.map((it) => {\n168\t      const price = it.pricePerKg ? ` @ ₹${it.pricePerKg}/kg` : ''\n169\t      return `• ${it.emoji ?? '🌿'} ${it.name}${it.variety ? ` (${it.variety})` : ''} — ${it.qty} kg${price}`\n170\t    })\n171\t\n172\t    const msg =\n173\t      `Hello ${f.farmerName} anna! 🙏\\n` +\n174\t      `I saw your produce on YourFamilyFarmer and would like to order:\\n\\n` +\n175\t      lines.join('\\n') +\n176\t      `\\n\\n*Pickup from your farm* (${f.farmerVillage})\\n\\n` +\n177\t      `My name: ${name.trim()}\\n` +\n178\t      `My WhatsApp: +91 ${phone.replace(/\\D/g, '').slice(-10)}\\n\\n` +\n179\t      `Please share a good pickup time. Thank you!\\n` +\n180\t      `ధన్యవాదాలు 🌱`\n181\t\n182\t    const digits = f.farmerPhone.replace(/\\D/g, '').replace(/^0+/, '')\n183\t    const waPhone = digits.length === 10 ? `91${digits}` : digits\n184\t    const waUrl = `https://wa.me/${waPhone}?text=${encodeURIComponent(msg)}`\n185\t\n186\t    window.open(waUrl, '_blank', 'noopener,noreferrer')\n187\t    setSentFarmers((s) => ({ ...s, [f.farmerId]: true }))\n188\t  }\n189\t\n190\t  return (\n191\t    <div className=\"fixed inset-0 z-50 bg-black/50 flex items-end justify-center\">\n192\t      <div className=\"bg-white w-full max-w-md rounded-t-3xl max-h-[92vh] flex flex-col\">\n193\t        {/* Header */}\n194\t        <div className=\"sticky top-0 bg-white flex items-center justify-between px-4 py-3 border-b border-gray-100 rounded-t-3xl\">\n195\t          <div>\n196\t            <h2 className=\"font-extrabold text-gray-900 text-lg\">Your cart / మీ బుట్ట</h2>\n197\t            <p className=\"text-xs text-gray-500\">\n198\t              Pickup from farm only / పొలం నుండి పికప్ మాత్రమే\n199\t            </p>\n200\t          </div>\n201\t          <button onClick={onClose} className=\"text-gray-400 text-3xl leading-none p-1\">×</button>\n202\t        </div>\n203\t\n204\t        {/* Body */}\n205\t        <div className=\"flex-1 overflow-y-auto px-4 py-4 space-y-5\">\n206\t          {items.length === 0 ? (\n207\t            <div className=\"text-center py-14 text-gray-400\">\n208\t              <div className=\"text-5xl mb-3\">🛒</div>\n209\t              <p className=\"font-semibold\">Your cart is empty</p>\n210\t              <p className=\"text-sm mt-1\">బుట్ట ఖాళీగా ఉంది</p>\n211\t            </div>\n212\t          ) : (\n213\t            <>\n214\t              {/* Consumer details */}\n215\t              <div className=\"bg-gray-50 rounded-2xl p-4 space-y-3\">\n216\t                <div>\n217\t                  <label className=\"text-xs font-bold text-gray-700 uppercase tracking-wide block mb-1\">\n218\t                    Your name / మీ పేరు\n219\t                  </label>\n220\t                  <input\n221\t                    type=\"text\"\n222\t                    value={name}\n223\t                    onChange={(e) => setName(e.target.value)}\n224\t                    placeholder=\"Ramya\"\n225\t                    className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-base focus:border-green-500 focus:outline-none bg-white\"\n226\t                  />\n227\t                </div>\n228\t                <div>\n229\t                  <label className=\"text-xs font-bold text-gray-700 uppercase tracking-wide block mb-1\">\n230\t                    Your WhatsApp number / వాట్సాప్ నంబర్\n231\t                  </label>\n232\t                  <div className=\"flex gap-2\">\n233\t                    <span className=\"flex items-center px-3 bg-white border border-gray-200 rounded-xl text-sm text-gray-600 font-medium\">\n234\t                      +91\n235\t                    </span>\n236\t                    <input\n237\t                      type=\"tel\"\n238\t                      inputMode=\"numeric\"\n239\t                      value={phone}\n240\t                      onChange={(e) => setPhone(e.target.value)}\n241\t                      placeholder=\"9876543210\"\n242\t                      maxLength={10}\n243\t                      className=\"flex-1 border border-gray-200 rounded-xl px-4 py-3 text-base focus:border-green-500 focus:outline-none bg-white\"\n244\t                    />\n245\t                  </div>\n246\t                </div>\n247\t                <p className=\"text-[11px] text-gray-500 leading-snug\">\n248\t                  The farmer needs this to confirm pickup time.<br />\n249\t                  పికప్ సమయం కోసం రైతుకు ఇది అవసరం.\n250\t                </p>\n251\t              </div>\n252\t\n253\t              {/* Farmer groups */}\n254\t              {farmerGroups.map((group) => {\n255\t                const f = group[0]\n256\t                const total = group.reduce(\n257\t                  (s, it) => s + (it.pricePerKg ?? 0) * it.qty,\n258\t                  0,\n259\t                )\n260\t                const sent = sentFarmers[f.farmerId]\n261\t                return (\n262\t                  <div\n263\t                    key={f.farmerId}\n264\t                    className=\"border border-gray-200 rounded-2xl overflow-hidden\"\n265\t                  >\n266\t                    <div className=\"bg-green-50 px-4 py-3 border-b border-green-100 flex items-center justify-between\">\n267\t                      <div className=\"min-w-0\">\n268\t                        <p className=\"font-extrabold text-green-900 truncate\">\n269\t                          🧑‍🌾 {f.farmerName}\n270\t                        </p>\n271\t                        <p className=\"text-xs text-green-700\">📍 {f.farmerVillage}</p>\n272\t                      </div>\n273\t                      <span className=\"text-[10px] font-bold bg-green-700 text-white px-2 py-1 rounded-full whitespace-nowrap\">\n274\t                        Pickup\n275\t                      </span>\n276\t                    </div>\n277\t\n278\t                    <div className=\"p-3 space-y-2\">\n279\t                      {group.map((it) => (\n280\t                        <div key={it.listingId} className=\"flex items-center gap-3\">\n281\t                          <div className=\"w-11 h-11 rounded-xl bg-gray-50 flex items-center justify-center text-xl flex-shrink-0\">\n282\t                            {it.emoji ?? '🌿'}\n283\t                          </div>\n284\t                          <div className=\"flex-1 min-w-0\">\n285\t                            <p className=\"font-semibold text-sm text-gray-900 truncate\">\n286\t                              {it.name}\n287\t                            </p>\n288\t                            {it.pricePerKg && (\n289\t                              <p className=\"text-xs text-gray-500\">₹{it.pricePerKg}/kg</p>\n290\t                            )}\n291\t                          </div>\n292\t                          <QtyStepper\n293\t                            qty={it.qty}\n294\t                            onDec={() => setQty(it.listingId, it.qty - 1)}\n295\t                            onInc={() => setQty(it.listingId, it.qty + 1)}\n296\t                          />\n297\t                          <button\n298\t                            onClick={() => removeItem(it.listingId)}\n299\t                            className=\"text-gray-300 text-xl px-1\"\n300\t                            aria-label=\"Remove\"\n301\t                          >\n302\t                            ×\n303\t                          </button>\n304\t                        </div>\n305\t                      ))}\n306\t\n307\t                      {total > 0 && (\n308\t                        <div className=\"flex items-center justify-between pt-2 border-t border-gray-100 mt-2\">\n309\t                          <span className=\"text-xs text-gray-500\">Estimated total</span>\n310\t                          <span className=\"font-extrabold text-gray-900\">\n311\t                            ₹{total}\n312\t                          </span>\n313\t                        </div>\n314\t                      )}\n315\t\n316\t                      <button\n317\t                        onClick={() => handleOrderFarmer(group)}\n318\t                        disabled={detailsMissing}\n319\t                        className={`mt-1 w-full font-bold py-3.5 rounded-xl text-sm flex items-center justify-center gap-2 ${\n320\t                          sent\n321\t                            ? 'bg-green-100 text-green-800'\n322\t                            : detailsMissing\n323\t                              ? 'bg-gray-200 text-gray-500'\n324\t                              : 'bg-green-700 text-white active:bg-green-800'\n325\t                        }`}\n326\t                      >\n327\t                        {sent ? (\n328\t                          <>✓ Order sent — tap to resend</>\n329\t                        ) : (\n330\t                          <>\n331\t                            <WhatsAppIcon />\n332\t                            Send to {f.farmerName.split(' ')[0] || 'farmer'} / వాట్సాప్\n333\t                          </>\n334\t                        )}\n335\t                      </button>\n336\t                    </div>\n337\t                  </div>\n338\t                )\n339\t              })}\n340\t\n341\t              {farmerGroups.length > 1 && (\n342\t                <p className=\"text-xs text-gray-500 text-center px-4 leading-snug\">\n343\t                  One WhatsApp chat opens per farmer, since each farm handles its own pickup.<br />\n344\t                  ప్రతి రైతుకు ప్రత్యేక వాట్సాప్ చాట్ తెరుచుకుంటుంది.\n345\t                </p>\n346\t              )}\n347\t\n348\t              <button\n349\t                onClick={clear}\n350\t                className=\"w-full text-sm text-gray-500 underline pt-2\"\n351\t              >\n352\t                Clear cart / బుట్ట ఖాళీ చేయండి\n353\t              </button>\n354\t            </>\n355\t          )}\n356\t        </div>\n357\t      </div>\n358\t    </div>\n359\t  )\n360\t}\n361\t\n362\tfunction QtyStepper({\n363\t  qty,\n364\t  onDec,\n365\t  onInc,\n366\t}: {\n367\t  qty: number\n368\t  onDec: () => void\n369\t  onInc: () => void\n370\t}) {\n371\t  return (\n372\t    <div className=\"flex items-center border border-gray-200 rounded-full\">\n373\t      <button\n374\t        onClick={onDec}\n375\t        className=\"w-8 h-8 text-lg text-gray-700 flex items-center justify-center active:bg-gray-100 rounded-l-full\"\n376\t        aria-label=\"Decrease\"\n377\t      >\n378\t        −\n379\t      </button>\n380\t      <span className=\"w-10 text-center font-bold text-sm text-gray-900\">\n381\t        {qty}\n382\t      </span>\n383\t      <button\n384\t        onClick={onInc}\n385\t        className=\"w-8 h-8 text-lg text-gray-700 flex items-center justify-center active:bg-gray-100 rounded-r-full\"\n386\t        aria-label=\"Increase\"\n387\t      >\n388\t        +\n389\t      </button>\n390\t    </div>\n391\t  )\n392\t}\n393\t\n394\tfunction CartIcon() {\n395\t  return (\n396\t    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n397\t      <circle cx=\"9\" cy=\"21\" r=\"1\" />\n398\t      <circle cx=\"20\" cy=\"21\" r=\"1\" />\n399\t      <path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\" />\n400\t    </svg>\n401\t  )\n402\t}\n403\t\n404\tfunction WhatsAppIcon() {\n405\t  return (\n406\t    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n407\t      <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\" />\n408\t    </svg>\n409\t  )\n410\t}\n411\t"}]},"uuid":"01447c60-23a7-4a60-b450-5f5e457eab78","timestamp":"2026-04-21T17:01:05.181Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/components/consumer/Cart.tsx","content":"'use client'\n\nimport { useEffect, useState, useCallback } from 'react'\n\nexport type CartItem = {\n  listingId: string\n  qty: number\n  name: string\n  variety?: string\n  emoji?: string\n  pricePerKg?: number\n  farmerId: string\n  farmerName: string\n  farmerPhone: string\n  farmerVillage: string\n  farmerSlug: string\n}\n\nexport type CartState = Record<string, CartItem>\n\nexport type ConsumerInfo = { name: string; phone: string }\n\nconst CART_KEY = 'yff_cart_v1'\nconst CONSUMER_KEY = 'REDACTED'\nconst CART_EVENT = 'yff:cart-change'\n\nconst readCart = (): CartState => {\n  if (typeof window === 'undefined') return {}\n  try {\n    const raw = localStorage.getItem(CART_KEY)\n    return raw ? (JSON.parse(raw) as CartState) : {}\n  } catch {\n    return {}\n  }\n}\n\nconst writeCart = (next: CartState) => {\n  localStorage.setItem(CART_KEY, JSON.stringify(next))\n  window.dispatchEvent(new Event(CART_EVENT))\n}\n\nexport function useCart() {\n  const [cart, setCart] = useState<CartState>({})\n\n  useEffect(() => {\n    setCart(readCart())\n    const sync = () => setCart(readCart())\n    window.addEventListener(CART_EVENT, sync)\n    window.addEventListener('storage', sync)\n    return () => {\n      window.removeEventListener(CART_EVENT, sync)\n      window.removeEventListener('storage', sync)\n    }\n  }, [])\n\n  const addItem = useCallback((item: Omit<CartItem, 'qty'>, qty = 1) => {\n    const next = { ...readCart() }\n    const existing = next[item.listingId]\n    next[item.listingId] = {\n      ...item,\n      qty: Math.max(1, (existing?.qty ?? 0) + qty),\n    }\n    writeCart(next)\n  }, [])\n\n  const setQty = useCallback((listingId: string, qty: number) => {\n    const next = { ...readCart() }\n    if (qty <= 0) delete next[listingId]\n    else if (next[listingId]) next[listingId] = { ...next[listingId], qty }\n    writeCart(next)\n  }, [])\n\n  const removeItem = useCallback((listingId: string) => {\n    const next = { ...readCart() }\n    delete next[listingId]\n    writeCart(next)\n  }, [])\n\n  const clear = useCallback(() => writeCart({}), [])\n\n  const items = Object.values(cart)\n  const count = items.reduce((sum, i) => sum + i.qty, 0)\n\n  return { cart, items, count, addItem, setQty, removeItem, clear }\n}\n\nexport function useConsumerInfo() {\n  const [info, setInfo] = useState<ConsumerInfo>({ name: '', phone: '' })\n\n  useEffect(() => {\n    if (typeof window === 'undefined') return\n    try {\n      const raw = localStorage.getItem(CONSUMER_KEY)\n      if (raw) setInfo(JSON.parse(raw))\n    } catch { /* ignore */ }\n  }, [])\n\n  const save = useCallback((next: ConsumerInfo) => {\n    setInfo(next)\n    localStorage.setItem(CONSUMER_KEY, JSON.stringify(next))\n  }, [])\n\n  return { info, save }\n}\n\n/* ─── Cart FAB + Sheet ───────────────────────────────── */\nexport function CartFab() {\n  const { items, count } = useCart()\n  const [open, setOpen] = useState(false)\n\n  if (count === 0 && !open) return null\n\n  return (\n    <>\n      {!open && (\n        <button\n          onClick={() => setOpen(true)}\n          className=\"fixed bottom-5 right-5 z-40 bg-green-700 active:bg-green-800 text-white rounded-full shadow-2xl flex items-center gap-2 pl-4 pr-5 py-3.5\"\n          aria-label=\"View cart\"\n        >\n          <CartIcon />\n          <span className=\"font-extrabold text-sm\">\n            {count} {count === 1 ? 'item' : 'items'} / బుట్ట\n          </span>\n        </button>\n      )}\n      {open && (\n        <CartSheet items={items} onClose={() => setOpen(false)} />\n      )}\n    </>\n  )\n}\n\n/* ─── Cart sheet ─────────────────────────────────────── */\nfunction CartSheet({\n  items,\n  onClose,\n}: {\n  items: CartItem[]\n  onClose: () => void\n}) {\n  const { setQty, removeItem, clear } = useCart()\n  const { info, save: saveInfo } = useConsumerInfo()\n  const [name, setName] = useState('')\n  const [phone, setPhone] = useState('')\n  const [sentFarmers, setSentFarmers] = useState<Record<string, boolean>>({})\n\n  useEffect(() => {\n    setName(info.name)\n    setPhone(info.phone)\n  }, [info])\n\n  // Group items by farmer\n  const byFarmer = items.reduce<Record<string, CartItem[]>>((acc, item) => {\n    (acc[item.farmerId] = acc[item.farmerId] ?? []).push(item)\n    return acc\n  }, {})\n  const farmerGroups = Object.values(byFarmer)\n\n  const detailsMissing = !name.trim() || phone.replace(/\\D/g, '').length < 10\n\n  const handleOrderFarmer = (group: CartItem[]) => {\n    if (detailsMissing) return\n    saveInfo({ name: name.trim(), phone: phone.trim() })\n\n    const f = group[0]\n    const lines = group.map((it) => {\n      const price = it.pricePerKg ? ` @ ₹${it.pricePerKg}/kg` : ''\n      return `• ${it.emoji ?? '🌿'} ${it.name}${it.variety ? ` (${it.variety})` : ''} — ${it.qty} kg${price}`\n    })\n\n    const msg =\n      `Hello ${f.farmerName} anna! 🙏\\n` +\n      `I saw your produce on YourFamilyFarmer and would like to order:\\n\\n` +\n      lines.join('\\n') +\n      `\\n\\n*Pickup from your farm* (${f.farmerVillage})\\n\\n` +\n      `My name: ${name.trim()}\\n` +\n      `My WhatsApp: +91 ${phone.replace(/\\D/g, '').slice(-10)}\\n\\n` +\n      `Please share a good pickup time. Thank you!\\n` +\n      `ధన్యవాదాలు 🌱`\n\n    const digits = f.farmerPhone.replace(/\\D/g, '').replace(/^0+/, '')\n    const waPhone = digits.length === 10 ? `91${digits}` : digits\n    const waUrl = `https://wa.me/${waPhone}?text=${encodeURIComponent(msg)}`\n\n    window.open(waUrl, '_blank', 'noopener,noreferrer')\n    setSentFarmers((s) => ({ ...s, [f.farmerId]: true }))\n  }\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-black/50 flex items-end justify-center\">\n      <div className=\"bg-white w-full max-w-md rounded-t-3xl max-h-[92vh] flex flex-col\">\n        {/* Header */}\n        <div className=\"sticky top-0 bg-white flex items-center justify-between px-4 py-3 border-b border-gray-100 rounded-t-3xl\">\n          <div>\n            <h2 className=\"font-extrabold text-gray-900 text-lg\">Your cart / మీ బుట్ట</h2>\n            <p className=\"text-xs text-gray-500\">\n              Pickup from farm only / పొలం నుండి పికప్ మాత్రమే\n            </p>\n          </div>\n          <button onClick={onClose} className=\"text-gray-400 text-3xl leading-none p-1\">×</button>\n        </div>\n\n        {/* Body */}\n        <div className=\"flex-1 overflow-y-auto px-4 py-4 space-y-5\">\n          {items.length === 0 ? (\n            <div className=\"text-center py-14 text-gray-400\">\n              <div className=\"text-5xl mb-3\">🛒</div>\n              <p className=\"font-semibold\">Your cart is empty</p>\n              <p className=\"text-sm mt-1\">బుట్ట ఖాళీగా ఉంది</p>\n            </div>\n          ) : (\n            <>\n              {/* Consumer details */}\n              <div className=\"bg-gray-50 rounded-2xl p-4 space-y-3\">\n                <div>\n                  <label className=\"text-xs font-bold text-gray-700 uppercase tracking-wide block mb-1\">\n                    Your name / మీ పేరు\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={name}\n                    onChange={(e) => setName(e.target.value)}\n                    placeholder=\"Ramya\"\n                    className=\"w-full border border-gray-200 rounded-xl px-4 py-3 text-base focus:border-green-500 focus:outline-none bg-white\"\n                  />\n                </div>\n                <div>\n                  <label className=\"text-xs font-bold text-gray-700 uppercase tracking-wide block mb-1\">\n                    Your WhatsApp number / వాట్సాప్ నంబర్\n                  </label>\n                  <div className=\"flex gap-2\">\n                    <span className=\"flex items-center px-3 bg-white border border-gray-200 rounded-xl text-sm text-gray-600 font-medium\">\n                      +91\n                    </span>\n                    <input\n                      type=\"tel\"\n                      inputMode=\"numeric\"\n                      value={phone}\n                      onChange={(e) => setPhone(e.target.value)}\n                      placeholder=\"9876543210\"\n                      maxLength={10}\n                      className=\"flex-1 border border-gray-200 rounded-xl px-4 py-3 text-base focus:border-green-500 focus:outline-none bg-white\"\n                    />\n                  </div>\n                </div>\n                <p className=\"text-[11px] text-gray-500 leading-snug\">\n                  The farmer needs this to confirm pickup time.<br />\n                  పికప్ సమయం కోసం రైతుకు ఇది అవసరం.\n                </p>\n              </div>\n\n              {/* Farmer groups */}\n              {farmerGroups.map((group) => {\n                const f = group[0]\n                const total = group.reduce(\n                  (s, it) => s + (it.pricePerKg ?? 0) * it.qty,\n                  0,\n                )\n                const sent = sentFarmers[f.farmerId]\n                return (\n                  <div\n                    key={f.farmerId}\n                    className=\"border border-gray-200 rounded-2xl overflow-hidden\"\n                  >\n                    <div className=\"bg-green-50 px-4 py-3 border-b border-green-100 flex items-center justify-between\">\n                      <div className=\"min-w-0\">\n                        <p className=\"font-extrabold text-green-900 truncate\">\n                          🧑‍🌾 {f.farmerName}\n                        </p>\n                        <p className=\"text-xs text-green-700\">📍 {f.farmerVillage}</p>\n                      </div>\n                      <span className=\"text-[10px] font-bold bg-green-700 text-white px-2 py-1 rounded-full whitespace-nowrap\">\n                        Pickup\n                      </span>\n                    </div>\n\n                    <div className=\"p-3 space-y-2\">\n                      {group.map((it) => (\n                        <div key={it.listingId} className=\"flex items-center gap-3\">\n                          <div className=\"w-11 h-11 rounded-xl bg-gray-50 flex items-center justify-center text-xl flex-shrink-0\">\n                            {it.emoji ?? '🌿'}\n                          </div>\n                          <div className=\"flex-1 min-w-0\">\n                            <p className=\"font-semibold text-sm text-gray-900 truncate\">\n                              {it.name}\n                            </p>\n                            {it.pricePerKg && (\n                              <p className=\"text-xs text-gray-500\">₹{it.pricePerKg}/kg</p>\n                            )}\n                          </div>\n                          <QtyStepper\n                            qty={it.qty}\n                            onDec={() => setQty(it.listingId, it.qty - 1)}\n                            onInc={() => setQty(it.listingId, it.qty + 1)}\n                          />\n                          <button\n                            onClick={() => removeItem(it.listingId)}\n                            className=\"text-gray-300 text-xl px-1\"\n                            aria-label=\"Remove\"\n                          >\n                            ×\n                          </button>\n                        </div>\n                      ))}\n\n                      {total > 0 && (\n                        <div className=\"flex items-center justify-between pt-2 border-t border-gray-100 mt-2\">\n                          <span className=\"text-xs text-gray-500\">Estimated total</span>\n                          <span className=\"font-extrabold text-gray-900\">\n                            ₹{total}\n                          </span>\n                        </div>\n                      )}\n\n                      <button\n                        onClick={() => handleOrderFarmer(group)}\n                        disabled={detailsMissing}\n                        className={`mt-1 w-full font-bold py-3.5 rounded-xl text-sm flex items-center justify-center gap-2 ${\n                          sent\n                            ? 'bg-green-100 text-green-800'\n                            : detailsMissing\n                              ? 'bg-gray-200 text-gray-500'\n                              : 'bg-green-700 text-white active:bg-green-800'\n                        }`}\n                      >\n                        {sent ? (\n                          <>✓ Order sent — tap to resend</>\n                        ) : (\n                          <>\n                            <WhatsAppIcon />\n                            Send to {f.farmerName.split(' ')[0] || 'farmer'} / వాట్సాప్\n                          </>\n                        )}\n                      </button>\n                    </div>\n                  </div>\n                )\n              })}\n\n              {farmerGroups.length > 1 && (\n                <p className=\"text-xs text-gray-500 text-center px-4 leading-snug\">\n                  One WhatsApp chat opens per farmer, since each farm handles its own pickup.<br />\n                  ప్రతి రైతుకు ప్రత్యేక వాట్సాప్ చాట్ తెరుచుకుంటుంది.\n                </p>\n              )}\n\n              <button\n                onClick={clear}\n                className=\"w-full text-sm text-gray-500 underline pt-2\"\n              >\n                Clear cart / బుట్ట ఖాళీ చేయండి\n              </button>\n            </>\n          )}\n        </div>\n      </div>\n    </div>\n  )\n}\n\nfunction QtyStepper({\n  qty,\n  onDec,\n  onInc,\n}: {\n  qty: number\n  onDec: () => void\n  onInc: () => void\n}) {\n  return (\n    <div className=\"flex items-center border border-gray-200 rounded-full\">\n      <button\n        onClick={onDec}\n        className=\"w-8 h-8 text-lg text-gray-700 flex items-center justify-center active:bg-gray-100 rounded-l-full\"\n        aria-label=\"Decrease\"\n      >\n        −\n      </button>\n      <span className=\"w-10 text-center font-bold text-sm text-gray-900\">\n        {qty}\n      </span>\n      <button\n        onClick={onInc}\n        className=\"w-8 h-8 text-lg text-gray-700 flex items-center justify-center active:bg-gray-100 rounded-r-full\"\n        aria-label=\"Increase\"\n      >\n        +\n      </button>\n    </div>\n  )\n}\n\nfunction CartIcon() {\n  return (\n    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <circle cx=\"9\" cy=\"21\" r=\"1\" />\n      <circle cx=\"20\" cy=\"21\" r=\"1\" />\n      <path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\" />\n    </svg>\n  )\n}\n\nfunction WhatsAppIcon() {\n  return (\n    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n      <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\" />\n    </svg>\n  )\n}\n","numLines":411,"startLine":1,"totalLines":411}},"sourceToolAssistantUUID":"a3ab8e65-93c4-49a2-9aa0-42b4e1a3e069","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"eb2775c9-1fd3-4173-b50c-698ac924cb4d","version":"2.1.114","gitBranch":"main"}
