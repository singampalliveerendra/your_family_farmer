n,\n})\n\nexport function LanguageProvider({ children }: { children: ReactNode }) {\n  const [lang, setLangState] = useState<Language>('en')\n\n  useEffect(() => {\n    const saved = localStorage.getItem('yff_lang') as Language\n    if (saved === 'en' || saved === 'te') setLangState(saved)\n  }, [])\n\n  const setLang = (newLang: Language) => {\n    setLangState(newLang)\n    localStorage.setItem('yff_lang', newLang)\n  }\n\n  return (\n    <LanguageContext.Provider value={{ lang, setLang, tx: t[lang] }}>\n      {children}\n    </LanguageContext.Provider>\n  )\n}\n\nexport function useLang() {\n  return useContext(LanguageContext)\n}\n","numLines":41,"startLine":1,"totalLines":41}},"sourceToolAssistantUUID":"3c94edb4-afe7-471e-bf0a-5f8ba0a2ddc3","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"eb2775c9-1fd3-4173-b50c-698ac924cb4d","version":"2.1.114","gitBranch":"main"}
