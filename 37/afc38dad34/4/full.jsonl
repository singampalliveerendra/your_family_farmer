{"parentUuid":"75988952-4d8d-4c54-9e29-da441269f242","isSidechain":false,"promptId":"6c013195-48de-41ec-afd8-5f54e76d9b01","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LLkNz3scVitaD1roMd5ny2","type":"tool_result","content":"1\t'use client'\n2\t\n3\timport { useState } from 'react'\n4\timport { useLang } from '@/lib/LanguageContext'\n5\timport RegionMap from './RegionMap'\n6\timport FarmersTab from './tabs/FarmersTab'\n7\timport BrowseProduceTab from './tabs/BrowseProduceTab'\n8\timport AddFarmerTab from './tabs/AddFarmerTab'\n9\t\n10\tconst CATEGORY_MAP: Record<string, string[]> = {\n11\t  Vegetables: ['Tomato', 'Brinjal', 'Drumstick', 'Bitter Gourd', 'Raw Banana'],\n12\t  Fruits: ['Mango', 'Banana', 'Papaya', 'Guava'],\n13\t  'Leafy greens': ['Palakura', 'Spinach', 'Methi', 'Coriander'],\n14\t}\n15\t\n16\texport default function RegionContent({\n17\t  farmers,\n18\t  produce,\n19\t}: {\n20\t  farmers: Record<string, unknown>[]\n21\t  produce: Record<string, unknown>[]\n22\t}) {\n23\t  const { tx } = useLang()\n24\t  const [activeFilter, setActiveFilter] = useState('All')\n25\t  const [activeTab, setActiveTab] = useState(0)\n26\t  const [highlightedFarmerId, setHighlightedFarmerId] = useState<string | null>(null)\n27\t\n28\t  const FILTERS = [tx.all, tx.vegetables, tx.fruits, tx.leafyGreens, tx.naturalOnly]\n29\t  const TABS = [tx.farmers, tx.browseProduce, tx.addFarmer]\n30\t\n31\t  // Map filter label back to English key for category lookup\n32\t  const filterKeyMap: Record<string, string> = {\n33\t    [tx.all]: 'All',\n34\t    [tx.vegetables]: 'Vegetables',\n35\t    [tx.fruits]: 'Fruits',\n36\t    [tx.leafyGreens]: 'Leafy greens',\n37\t    [tx.naturalOnly]: 'Natural only',\n38\t  }\n39\t\n40\t  const filterKey = filterKeyMap[activeFilter] ?? activeFilter\n41\t\n42\t  const filteredProduce = produce.filter((p) => {\n43\t    if (filterKey === 'All') return true\n44\t    if (filterKey === 'Natural only') return p.method === 'natural'\n45\t    const names = CATEGORY_MAP[filterKey] ?? []\n46\t    return names.some((n) => (p.name as string).includes(n))\n47\t  })\n48\t\n49\t  const filteredFarmerIds = new Set(filteredProduce.map((p) => p.farmer_id))\n50\t  const filteredFarmers = filterKey === 'All'\n51\t    ? farmers\n52\t    : farmers.filter((f) => filteredFarmerIds.has(f.id))\n53\t\n54\t  return (\n55\t    <div>\n56\t      {/* Filter chips */}\n57\t      <div className=\"bg-white border-b border-gray-100 px-4 py-3\">\n58\t        <div className=\"flex gap-2 overflow-x-auto scrollbar-hide\">\n59\t          {FILTERS.map((filter) => (\n60\t            <button\n61\t              key={filter}\n62\t              onClick={() => setActiveFilter(filter)}\n63\t              className={`flex-shrink-0 px-4 py-1.5 rounded-full text-sm font-semibold border transition-all ${\n64\t                activeFilter === filter\n65\t                  ? 'bg-green-700 text-white border-green-700'\n66\t                  : 'bg-white text-gray-600 border-gray-200'\n67\t              }`}\n68\t            >\n69\t              {filter}\n70\t            </button>\n71\t          ))}\n72\t        </div>\n73\t      </div>\n74\t\n75\t      {/* SVG Map */}\n76\t      <RegionMap\n77\t        farmers={filteredFarmers}\n78\t        highlightedFarmerId={highlightedFarmerId}\n79\t        onPinClick={setHighlightedFarmerId}\n80\t      />\n81\t\n82\t      {/* Tabs */}\n83\t      <div className=\"sticky top-0 z-40 bg-white border-b border-gray-200\">\n84\t        <div className=\"flex\">\n85\t          {TABS.map((tab, i) => (\n86\t            <button\n87\t              key={tab}\n88\t              onClick={() => setActiveTab(i)}\n89\t              className={`flex-1 py-3 text-xs font-semibold border-b-2 transition-colors ${\n90\t                activeTab === i\n91\t                  ? 'border-green-700 text-green-700'\n92\t                  : 'border-transparent text-gray-500'\n93\t              }`}\n94\t            >\n95\t              {tab}\