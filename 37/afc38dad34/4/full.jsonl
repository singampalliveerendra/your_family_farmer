      )}\n44\t      </div>\n45\t\n46\t      {videos.length > 0 && (\n47\t        <div>\n48\t          <h3 className=\"text-sm font-bold text-gray-700 mb-3\">{tx.farmVideos}</h3>\n49\t          <div className=\"space-y-2\">\n50\t            {videos.map((video) => (\n51\t              <a key={video.id} href={video.url} target=\"_blank\" rel=\"noopener noreferrer\"\n52\t                className=\"flex items-center gap-3 bg-white rounded-lg border border-gray-100 p-3\">\n53\t                <div className=\"w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0\">\n54\t                  <span className=\"text-2xl\">▶️</span>\n55\t                </div>\n56\t                <div className=\"flex-1 min-w-0\">\n57\t                  <p className=\"text-sm font-semibold text-gray-800 truncate\">{video.caption ?? 'Farm video'}</p>\n58\t                  <div className=\"flex items-center gap-2 mt-0.5\">\n59\t                    {video.language && <span className=\"text-xs text-gray-500\">{video.language}</span>}\n60\t                    {video.has_subtitles && <span className=\"bg-blue-100 text-blue-700 text-[10px] font-bold px-1.5 py-0.5 rounded\">CC</span>}\n61\t                  </div>\n62\t                </div>\n63\t              </a>\n64\t            ))}\n65\t          </div>\n66\t        </div>\n67\t      )}\n68\t\n69\t      {list.length === 0 && (\n70\t        <p className=\"text-xs text-gray-400 text-center py-4\">{tx.mediaComingSoon}</p>\n71\t      )}\n72\t    </div>\n73\t  )\n74\t}\n75\t"}]},"uuid":"122f7e23-df07-4450-8a49-c2fc32b01047","timestamp":"2026-04-21T17:04:25.783Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/components/farmer/tabs/FarmMediaTab.tsx","content":"'use client'\n\nimport { useLang } from '@/lib/LanguageContext'\n\ntype Media = {\n  id: string\n  type: 'photo' | 'video'\n  url: string\n  caption?: string\n  language?: string\n  has_subtitles?: boolean\n}\n\nconst PHOTO_PLACEHOLDERS = ['🌾', '🥬', '🌱', '🍅', '🌿', '🥕', '🌽', '🍆', '🌻', '🫑', '🥦', '🌾']\n\nexport default function FarmMediaTab({ media }: { media: Record<string, unknown>[] }) {\n  const { tx } = useLang()\n  const list = media as Media[]\n  const photos = list.filter((m) => m.type === 'photo')\n  const videos = list.filter((m) => m.type === 'video')\n\n  const gridItems = photos.length > 0\n    ? photos\n    : PHOTO_PLACEHOLDERS.map((emoji, i) => ({ id: String(i), type: 'photo' as const, url: '', caption: emoji }))\n\n  return (\n    <div className=\"space-y-5\">\n      <div>\n        <h3 className=\"text-sm font-bold text-gray-700 mb-3\">{tx.farmPhotos}</h3>\n        <div className=\"grid grid-cols-3 gap-1.5\">\n          {gridItems.slice(0, 12).map((item, i) => (\n            <div key={item.id ?? i} className=\"aspect-square bg-green-50 rounded-lg flex items-center justify-center overflow-hidden relative border border-gray-100\">\n              {item.url ? (\n                <img src={item.url} alt={item.caption ?? ''} className=\"w-full h-full object-cover\" />\n              ) : (\n                <span className=\"text-3xl\">{item.caption}</span>\n              )}\n            </div>\n          ))}\n        </div>\n        {photos.length === 0 && (\n          <p className=\"text-xs text-gray-400 text-center mt-2\">{tx.realPhotosComing}</p>\n        )}\n      </div>\n\n      {videos.length > 0 && (\n        <div>\n          <h3 className=\"text-sm font-bold text-gray-700 mb-3\">{tx.farmVideos}</h3>\n          <div className=\"space-y-2\">\n            {videos.map((video) => (\n              <a key={video.id} href={video.url} target=\"_blank\" rel=\"noopener noreferrer\"\n                className=\"flex items-center gap-3 bg-white rounded-lg border border-gray-100 p-3\">\n                <div className=\"w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0\">\n                  <span className=\"text-2xl\">▶️</span>\n                </div>\n                <div className=\"flex-1 min-w-0\">\n                  <p className=\"text-sm font-semibold text-gray-800 truncate\">{video.caption ?? 'Farm video'}</p>\n                  <div className=\"flex items-center gap-2 mt-0.5\">\n                    {video.language && <span className=\"text-xs text-gray-500\">{video.language}</span>}\n                    {video.has_subtitles && <span className=\"bg-blue-100 text-blue-700 text-[10px] font-bold px-1.5 py-0.5 rounded\">CC</span>}\n                  </div>\n                </div>\n              </a>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {list.length === 0 && (\n        <p className=\"text-xs text-gray-400 text-center py-4\">{tx.mediaComingSoon}</p>\n      )}\n    </div>\n  )\n}\n","numLines":75,"startLine":1,"totalLines":75}},"sourceToolAssistantUUID":"c3ed763c-32c8-47b5-bffc-72b90638b157","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"eb2775c9-1fd3-4173-b50c-698ac924cb4d","version":"2.1.114","gitBranch":"main"}
