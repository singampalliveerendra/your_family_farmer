{"parentUuid":"30043458-4a1a-4e79-93ad-bb6c3dfde013","isSidechain":false,"message":{"model":"claude-opus-4-7","id":"msg_01N8gGgJL1tDoPXeE3xgHHKx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SV42e8QmmKP6d6RWc2vF8U","name":"Read","input":{"file_path":"/home/veerendra/farmer/yourfamilyfarmer/src/app/consumer/page.tsx"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":157,"cache_read_input_tokens":36660,"output_tokens":99,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":157,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[{"input_tokens":1,"output_tokens":99,"cache_read_input_tokens":36660,"cache_creation_input_tokens":157,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":157},"type":"message"}],"speed":"standard"}},"requestId":"req_011CaHGeageqaz724diYxhrU","type":"assistant","uuid":"1b883119-e4d6-438f-804d-b1a6aa2adaf4","timestamp":"2026-04-21T16:57:52.769Z","userType":"external","entrypoint":"cli","cwd":"/home/veerendra/farmer/yourfamilyfarmer","sessionId":"eb2775c9-1fd3-4173-b50c-698ac924cb4d","version":"2.1.114","gitBranch":"main"}
{"parentUuid":"1b883119-e4d6-438f-804d-b1a6aa2adaf4","isSidechain":false,"promptId":"6c013195-48de-41ec-afd8-5f54e76d9b01","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SV42e8QmmKP6d6RWc2vF8U","type":"tool_result","content":"1\t'use client'\n2\t\n3\timport { useState, useEffect, useCallback } from 'react'\n4\timport Link from 'next/link'\n5\timport GlobalNav from '@/components/consumer/GlobalNav'\n6\timport { CartFab, useCart } from '@/components/consumer/Cart'\n7\t\n8\ttype Farmer = {\n9\t  id: string\n10\t  name: string\n11\t  village: string\n12\t  slug: string\n13\t  phone: string\n14\t  method: string\n15\t}\n16\t\n17\ttype ProduceListing = {\n18\t  id: string\n19\t  name: string\n20\t  variety?: string\n21\t  emoji?: string\n22\t  method?: string\n23\t  status: string\n24\t  price_tier_1_price?: number\n25\t  price_tier_1_qty?: number\n26\t  price_tier_2_price?: number\n27\t  price_tier_2_qty?: number\n28\t  price_tier_3_price?: number\n29\t  price_tier_3_qty?: number\n30\t  stock_qty?: number\n31\t  available_to?: string\n32\t  farmer_id: string\n33\t  farmer?: Farmer\n34\t}\n35\t\n36\tconst CATEGORIES = [\n37\t  { key: 'all',        en: 'All',             te: 'అన్నీ' },\n38\t  { key: 'vegetables', en: 'Vegetables',      te: 'కూరగాయలు' },\n39\t  { key: 'fruits',     en: 'Fruits',          te: 'పళ్ళు' },\n40\t  { key: 'grains',     en: 'Grains & Pulses', te: 'ధాన్యాలు' },\n41\t  { key: 'leafy',      en: 'Leafy Greens',    te: 'ఆకు కూరలు' },\n42\t]\n43\t\n44\tconst EMOJI_BG: Record<string, string> = {\n45\t  '🍅': 'bg-red-100',    '🥬': 'bg-green-100',  '🥭': 'bg-orange-100',\n46\t  '🍆': 'bg-purple-100', '🥕': 'bg-orange-100', '🌽': 'bg-yellow-100',\n47\t  '🍌': 'bg-yellow-100', '🫑': 'bg-green-100',  '🧅': 'bg-orange-50',\n48\t  '🧄': 'bg-amber-50',   '🍓': 'bg-red-50',     '🥦': 'bg-green-100',\n49\t  '🌾': 'bg-amber-100',  '🫒': 'bg-green-100',  '🌿': 'bg-green-50',\n50\t  '🥥': 'bg-orange-50',  '🍇': 'bg-purple-50',  '🍋': 'bg-yellow-50',\n51\t}\n52\t\n53\tconst METHOD_STYLE: Record<string, string> = {\n54\t  natural:      'bg-green-100 text-green-800',\n55\t  organic:      'bg-teal-100  text-teal-800',\n56\t  low_chemical: 'bg-amber-100 text-amber-800',\n57\t  chemical:     'bg-red-100   text-red-700',\n58\t}\n59\t\n60\tconst METHOD_LABEL: Record<string, string> = {\n61\t  natural:      'Natural / సహజం',\n62\t  organic:      'Organic / సేంద్రీయ',\n63\t  low_chemical: 'Low chemical',\n64\t  chemical:     'Chemical',\n65\t}\n66\t\n67\texport default function ConsumerPage() {\n68\t  const [available, setAvailable]     = useState<ProduceListing[]>([])\n69\t  const [comingSoon, setComingSoon]   = useState<ProduceListing[]>([])\n70\t  const [filtered, setFiltered]       = useState<ProduceListing[]>([])\n71\t  const [search, setSearch]           = useState('')\n72\t  const [method, setMethod]           = useState('all')\n73\t  const [category, setCategory]       = useState('all')\n74\t  const [loading, setLoading]         = useState(true)\n75\t  const [farmerCount, setFarmerCount] = useState(0)\n76\t\n77\t  useEffect(() => { fetchData() }, [])\n78\t\n79\t  const fetchData = async () => {\n80\t    setLoading(true)\n81\t    try {\n82\t      const [avRes, csRes] = await Promise.all([\n83\t        fetch('/api/produce'),\n84\t        fetch('/api/produce?status=coming_soon'),\n85\t      ])\n86\t      const av: ProduceListing[] = await avRes.json().catch(() => [])\n87\t      const cs: ProduceListing[] = await csRes.json().catch(() => [])\n88\t      const avArr = Array.isArray(av) ? av : []\n89\t      const csArr = Array.isArray(cs) ? cs : []\n90\t      setAvailable(avArr)\n91\t      setFiltered(avArr)\n92\t      setComingSoon(csArr)\n93\t      setFarmerCount(new Set(avArr.map((p) => p.farmer_id)).size)\n94\t    } catch { /* silent */ }\n95\t    setLoading(false)\n96\t  }\n97\t\n98\t  const doSearch = useCallback(async () => {\n99\t    if (!search && method === 'all' && category === 'all') {\n100\t      setFiltered(available)\n101\t      return\n102\t    }\n103\t    try {\n104\t      const p = new URLSearchParams()\n105\t      if (search)              p.set('q', search)\n106\t      if (method !== 'all')    p.set('method', method)\n107\t      if (category !== 'all')  p.set('category', category)\n108\t      const res = await fetch(`/api/produce/search?${p}`)\n109\t      const data = await res.json().catch(() => [])\n110\t      setFiltered(Array.isArray(data) ? data : [])\n111\t    } catch { /* silent */ }\n112\t  }, [search, method, category, available])\n113\t\n114\t  useEffect(() => {\n115\t    const t = setTimeout(doSearch, 300)\n116\t    return () => clearTimeout(t)\n117\t  }, [doSearch])\n118\t\n119\t  return (\n120\t    <main className=\"min-h-screen bg-gray-50 pb-12\">\n121\t      <GlobalNav activeTab=\"consumer\" />\n122\t\n123\t      {/* ── Hero ─────────────────────────────── */}\n124\t      <div className=\"bg-green-900 px-4 pt-8 pb-14\">\n125\t        <h1 className=\"text-2xl font-extrabold text-white leading-snug\">\n126\t          Fresh from your<br />neighbourhood farmer\n127\t        </h1>\n128\t        <p className=\"text-green-300 text-base mt-1 font-medium\">\n129\t          మీ పక్కింటి రైతు నుండి తాజా ఆహారం\n130\t        </p>\n131\t        <p className=\"text-green-400 text-sm mt-1\">నేరుగా పొలం నుండి · మధ్యవర్తులు లేరు</p>\n132\t\n133\t        {/* Stats */}\n134\t        <div className=\"flex gap-8 mt-6\">\n135\t          {[\n136\t            { val: farmerCount,       en: 'Farmers',    te: 'రైతులు' },\n137\t            { val: available.length,  en: 'Products',   te: 'పంటలు' },\n138\t            { val: 0,                 en: 'Middlemen',  te: 'మధ్యవర్తులు' },\n139\t          ].map((s) => (\n140\t            <div key={s.en}>\n141\t              <div className=\"text-4xl font-black text-white\">{s.val}</div>\n142\t              <div className=\"text-xs text-green-300 mt-0.5 leading-snug\">\n143\t                {s.en}<br />{s.te}\n144\t              </div>\n145\t            </div>\n146\t          ))}\n147\t        </div>\n148\t      </div>\n149\t\n150\t      {/* ── Search card (floats over hero) ────── */}\n151\t      <div className=\"px-4 -mt-7\">\n152\t        <div className=\"bg-white rounded-2xl shadow-xl p-4 space-y-3\">\n153\t          <div className=\"relative\">\n154\t            <svg className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-400\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\">\n155\t              <circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.35-4.35\" strokeLinecap=\"round\"/>\n156\t            </svg>\n157\t            <input\n158\t              type=\"search\"\n159\t              placeholder=\"Search produce... / పంట వెతకండి...\"\n160\t              value={search}\n161\t              onChange={(e) => setSearch(e.target.value)}\n162\t              className=\"w-full pl-10 pr-4 py-3 border-2 border-gray-200 rounded-xl text-base focus:border-green-500 focus:outline-none\"\n163\t            />\n164\t          </div>\n165\t          <select\n166\t            value={method}\n167\t            onChange={(e) => setMethod(e.target.value)}\n168\t            className=\"w-full px-4 py-3 border-2 border-gray-200 rounded-xl text-base bg-white focus:border-green-500 focus:outline-none\"\n169\t          >\n170\t            <option value=\"all\">🌿 All methods / అన్ని పద్ధతులు</option>\n171\t            <option value=\"natural\">🌱 Natural / సహజం</option>\n172\t            <option value=\"organic\">🍃 Organic / సేంద్రీయ</option>\n173\t            <option value=\"low_chemical\">⚡ Low chemical / తక్కువ రసాయన</option>\n174\t          </select>\n175\t        </div>\n176\t      </div>\n177\t\n178\t      {/* ── Category chips ───────────────────── */}\n179\t      <div className=\"mt-4 px-4\">\n180\t        <div className=\"flex gap-2 overflow-x-auto scrollbar-hide pb-1\">\n181\t          {CATEGORIES.map((chip) => (\n182\t            <button\n183\t              key={chip.key}\n184\t              onClick={() => setCategory(chip.key)}\n185\t              className={`flex-shrink-0 px-4 py-2.5 rounded-full text-sm font-semibold border transition-all ${\n186\t                category === chip.key\n187\t                  ? 'bg-green-700 text-white border-green-700'\n188\t                  : 'bg-white text-gray-700 border-gray-200'\n189\t              }`}\n190\t            >\n191\t              {chip.en} / {chip.te}\n192\t            </button>\n193\t          ))}\n194\t        </div>\n195\t      </div>\n196\t\n197\t      {/* ── Available now ────────────────────── */}\n198\t      <div className=\"px-4 mt-6\">\n199\t        <div className=\"flex items-end justify-between mb-4\">\n200\t          <div>\n201\t            <h2 className=\"text-xl font-extrabold text-gray-900\">Available now</h2>\n202\t            <p className=\"text-green-700 font-semibold text-sm leading-tight\">ఇప్పుడు అందుబాటులో</p>\n203\t          </div>\n204\t          {!loading && (\n205\t            <span className=\"text-sm font-bold text-gray-400\">\n206\t              {filtered.length} items\n207\t            </span>\n208\t          )}\n209\t        </div>\n210\t\n211\t        {loading ? (\n212\t          <LoadingSkeleton />\n213\t        ) : filtered.length === 0 ? (\n214\t          <EmptyState />\n215\t        ) : (\n216\t          <div className=\"grid grid-cols-2 gap-3\">\n217\t            {filtered.map((item) => (\n218\t              <ProduceCard key={item.id} item={item} />\n219\t            ))}\n220\t          </div>\n221\t        )}\n222\t      </div>\n223\t\n224\t      {/* ── Coming soon ──────────────────────── */}\n225\t      {!loading && comingSoon.length > 0 && (\n226\t        <div className=\"px-4 mt-10\">\n227\t          <div className=\"mb-4\">\n228\t            <h2 className=\"text-xl font-extrabold text-gray-900\">Coming soon</h2>\n229\t            <p className=\"text-amber-600 font-semibold text-sm\">త్వరలో వస్తుంది</p>\n230\t          </div>\n231\t          <div className=\"grid grid-cols-2 gap-3\">\n232\t            {comingSoon.map((item) => (\n233\t              <ComingSoonCard key={item.id} item={item} />\n234\t            ))}\n235\t          </div>\n236\t        </div>\n237\t      )}\n238\t\n239\t      {/* ── Demand intent banner ─────────────── */}\n240\t      <DemandIntentBanner />\n241\t\n242\t      {/* ── Floating cart button ─────────────── */}\n243\t      <CartFab />\n244\t    </main>\n245\t  )\n246\t}\n247\t\n248\t/* ─── Produce card ──────────────────────────────────────── */\n249\tfunction ProduceCard({ item }: { item: ProduceListing }) {\n250\t  const emoji    = item.emoji ?? '🌿'\n251\t  const emojiBg  = EMOJI_BG[emoji] ?? 'bg-green-50'\n252\t  const method   = item.method?.toLowerCase() ?? 'natural'\n253\t  const badge    = METHOD_STYLE[method]  ?? 'bg-green-100 text-green-800'\n254\t  const badgeLabel = METHOD_LABEL[method] ?? 'Natural'\n255\t  const farmer   = item.farmer\n256\t  const farmerHref = farmer ? `/farmer/${farmer.slug}` : '#'\n257\t\n258\t  const { cart, addItem, setQty } = useCart()\n259\t  const inCart = cart[item.id]\n260\t\n261\t  const canAdd = !!farmer && !!farmer.phone\n262\t\n263\t  const handleAdd = () => {\n264\t    if (!farmer) return\n265\t    addItem({\n266\t      listingId: item.id,\n267\t      name: item.name,\n268\t      variety: item.variety,\n269\t      emoji: item.emoji,\n270\t      pricePerKg: item.price_tier_1_price,\n271\t      farmerId: farmer.id,\n272\t      farmerName: farmer.name,\n273\t      farmerPhone: farmer.phone,\n274\t      farmerVillage: farmer.village,\n275\t      farmerSlug: farmer.slug,\n276\t    }, 1)\n277\t  }\n278\t\n279\t  return (\n280\t    <div className=\"bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 flex flex-col\">\n281\t      {/* Emoji header — taps go to farmer profile */}\n282\t      <Link href={farmerHref}>\n283\t        <div className={`${emojiBg} flex items-center justify-center py-7`}>\n284\t          <span className=\"text-5xl\">{emoji}</span>\n285\t        </div>\n286\t      </Link>\n287\t\n288\t      <div className=\"p-3 flex flex-col flex-1 gap-1\">\n289\t        {/* Name + variety */}\n290\t        <Link href={farmerHref}>\n291\t          <h3 className=\"font-extrabold text-gray-900 text-base leading-tight\">{item.name}</h3>\n292\t          {item.variety && (\n293\t            <p className=\"text-xs text-gray-400 mt-0.5\">{item.variety}</p>\n294\t          )}\n295\t        </Link>\n296\t\n297\t        {/* Farmer info */}\n298\t        {farmer && (\n299\t          <Link href={farmerHref} className=\"text-xs text-gray-500 leading-snug\">\n300\t            🧑‍🌾 {farmer.name}<br />\n301\t            📍 {farmer.village}\n302\t          </Link>\n303\t        )}\n304\t\n305\t        {/* Price + method badge */}\n306\t        <div className=\"flex items-center justify-between mt-1\">\n307\t          <span className=\"text-green-700 font-black text-lg\">\n308\t            {item.price_tier_1_price ? `₹${item.price_tier_1_price}` : '—'}\n309\t            <span className=\"text-xs font-normal text-gray-400\">/kg</span>\n310\t          </span>\n311\t          <span className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${badge}`}>\n312\t            {badgeLabel}\n313\t          </span>\n314\t        </div>\n315\t\n316\t        {/* Stock */}\n317\t        {item.stock_qty != null && (\n318\t          <p className=\"text-xs text-gray-400\">\n319\t            {item.stock_qty} kg left / మిగిలాయి\n320\t          </p>\n321\t        )}\n322\t\n323\t        {/* CTA */}\n324\t        {!canAdd ? (\n325\t          <Link\n326\t            href={farmerHref}\n327\t            className=\"mt-2 block text-center w-full bg-green-700 text-white font-bold py-3 rounded-xl text-sm\"\n328\t          >\n329\t            View / చూడండి\n330\t          </Link>\n331\t        ) : !inCart ? (\n332\t          <button\n333\t            onClick={handleAdd}\n334\t            className=\"mt-2 w-full bg-green-700 active:bg-green-800 text-white font-bold py-3 rounded-xl text-sm\"\n335\t          >\n336\t            + Add / చేర్చు\n337\t          </button>\n338\t        ) : (\n339\t          <div className=\"mt-2 flex items-center justify-between bg-green-50 border border-green-200 rounded-xl px-2 py-1.5\">\n340\t            <button\n341\t              onClick={() => setQty(item.id, inCart.qty - 1)}\n342\t              className=\"w-8 h-8 rounded-lg bg-white border border-green-300 text-green-800 text-lg font-bold\"\n343\t              aria-label=\"Decrease\"\n344\t            >\n345\t              −\n346\t            </button>\n347\t            <span className=\"font-extrabold text-green-900 text-sm\">\n348\t              {inCart.qty} kg\n349\t            </span>\n350\t            <button\n351\t              onClick={() => setQty(item.id, inCart.qty + 1)}\n352\t              className=\"w-8 h-8 rounded-lg bg-green-700 text-white text-lg font-bold\"\n353\t              aria-label=\"Increase\"\n354\t            >\n355\t              +\n356\t            </button>\n357\t          </div>\n358\t        )}\n359\t      </div>\n360\t    </div>\n361\t  )\n362\t}\n363\t\n364\t/* ─── Coming soon card ──────────────────────────────────── */\n365\tfunction ComingSoonCard({ item }: { item: ProduceListing }) {\n366\t  const emoji   = item.emoji ?? '🌱'\n367\t  const emojiBg = EMOJI_BG[emoji] ?? 'bg-amber-50'\n368\t  const farmer  = item.farmer\n369\t\n370\t  return (\n371\t    <div className=\"bg-white rounded-2xl overflow-hidden border-2 border-dashed border-amber-200 flex flex-col\">\n372\t      <div className={`${emojiBg} flex items-center justify-center py-7`}>\n373\t        <span className=\"text-5xl\">{emoji}</span>\n374\t      </div>\n375\t      <div className=\"p-3 flex flex-col flex-1 gap-1\">\n376\t        <h3 className=\"font-extrabold text-gray-700 text-base leading-tight\">{item.name}</h3>\n377\t        {farmer && (\n378\t          <p className=\"text-xs text-gray-400\">🧑‍🌾 {farmer.name}</p>\n379\t        )}\n380\t        {item.available_to && (\n381\t          <p className=\"text-xs text-amber-600 font-medium\">\n382\t            Ready: {new Date(item.available_to).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })}\n383\t          </p>\n384\t        )}\n385\t        <span className=\"mt-1 inline-block bg-amber-100 text-amber-700 text-xs font-bold px-2 py-1 rounded-full self-start\">\n386\t          Coming soon / త్వరలో\n387\t        </span>\n388\t        {farmer && (\n389\t          <Link\n390\t            href={`/farmer/${farmer.slug}`}\n391\t            className=\"mt-2 block text-center w-full border-2 border-green-600 text-green-700 font-bold py-3 rounded-xl text-sm\"\n392\t          >\n393\t            View farmer / రైతు చూడండి\n394\t          </Link>\n395\t        )}\n396\t      </div>\n397\t    </div>\n398\t  )\n399\t}\n400\t\n401\t/* ─── Loading skeleton ──────────────────────────────────── */\n402\tfunction LoadingSkeleton() {\n403\t  return (\n404\t    <div className=\"grid grid-cols-2 gap-3\">\n405\t      {[1, 2, 3, 4].map((i) => (\n406\t        <div key={i} className=\"bg-white rounded-2xl overflow-hidden animate-pulse\">\n407\t          <div className=\"h-28 bg-gray-100\" />\n408\t          <div className=\"p-3 space-y-2\">\n409\t            <div className=\"h-4 bg-gray-100 rounded w-3/4\" />\n410\t            <div className=\"h-3 bg-gray-100 rounded w-1/2\" />\n411\t            <div className=\"h-3 bg-gray-100 rounded w-2/3\" />\n412\t            <div className=\"h-11 bg-gray-100 rounded-xl mt-3\" />\n413\t          </div>\n414\t        </div>\n415\t      ))}\n416\t    </div>\n417\t  )\n418\t}\n419\t\n420\t/* ─── Empty state ───────────────────────────────────────── */\n421\tfunction EmptyState() {\n422\t  return (\n423\t    <div className=\"text-center py-14\">\n424\t      <div className=\"text-6xl mb-4\">🔍</div>\n425\t      <p className=\"text-gray-800 font-bold text-lg\">No produce found</p>\n426\t      <p className=\"text-gray-500 text-base mt-1\">పంట కనుగొనబడలేదు</p>\n427\t      <p className=\"text-gray-400 text-sm mt-2\">Try a different search or category</p>\n428\t    </div>\n429\t  )\n430\t}\n431\t\n432\t/* ─── Demand intent banner ──────────────────────────────────── */\n433\tfunction DemandIntentBanner() {\n434\t  const [open, setOpen] = useState(false)\n435\t  const [crop, setCrop] = useState('')\n436\t  const [qty, setQty] = useState('')\n437\t  const [date, setDate] = useState('')\n438\t  const [location, setLocation] = useState('')\n439\t  const [name, setName] = useState('')\n440\t  const [phone, setPhone] = useState('')\n441\t  const [loading, setLoading] = useState(false)\n442\t  const [submitted, setSubmitted] = useState(false)\n443\t  const [error, setError] = useState('')\n444\t\n445\t  const handleSubmit = async () => {\n446\t    if (!crop.trim() || !name.trim() || !phone.trim()) {\n447\t      setError('Please fill crop name, your name, and phone number.')\n448\t      return\n449\t    }\n450\t    setLoading(true)\n451\t    setError('')\n452\t    const { supabase: sb } = await import('@/lib/supabase')\n453\t    const { error: err } = await sb.from('demand_intents').insert({\n454\t      crop_name: crop.trim(),\n455\t      quantity_kg: qty ? Number(qty) : null,\n456\t      needed_by_date: date || null,\n457\t      delivery_location: location.trim() || null,\n458\t      requester_name: name.trim(),\n459\t      requester_phone: phone.trim(),\n460\t      region_slug: 'tadepalligudem',\n461\t    })\n462\t    setLoading(false)\n463\t    if (err) { setError(err.message); return }\n464\t    setSubmitted(true)\n465\t  }\n466\t\n467\t  return (\n468\t    <div className=\"px-4 mt-10 mb-4\">\n469\t      <div className=\"bg-amber-50 border-2 border-amber-200 rounded-2xl p-4\">\n470\t        <div className=\"flex items-start gap-3\">\n471\t          <span className=\"text-2xl\">📣</span>\n472\t          <div className=\"flex-1 min-w-0\">\n473\t            <h3 className=\"font-extrabold text-amber-900 text-base leading-tight\">Raise a Demand Intent</h3>\n474\t            <p className=\"text-amber-700 text-sm mt-1 leading-snug\">\n475\t              Let local farmers know what you need — they&apos;ll reach out when available.\n476\t            </p>\n477\t            <p className=\"text-amber-600 text-xs mt-0.5\">\n478\t              స్థానిక రైతులకు మీకు ఏమి కావాలో తెలియజేయండి\n479\t            </p>\n480\t          </div>\n481\t        </div>\n482\t\n483\t        {!open && !submitted && (\n484\t          <button\n485\t            onClick={() => setOpen(true)}\n486\t            className=\"mt-4 w-full bg-amber-600 text-white font-bold py-3.5 rounded-xl text-sm flex items-center justify-center gap-2\"\n487\t          >\n488\t            <span className=\"text-lg leading-none\">+</span>\n489\t            Raise Intent / డిమాండ్ నమోదు\n490\t          </button>\n491\t        )}\n492\t\n493\t        {submitted && (\n494\t          <div className=\"mt-4 text-center py-3\">\n495\t            <p className=\"text-green-700 font-bold text-base\">✓ Intent raised!</p>\n496\t            <p className=\"text-green-600 text-sm mt-1\">Farmers in your area will be notified.</p>\n497\t          </div>\n498\t        )}\n499\t\n500\t        {open && !submitted && (\n501\t          <div className=\"mt-4 space-y-3\">\n502\t            <input\n503\t              type=\"text\"\n504\t              placeholder=\"Crop name * (e.g. Tomato / టమాటా)\"\n505\t              value={crop}\n506\t              onChange={(e) => setCrop(e.target.value)}\n507\t              className=\"w-full border border-amber-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n508\t            />\n509\t            <div className=\"grid grid-cols-2 gap-2\">\n510\t              <input\n511\t                type=\"number\"\n512\t                placeholder=\"Quantity (kg)\"\n513\t                value={qty}\n514\t                onChange={(e) => setQty(e.target.value)}\n515\t                className=\"border border-amber-200 rounded-xl px-3 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n516\t              />\n517\t              <input\n518\t                type=\"date\"\n519\t                value={date}\n520\t                onChange={(e) => setDate(e.target.value)}\n521\t                className=\"border border-amber-200 rounded-xl px-3 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n522\t              />\n523\t            </div>\n524\t            <input\n525\t              type=\"text\"\n526\t              placeholder=\"Delivery location (e.g. Tadepalligudem)\"\n527\t              value={location}\n528\t              onChange={(e) => setLocation(e.target.value)}\n529\t              className=\"w-full border border-amber-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n530\t            />\n531\t            <input\n532\t              type=\"text\"\n533\t              placeholder=\"Your name *\"\n534\t              value={name}\n535\t              onChange={(e) => setName(e.target.value)}\n536\t              className=\"w-full border border-amber-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n537\t            />\n538\t            <input\n539\t              type=\"tel\"\n540\t              placeholder=\"Your WhatsApp number *\"\n541\t              value={phone}\n542\t              onChange={(e) => setPhone(e.target.value)}\n543\t              className=\"w-full border border-amber-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n544\t            />\n545\t\n546\t            {error && (\n547\t              <p className=\"text-sm text-red-600 bg-red-50 rounded-xl px-3 py-2\">{error}</p>\n548\t            )}\n549\t\n550\t            <div className=\"flex gap-2\">\n551\t              <button\n552\t                onClick={() => { setOpen(false); setError('') }}\n553\t                className=\"flex-1 border-2 border-gray-300 text-gray-600 font-semibold py-3 rounded-xl text-sm\"\n554\t              >\n555\t                Cancel\n556\t              </button>\n557\t              <button\n558\t                onClick={handleSubmit}\n559\t                disabled={loading}\n560\t                className=\"flex-1 bg-amber-600 text-white font-bold py-3 rounded-xl text-sm disabled:opacity-50\"\n561\t              >\n562\t                {loading ? 'Submitting...' : 'Submit / నమోదు'}\n563\t              </button>\n564\t            </div>\n565\t          </div>\n566\t        )}\n567\t      </div>\n568\t    </div>\n569\t  )\n570\t}\n571\t\n572\t"}]},"uuid":"79bf0644-1485-4d9e-be36-d1f6455ffe3e","timestamp":"2026-04-21T16:57:52.792Z","toolUseResult":{"type":"text","file":{"filePath":"/home/veerendra/farmer/yourfamilyfarmer/src/app/consumer/page.tsx","content":"'use client'\n\nimport { useState, useEffect, useCallback } from 'react'\nimport Link from 'next/link'\nimport GlobalNav from '@/components/consumer/GlobalNav'\nimport { CartFab, useCart } from '@/components/consumer/Cart'\n\ntype Farmer = {\n  id: string\n  name: string\n  village: string\n  slug: string\n  phone: string\n  method: string\n}\n\ntype ProduceListing = {\n  id: string\n  name: string\n  variety?: string\n  emoji?: string\n  method?: string\n  status: string\n  price_tier_1_price?: number\n  price_tier_1_qty?: number\n  price_tier_2_price?: number\n  price_tier_2_qty?: number\n  price_tier_3_price?: number\n  price_tier_3_qty?: number\n  stock_qty?: number\n  available_to?: string\n  farmer_id: string\n  farmer?: Farmer\n}\n\nconst CATEGORIES = [\n  { key: 'all',        en: 'All',             te: 'అన్నీ' },\n  { key: 'vegetables', en: 'Vegetables',      te: 'కూరగాయలు' },\n  { key: 'fruits',     en: 'Fruits',          te: 'పళ్ళు' },\n  { key: 'grains',     en: 'Grains & Pulses', te: 'ధాన్యాలు' },\n  { key: 'leafy',      en: 'Leafy Greens',    te: 'ఆకు కూరలు' },\n]\n\nconst EMOJI_BG: Record<string, string> = {\n  '🍅': 'bg-red-100',    '🥬': 'bg-green-100',  '🥭': 'bg-orange-100',\n  '🍆': 'bg-purple-100', '🥕': 'bg-orange-100', '🌽': 'bg-yellow-100',\n  '🍌': 'bg-yellow-100', '🫑': 'bg-green-100',  '🧅': 'bg-orange-50',\n  '🧄': 'bg-amber-50',   '🍓': 'bg-red-50',     '🥦': 'bg-green-100',\n  '🌾': 'bg-amber-100',  '🫒': 'bg-green-100',  '🌿': 'bg-green-50',\n  '🥥': 'bg-orange-50',  '🍇': 'bg-purple-50',  '🍋': 'bg-yellow-50',\n}\n\nconst METHOD_STYLE: Record<string, string> = {\n  natural:      'bg-green-100 text-green-800',\n  organic:      'bg-teal-100  text-teal-800',\n  low_chemical: 'bg-amber-100 text-amber-800',\n  chemical:     'bg-red-100   text-red-700',\n}\n\nconst METHOD_LABEL: Record<string, string> = {\n  natural:      'Natural / సహజం',\n  organic:      'Organic / సేంద్రీయ',\n  low_chemical: 'Low chemical',\n  chemical:     'Chemical',\n}\n\nexport default function ConsumerPage() {\n  const [available, setAvailable]     = useState<ProduceListing[]>([])\n  const [comingSoon, setComingSoon]   = useState<ProduceListing[]>([])\n  const [filtered, setFiltered]       = useState<ProduceListing[]>([])\n  const [search, setSearch]           = useState('')\n  const [method, setMethod]           = useState('all')\n  const [category, setCategory]       = useState('all')\n  const [loading, setLoading]         = useState(true)\n  const [farmerCount, setFarmerCount] = useState(0)\n\n  useEffect(() => { fetchData() }, [])\n\n  const fetchData = async () => {\n    setLoading(true)\n    try {\n      const [avRes, csRes] = await Promise.all([\n        fetch('/api/produce'),\n        fetch('/api/produce?status=coming_soon'),\n      ])\n      const av: ProduceListing[] = await avRes.json().catch(() => [])\n      const cs: ProduceListing[] = await csRes.json().catch(() => [])\n      const avArr = Array.isArray(av) ? av : []\n      const csArr = Array.isArray(cs) ? cs : []\n      setAvailable(avArr)\n      setFiltered(avArr)\n      setComingSoon(csArr)\n      setFarmerCount(new Set(avArr.map((p) => p.farmer_id)).size)\n    } catch { /* silent */ }\n    setLoading(false)\n  }\n\n  const doSearch = useCallback(async () => {\n    if (!search && method === 'all' && category === 'all') {\n      setFiltered(available)\n      return\n    }\n    try {\n      const p = new URLSearchParams()\n      if (search)              p.set('q', search)\n      if (method !== 'all')    p.set('method', method)\n      if (category !== 'all')  p.set('category', category)\n      const res = await fetch(`/api/produce/search?${p}`)\n      const data = await res.json().catch(() => [])\n      setFiltered(Array.isArray(data) ? data : [])\n    } catch { /* silent */ }\n  }, [search, method, category, available])\n\n  useEffect(() => {\n    const t = setTimeout(doSearch, 300)\n    return () => clearTimeout(t)\n  }, [doSearch])\n\n  return (\n    <main className=\"min-h-screen bg-gray-50 pb-12\">\n      <GlobalNav activeTab=\"consumer\" />\n\n      {/* ── Hero ─────────────────────────────── */}\n      <div className=\"bg-green-900 px-4 pt-8 pb-14\">\n        <h1 className=\"text-2xl font-extrabold text-white leading-snug\">\n          Fresh from your<br />neighbourhood farmer\n        </h1>\n        <p className=\"text-green-300 text-base mt-1 font-medium\">\n          మీ పక్కింటి రైతు నుండి తాజా ఆహారం\n        </p>\n        <p className=\"text-green-400 text-sm mt-1\">నేరుగా పొలం నుండి · మధ్యవర్తులు లేరు</p>\n\n        {/* Stats */}\n        <div className=\"flex gap-8 mt-6\">\n          {[\n            { val: farmerCount,       en: 'Farmers',    te: 'రైతులు' },\n            { val: available.length,  en: 'Products',   te: 'పంటలు' },\n            { val: 0,                 en: 'Middlemen',  te: 'మధ్యవర్తులు' },\n          ].map((s) => (\n            <div key={s.en}>\n              <div className=\"text-4xl font-black text-white\">{s.val}</div>\n              <div className=\"text-xs text-green-300 mt-0.5 leading-snug\">\n                {s.en}<br />{s.te}\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* ── Search card (floats over hero) ────── */}\n      <div className=\"px-4 -mt-7\">\n        <div className=\"bg-white rounded-2xl shadow-xl p-4 space-y-3\">\n          <div className=\"relative\">\n            <svg className=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-400\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\">\n              <circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.35-4.35\" strokeLinecap=\"round\"/>\n            </svg>\n            <input\n              type=\"search\"\n              placeholder=\"Search produce... / పంట వెతకండి...\"\n              value={search}\n              onChange={(e) => setSearch(e.target.value)}\n              className=\"w-full pl-10 pr-4 py-3 border-2 border-gray-200 rounded-xl text-base focus:border-green-500 focus:outline-none\"\n            />\n          </div>\n          <select\n            value={method}\n            onChange={(e) => setMethod(e.target.value)}\n            className=\"w-full px-4 py-3 border-2 border-gray-200 rounded-xl text-base bg-white focus:border-green-500 focus:outline-none\"\n          >\n            <option value=\"all\">🌿 All methods / అన్ని పద్ధతులు</option>\n            <option value=\"natural\">🌱 Natural / సహజం</option>\n            <option value=\"organic\">🍃 Organic / సేంద్రీయ</option>\n            <option value=\"low_chemical\">⚡ Low chemical / తక్కువ రసాయన</option>\n          </select>\n        </div>\n      </div>\n\n      {/* ── Category chips ───────────────────── */}\n      <div className=\"mt-4 px-4\">\n        <div className=\"flex gap-2 overflow-x-auto scrollbar-hide pb-1\">\n          {CATEGORIES.map((chip) => (\n            <button\n              key={chip.key}\n              onClick={() => setCategory(chip.key)}\n              className={`flex-shrink-0 px-4 py-2.5 rounded-full text-sm font-semibold border transition-all ${\n                category === chip.key\n                  ? 'bg-green-700 text-white border-green-700'\n                  : 'bg-white text-gray-700 border-gray-200'\n              }`}\n            >\n              {chip.en} / {chip.te}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* ── Available now ────────────────────── */}\n      <div className=\"px-4 mt-6\">\n        <div className=\"flex items-end justify-between mb-4\">\n          <div>\n            <h2 className=\"text-xl font-extrabold text-gray-900\">Available now</h2>\n            <p className=\"text-green-700 font-semibold text-sm leading-tight\">ఇప్పుడు అందుబాటులో</p>\n          </div>\n          {!loading && (\n            <span className=\"text-sm font-bold text-gray-400\">\n              {filtered.length} items\n            </span>\n          )}\n        </div>\n\n        {loading ? (\n          <LoadingSkeleton />\n        ) : filtered.length === 0 ? (\n          <EmptyState />\n        ) : (\n          <div className=\"grid grid-cols-2 gap-3\">\n            {filtered.map((item) => (\n              <ProduceCard key={item.id} item={item} />\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* ── Coming soon ──────────────────────── */}\n      {!loading && comingSoon.length > 0 && (\n        <div className=\"px-4 mt-10\">\n          <div className=\"mb-4\">\n            <h2 className=\"text-xl font-extrabold text-gray-900\">Coming soon</h2>\n            <p className=\"text-amber-600 font-semibold text-sm\">త్వరలో వస్తుంది</p>\n          </div>\n          <div className=\"grid grid-cols-2 gap-3\">\n            {comingSoon.map((item) => (\n              <ComingSoonCard key={item.id} item={item} />\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* ── Demand intent banner ─────────────── */}\n      <DemandIntentBanner />\n\n      {/* ── Floating cart button ─────────────── */}\n      <CartFab />\n    </main>\n  )\n}\n\n/* ─── Produce card ──────────────────────────────────────── */\nfunction ProduceCard({ item }: { item: ProduceListing }) {\n  const emoji    = item.emoji ?? '🌿'\n  const emojiBg  = EMOJI_BG[emoji] ?? 'bg-green-50'\n  const method   = item.method?.toLowerCase() ?? 'natural'\n  const badge    = METHOD_STYLE[method]  ?? 'bg-green-100 text-green-800'\n  const badgeLabel = METHOD_LABEL[method] ?? 'Natural'\n  const farmer   = item.farmer\n  const farmerHref = farmer ? `/farmer/${farmer.slug}` : '#'\n\n  const { cart, addItem, setQty } = useCart()\n  const inCart = cart[item.id]\n\n  const canAdd = !!farmer && !!farmer.phone\n\n  const handleAdd = () => {\n    if (!farmer) return\n    addItem({\n      listingId: item.id,\n      name: item.name,\n      variety: item.variety,\n      emoji: item.emoji,\n      pricePerKg: item.price_tier_1_price,\n      farmerId: farmer.id,\n      farmerName: farmer.name,\n      farmerPhone: farmer.phone,\n      farmerVillage: farmer.village,\n      farmerSlug: farmer.slug,\n    }, 1)\n  }\n\n  return (\n    <div className=\"bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 flex flex-col\">\n      {/* Emoji header — taps go to farmer profile */}\n      <Link href={farmerHref}>\n        <div className={`${emojiBg} flex items-center justify-center py-7`}>\n          <span className=\"text-5xl\">{emoji}</span>\n        </div>\n      </Link>\n\n      <div className=\"p-3 flex flex-col flex-1 gap-1\">\n        {/* Name + variety */}\n        <Link href={farmerHref}>\n          <h3 className=\"font-extrabold text-gray-900 text-base leading-tight\">{item.name}</h3>\n          {item.variety && (\n            <p className=\"text-xs text-gray-400 mt-0.5\">{item.variety}</p>\n          )}\n        </Link>\n\n        {/* Farmer info */}\n        {farmer && (\n          <Link href={farmerHref} className=\"text-xs text-gray-500 leading-snug\">\n            🧑‍🌾 {farmer.name}<br />\n            📍 {farmer.village}\n          </Link>\n        )}\n\n        {/* Price + method badge */}\n        <div className=\"flex items-center justify-between mt-1\">\n          <span className=\"text-green-700 font-black text-lg\">\n            {item.price_tier_1_price ? `₹${item.price_tier_1_price}` : '—'}\n            <span className=\"text-xs font-normal text-gray-400\">/kg</span>\n          </span>\n          <span className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${badge}`}>\n            {badgeLabel}\n          </span>\n        </div>\n\n        {/* Stock */}\n        {item.stock_qty != null && (\n          <p className=\"text-xs text-gray-400\">\n            {item.stock_qty} kg left / మిగిలాయి\n          </p>\n        )}\n\n        {/* CTA */}\n        {!canAdd ? (\n          <Link\n            href={farmerHref}\n            className=\"mt-2 block text-center w-full bg-green-700 text-white font-bold py-3 rounded-xl text-sm\"\n          >\n            View / చూడండి\n          </Link>\n        ) : !inCart ? (\n          <button\n            onClick={handleAdd}\n            className=\"mt-2 w-full bg-green-700 active:bg-green-800 text-white font-bold py-3 rounded-xl text-sm\"\n          >\n            + Add / చేర్చు\n          </button>\n        ) : (\n          <div className=\"mt-2 flex items-center justify-between bg-green-50 border border-green-200 rounded-xl px-2 py-1.5\">\n            <button\n              onClick={() => setQty(item.id, inCart.qty - 1)}\n              className=\"w-8 h-8 rounded-lg bg-white border border-green-300 text-green-800 text-lg font-bold\"\n              aria-label=\"Decrease\"\n            >\n              −\n            </button>\n            <span className=\"font-extrabold text-green-900 text-sm\">\n              {inCart.qty} kg\n            </span>\n            <button\n              onClick={() => setQty(item.id, inCart.qty + 1)}\n              className=\"w-8 h-8 rounded-lg bg-green-700 text-white text-lg font-bold\"\n              aria-label=\"Increase\"\n            >\n              +\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}\n\n/* ─── Coming soon card ──────────────────────────────────── */\nfunction ComingSoonCard({ item }: { item: ProduceListing }) {\n  const emoji   = item.emoji ?? '🌱'\n  const emojiBg = EMOJI_BG[emoji] ?? 'bg-amber-50'\n  const farmer  = item.farmer\n\n  return (\n    <div className=\"bg-white rounded-2xl overflow-hidden border-2 border-dashed border-amber-200 flex flex-col\">\n      <div className={`${emojiBg} flex items-center justify-center py-7`}>\n        <span className=\"text-5xl\">{emoji}</span>\n      </div>\n      <div className=\"p-3 flex flex-col flex-1 gap-1\">\n        <h3 className=\"font-extrabold text-gray-700 text-base leading-tight\">{item.name}</h3>\n        {farmer && (\n          <p className=\"text-xs text-gray-400\">🧑‍🌾 {farmer.name}</p>\n        )}\n        {item.available_to && (\n          <p className=\"text-xs text-amber-600 font-medium\">\n            Ready: {new Date(item.available_to).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })}\n          </p>\n        )}\n        <span className=\"mt-1 inline-block bg-amber-100 text-amber-700 text-xs font-bold px-2 py-1 rounded-full self-start\">\n          Coming soon / త్వరలో\n        </span>\n        {farmer && (\n          <Link\n            href={`/farmer/${farmer.slug}`}\n            className=\"mt-2 block text-center w-full border-2 border-green-600 text-green-700 font-bold py-3 rounded-xl text-sm\"\n          >\n            View farmer / రైతు చూడండి\n          </Link>\n        )}\n      </div>\n    </div>\n  )\n}\n\n/* ─── Loading skeleton ──────────────────────────────────── */\nfunction LoadingSkeleton() {\n  return (\n    <div className=\"grid grid-cols-2 gap-3\">\n      {[1, 2, 3, 4].map((i) => (\n        <div key={i} className=\"bg-white rounded-2xl overflow-hidden animate-pulse\">\n          <div className=\"h-28 bg-gray-100\" />\n          <div className=\"p-3 space-y-2\">\n            <div className=\"h-4 bg-gray-100 rounded w-3/4\" />\n            <div className=\"h-3 bg-gray-100 rounded w-1/2\" />\n            <div className=\"h-3 bg-gray-100 rounded w-2/3\" />\n            <div className=\"h-11 bg-gray-100 rounded-xl mt-3\" />\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n\n/* ─── Empty state ───────────────────────────────────────── */\nfunction EmptyState() {\n  return (\n    <div className=\"text-center py-14\">\n      <div className=\"text-6xl mb-4\">🔍</div>\n      <p className=\"text-gray-800 font-bold text-lg\">No produce found</p>\n      <p className=\"text-gray-500 text-base mt-1\">పంట కనుగొనబడలేదు</p>\n      <p className=\"text-gray-400 text-sm mt-2\">Try a different search or category</p>\n    </div>\n  )\n}\n\n/* ─── Demand intent banner ──────────────────────────────────── */\nfunction DemandIntentBanner() {\n  const [open, setOpen] = useState(false)\n  const [crop, setCrop] = useState('')\n  const [qty, setQty] = useState('')\n  const [date, setDate] = useState('')\n  const [location, setLocation] = useState('')\n  const [name, setName] = useState('')\n  const [phone, setPhone] = useState('')\n  const [loading, setLoading] = useState(false)\n  const [submitted, setSubmitted] = useState(false)\n  const [error, setError] = useState('')\n\n  const handleSubmit = async () => {\n    if (!crop.trim() || !name.trim() || !phone.trim()) {\n      setError('Please fill crop name, your name, and phone number.')\n      return\n    }\n    setLoading(true)\n    setError('')\n    const { supabase: sb } = await import('@/lib/supabase')\n    const { error: err } = await sb.from('demand_intents').insert({\n      crop_name: crop.trim(),\n      quantity_kg: qty ? Number(qty) : null,\n      needed_by_date: date || null,\n      delivery_location: location.trim() || null,\n      requester_name: name.trim(),\n      requester_phone: phone.trim(),\n      region_slug: 'tadepalligudem',\n    })\n    setLoading(false)\n    if (err) { setError(err.message); return }\n    setSubmitted(true)\n  }\n\n  return (\n    <div className=\"px-4 mt-10 mb-4\">\n      <div className=\"bg-amber-50 border-2 border-amber-200 rounded-2xl p-4\">\n        <div className=\"flex items-start gap-3\">\n          <span className=\"text-2xl\">📣</span>\n          <div className=\"flex-1 min-w-0\">\n            <h3 className=\"font-extrabold text-amber-900 text-base leading-tight\">Raise a Demand Intent</h3>\n            <p className=\"text-amber-700 text-sm mt-1 leading-snug\">\n              Let local farmers know what you need — they&apos;ll reach out when available.\n            </p>\n            <p className=\"text-amber-600 text-xs mt-0.5\">\n              స్థానిక రైతులకు మీకు ఏమి కావాలో తెలియజేయండి\n            </p>\n          </div>\n        </div>\n\n        {!open && !submitted && (\n          <button\n            onClick={() => setOpen(true)}\n            className=\"mt-4 w-full bg-amber-600 text-white font-bold py-3.5 rounded-xl text-sm flex items-center justify-center gap-2\"\n          >\n            <span className=\"text-lg leading-none\">+</span>\n            Raise Intent / డిమాండ్ నమోదు\n          </button>\n        )}\n\n        {submitted && (\n          <div className=\"mt-4 text-center py-3\">\n            <p className=\"text-green-700 font-bold text-base\">✓ Intent raised!</p>\n            <p className=\"text-green-600 text-sm mt-1\">Farmers in your area will be notified.</p>\n          </div>\n        )}\n\n        {open && !submitted && (\n          <div className=\"mt-4 space-y-3\">\n            <input\n              type=\"text\"\n              placeholder=\"Crop name * (e.g. Tomato / టమాటా)\"\n              value={crop}\n              onChange={(e) => setCrop(e.target.value)}\n              className=\"w-full border border-amber-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n            />\n            <div className=\"grid grid-cols-2 gap-2\">\n              <input\n                type=\"number\"\n                placeholder=\"Quantity (kg)\"\n                value={qty}\n                onChange={(e) => setQty(e.target.value)}\n                className=\"border border-amber-200 rounded-xl px-3 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n              />\n              <input\n                type=\"date\"\n                value={date}\n                onChange={(e) => setDate(e.target.value)}\n                className=\"border border-amber-200 rounded-xl px-3 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n              />\n            </div>\n            <input\n              type=\"text\"\n              placeholder=\"Delivery location (e.g. Tadepalligudem)\"\n              value={location}\n              onChange={(e) => setLocation(e.target.value)}\n              className=\"w-full border border-amber-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n            />\n            <input\n              type=\"text\"\n              placeholder=\"Your name *\"\n              value={name}\n              onChange={(e) => setName(e.target.value)}\n              className=\"w-full border border-amber-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n            />\n            <input\n              type=\"tel\"\n              placeholder=\"Your WhatsApp number *\"\n              value={phone}\n              onChange={(e) => setPhone(e.target.value)}\n              className=\"w-full border border-amber-200 rounded-xl px-4 py-3 text-sm bg-white focus:border-amber-500 focus:outline-none\"\n            />\n\n            {error && (\n              <p className=\"text-sm text-red-600 bg-red-50 rounded-xl px-3 py-2\">{error}</p>\n            )}\n\n            <div className=\"flex gap-2\">\n              <button\n                onClick={() =>